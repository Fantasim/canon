diff --git a/internal/edit/undoorder.go b/internal/edit/undoorder.go
new file mode 100644
index 0000000..bd7d7fe
--- /dev/null
+++ b/internal/edit/undoorder.go
@@ -0,0 +1,121 @@
+package edit
+
+import (
+	"slices"
+
+	"github.com/fantasim/canonlang/internal/types"
+	"github.com/fantasim/canonlang/internal/value"
+)
+
+// undoGroup is one operation's or cascade's inverses, placed in the Undo by what it wrote
+// (API.md E22, E23); reach is its path, the item an Add or AddEntry adds, or the collection
+// whose items' paths an Insert, Remove, Move or Rename shifts.
+type undoGroup struct {
+	ops     []Operation
+	path    string   // the canonical path it wrote
+	reach   string   // the value it may change
+	drivers []string // the fields computing the types along path (TYPES.md 11)
+}
+
+// undoSite is the placing of x's inverses: its path, its reach, and its path's drivers.
+func (x *opCtx) undoSite() undoGroup {
+	g := undoGroup{path: x.res.Canonical, reach: x.res.Canonical}
+	n := len(x.res.Steps)
+	switch {
+	case itemOps[x.op.Kind] && n > 0:
+		g.reach = x.pathAt(n - 1)
+	case appendOps[x.op.Kind] && len(x.w.undo) == 1 && x.w.undo[0].Kind == OpRemove:
+		g.reach = x.w.undo[0].Path // the item added, which shifts no other
+	}
+	for i, st := range x.res.Steps {
+		if rec, ok := x.res.parent(i).(*value.Record); ok && st.Seg.Kind == SegField {
+			g.drivers = append(g.drivers, driversOf(x.pathAt(i), fieldsOf(rec.T), st.Seg.Name)...)
+		}
+	}
+	return g
+}
+
+// driversOf are the paths of the fields of the record at rec, declared by decl, that compute
+// the type of its field name.
+func driversOf(rec string, decl []*types.Field, name string) []string {
+	k := fieldIndex(decl, name)
+	if k < 0 {
+		return nil
+	}
+	var out []string
+	for _, d := range decl[k].DependsOn {
+		if d < len(decl) {
+			out = append(out, childPath(rec, Seg{Kind: SegField, Name: decl[d].Name}))
+		}
+	}
+	return out
+}
+
+// cascadeGroup is the placing of inverse, which gives back c's field (API.md E15).
+func cascadeGroup(c fieldCheck, inverse Operation) undoGroup {
+	p := c.path()
+	return undoGroup{ops: []Operation{inverse}, path: p, reach: p, drivers: driversOf(c.t.path, c.t.decl, c.f.Name)}
+}
+
+// undoOrder is the Undo, last operation first then the cascades (API.md E23), each group placed
+// right after the anchor that restores its drivers, so a driver comes back before the values it
+// types; each inverse is listed once (E22; log-2026-09-29 U-E22).
+func undoOrder(ops, cascades []undoGroup) []Operation {
+	groups := slices.Concat(ops, cascades)
+	after := make([][]int, len(groups))
+	moved := make([]bool, len(groups))
+	for j := range groups {
+		if i, ok := anchor(groups, j); ok {
+			after[i], moved[j] = append(after[i], j), true
+		}
+	}
+	u := undoList{groups: groups, after: after}
+	for k := range slices.Backward(ops) {
+		u.place(k, moved[k])
+	}
+	for k := len(ops); k < len(groups); k++ {
+		u.place(k, moved[k])
+	}
+	return u.out
+}
+
+// anchor is the earliest group before j that wrote one of j's drivers after the last group
+// reaching j's value: the inverses before it in the Undo leave j's value as it was then; false
+// for none.
+func anchor(groups []undoGroup, j int) (int, bool) {
+	g := groups[j]
+	at, found := 0, false
+	for k := j - 1; k >= 0; k-- {
+		h := groups[k]
+		if related(h.reach, g.reach) {
+			break
+		}
+		if slices.ContainsFunc(g.drivers, func(d string) bool { return within(h.path, d, pathMarks, true) }) {
+			at, found = k, true
+		}
+	}
+	return at, found
+}
+
+// related reports one of two canonical paths at or inside the other.
+func related(a, b string) bool {
+	return within(a, b, pathMarks, true) || within(b, a, pathMarks, true)
+}
+
+// undoList is the Undo being listed: each group, followed by the groups placed after it.
+type undoList struct {
+	groups []undoGroup
+	after  [][]int
+	out    []Operation
+}
+
+// place lists group k and the groups placed after it, unless it is itself placed after another.
+func (u *undoList) place(k int, moved bool) {
+	if moved {
+		return
+	}
+	u.out = append(u.out, u.groups[k].ops...)
+	for _, j := range u.after[k] {
+		u.place(j, false)
+	}
+}

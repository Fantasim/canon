package telemetry

// catalog.json: the whole catalogue as data, for tools that are not C++ or Go (the HTML
// catalogue, the lake gates). The records below are its shape; Canon writes them as JSON
// (WIRE.md §8.5: two-space indentation, one member or element per line, keys in field order,
// `none` as null, one final newline). Format 3: an event is tagged by its "state", "live" or
// "retired" (a tombstone, whose id is never reused). Format 1 was gen_catalog.py's.

/// The catalogue document.
local record CatalogDoc {
  /// CATALOG_FORMAT: the version of this shape.
  format: Int
  /// CONTRACT_VERSION.
  contract: Int
  /// The provenance prefix of every table, in order.
  provenance: [CatalogProvenance]
  /// Every event type, in id order, tombstones included.
  events: [CatalogEvent]
  /// The enum views the lake needs, in first-use order.
  enums: [CatalogEnum]
}

/// A provenance column.
local record CatalogProvenance {
  /// Its SQL name.
  name: String
  /// Its SQL type.
  sqlType: SqlType @json("type")
}

/// One event type.
local variant CatalogEvent @json(tag: "state") {
  /// A live event type and its table.
  live {
    /// The event type byte.
    id: Int
    /// The lake table.
    tableName: String @json("table")
    /// The current layout version.
    version: Int
    /// The first version whose layout the catalogue knows.
    since: Int
    /// Ring policy.
    tier: Tier
    /// The processes that own a ring for it.
    producers: [Producer]
    /// How the client enqueues it.
    enqueue: Enqueue
    /// Whether the current layout has item_instance_id.
    hasInstanceId: Bool
    /// The packed size of the current struct.
    wireSize: Int
    /// What one row records.
    description: String
    /// Every column in wire order, header first, retired ones where they stood.
    columns: [CatalogColumn]
    /// Its ledger roles.
    ledger: [CatalogRole]
  }
  // `retired` here is the case's name (its wire tag), not the retired modifier.
  /// A tombstone: the id is never reused.
  retired {
    /// The event type byte.
    id: Int
    /// The lake table, or the event's name when the table is not recorded.
    tableName: String @json("table")
  }
}

/// One column of an event table.
local record CatalogColumn {
  /// Its SQL name.
  name: String
  /// Its SQL type.
  sqlType: SqlType @json("type")
  /// How it is streamed.
  fieldKind: FieldKind @json("kind")
  /// Whether the lake allows NULL.
  nullable: Bool
  /// The version that added it.
  since: Int
  /// The version that retired it.
  retiredIn: Int?
  /// The Canon enum an enum8 column holds.
  enumName: String? @json("enum")
}

/// One ledger role.
local record CatalogRole {
  /// The rows it covers; none: every row.
  kinds: CatalogKinds?
  /// What moves.
  currency: Currency
  /// Mint, sink, transfer or none.
  bucket: Bucket
  /// +1, -1 or 0.
  sign: Int
  /// The economy panel's vocabulary.
  token: String
  /// The side a single-row transfer reads.
  leg: Leg?
  /// An extra predicate (DuckDB SQL).
  filter: String?
  /// The magnitude column.
  amount: String?
  /// The column naming the item.
  item: String?
  /// The column whose ledger the leg lands on.
  player: String
  /// The other side's column.
  counterparty: String?
  /// Whether it is summed into the reconciliation.
  counted: Bool
  /// The token this row would double-count with.
  dedupOf: String?
  /// The last version whose rows it reads.
  untilVersion: Int?
  /// Why.
  note: String
}

/// The rows a role covers: the members of `column` it names.
local record CatalogKinds {
  /// The enum8 column that splits the rows.
  column: String
  /// The member names.
  values: [String]
}

/// One enum view.
local record CatalogEnum {
  /// The Canon enum's name.
  name: String
  /// The lake's lookup view.
  viewName: String @json("view")
  /// Its members, retired ones included, in code order.
  values: [Label]
}

/// Column `c` of event `ev`, as the catalogue lists it.
fn columnDoc(ev: Event, c: Column) -> CatalogColumn {
  return {
    name: c.name
    sqlType: c.sql
    fieldKind: c.kind
    nullable: c.nullable()
    since: c.since ?? ev.since
    retiredIn: c.retiredIn
    enumName: if c.values != none { enumOf(c.values).name } else { none }
  }
}

/// The rows role `r` covers; none: every row.
fn kindsDoc(r: Role) -> CatalogKinds? {
  return match r.rows {
    every => none
    some(s) => CatalogKinds { column: s.column.name, values: [String(k) for k in s.kinds] }
  }
}

/// Ledger role `r`, as the catalogue lists it.
fn roleDoc(r: Role) -> CatalogRole {
  return {
    kinds: kindsDoc(r)
    currency: r.currency
    bucket: r.bucket
    sign: r.sign
    token: r.token
    leg: r.leg
    filter: r.filter
    amount: r.amount?.name
    item: r.item?.name
    player: r.player?.name ?? playerColumn()
    counterparty: r.counterparty?.name
    counted: r.counted
    dedupOf: r.dedupOf
    untilVersion: r.untilVersion
    note: r.note
  }
}

/// Event type `e`: its live table, or its tombstone.
fn eventDoc(e: EventType) -> CatalogEvent {
  let ev = eventOf(e)
  if ev == none { return CatalogEvent.retired { id: e.code, tableName: tableOf(e) } }
  return CatalogEvent.live {
    id: e.code
    tableName: tableOf(e)
    version: ev.version
    since: ev.since
    tier: ev.tier
    producers: ev.producers
    enqueue: ev.enqueue
    hasInstanceId: hasInstanceId(e)
    wireSize: wireSize(e)
    description: ev.description
    columns: [columnDoc(ev, c) for c in headerColumns.values() + ev.columns]
    ledger: [roleDoc(r) for r in ev.ledger]
  }
}

/// The enum view of vocabulary `v`.
fn enumDoc(v: Vocabulary) -> CatalogEnum {
  let info = enumOf(v)
  return { name: info.name, viewName: "enum_{v}", values: info.labels }
}

/// The catalogue, written as JSON.
@text("catalog.json")
export fn catalogJson() -> CatalogDoc {
  return {
    format: CATALOG_FORMAT
    contract: CONTRACT_VERSION
    provenance: [{ name: p.name, sqlType: p.sql } for p in provenanceColumns]
    events: [eventDoc(e) for e in EventType.members.sortBy(.code)]
    enums: [enumDoc(v) for v in usedVocabularies()]
  }
}

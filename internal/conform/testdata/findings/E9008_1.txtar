CONFORMANCE.md §6.1: a translated method that no test of its package calls has no receiver.
-- pipeline/potion.canon --
/// Potions.
package pipeline

/// A healing potion.
record Potion {
  /// Hit points restored.
  heal: Int

  /// What a player missing missingHp gets back.
  export fn healFor(self, missingHp: Int) -> Int { return min(heal, max(missingHp, 0)) }
}

emit cpp { out: "@features/pipeline" }
-- findings.txt --
error[E9008]  pipeline/potion.canon:10:13
  translated method Potion.healFor is called by no test of package pipeline: add one, it gives the conformance test its receiver

1 error, 0 warnings in 1 package (…)

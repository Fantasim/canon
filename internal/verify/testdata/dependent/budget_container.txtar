/// A.
package a

/// K.
enum K { num, many }

local fn spin(n: Int) -> Int {
  var i = 0
  while i < n { i += 1 }
  return i
}

/// P.
type P(k: K) = match k {
  num => Int
  many => [Int] where spin(200) == 200
}

/// Thing.
record Thing {
  /// K.
  k: K
  /// Payload.
  p: P(k)
}

/// Things.
let things: [Thing] = [{ k: many, p: [1] }]

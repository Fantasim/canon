-- a/a.canon --
/// A.
package a

/// K.
enum K { pick }

/// Shape.
variant Shape {
  /// Dot.
  dot {
    /// Size.
    size: Int(0..3) = [1, 2, 3, 4].len() + 1
  }
}

/// P.
type P(k: K) = match k {
  pick => Shape
}

/// Thing.
record Thing {
  /// K.
  k: K
  /// Payload.
  p: P(k)
}

/// Things.
let things: [Thing] = [{ k: pick, p: dot }]

test "the shared instance fails E3204" {
  expect things[0] fails E3204
}

test "the shared instance does not pass" {
  expect things[0] passes
}

EVALUATION.md §14, DECISIONS 509: bad, holding a retired member, sits at [2] and [10]. Each
entry of the top-level list xs is walked on its own, so both places report and §14 keeps the least
path, xs[10].e; the list inside the record h is one walk, so bad is verified once, at its first
place in walk order, h.xs[2].e.
-- a/a.canon --
/// A.
package a

/// Element.
enum Element { FIRE, retired WIND }

/// Box.
record Box {
  /// E.
  e: Element
}

local fn mk() -> [Box] {
  let good: Box = { e: FIRE }
  let bad: Box = { e: WIND }
  return [good, good, bad, good, good, good, good, good, good, good, bad]
}

/// Xs.
let xs: [Box] = mk()

/// Holder.
record Holder {
  /// Xs.
  xs: [Box]
}

local fn mk3() -> Holder {
  let good: Box = { e: FIRE }
  let bad: Box = { e: WIND }
  return { xs: [good, good, bad, good, good, good, good, good, good, good, bad] }
}

/// H.
let h: Holder = mk3()
-- project.canon --
project demo {
  canon: "0.1"
}

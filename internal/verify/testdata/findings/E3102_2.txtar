LOCK.md §1: a @stable value is unique among all entries of its table, retired entries included.
-- teamboard/vocab.canon --
package teamboard

record EventType {
  code: UInt16 @stable
  label: String
}

let eventTypes: stable table EventType = {
  KILL_MONSTER { code: 0, label: "Kill a monster" }
  retired KILL_GIANT { code: 1, label: "Kill a giant" }
  KILL_RAID { code: 1, label: "Kill a raid boss" }
}

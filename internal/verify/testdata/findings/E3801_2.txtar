-- a/a.canon --
/// A.
package a

/// K.
enum K { one, gone }

/// P.
type P(k: K) = match k {
  one => Int
  gone => Never
}

/// Thing.
record Thing {
  /// K.
  k: K
  /// Required payload.
  q: P(k)
}

/// Things.
let things: [Thing] = load("things.json")
-- a/things.json --
[{"k": "one", "q": 1}, {"k": "gone", "q": 2}]
-- project.canon --
project demo {
  canon: "0.1"
}

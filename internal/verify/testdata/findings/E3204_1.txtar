TYPES.md §7.4, EVALUATION.md §4.3: computed values outside their range refinements, which no
static check sees: a string's length in bytes, a list's number of elements (a function's result)
and an integer's value; each is reported at its own location, related to the refinement.
-- teamboard/taxonomy.canon --
package teamboard

record AreaGroup {
  label: String(1..=8)
}

record Deck {
  layouts: [String](1..)
  maxHidden: Int(1..4)
}

fn noLayouts() -> [String] {
  return []
}

let areaGroups: stable table AreaGroup = {
  in_game { label: "In game" }
  out_game { label: "Out of " + "game" }
}

let deck: Deck = { layouts: noLayouts(), maxHidden: 2 + 2 }

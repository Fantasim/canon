TYPES.md §13.4, WIRE.md §2.2 rule 5 (DECISIONS 332): under an optional root absent on this machine
there is no listing to match against, so each asset value is E3705 naming the root, instead of E3701;
a path that is not clean or has the wrong extension is still E3703 or E3702.
-- items/items.canon --
/// Items.
package items

/// Item.
record Item {
  /// Icon.
  icon: asset("@client/Icon", ext: [png])
}

/// Items.
let items: stable table Item = {
  sword { icon: "sword.png" }
  shield { icon: "Shield.png" }
  staff { icon: "staff.jpg" }
  bow { icon: "../bow.png" }
}
-- project.canon --
project demo {
  canon: "0.1"
  roots {
    client: "../absent-client"
  }
  optional_roots: [client]
}

TYPES.md §11.6, EVALUATION.md §5: a key that names no entry of a computed ref target is E3501
at the value; a key of an entry is fine.
-- a/a.canon --
/// A.
package a

/// Tag.
record Tag {
  /// Label.
  label: String
}

/// Tags.
let tags: table Tag = {
  red { label: "red" }
}

/// K.
enum K { one, two }

/// P.
type P(k: K) = match k {
  one => Int
  two => ref tags
}

/// Thing.
record Thing {
  /// K.
  k: K
  /// Payload.
  p: P(k)
}

/// Things.
let things: [Thing] = [
  { k: two, p: red },
  { k: two, p: "blue" },
]
-- project.canon --
project demo {
  canon: "0.1"
}
-- findings.txt --
error[E3501]  a/a.canon:35:16
  things[1].p: unknown key blue in tags
  expected by a/a.canon:21 (ref tags)

1 error, 0 warnings in 1 package (…)

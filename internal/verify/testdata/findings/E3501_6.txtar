API.md P9 (log-2026-09-29 M4 U13-r): an entry is named by the key type declared where the map
is, never by the type of a value assigned from elsewhere: `ms: {String | "none": Slot} = base`,
`base` a `{String: Slot}`, names its entry `ms["none"]`, while `base`'s own paths stay bare.
-- a/a.canon --
/// A.
package a

/// Color.
enum Color { red, blue }

/// Tag.
record Tag {
  /// Label.
  label: String
}

/// Tags.
let tags: table Tag = {
  red { label: "red" }
}

/// Slot.
record Slot {
  /// Size.
  size: Int
  /// Tag.
  tag: ref tags

  check size < 5 else "big"
}

/// Ms.
let ms: {String | "none": Slot} = base

/// Base.
let base: {String: Slot} = { "none": { size: 7, tag: red }, "other": { size: 1, tag: "green" } }
-- project.canon --
project demo {
  canon: "0.1"
}
-- findings.txt --
error[E5001]  a/a.canon:32:38
  ms["none"]: big
  expected by a/a.canon:25 (check)

error[E3501]  a/a.canon:32:86
  base[other].tag: unknown key green in tags
  expected by a/a.canon:23 (tag: ref tags)


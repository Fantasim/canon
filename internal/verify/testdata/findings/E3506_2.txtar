-- a/a.canon --
/// A.
package a

/// K.
enum K { col, num }

/// Color.
enum Color { red, retired gone }

/// P.
type P(k: K) = match k {
  col => Color
  num => Int
}

/// X.
record X {
  /// K.
  k: K
  /// Payload.
  p: P(k)
  /// Old.
  c: Color
}

/// T.
record T {
  /// X.
  x: X
}

/// Build, the retired entry first.
fn build() -> table T {
  let s = X { k: col, p: red, c: gone }
  return { retired old { x: s }, cur { x: s } }
}

/// Build2, the live entry first.
fn build2() -> table T {
  let s = X { k: col, p: red, c: gone }
  return { cur { x: s }, retired old { x: s } }
}

/// Ts.
let ts: table T = build()

/// Ts2.
let ts2: table T = build2()
-- project.canon --
project demo {
  canon: "0.1"
}

TYPES.md §10.3, LOCK.md §4.3, DECISIONS 304: a live entry cannot reference a retired one; a
retired entry may, its refs still checked; a top-level value that is not an entry cannot either,
its finding naming no entry (EVALUATION.md §5).
-- teamboard/taxonomy.canon --
package teamboard

record Status {
  label: String
  next: [ref Status]
}

let statuses: stable table Status = {
  open { label: "Open", next: [taken, duplicate] }
  taken { label: "Taken", next: [open] }
  retired duplicate { label: "Duplicate", next: [open, gone] }
}

let lastStatus: ref Status = duplicate

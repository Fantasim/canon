TYPES.md §11.6: a symbolic identifier the computed type has no name for is E3802: no member, no
case; in a dependent list and through a nested type function, whose branch is judged too.
-- a/a.canon --
/// A.
package a

/// K.
enum K { col, shape, deep }

/// Color.
enum Color { red, blue }

/// Shape.
variant Shape {
  /// Dot.
  dot {}
}

/// P.
type P(k: K) = match k {
  col => Color
  shape => Shape
  deep => R(k)
}

/// R, nested.
type R(k: K) = match k {
  deep => Color
  _ => Never
}

/// Thing.
record Thing {
  /// K.
  k: K
  /// Payloads.
  ps: [P(k)]
}

/// Things.
let things: [Thing] = [
  { k: col, ps: [red, dot] },
  { k: shape, ps: [dot, blue] },
  { k: deep, ps: [blue, dot] },
]
-- project.canon --
project demo {
  canon: "0.1"
}

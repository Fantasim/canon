-- a/a.canon --
/// A.
package a

/// K.
enum K { col, num }

/// Color.
enum Color { red, blue }

/// P.
type P(k: K) = match k {
  col => Color
  num => Int
}

/// Tag.
record Tag {
  /// Label.
  label: String
}

/// Tags.
let tags: table Tag = { retired old { label: "o" }, cur { label: "c" } }

/// X.
record X {
  /// K.
  k: K
  /// Payload.
  p: P(k)
  /// Tag.
  t: ref tags
}

/// T.
record T {
  /// X.
  x: X
}

/// S.
let s: X = { k: col, p: red, t: old }

/// Ta.
let ta: table T = { a { x: s } }

/// Tb.
let tb: table T = { b { x: s } }
-- project.canon --
project demo {
  canon: "0.1"
}

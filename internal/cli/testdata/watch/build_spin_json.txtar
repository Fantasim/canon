IMPLEMENTATION-PLAN.md §8.1, meta/decisions/log-2026-09-29.md "M4 U6-r", DECISIONS 341: in JSON, a
project reading its own output is refused with E8026 at the first build, nothing is written and no
cycle follows. (The `cycle` line whose `settled` is false is TestWatchUnsettledJSON's.)
-- args --
build
--watch
--format
json
-- cycles --
1
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
  }
}
-- a/a.canon --
/// A.
package a

/// Cfg.
record Cfg {
  /// Weight.
  weight: Int = 1
}

/// Prev.
let prev: Cfg = load("@out/cfg.json", at: "value")

/// Config.
let cfg: Cfg = { weight: prev.weight + 1 }

emit json { out: "@out/" }
-- out/cfg.json --
{
  "$schema": "a.Cfg@0df3c93b",
  "value": {
    "weight": 1
  }
}
-- want --
[exit 130]
[stdout]
{"severity":"error","code":"E8026","file":"a/a.canon","line":11,"col":17,"endLine":11,"endCol":51,"package":"a","message":"@out/cfg.json is read by this load and written by emit json of a: an output is never an input of its own build"}

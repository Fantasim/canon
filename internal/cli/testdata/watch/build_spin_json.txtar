-- a/a.canon --
/// A.
package a

/// Cfg.
record Cfg {
  /// Weight.
  weight: Int = 1
}

/// Prev.
let prev: Cfg = load("@out/cfg.json", at: "value")

/// Config.
let cfg: Cfg = { weight: prev.weight + 1 }

emit json { out: "@out/" }

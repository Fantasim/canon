CLI.md §3.4, meta/decisions/log-2026-09-29.md "M4 U6-r", DECISIONS 341: package a computes its output
from its own previous output. That self-feeding project can no longer spin a watch: the load of its
own output is E8026, the build writes nothing, and the watch waits for a change from outside. (The
unsettled line a self-feeding build once printed is TestWatchOwnWritesRunOnce's.)
-- args --
build
--watch
-- cycles --
1
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
  }
}
-- a/a.canon --
/// A.
package a

/// Cfg.
record Cfg {
  /// Weight.
  weight: Int = 1
}

/// Prev.
let prev: Cfg = load("@out/cfg.json", at: "value")

/// Config.
let cfg: Cfg = { weight: prev.weight + 1 }

emit json { out: "@out/" }
-- out/cfg.json --
{
  "$schema": "a.Cfg@0df3c93b",
  "value": {
    "weight": 1
  }
}
-- want --
[exit 130]
[stdout]
error[E8026]  a/a.canon:11:17
  @out/cfg.json is read by this load and written by emit json of a: an output is never an input of its own build

1 error, 0 warnings in 1 package (…)
[stderr]
canon: interrupted

CLI.md §3.4, meta/decisions/log-2026-09-29.md "M4 U6-r", DECISIONS 341: a build's own write wakes the
watch once more: here the canon.lock the build reads and rewrites when a stable table gains a row
(a package reading its own output, the loop this case once used, is E8026). One rebuild answers it
(a cycle listing no change), and then the watch is quiet: exactly three summaries in all.
-- args --
build
--watch
-- cycles --
3
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
  }
}
-- a/a.canon --
/// A.
package a

/// Tier.
record Tier {
  /// Weight.
  weight: Int = 1
}

/// Tiers.
let tiers: stable table Tier = { low {} }

emit json { out: "@out/" }
-- a/canon.lock --
# canon.lock v1
table  a.tiers  low
-- step1/a/a.canon --
/// A.
package a

/// Tier.
record Tier {
  /// Weight.
  weight: Int = 1
}

/// Tiers.
let tiers: stable table Tier = { low {}, high {} }

emit json { out: "@out/" }
-- want --

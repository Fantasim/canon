CLI.md §2.3: fmt text findings are coloured like check.
-- args --
fmt
--color
always
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
package a

const = 1
-- b/b.canon --
package b
let  x:Int=1
const   Y = 60s
-- want --
[exit 1]
[stdout]
[31merror[E1116][0m  a/a.canon:3:7
  expected IDENT; found =

1 error, 0 warnings in 0 packages (…)
[stderr]
[file b/b.canon]
package b

let x: Int = 1
const Y = 1m

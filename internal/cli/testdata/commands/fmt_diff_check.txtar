CLI.md §3.6, §2.5: --diff --check prints the diff instead of the list and exits 1.
-- args --
fmt
--diff
--check
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
package a
let  x:Int=1
const   Y = 60s
-- want --
[exit 1]
[stdout]
--- a/a.canon
+++ a/a.canon
@@ -1,3 +1,4 @@
 package a
-let  x:Int=1
-const   Y = 60s
+
+let x: Int = 1
+const Y = 1m
[stderr]

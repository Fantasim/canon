CLI.md §3.15: a request file that does not exist is a usage error, exit 2.
-- args --
edit missing.json
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// A server.
record Rules {
  /// Attempts.
  retries: Int(1..) = 3
}

/// The rules.
let server: Rules = { retries: 2 }
-- a/staging.layer.canon --
package a
layer staging

amend server {
  retries: 4
}
-- want --
[exit 2]
[stdout]
[stderr]
canon: missing.json: no such file

CLI.md §2.3: --color auto does not colour when stdout is not a terminal.
-- args --
check
--color
auto
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
package a

/// Dangling.

const = 1
-- want --
[exit 1]
[stdout]
warning[W1001]  a/a.canon:3:1
  doc comment is not attached to anything

error[E1116]  a/a.canon:5:7
  expected IDENT; found =

1 error, 1 warning in 1 package (…)
[stderr]

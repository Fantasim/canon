CLI.md §3.4: a check error blocks every output; canon build reports it and exits 1.
-- args --
build
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
  }
}
-- a/a.canon --
/// A.
package a

let x: Int = 1 / 0

emit json { out: "@out/" }
-- want --
[exit 1]
[stdout]
error[E3008]  a/a.canon:4:14
  cannot infer the type of this expression; add a type

1 error, 0 warnings in 1 package (…)
[stderr]

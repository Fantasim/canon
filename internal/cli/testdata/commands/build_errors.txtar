CLI.md §3.4: a check error blocks every output; canon build reports it and exits 1.
-- args --
build
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
  }
}
-- a/a.canon --
/// A.
package a

let x: Int = true

emit json { out: "@out/" }
-- want --
[exit 1]
[stdout]
error[E3002]  a/a.canon:4:14
  expected Int, found Bool

1 error, 0 warnings in 1 package (…)
[stderr]

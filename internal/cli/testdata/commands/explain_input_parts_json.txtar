EVALUATION.md §11.2, CLI.md §3.7, API.md P10: in JSON the input fields are objects of `parts`,
with their canonical path, no type, value null and an empty origin, among the other parts.
-- args --
explain
srv
--format
json
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// A server.
record Srv {
  /// Where it listens.
  host: String = "localhost"
  /// A key.
  key: input String? from env "A_KEY"
}

/// The server.
let srv: Srv = {}
-- want --
[exit 0]
[stdout]

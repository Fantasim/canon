CLI.md §3.19, API.md L1, L2, L6: canon lint prints JSON lines whatever --format says, and -q changes nothing: each lint finding of the selected package, then the summary; no fix line without --fix; exit 0.
-- args --
lint
--format
text
-q
a
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// A unit.
record Unit {
  /// Health.
  dwHealth: Int
  /// Its banner.
  banner: String = "Code generated by canon"
}

/// The units.
let units: [Unit] = [{ dwHealth: 3 }]
-- b/b.canon --
/// B, not selected.
package b

/// A row.
record Row {
  /// Count.
  nCount: Int
}
-- want --
[exit 0]
[stdout]
{"severity":"warning","code":"W0001","file":"a/a.canon","line":7,"col":3,"endLine":7,"endCol":11,"package":"a","message":"field dwHealth keeps the legacy prefix dw in its Canon name: rename it health (canon rename keeps the old wire name with @json where a load or a data emit reads the field)"}
{"severity":"warning","code":"W0005","file":"a/a.canon","line":9,"col":20,"endLine":9,"endCol":45,"package":"a","message":"this string holds the words of canon's generated marker: an output built from it claims to come from canon's generators; give it a marker of its own"}
{"summary":{"errors":0,"warnings":2,"packages":1,"ms":0}}
[stderr]

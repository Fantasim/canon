CLI.md §3.7, EVALUATION.md §13, API.md §5.2: a list, a map, a record (a dependent one, which
verification judges, included) and a table a spread copies are each `spread` at the spread with
the spread expression as detail, as a scalar is; the parts inside keep their own origin.
-- args --
explain
other
--depth
2
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// K.
enum K { num, sub }

/// Node.
record Node {
  /// K.
  k: K
  /// Max.
  max: Int = 5
}

/// Nodes.
let nodes: table Node = { a { k: num }, b { k: sub, max: 3 } }

/// Sub, of a node.
record Sub(e: Node) {
  /// Limit, the node's max unless given.
  lim: Int = e.max
}

/// P.
type P(e: Node) = match e.k {
  num => Int
  sub => Sub(e)
}

/// Tier.
record Tier {
  /// Weight.
  weight: Int = 1
}

/// A label.
record Label {
  /// Its text.
  text: String
  /// Its tags.
  tags: [String]
  /// Its limits.
  lim: {String: Int}
  /// Its tier.
  tier: Tier
  /// Its tiers.
  tiers: table Tier
  /// Like.
  like: ref nodes
  /// Sub, dependent.
  sub: P(like)
}

/// The base label.
let base: Label = {
  text: "Base"
  tags: ["x"]
  lim: { "a": 1 }
  tier: { weight: 2 }
  tiers: { low {} }
  like: b
  sub: { lim: 2 }
}

/// A copy with another text.
let other: Label = { ...base, text: "Other" }
-- want --
[exit 0]
[stdout]
other = Label{text: "Other", tags: ["x"], lim: {"a": 1}, tier: Tier{weight: 2}, tiers: {low: Tier{weight: 1}}, like: b, sub: Sub{lim: 2}}  a.Label
  literal  a/a.canon:66
other.text = Other  String
  literal  a/a.canon:66
other.tags = ["x"]  [String]
  spread  a/a.canon:66  ...base
other.tags[0] = x  String
  literal  a/a.canon:57
other.lim = {"a": 1}  {String: Int}
  spread  a/a.canon:66  ...base
other.lim[a] = 1  Int
  literal  a/a.canon:58
other.tier = Tier{weight: 2}  a.Tier
  spread  a/a.canon:66  ...base
other.tier.weight = 2  Int
  literal  a/a.canon:59
other.tiers = {low: Tier{weight: 1}}  table a.Tier
  spread  a/a.canon:66  ...base
other.tiers.low = Tier{weight: 1}  a.Tier
  literal  a/a.canon:60
other.like = b  ref a.nodes
  spread  a/a.canon:66  ...base
other.sub = Sub{lim: 2}  a.P(like)
  spread  a/a.canon:66  ...base
other.sub.lim = 2  Int
  literal  a/a.canon:62
[stderr]

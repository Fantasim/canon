CLI.md §3.15, API.md S5, §15: a base that is not the current revision is ErrStale, exit 1, stderr only.
-- args --
edit req.json
-- req.json --
{"base":"r1:00","ops":[{"op":"set","path":"a:server.retries","value":7}]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// A server.
record Rules {
  /// Attempts.
  retries: Int(1..) = 3
}

/// The rules.
let server: Rules = { retries: 2 }
-- a/staging.layer.canon --
package a
layer staging

amend server {
  retries: 4
}
-- want --
[exit 1]
[stdout]
[stderr]
canon: sources changed since the base revision

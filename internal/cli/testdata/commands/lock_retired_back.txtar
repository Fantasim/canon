LOCK.md §4.2, CLI.md §2.5: a retired id that comes back is E6002, exit 1.
-- args --
lock
check

-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// Tier.
record Tier {
  /// Weight.
  weight: Int = 1
}

/// Tiers.
let tiers: stable table Tier = { low {}, high {} }
-- a/canon.lock --
# canon.lock v1
table  a.tiers  high  retired
table  a.tiers  low
-- want --
[exit 1]
[stdout]
error[E6002]  a/a.canon:11:42
  retired entry high cannot come back

1 error, 0 warnings in 1 package (…)
[stderr]

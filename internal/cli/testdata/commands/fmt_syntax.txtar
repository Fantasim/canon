CLI.md §3.6, FORMATTER.md §1, §16: a file with a syntax error is left unchanged, its E11xx findings printed, exit 1; the other files are still formatted.
-- args --
fmt
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
package a

const = 1
-- b/b.canon --
package b
let  x:Int=1
const   Y = 60s
-- want --
[exit 1]
[stdout]
error[E1116]  a/a.canon:3:7
  expected IDENT; found =

1 error, 0 warnings in 0 packages (…)
[stderr]
[file b/b.canon]
package b

let x: Int = 1
const Y = 1m

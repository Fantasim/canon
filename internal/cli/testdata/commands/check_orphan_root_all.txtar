CLI.md §2.2 (DECISIONS 353): a root-level file is reported by an unscoped check.
-- args --
check
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
package a

const X = 1
-- top.canon --
const Y = 2
-- want --
[exit 1]
[stdout]
error[E1127]  top.canon:1:1
  a file must start with "package"

1 error, 0 warnings in 1 package (…)
[stderr]

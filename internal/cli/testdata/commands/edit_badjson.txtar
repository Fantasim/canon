CLI.md §3.15, API.md E24, §15: JSON that does not decode is ErrBadOp, exit 2.
-- args --
edit req.json
-- req.json --
{"ops":[{"op":"bogus"}]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// A server.
record Rules {
  /// Attempts.
  retries: Int(1..) = 3
}

/// The rules.
let server: Rules = { retries: 2 }
-- a/staging.layer.canon --
package a
layer staging

amend server {
  retries: 4
}
-- want --
[exit 2]
[stdout]
[stderr]
canon: op 0: operation not valid here: invalid operation JSON: op: unknown operation

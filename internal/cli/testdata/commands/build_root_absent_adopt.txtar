p
-- args --
build
--adopt
@src/sql/_version.sql
-- p/project.canon --
project acme {
  canon: "0.1"
  roots {
    src: "../Source"
  }
  optional_roots: [src]
}
-- p/a/a.canon --
/// A.
package a

/// The version.
@text("_version.sql")
export fn versionSql() -> String { return "SELECT 1;\n" }

emit text { out: "@src/sql" }

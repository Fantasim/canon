CLI.md §3.15, API.md §7.5: --edit-layer sends the edit to the layer file.
-- args --
edit req.json --edit-layer staging
-- req.json --
{"ops":[{"op":"set","path":"a:server.retries","value":9}]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// A server.
record Rules {
  /// Attempts.
  retries: Int(1..) = 3
}

/// The rules.
let server: Rules = { retries: 2 }
-- a/staging.layer.canon --
package a
layer staging

amend server {
  retries: 4
}
-- want --
[exit 0]
[stdout]
{"edit":{"applied":true,"revision":"r1:7ffd4b11f0b1df6009a78d67dcdb287bf81d336f8705200b05452a01153a6d28","changes":[{"kind":"modified","path":"a/staging.layer.canon"}],"dropped":[],"undo":{"base":"r1:7ffd4b11f0b1df6009a78d67dcdb287bf81d336f8705200b05452a01153a6d28","editLayer":"staging","ops":[{"op":"set","path":"a:server.retries","source":"4"}]}}}
{"summary":{"errors":0,"warnings":0,"packages":1,"ms":0}}
[stderr]
[file a/staging.layer.canon]
package a
layer staging

amend server {
  retries: 9
}

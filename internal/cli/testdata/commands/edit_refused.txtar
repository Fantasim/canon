CLI.md §3.15, API.md E19, §15: an edit refused for its findings prints them, exits 1 and writes nothing.
-- args --
edit req.json
-- req.json --
{"ops":[{"op":"set","path":"a:server.retries","value":0}]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// A server.
record Rules {
  /// Attempts.
  retries: Int(1..) = 3
}

/// The rules.
let server: Rules = { retries: 2 }
-- a/staging.layer.canon --
package a
layer staging

amend server {
  retries: 4
}
-- want --
[exit 1]
[stdout]
{"edit":{"applied":false,"revision":"r1:e37a2c5808243526d7486cda6556f600089ec695cdab46fc49a678785b1375ec","changes":[],"dropped":[]}}
{"severity":"error","code":"E3204","file":"a/a.canon","line":11,"col":32,"endLine":11,"endCol":33,"package":"a","message":"0 is outside 1..","related":[{"file":"a/a.canon","line":7,"col":3,"endLine":7,"endCol":20,"note":"retries: Int(1..)"}]}
{"summary":{"errors":1,"warnings":0,"packages":1,"ms":0}}
[stderr]

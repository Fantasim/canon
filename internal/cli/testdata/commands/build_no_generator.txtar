DECISIONS 196: a target without a generator yet (M1: cpp, ts, view) is refused before analysis.
-- args --
build
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    web: "web"
  }
}
-- a/a.canon --
/// A.
package a

let x: Int = 1

emit ts { out: "@web/a.generated.ts" }
-- want --
[exit 2]
[stdout]
[stderr]
canon: package a, emit ts: no generator for this emit target yet

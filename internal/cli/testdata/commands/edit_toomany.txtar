CLI.md §3.15: at most one request file.
-- args --
edit a.json b.json
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// A server.
record Rules {
  /// Attempts.
  retries: Int(1..) = 3
}

/// The rules.
let server: Rules = { retries: 2 }
-- a/staging.layer.canon --
package a
layer staging

amend server {
  retries: 4
}
-- want --
[exit 2]
[stdout]
[stderr]
canon: edit: takes at most one argument

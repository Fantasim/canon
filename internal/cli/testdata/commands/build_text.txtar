CLI.md §3.4, CODEGEN.md §2.9, DECISIONS 294: text outputs are listed last, after json; the files are written verbatim with their .canon-text.
-- args --
build
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
  }
}
-- a/a.canon --
/// A.
package a

/// X.
let x: Int = 1

/// The version.
@text("_version.sql")
export fn versionSql() -> String { return "SELECT {x};\n" }

/// The schema.
@text("Schema.sql")
export fn schemaSql() -> String { return "CREATE TABLE t (id INT);" }

emit json { out: "@out/" }

emit text { out: "@out/sql" }
-- want --
[exit 0]
[stdout]
0 errors, 0 warnings in 1 package (…)
json:
  @out/x.json
text:
  @out/sql/.canon-text
  @out/sql/Schema.sql
  @out/sql/_version.sql

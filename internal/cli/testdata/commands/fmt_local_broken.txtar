CLI.md §3.6 (DECISIONS 332): a project.local.canon with a syntax error is reported, exit 1, and nothing is written.
-- args --
fmt
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    src: "src"
  }
}
-- project.local.canon --
project acme {
  roots {
    src: "elsewhere/src"
  }
}
let x = 1
-- a/a.canon --
package a
let  x:Int=1
-- want --
[exit 1]
[stdout]
error[E1011]  project.local.canon:6:1
  project.local.canon may only contain the project declaration

1 error, 0 warnings in 0 packages (…)
[stderr]

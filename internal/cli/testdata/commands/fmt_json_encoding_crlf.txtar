WIRE.md §3.1, FORMATTER.md §16: the E7105 offset counts the file as written, CRLF included; the file is left unchanged.
-- args --
fmt
--json-sources
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
package a

let x: Int = load("../data/x.json")
-- data/x.json --
{
"a":"�"}
-- want --
[exit 1]
[stdout]
error[E7105]  data/x.json:2:6
  data/x.json is not valid UTF-8 at byte 8

1 error, 0 warnings in 0 packages (…)
[stderr]

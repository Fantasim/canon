// GENERATED by canon from core/. DO NOT EDIT.

// ---------------------------------------------------------------------------
// canon runtime, TypeScript v1 (CODEGEN.md §8.2). Identical in every generated file.
// ---------------------------------------------------------------------------

/** An error the Canon evaluator would also report, with its code ("E4101"). */
export class CanonEvalError extends Error {
  readonly code: string;
  constructor(code: string, message: string) {
    super(code + ": " + message);
    this.name = "CanonEvalError";
    this.code = code;
  }
}

/** A table or keyed list: entries in source order, lookup by key. */
export interface CanonTable<K, T> {
  readonly length: number;
  readonly all: ReadonlyArray<T>;
  at(i: number): T;
  find(key: K): T | null;
}
// ---------------------------------------------------------------------------

/** A colour. */
export type Tone = "red" | "blue";
export const ToneMembers: ReadonlyArray<Tone> = Object.freeze(["red", "blue"]);
export const ToneLiveMembers: ReadonlyArray<Tone> = Object.freeze(["red", "blue"]);
export const ToneNames: Readonly<Record<Tone, string>> = Object.freeze({ red: "red", blue: "blue" });
export const ToneIndex: Readonly<Record<Tone, number>> = Object.freeze({ red: 0, blue: 1 });
[file x/web/app.ts]
// GENERATED by canon from app/. DO NOT EDIT.
import * as core from "../gen/core.js";

// ---------------------------------------------------------------------------
// canon runtime, TypeScript v1 (CODEGEN.md §8.2). Identical in every generated file.
// ---------------------------------------------------------------------------

/** An error the Canon evaluator would also report, with its code ("E4101"). */
export class CanonEvalError extends Error {
  readonly code: string;
  constructor(code: string, message: string) {
    super(code + ": " + message);
    this.name = "CanonEvalError";
    this.code = code;
  }
}

/** A table or keyed list: entries in source order, lookup by key. */
export interface CanonTable<K, T> {
  readonly length: number;
  readonly all: ReadonlyArray<T>;
  at(i: number): T;
  find(key: K): T | null;
}

/** Deep-freezes plain objects and arrays (CanonMaps are already read-only). */
function canonFreeze<T>(x: T): T {
  if (typeof x === "object" && x !== null && !Object.isFrozen(x)) {
    Object.freeze(x);
    for (const v of Object.values(x)) canonFreeze(v);
  }
  return x;
}
// ---------------------------------------------------------------------------

/** A badge. */
export interface Badge {
  /** Its colour. */
  readonly tone: core.Tone;
}

const decOrder = Symbol.for("canon.order");

const decTokenKey = Symbol.for("canon.token");

/** A number token with a fraction or an exponent, as parse reads it: its exact text, under a key every generated file shares. */
function decToken(text: string): unknown {
  return Object.freeze(Object.defineProperty({}, decTokenKey, { value: text }));
}

/** Throws the failure at path, behind the name of what is read: `$`-rooted for a types-mode decoder (`Skill: $.events[1].level`), from the file's top for a data file (`skills.json: rows[1].level`) (CODEGEN.md §5.13, DECISIONS 361). */
function decFail(path: string, message: string): never {
  throw new Error(path + ": " + message);
}

function decGet(o: Record<string, unknown>, key: string): unknown {
  return Object.prototype.hasOwnProperty.call(o, key) ? o[key] : undefined;
}

function decIsObject(raw: unknown): raw is Record<string, unknown> {
  return typeof raw === "object" && raw !== null && !Array.isArray(raw) && !Reflect.has(raw, decTokenKey);
}

function decObject(raw: unknown, path: string): Record<string, unknown> {
  if (!decIsObject(raw)) decFail(path, "expected an object");
  return raw;
}

/** One of members; a literal union's arm refuses with the value, as the Go decoder does. */
function decEnum<T extends string>(raw: unknown, path: string, members: ReadonlyArray<T>, union = false): T {
  const m = members.find((x) => x === raw);
  if (m === undefined) decFail(path, union ? "unknown value " + String(raw) : "unknown member");
  return m;
}

/** Reads JSON text the way WIRE.md §3.1 to §3.3 read a file, the first failure in document order, placed where it becomes certain. A types-mode decoder (root `$`): a syntax error is `<T>: invalid JSON at byte N`, N the 0-based UTF-8 offset of the first byte that cannot continue the document (a BOM counted) or the text's length when it ends too early; a repeated key, an unpaired surrogate, a lone surrogate code unit in a string (`not UTF-8`) and nesting past 512 are named at their `$` path (`<T>: $.a[1]: …`). A data file (root ""): a syntax error, invalid UTF-8 or an unpaired surrogate is `<file>: not a canon data file (invalid JSON)`, as the loaders print it; a repeated key and nesting past 512 are named at their path (`<file>: a[1]: …`) (DECISIONS 361). */
function decParse(text: string, label: string, root: string): unknown {
  let i = text.charCodeAt(0) === 0xfeff ? 1 : 0;
  const escapes: Record<string, string> = { '"': '"', "\\": "\\", "/": "/", b: "\b", f: "\f", n: "\n", r: "\r", t: "\t" };
  const bytes = (end: number): number => {
    let n = 0;
    for (const ch of text.slice(0, end)) {
      const cp = ch.codePointAt(0) as number;
      n += cp < 0x80 ? 1 : cp < 0x800 ? 2 : cp < 0x10000 ? 3 : 4;
    }
    return n;
  };
  const data = root === "";
  const member = (path: string, k: string): string => (path === label + ": " ? path + k : path + "." + k);
  const bad = (): never => decFail(label, data ? "not a canon data file (invalid JSON)" : "invalid JSON at byte " + bytes(i));
  const invalid = (path: string, message: string): never => (data ? bad() : decFail(path, message));
  const ws = (): void => {
    while (i < text.length && " \t\n\r".includes(text[i])) i++;
  };
  const digits = (): void => {
    if (!(text[i] >= "0" && text[i] <= "9")) bad();
    while (text[i] >= "0" && text[i] <= "9") i++;
  };
  const hex4 = (): number => {
    for (let k = 0; k < 4; k++) {
      if (!/^[0-9a-fA-F]$/.test(text[i + k] ?? "")) {
        i += k;
        bad();
      }
    }
    i += 4;
    return parseInt(text.slice(i - 4, i), 16);
  };
  const unicode = (path: string): string => {
    const u = hex4();
    if (u >= 0xdc00 && u <= 0xdfff) invalid(path, "unpaired surrogate");
    if (u < 0xd800 || u > 0xdbff) return String.fromCharCode(u);
    const next = text.slice(i, i + 2);
    if (next.length < 2 && "\\u".startsWith(next)) {
      i = text.length;
      bad();
    }
    if (next !== "\\u") invalid(path, "unpaired surrogate");
    i += 2;
    const lo = hex4();
    if (lo < 0xdc00 || lo > 0xdfff) invalid(path, "unpaired surrogate");
    return String.fromCharCode(u, lo);
  };
  const str = (path: string): string => {
    i++;
    let out = "";
    for (;;) {
      if (i >= text.length || text[i] < " ") bad();
      const c = text[i++];
      if (c === '"') return out;
      if (c >= "\ud800" && c <= "\udfff") {
        i--;
        if (c > "\udbff" || !(text[i + 1] >= "\udc00" && text[i + 1] <= "\udfff")) invalid(path, "not UTF-8");
        out += text.slice(i, i + 2);
        i += 2;
      } else if (c !== "\\") {
        out += c;
      } else if (text[i] === "u") {
        i++;
        out += unicode(path);
      } else if (Object.prototype.hasOwnProperty.call(escapes, text[i])) {
        out += escapes[text[i++]];
      } else {
        bad();
      }
    }
  };
  const num = (): unknown => {
    const start = i;
    if (text[i] === "-") i++;
    if (text[i] === "0") i++;
    else digits();
    let exact = false;
    if (text[i] === ".") {
      i++;
      digits();
      exact = true;
    }
    if (text[i] === "e" || text[i] === "E") {
      i++;
      if (text[i] === "+" || text[i] === "-") i++;
      digits();
      exact = true;
    }
    const token = text.slice(start, i);
    if (exact) return decToken(token);
    const n = Number(token);
    return Number.isSafeInteger(n) ? n : BigInt(token);
  };
  const word = (w: string, v: unknown): unknown => {
    for (let k = 0; k < w.length; k++) {
      if (text[i + k] !== w[k]) {
        i += k;
        bad();
      }
    }
    i += w.length;
    return v;
  };
  const sep = (close: string): boolean => {
    ws();
    if (text[i] === ",") {
      i++;
      return true;
    }
    if (text[i] !== close) bad();
    i++;
    return false;
  };
  const open = (depth: number, path: string): void => {
    if (depth >= 512) decFail(path, "nested deeper than 512 levels");
    i++;
    ws();
  };
  const obj = (depth: number, path: string): unknown => {
    open(depth, path);
    const o: Record<string, unknown> = {};
    const order: string[] = [];
    if (text[i] === "}") {
      i++;
    } else {
      do {
        ws();
        if (text[i] !== '"') bad();
        const k = str(path);
        if (Object.prototype.hasOwnProperty.call(o, k)) decFail(member(path, k), "duplicate key");
        ws();
        if (text[i] !== ":") bad();
        i++;
        Object.defineProperty(o, k, { value: val(depth + 1, member(path, k)), enumerable: true, writable: true, configurable: true });
        order.push(k);
      } while (sep("}"));
    }
    Object.defineProperty(o, decOrder, { value: order });
    return o;
  };
  const arr = (depth: number, path: string): unknown => {
    open(depth, path);
    const a: unknown[] = [];
    if (text[i] === "]") {
      i++;
      return a;
    }
    do {
      a.push(val(depth + 1, path + "[" + a.length + "]"));
    } while (sep("]"));
    return a;
  };
  const val = (depth: number, path: string): unknown => {
    ws();
    const c = text[i];
    if (c === "{") return obj(depth, path);
    if (c === "[") return arr(depth, path);
    if (c === '"') return str(path);
    if (c === "t") return word("true", true);
    if (c === "f") return word("false", false);
    if (c === "n") return word("null", null);
    if (c === "-" || (c >= "0" && c <= "9")) return num();
    return bad();
  };
  const v = val(0, label + ": " + root);
  ws();
  if (i < text.length) bad();
  return v;
}

function readBadge($raw: unknown, $path: string): Badge {
  const $o = decObject($raw, $path);
  const $v1: core.Tone = decEnum(decGet($o, "tone"), $path + ".tone", core.ToneMembers);
  return { tone: $v1 };
}

/** A badge. */
export function decodeBadge(json: unknown): Badge {
  return canonFreeze(readBadge(json, "Badge: $"));
}

export function parseBadge(text: string): Badge {
  return decodeBadge(decParse(text, "Badge", "$"));
}

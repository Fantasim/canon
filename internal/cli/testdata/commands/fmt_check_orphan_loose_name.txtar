CLI.md §2.2 (DECISIONS 353): fmt of a package name also visits the package-less files in it.
-- args --
fmt
--check
a
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
package a

const X = 1
-- a/loose.canon --
const Q = 1
-- stray/s.canon --
record R { a: Int
-- b/b.canon --
const Z = 3
-- top.canon --
const Y = 2
-- want --
[exit 1]
[stdout]
error[E1127]  a/loose.canon:1:1
  a file must start with "package"

1 error, 0 warnings in 0 packages (…)
[stderr]

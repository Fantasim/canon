CLI.md §3.4, CODEGEN.md §2.4, §2.9: a hand-written file at a text path is E8001; --adopt takes it over and lists it under text.
-- args --
build
--target
text
--adopt
@out/sql/Schema.sql
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
  }
}
-- a/a.canon --
/// A.
package a

/// X.
let x: Int = 1

/// The version.
@text("_version.sql")
export fn versionSql() -> String { return "SELECT {x};\n" }

/// The schema.
@text("Schema.sql")
export fn schemaSql() -> String { return "CREATE TABLE t (id INT);" }

emit json { out: "@out/" }

emit text { out: "@out/sql" }
-- out/sql/Schema.sql --
-- written by hand
-- want --
[exit 0]
[stdout]
0 errors, 0 warnings in 1 package (…)
adopting @out/sql/Schema.sql
text:
  @out/sql/Schema.sql
  @out/sql/_version.sql
  a/canon.outputs
[stderr]
[file a/canon.outputs]

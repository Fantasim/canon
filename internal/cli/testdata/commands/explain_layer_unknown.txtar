CLI.md §2.3, §2.5, API.md O4: explain applies --layer as check does; a name no package declares
is its finding, exit 2.
-- args --
explain
x
--layer
nope
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// X.
let x: Int = 1
-- want --
[exit 2]
[stdout]
error[E1901]
  no loaded package declares layer nope

1 error, 0 warnings in 0 packages (…)
[stderr]

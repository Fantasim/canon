CLI.md §3.7, EVALUATION.md §13, §4.2: a record a spread copies whose instance verification
remembers (its dependent field charged, its list of dependent values converted) is `spread` at
the spread with the spread expression as detail; its parts keep their own origin.
-- args --
explain
other
--depth
2
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// K.
enum K { num, sub }

/// Node.
record Node {
  /// K.
  k: K
  /// Max.
  max: Int = 5
}

/// Nodes.
let nodes: table Node = { a { k: num }, b { k: sub, max: 3 } }

/// Sub, of a node.
record Sub(e: Node) {
  /// Limit, the node's max unless given.
  lim: Int = e.max
}

/// P.
type P(e: Node) = match e.k {
  num => Int
  sub => Sub(e)
}

/// Holder: verification charges its dependent field.
record Holder {
  /// Like.
  like: ref nodes
  /// Sub, dependent.
  sub: P(like)
}

/// Many: verification converts its list of dependent values.
record Many {
  /// Like.
  like: ref nodes
  /// Subs, dependent.
  subs: [P(like)]
}

/// A label.
record Label {
  /// Its text.
  text: String
  /// A holder.
  holder: Holder
  /// Many.
  many: Many
}

/// The base label.
let base: Label = {
  text: "Base"
  holder: { like: b, sub: { lim: 1 } }
  many: { like: b, subs: [{ lim: 2 }] }
}

/// A copy with another text.
let other: Label = { ...base, text: "Other" }
-- want --
[exit 0]
[stdout]
other = Label{text: "Other", holder: Holder{like: b, sub: Sub{lim: 1}}, many: Many{like: b, subs: [Sub{lim: 2}]}}  a.Label
  literal  a/a.canon:64
other.text = Other  String
  literal  a/a.canon:64
other.holder = Holder{like: b, sub: Sub{lim: 1}}  a.Holder
  spread  a/a.canon:64  ...base
other.holder.like = b  ref a.nodes
  literal  a/a.canon:59
other.holder.sub = Sub{lim: 1}  a.P(like)
  literal  a/a.canon:59
other.many = Many{like: b, subs: [Sub{lim: 2}]}  a.Many
  spread  a/a.canon:64  ...base
other.many.like = b  ref a.nodes
  literal  a/a.canon:60
other.many.subs = [Sub{lim: 2}]  [a.P(like)]
  literal  a/a.canon:60
[stderr]

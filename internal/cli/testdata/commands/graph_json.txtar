CLI.md §3.18, IMPLEMENTATION-PLAN.md §8.1: node lines, edge lines (retired, computed, key, member), then the summary.
-- args --
graph
--format
json
-- project.canon --
project acme {
  canon: "0.1"
}
-- r/r.canon --
/// R.
package r

/// A tone.
enum Tone { calm, loud }

/// A status.
record Status {
  /// Where it goes.
  next: [ref statuses] = []
  /// Its tone.
  tone: Tone = calm
}

/// Statuses.
let statuses: table Status = {
  open { next: [done, done, open, closed, done], tone: loud }
  done { tone: loud }
  retired closed {}
}

/// Mapping.
let m: {ref statuses: ref statuses} = { open: done }

/// Weights.
let weights: {ref statuses: Int} = { open: 1, done: 2 }

/// A choice.
fn choose(b: Bool) -> ref statuses {
  return if b { done } else { open }
}

/// A flag.
let flag: Bool = true

/// The computed pick.
let pick: ref statuses = choose(flag)
-- want --
[exit 0]

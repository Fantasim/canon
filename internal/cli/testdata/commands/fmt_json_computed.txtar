CLI.md §3.6, WIRE.md §6.1: a load whose path is not a plain string is not read, so --json-sources does not follow it.
-- args --
fmt
--json-sources
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
package a

const P = "../data/x.json"
let x: Int = load(P)
let y: Int = load("../data/${P}.json")
-- data/x.json --
{"a":1}
-- want --
[exit 0]
[stdout]
[stderr]

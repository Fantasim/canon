GRAMMAR.md §2.3, DECISIONS 378: a file that imports the enum's package only as `import v { Row }`
binds no name for the enum (SPEC.md §3.2); a reserved-word member is written quoted
(`` `if` ``), which needs none, and the re-check is clean (API.md V2).
-- options --
pkgs: k
-- edit.json --
{"ops": [
  {"op": "set", "path": "k:rows.a.word", "value": "if"}
]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- v/v.canon --
package v

/// A word.
enum Word { plain, if }

/// A row.
record Row {
  /// A word.
  word: Word = plain
}
-- k/k.canon --
package k

import v { Row }

/// Rows.
let rows: table Row = {
  a {}
}
-- result.json --
{
  "changes": [
    {
      "kind": "modified",
      "path": "k/k.canon"
    }
  ],
  "undo": [
    {
      "op": "reset",
      "path": "k:rows.a.word"
    }
  ],
  "touched": [
    "k"
  ]
}
-- after/k/k.canon --
package k

import v { Row }

/// Rows.
let rows: table Row = {
  a { word: `if` }
}

-- after/dep/dep.canon --
package dep

/// A kind.
enum K { a, b }

/// By kind.
type T(k: K) = match k {
  a => Int
  b => String
}

/// Inner.
record Inner {
  /// Kind.
  k: K
  /// Val.
  v: T(k)
}

/// By flag.
type W(f: Bool) = match f {
  true => Inner
  false => Inner
}

/// A thing.
record Thing {
  /// Flag.
  f: Bool
  /// Wrapped.
  w: W(f)?
}

/// Things.
let things: table Thing = {
  a { f: false, w: { k: a, v: "oops" } }
}

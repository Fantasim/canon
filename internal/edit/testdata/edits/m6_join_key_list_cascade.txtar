{"ops": [
  {"op": "rename", "path": "nodes.a_rather_long_node_key_name_number_one", "key": "a"}
]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- p/p.canon --
package p

/// A node.
record Node {
  /// Tags by node.
  tags: {ref Node: [String]} = {}
}

/// Nodes.
let nodes: table Node = {
  a_rather_long_node_key_name_number_one {}
  b {
    tags: {
      a_rather_long_node_key_name_number_one: [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      ]
    }
  }
  c {
    tags: {
      "a_rather_long_node_key_name_number_one": [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      ]
    }
  }
}

package p

/// A node.
record Node {
  /// Tags by node.
  tags: {ref Node: [String]} = {}
}

/// Nodes.
let nodes: table Node = {
  a {}
  b {
    tags: {
      a: ["aaaaaaaaaaaaaaaaaaaaaaaaaaaa", "bbbbbbbbbbbbbbbbbbbbbbbbbbbb"]
    }
  }
  c {
    tags: {
      "a": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaa", "bbbbbbbbbbbbbbbbbbbbbbbbbbbb"]
    }
  }
}

API.md M5, API.md M6 (review probe zz3_map_rename, 2026-10-13): what the edit writes is a fixed point and
changes no byte outside the items it re-prints, a settle that joins an enclosing item included.
Here: a map key renamed shorter lets its value, alone on the next line, join the key.
-- options --
pkgs: p
-- edit.json --
{"ops": [{"op": "rename", "path": "rows.b.m[kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk]", "key": "k"}]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- p/p.canon --
package p

/// A rec.
record R {
  /// Nest.
  nest: [[String]] = []
  /// Map.
  m: {String: String} = {}
}

/// Rows.
let rows: table R = {
  a {
    nest: [
      [
        "ttttttttttttttttttttttttttttt",
        "uuuuuuuuuuuuuuuuuuuuuuuuuuuuu",
        "wwwwwwwwwwwwwwwwwwwwwwwwwwwww",
      ],
      ["r"],
    ]
  }
  b {
    m: {
      "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk":
        "vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv"
    }
  }
}

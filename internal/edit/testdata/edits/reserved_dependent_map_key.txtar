API.md M7, DECISIONS 378 point 7: a map keyed by a dependent type (TYPES.md 11.5) writes each
symbol key as the WORD before `:`, bare even when it is a quotable word (`while: 2`, GRAMMAR.md
§4.3 (a)), never quoted; a symbol in value position is quoted.
-- options --
pkgs: p
-- edit.json --
{"ops": [
  {"op": "set", "path": "evs.b.counts", "source": "{ while: 2, plain: 3 }"},
  {"op": "set", "path": "evs.b.param", "source": "Word.while"}
]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- p/p.canon --
package p

/// A kind.
enum Kind { word, num }

/// A word.
enum Word { plain, if, while }

/// A param.
type Param(k: Kind) = match k {
  word => Word
  num => Never
}

/// An event.
record Ev {
  /// Its kind.
  kind: Kind = word
  /// Its param.
  param: Param(kind)?
  /// Counts by param.
  counts: {Param(kind): Int} = {}
}

/// Events.
let evs: table Ev = {
  b { param: plain }
}

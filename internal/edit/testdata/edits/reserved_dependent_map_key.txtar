-- after/p/p.canon --
package p

/// A kind.
enum Kind { word, num }

/// A word.
enum Word { plain, if, while }

/// A param.
type Param(k: Kind) = match k {
  word => Word
  num => Never
}

/// An event.
record Ev {
  /// Its kind.
  kind: Kind = word
  /// Its param.
  param: Param(kind)?
  /// Counts by param.
  counts: {Param(kind): Int} = {}
}

/// Events.
let evs: table Ev = {
  b { param: `while`, counts: { while: 2, plain: 3 } }
}

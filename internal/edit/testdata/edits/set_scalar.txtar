API.md M1, API.md M2, API.md M6: a one-value Set of a scalar re-prints the one item whose value changed and
changes exactly one line; the teamboard's single-line entry keeps its layout. API.md E23: its
inverse is Set(old), carried as a Source literal.
-- options --
pkgs: tb
-- edit.json --
{"ops": [{"op": "set", "path": "statuses.wont_do.label", "value": "Will not do"}]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- tb/tb.canon --
/// Taxonomy of the team board.
package tb

/// Colour of a badge.
enum Tone { neutral, info, success, warning, danger, accent }

/// Inputs a status transition may collect.
enum PostField { assignee, fixed_in, reason, duplicate_of }

/// Who may make a transition.
enum Actor { reporter, triager, reporter_or_triager }

/// One point of the post lifecycle.
record Status {
  /// Colour of the status badge.
  tone: Tone
  /// Name of the status.
  label: String(1..)
  /// A terminal status closes the post.
  terminal: Bool
  /// The statuses a post may move to from here.
  next: [ref Status]
  /// Inputs a transition into this status must collect.
  requires: [PostField] = []
  /// Inputs a transition into this status may collect.
  optional: [PostField] = []
  /// Who, besides a triager, may make the transition.
  by: Actor? = none
}

/// The post lifecycle.
let statuses: table Status = {
  open { tone: warning, label: "Open", terminal: false, next: [taken, wont_do] }
  taken {
    tone: info
    label: "Taken"
    terminal: false
    // a comment inside the entry
    next: [open, wont_do]
    requires: [assignee]
  }
  wont_do { tone: neutral, label: "Won't do", terminal: true, next: [open], requires: [reason] }
}
-- result.json --
{
  "changes": [
    {
      "kind": "modified",
      "path": "tb/tb.canon"
    }
  ],
  "undo": [
    {
      "op": "set",
      "path": "tb:statuses.wont_do.label",
      "source": "\"Won't do\""
    }
  ],
  "touched": [
    "tb"
  ]
}
-- after/tb/tb.canon --
/// Taxonomy of the team board.
package tb

/// Colour of a badge.
enum Tone { neutral, info, success, warning, danger, accent }

/// Inputs a status transition may collect.
enum PostField { assignee, fixed_in, reason, duplicate_of }

/// Who may make a transition.
enum Actor { reporter, triager, reporter_or_triager }

/// One point of the post lifecycle.
record Status {
  /// Colour of the status badge.
  tone: Tone
  /// Name of the status.
  label: String(1..)
  /// A terminal status closes the post.
  terminal: Bool
  /// The statuses a post may move to from here.
  next: [ref Status]
  /// Inputs a transition into this status must collect.
  requires: [PostField] = []
  /// Inputs a transition into this status may collect.
  optional: [PostField] = []
  /// Who, besides a triager, may make the transition.
  by: Actor? = none
}

/// The post lifecycle.
let statuses: table Status = {
  open { tone: warning, label: "Open", terminal: false, next: [taken, wont_do] }
  taken {
    tone: info
    label: "Taken"
    terminal: false
    // a comment inside the entry
    next: [open, wont_do]
    requires: [assignee]
  }
  wont_do { tone: neutral, label: "Will not do", terminal: true, next: [open], requires: [reason] }
}

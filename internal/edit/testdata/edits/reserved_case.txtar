-- after/g/g.canon --
package g

/// A shape.
variant Shape {
  /// A dot.
  dot
  /// A condition.
  if
  /// A loop.
  while {
    /// Its radius.
    r: Int = 0
  }
}

/// A node.
record Node {
  /// Its shape.
  shape: Shape = dot
  /// Its shapes.
  shapes: [Shape] = []
}

/// Nodes.
let nodes: table Node = {
  a { shape: Shape.if, shapes: [Shape.while { r: 2 }, dot] }
  b { shape: Shape.while { r: 3 }, shapes: [Shape.if, dot, Shape.while { r: 4 }] }
}

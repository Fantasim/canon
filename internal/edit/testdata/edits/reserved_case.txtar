-- after/g/g.canon --
package g

/// A shape.
variant Shape {
  /// A dot.
  dot
  /// A condition.
  if
  /// A loop.
  while {
    /// Its radius.
    r: Int = 0
  }
}

/// A node.
record Node {
  /// Its shape.
  shape: Shape = dot
  /// Its shapes.
  shapes: [Shape] = []
}

/// Nodes.
let nodes: table Node = {
  a { shape: `if`, shapes: [`while` { r: 2 }, dot] }
  b { shape: `while` { r: 3 }, shapes: [`if`, dot, `while` { r: 4 }] }
}

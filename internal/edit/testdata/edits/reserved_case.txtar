GRAMMAR.md §4.3 (a): a variant case may be named by any reserved word; in value position one
that is not nameable is written quoted (§2.3, DECISIONS 378), alone (`` `if` ``) or before its
fields as a typed literal (`` `while` { r: 2 } ``, GRAMMAR.md §5.12), by its wire form or its
Source form (API.md §8.2) alike; a plain case stays bare (API.md M7). API.md E23: the inverse
Source of the old qualified case is quoted.
-- options --
pkgs: g
-- edit.json --
{"ops": [
  {"op": "set", "path": "nodes.a.shape", "value": {"kind": "if"}},
  {"op": "set", "path": "nodes.a.shapes", "value": [{"kind": "while", "r": 2}, {"kind": "dot"}]},
  {"op": "set", "path": "nodes.b.shape", "source": "Shape.while { r: 3 }"},
  {"op": "set", "path": "nodes.b.shapes", "source": "[g.Shape.if, Shape.dot, g.Shape.while { r: 4 }]"}
]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- g/g.canon --
package g

/// A shape.
variant Shape {
  /// A dot.
  dot
  /// A condition.
  if
  /// A loop.
  while {
    /// Its radius.
    r: Int = 0
  }
}

/// A node.
record Node {
  /// Its shape.
  shape: Shape = dot
  /// Its shapes.
  shapes: [Shape] = []
}

/// Nodes.
let nodes: table Node = {
  a { shape: Shape.while { r: 1 } }
  b { shape: Shape.if }
}

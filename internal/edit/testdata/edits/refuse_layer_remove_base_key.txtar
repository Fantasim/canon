API.md W11 (log-2026-11-01 EDIT-OWED review and re-review 1): a Remove of the edit layer's own
line takes out only an entry the layer itself adds; the line `weights["b"]: 3` re-values a key
the base states: the Remove is ErrNotEditable with reason layer, nothing written.
-- options --
pkgs: p
editLayer: dev
-- edit.json --
{"ops": [{"op": "remove", "path": "conf.weights[b]"}]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- p/p.canon --
package p

/// An item.
record Item {
  /// Its id.
  id: String = "i"
  /// A count.
  n: Int = 0
}

/// Holds an item.
record Holder {
  /// The item.
  data: Item
}

/// A configuration.
record Conf {
  /// Weights.
  weights: {String: Int} = {}
  /// A limit.
  limit: Int = 1
}

/// A holder.
let holder: Holder = { data: { id: "h" } }

/// Configuration.
let conf: Conf = { weights: { "a": 1, "b": 2 } }
-- p/dev.layer.canon --
package p
layer dev

amend holder {
  data: { id: "hd", n: 1 }
}

amend conf {
  weights["b"]: 3
}
-- result.json --
{
  "error": "op 0: value not editable: reason layer"
}

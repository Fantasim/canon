{"ops": [{"op": "set", "path": "objectives.slay.goal", "source": "collect"}]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- dep/dep.canon --
package dep

/// What an objective counts.
enum Goal { kill, collect }

/// What an objective aims at, by goal.
type Target(g: Goal) = match g {
  kill => String(1..)
  collect => Int(1..)
}

/// A daily objective.
record Objective {
  /// What it counts.
  goal: Goal
  /// What it aims at.
  target: Target(goal)?
}

/// The daily objectives.
let objectives: table Objective = load("objectives.json")
-- dep/objectives.json --
{
  "slay": {
    "goal": "kill",
    "target": "wolf"
  },
  "gather": {
    "goal": "collect",
    "target": 10
  }
}
-- result.json --
{
  "changes": [
    {
      "kind": "modified",
      "path": "dep/objectives.json"
    }
  ],
  "dropped": [
    {
      "path": "dep:objectives.slay.target",
      "value": "wolf"
    }
  ],
  "undo": [
    {
      "op": "set",
      "path": "dep:objectives.slay.goal",
      "source": "kill"
    },
    {
      "op": "set",
      "path": "dep:objectives.slay.target",
      "value": "wolf"
    }
  ],
  "touched": [
    "dep"
  ]
}
-- after/dep/objectives.json --

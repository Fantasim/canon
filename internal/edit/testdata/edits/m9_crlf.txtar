API.md M9 on raw bytes (log-2026-09-29 M4): a file whose bytes hold a carriage return is not in
canonical layout, whatever the file set folds; it is normalized entirely before the edit and
listed in NotCanonical, which the caller refuses without Normalize. N12: `\n` line ends. The
test writes p/p.canon with CRLF line ends (option crlf).
-- options --
pkgs: p
crlf: p/p.canon
-- edit.json --
{"ops": [{"op": "set", "path": "limit", "value": 9}]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- p/p.canon --
package p

/// A limit.
let limit: Int = 5

/// A name.
let name: String = "n"
-- result.json --
{
  "changes": [
    {
      "kind": "modified",
      "path": "p/p.canon"
    }
  ],
  "undo": [
    {
      "op": "set",
      "path": "p:limit",
      "source": "5"
    }
  ],
  "touched": [
    "p"
  ],
  "notCanonical": [
    "p/p.canon"
  ]
}
-- after/p/p.canon --
package p

/// A limit.
let limit: Int = 9

/// A name.
let name: String = "n"

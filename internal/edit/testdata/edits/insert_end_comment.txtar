-- after/p/p.canon --
package p

/// A status.
record Status {
  /// Its label.
  label: String
}

/// Statuses.
let statuses: table Status = {
  open { label: "Open" } // the first one
  closed { label: "Closed" }
  // ... the other statuses of the tracker
}

/// Weights.
let weights: {String: Int} = {
  "a": 1
  "b": 2
  "c": 3

  // more weights come from the tuning sheet
  /* and the old one */
}

/// Spare statuses.
let spare: table Status = {
  first { label: "First" }
  // none yet
}

/// Tags.
let tags: [String] = [
  "alpha",
  "beta",
  "gamma",
  // the rest are generated
]

-- after/p/p.canon --
package p

/// A season.
enum Season { spring, summer, autumn }

/// A model.
record Model {
  /// Its id.
  typeId: Int
  /// Its name.
  name: String
}

/// A status.
record Status {
  /// Its label.
  label: String
}

/// Models.
let models: [Model] keyed by typeId = [
  { typeId: 4, name: "four" },
  { typeId: 3, name: "three" },
  { typeId: 9, name: "nine" },
]

/// Statuses.
let statuses: table Status = {
  closed { label: "Closed" }
  blocked { label: "Blocked" }
}

/// Weights.
let weights: {Season: Int} = { summer: 2, autumn: 3 }

-- after/g/g.canon --
package g

/// A word.
enum Word { plain, if }

/// A slot.
record Slot {
  /// Its word.
  word: Word
}

/// Slots, keyed by word.
let slots: [Slot] keyed by word = [{ word: plain }, { word: Word.if }]

/// A node.
record Node {
  /// The nodes after it.
  next: [ref Node] = []
  /// Weights by node.
  weights: {ref Node: Int} = {}
  /// Its slot.
  slot: (ref slots)?
}

/// Nodes.
let nodes: table Node = {
  if { next: ["if"] }
  plain { next: ["if", plain], weights: { if: 1 }, slot: "if" }
}

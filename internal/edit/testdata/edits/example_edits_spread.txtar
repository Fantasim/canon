API.md W9, E23: over examples/features/edits, a field present after the spread is edited in place
(derived.label); one the spread supplies is edited by inserting an override after the spread
(derived.retries comes from base, derived.open from the default base leaves); base is not changed
through derived, and Undo of an override sets the old value back, not Reset.
-- options --
example: features/edits
pkgs: features.edits
-- edit.json --
{"ops": [
  {"op": "set", "path": "derived.retries", "value": 7},
  {"op": "set", "path": "derived.label", "value": "Other"},
  {"op": "set", "path": "derived.open", "value": false}
]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- result.json --
{
  "changes": [
    {
      "kind": "modified",
      "path": "features/edits/edits.canon"
    }
  ],
  "undo": [
    {
      "op": "set",
      "path": "features.edits:derived.open",
      "source": "true"
    },
    {
      "op": "set",
      "path": "features.edits:derived.label",
      "source": "\"Derived\""
    },
    {
      "op": "set",
      "path": "features.edits:derived.retries",
      "source": "5"
    }
  ],
  "touched": [
    "features.edits"
  ]
}
-- after/features/edits/edits.canon --
/// A project used only by the edit tests (API.md §8, IMPLEMENTATION-PLAN §7.9): one small
/// declaration for each thing an edit must handle. Defaults, one computed from another
/// field, a spread, a layered value, a JSON source, a dependent field and a variant. Nothing
/// here is emitted.
package features.edits

/// What a quest counts.
enum Goal { kill, collect }

/// What a quest aims at, by goal: a monster, or a number of items.
type Target(g: Goal) = match g {
  kill => String(1..)
  collect => Int(1..)
}

/// What completing a quest gives.
variant Reward {
  /// Gold coins.
  gold {
    /// How many.
    amount: Int(1..)
  }
  /// An item.
  item {
    /// Which one.
    id: String(1..)
    /// How many.
    count: Int = 1
  }
}

/// A quest.
record Quest {
  /// What it counts.
  goal: Goal
  /// What it aims at, chosen by the goal; none until chosen.
  target: Target(goal)?
  /// What it gives.
  reward: Reward
  /// Its level.
  level: Int = 1
  /// The lowest level that may take it: one below its level unless said otherwise.
  minLevel: Int = level - 1
  /// Whether it can be taken again.
  repeatable: Bool = false
}

/// The quests.
let quests: table Quest = {
  slay { goal: kill, target: "wolf", reward: gold { amount: 100 }, level: 3, repeatable: true }
  gather { goal: collect, target: 10, reward: item { id: "potion", count: 2 }, minLevel: 4 }
}

/// How a server behaves.
record Rules {
  /// Attempts before giving up.
  retries: Int = 3
  /// A label for logs.
  label: String = ""
  /// Whether new players are welcome.
  open: Bool = true
}

/// The rules every server starts from.
let base: Rules = { retries: 5, label: "Base" }

/// A server's rules: the base, with its own label.
let derived: Rules = { ...base, retries: 7, label: "Other", open: false }

/// The production server's rules; the staging layer amends them.
let server: Rules = { retries: 2, label: "Prod" }

/// Capacities, as the server reads them in `data/limits.json`.
record Limits {
  /// Players at once.
  players: Int @json("nPlayers")
  /// How many may wait to join.
  queue: Int = 10 @json("nQueue")
  /// How long a session lasts.
  timeout: Duration @json("dwTimeoutMs", unit: ms)
  /// Where the server runs.
  region: String = "eu" @json("szRegion")
  /// A welcome message; an empty string in the file means none.
  motd: String? @json("szMotd", none: "")
}

/// The capacities.
let limits: Limits = load("data/limits.json")

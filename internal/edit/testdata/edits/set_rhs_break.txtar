API.md M5, API.md M6: a value written on the line after its `:` because it did not fit
(FORMATTER.md §7.2 rule A) is set to a short one: the settle joins it to its name, re-printing
the item from its `:`; every byte outside the items re-printed is kept.
-- options --
pkgs: p
-- edit.json --
{"ops": [
  {"op": "set", "path": "rows.a.label", "value": "short"}
]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- p/p.canon --
package p

/// A row.
record Row {
  /// Its label.
  label: String
  /// A count.
  n: Int = 0
}

/// Rows.
let rows: table Row = {
  a {
    label:
      "a label far too long to be written on the line of its name, so the formatter breaks it there"
    n: 1
  }
  b { label: "b", n: 2 }
}
-- result.json --
{
  "changes": [
    {
      "kind": "modified",
      "path": "p/p.canon"
    }
  ],
  "undo": [
    {
      "op": "set",
      "path": "p:rows.a.label",
      "source": "\"a label far too long to be written on the line of its name, so the formatter breaks it there\""
    }
  ],
  "touched": [
    "p"
  ]
}
-- after/p/p.canon --
package p

/// A row.
record Row {
  /// Its label.
  label: String
  /// A count.
  n: Int = 0
}

/// Rows.
let rows: table Row = {
  a {
    label: "short"
    n: 1
  }
  b { label: "b", n: 2 }
}

GRAMMAR.md §2.3, DECISIONS 378: an amendment line (API.md W11) writes a reserved-word member
quoted (`` `if` ``), which needs no name in scope; a new line, and a line the layer already
holds, the old line replaced (API.md W11a). API.md E22: the Undo, the old value written quoted,
is typed back.
-- options --
pkgs: p
layers: dev
editLayer: dev
-- edit.json --
{"ops": [
  {"op": "set", "path": "conf.word", "value": "if"},
  {"op": "set", "path": "conf.words", "value": ["while", "plain"]}
]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- p/p.canon --
package p

/// A word.
enum Word { plain, if, while }

/// A configuration.
record Conf {
  /// A word.
  word: Word = plain
  /// Words.
  words: [Word] = []
}

/// Configuration.
let conf: Conf = {}
-- p/dev.layer.canon --
package p
layer dev

amend conf {
  words: [Word.if]
}
-- result.json --
{
  "changes": [
    {
      "kind": "modified",
      "path": "p/dev.layer.canon"
    }
  ],
  "undo": [
    {
      "op": "set",
      "path": "p:conf.words",
      "source": "[`if`]"
    },
    {
      "op": "reset",
      "path": "p:conf.word"
    }
  ],
  "touched": [
    "p"
  ]
}
-- after/p/dev.layer.canon --
package p
layer dev

amend conf {
  words: [`while`, plain]
  word: `if`
}

    },
    {
      "op": "addEntry",
      "path": "p:evs",
      "key": "eb",
      "source": "{ kind: b, param: WB.if }"
    },
    {
      "op": "move",
      "path": "p:evs.eb",
      "index": 1
    },
    {
      "op": "set",
      "path": "p:evs.ea",
      "source": "{ param: WA.if }"
    },
    {
      "op": "remove",
      "path": "p:evs.ec"
    }
  ],
  "touched": [
    "p"
  ]
}
-- after/p/p.canon --
package p

/// A kind.
enum Kind { a, b }

/// Words of a.
enum WA { x, if }

/// Words of b.
enum WB { y, if }

/// A param.
type Param(k: Kind) = match k {
  a => WA
  b => WB
}

/// An event.
record Ev {
  /// Its kind.
  kind: Kind = a
  /// Its param.
  param: Param(kind)?
}

/// Events.
let evs: table Ev = {
  ea { kind: b, param: WB.if }
  ey {}
  ec { kind: b, param: WB.if }
}

DECISIONS 366: two branches of a dependent field share a reserved member (`WA.if`, `WB.if`); the
symbol is qualified through the branch the record's discriminant selects, computed as the decoder
computes it (DEP-02): an AddEntry and a Set of a record with `kind: b` write `WB.if` and keep
it, a Remove's Undo restores `WB.if` (API.md E22, E23), and a Set changing the discriminant has
an Undo giving the old param back.
-- options --
pkgs: p
-- edit.json --
{"ops": [
  {"op": "addEntry", "path": "evs", "key": "ec", "source": "{ kind: b, param: WB.if }"},
  {"op": "set", "path": "evs.ea", "source": "{ kind: b, param: WB.if }"},
  {"op": "remove", "path": "evs.eb"},
  {"op": "set", "path": "evs.ey", "value": {"kind": "a"}}
]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- p/p.canon --
package p

/// A kind.
enum Kind { a, b }

/// Words of a.
enum WA { x, if }

/// Words of b.
enum WB { y, if }

/// A param.
type Param(k: Kind) = match k {
  a => WA
  b => WB
}

/// An event.
record Ev {
  /// Its kind.
  kind: Kind = a
  /// Its param.
  param: Param(kind)?
}

/// Events.
let evs: table Ev = {
  ea { param: WA.if }
  eb { kind: b, param: WB.if }
  ey { kind: b, param: y }
}

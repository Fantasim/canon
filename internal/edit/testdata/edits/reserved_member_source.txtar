-- after/g/g.canon --
package g

/// A word.
enum Word { plain, check, if, match, while, return, for }

/// An inner record.
record Inner {
  /// A word.
  w: Word = plain
}

/// A row.
record Row {
  /// A word.
  word: Word = plain
  /// Words.
  words: [Word] = []
  /// Words by name.
  named: {String: Word} = {}
  /// Counts by word.
  counts: {Word: Int} = {}
  /// An inner record.
  inner: Inner = {}
}

/// Rows.
let rows: table Row = {
  a {
    word: `match`
    words: [`if`, plain, check, `while`]
    named: { "x": `return` }
    inner: { w: `for` }
  }
  b { counts: { if: 1, match: 2 } }
}

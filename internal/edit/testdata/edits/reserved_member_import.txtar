GRAMMAR.md §2.3, DECISIONS 378: a reserved-word member of another package's enum is written
quoted, the same text whatever the file being written imports: under `import v`, `import v as
voc` and `import v { Word }` alike. API.md M7: a plain member stays bare. API.md §8.2 Source:
`v.Word.if`, the package path and the enum, is accepted.
-- options --
pkgs: g h k
-- edit.json --
{"ops": [
  {"op": "set", "path": "g:rows.a.word", "value": "if"},
  {"op": "set", "path": "h:rows.a.word", "value": "if"},
  {"op": "set", "path": "k:rows.a.word", "source": "v.Word.if"},
  {"op": "set", "path": "k:rows.b.word", "value": "plain"}
]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- v/v.canon --
package v

/// A word.
enum Word { plain, check, if }

/// A row.
record Row {
  /// A word.
  word: Word = plain
}
-- g/g.canon --
package g

import v

/// Rows.
let rows: table v.Row = {
  a { word: check }
}
-- h/h.canon --
package h

import v as voc

/// Rows.
let rows: table voc.Row = {
  a { word: check }
}
-- k/k.canon --
package k

import v { Row, Word }

/// Rows.
let rows: table Row = {
  a { word: check }
  b { word: check }
}

-- after/p/p.canon --
package p

/// A node.
record Node {
  /// Labels by node.
  labels: {ref Node: String} = {}
}

/// Nodes.
let nodes: table Node = {
  a {}
  b {
    labels: {
      a: "vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv"
    }
  }
  c {
    labels: {
      "a": "wwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwww"
    }
  }
}

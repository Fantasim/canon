API.md M5, API.md M6, API.md E11: renaming a table key shorter renames each ref to it, map keys
included; a key that narrows lets its value, alone on the line after the `:`, join it, whether
the key is a bare name (a named item) or a string (a keyed item). Every byte outside the items
re-printed is kept.
-- options --
pkgs: p
-- edit.json --
{"ops": [
  {"op": "rename", "path": "nodes.a_rather_long_node_key_name_number_one", "key": "a"}
]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- p/p.canon --
package p

/// A node.
record Node {
  /// Labels by node.
  labels: {ref Node: String} = {}
}

/// Nodes.
let nodes: table Node = {
  a_rather_long_node_key_name_number_one {}
  b {
    labels: {
      a_rather_long_node_key_name_number_one:
        "vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv"
    }
  }
  c {
    labels: {
      "a_rather_long_node_key_name_number_one":
        "wwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwww"
    }
  }
}

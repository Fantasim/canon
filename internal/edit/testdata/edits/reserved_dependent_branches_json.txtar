DECISIONS 366: in a JSON source, the Undo of a Remove restores a dependent symbol shared by two
branches qualified through the branch its record's `kind` selects (`WB.if`), and applies (API.md
E22, E23); a Source giving it through that branch writes its wire value.
-- options --
pkgs: p
-- edit.json --
{"ops": [
  {"op": "remove", "path": "evs.eb"},
  {"op": "set", "path": "evs.ea", "source": "{ id: \"ea\", kind: b, param: WB.if }"}
]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- p/p.canon --
package p

/// A kind.
enum Kind { a, b }

/// Words of a.
enum WA { x, if }

/// Words of b.
enum WB { y, if }

/// A param.
type Param(k: Kind) = match k {
  a => WA
  b => WB
}

/// An event.
record Ev {
  /// Its kind.
  kind: Kind = a
  /// Its id.
  id: String
  /// Its param.
  param: Param(kind)?
}

/// Events.
let evs: [Ev] keyed by id = load("evs.json")
-- p/evs.json --
[
  {
    "id": "ea",
    "param": "if"
  },
  {
    "id": "eb",
    "kind": "b",
    "param": "if"
  }
]
-- result.json --
{
  "changes": [
    {
      "kind": "modified",
      "path": "p/evs.json"
    }
  ],
  "undo": [
    {
      "op": "set",
      "path": "p:evs[ea]",
      "source": "{ id: \"ea\", param: WA.if }"
    },
    {
      "op": "insert",
      "path": "p:evs",
      "index": 1,
      "source": "{ kind: b, id: \"eb\", param: WB.if }"
    }
  ],
  "touched": [
    "p"
  ]
}
-- after/p/evs.json --
[
  {
    "kind": "b",
    "id": "ea",
    "param": "if"
  }
]

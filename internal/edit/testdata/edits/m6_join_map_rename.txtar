API.md M5, API.md M6 (review probe zz_map_rename, 2026-10-13): what the edit writes is a fixed point and
changes no byte outside the items it re-prints, a settle that joins an enclosing item included.
Here: a map key renamed shorter lets its value, alone on the next line, join the key.
-- options --
pkgs: p
-- edit.json --
{"ops": [{"op": "rename", "path": "m[kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk]", "key": "k"}]}
-- project.canon --
project acme {
  canon: "0.1"
}
-- p/p.canon --
package p

/// A col.
record Col {
  /// Name.
  name: String
  /// Tags.
  tags: [String] = []
}

/// A row.
record Row {
  /// Label.
  label: String = ""
  /// Tags.
  tags: [String] = []
  /// Cols.
  cols: [Col] = []
  /// Nested.
  nest: [[String]] = []
}

/// A string.
let s: String =
  "ssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss"

/// A map.
let m: {String: String} = {
  "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk":
    "vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv"
}

/// Rows.
let rows: table Row = {
  a {
    label: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" // keep me
  }
  c {
    tags: [
      "tttttttttttttttttttttttttttttt",
      "uuuuuuuuuuuuuuuuuuuuuuuuuuuuuu",
      "wwwwwwwwwwwwwwwwwwwwwwwwwwwwww",
    ]
  } // tail
  d {
    cols: [
      { name: "nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn" },
      { name: "oooooooooooooooooooooooooooooooooooooooo", tags: ["q"] },
    ]
  }
  e {
    nest: [
      ["pppppppppppppppppppppppppppppppppppppppp"],
      ["rrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr"],
    ]
  }
  f { label: "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" }
}
-- result.json --
{
  "changes": [
    {
      "kind": "modified",
      "path": "p/p.canon"
    }
  ],
  "undo": [
    {
      "op": "rename",
      "path": "p:m[k]",
      "key": "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"
    }
  ],
  "touched": [
    "p"
  ]
}
-- after/p/p.canon --

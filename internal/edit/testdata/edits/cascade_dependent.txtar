/// What an objective aims at, by goal.
type Target(g: Goal) = match g {
  kill => String(1..)
  collect => Int(1..)
}

/// A reward: gold, or an item.
type Reward(item: Bool) = match item {
  false => Int(1..)
  true => String(1..)
}

/// A daily objective.
record Objective {
  /// What it counts.
  goal: Goal
  /// What it aims at.
  target: Target(goal)?
  /// Whether its rewards are items rather than gold.
  itemRewards: Bool
  /// What completing it gives.
  rewards: [Reward(itemRewards)]
}

/// The daily objectives.
let objectives: table Objective = {
  slay { goal: collect, itemRewards: false, rewards: [100, 50] }
  gather { goal: collect, target: 10, itemRewards: false, rewards: ["potion"] }

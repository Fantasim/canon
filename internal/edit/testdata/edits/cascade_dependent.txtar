      "path": "dep:objectives.gather.itemRewards",
      "source": "true"
    },
    {
      "op": "set",
      "path": "dep:objectives.slay.goal",
      "source": "kill"
    },
    {
      "op": "set",
      "path": "dep:objectives.slay.target",
      "value": "wolf"
    }
  ],
  "touched": [
    "dep"
  ]
}

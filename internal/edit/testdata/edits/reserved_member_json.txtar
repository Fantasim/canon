-- after/g/g.canon --
package g

/// A word.
enum Word { plain, check, if, match, while, return, for }

/// An inner record.
record Inner {
  /// A word.
  w: Word = plain
}

/// A row.
record Row {
  /// A word.
  word: Word = plain
  /// Words.
  words: [Word] = []
  /// Words by name.
  named: {String: Word} = {}
  /// Counts by word.
  counts: {Word: Int} = {}
  /// An inner record.
  inner: Inner = {}
}

/// Rows.
let rows: table Row = {
  a {
    word: Word.match
    words: [Word.if, plain, check, Word.while]
    named: { "x": Word.return, "y": plain }
    counts: { if: 1, plain: 2 }
    inner: { w: Word.for }
  }
}

The verdict matrix TestLayerVerdictMatrix runs (orchestrator ruling EVAL-AMENDNOTE round 6): a dev layer amends server.port at the top level and cfg.server inside cfg; url re-derives from the port, host does not. Set, Reset and Remove on url, host, port and tag, top level and nested, with dev active and edited (A), inactive and edited (B), and active under a base edit (C): the verdicts, the writes and whether the Undo restores the files, which F11's layer on a re-derived default never changes.
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// Server.
record Server {
  /// Port.
  port: Int = 1
  /// Host.
  host: String = "localhost"
  /// URL.
  url: String = "http://{host}:{port}"
}

/// Server.
let server: Server = {}

/// Cfg.
record Cfg {
  /// Server.
  server: Server = {}
  /// Tag.
  tag: String = "t"
}

/// Cfg.
let cfg: Cfg = {}
-- a/dev.layer.canon --
package a
layer dev

amend server {
  port: 9000
}

amend cfg {
  server: { port: 9000 }
}

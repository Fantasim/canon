EVALUATION.md §10.5 items 2 and 3, §10.3: the world builds stages A to D of the test's package, so
a let derived from a substituted one follows it (E3204 at its storage point), a ref to a removed
key is E3501 (stage B), a record check runs on an element of a substituted list (stage C) and the
package checks run (stage D), matched by name, by text and by code; a failing `passes` lists what
the world captured, each finding with its path and check.
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// One crafting level.
record Level {
  /// Level index.
  index: Int(0..=24)
  /// Experience needed to reach it.
  exp: Int(0..)

  check rising: exp >= index * 10 else "level {index} needs at least {index * 10} exp"
}

/// The shipped levels.
let levels: [Level] = [
  { index: 0, exp: 0 },
  { index: 1, exp: 100 },
  { index: 2, exp: 250 }
]

/// The highest level a player can reach.
let maxLevel: Int(0..=24) = 2

/// How many levels ship, derived from levels.
local let count: Int(1..=3) = levels.len()

/// A reward.
record Reward {
  /// Its label.
  label: String
}

/// The rewards.
let rewards: table Reward = {
  gold { label: "Gold" }
  gem { label: "Gem" }
}

/// What the first level gives.
let firstReward: ref rewards = gold

check uniqueIndex: [l.index for l in levels].isUnique() else "a level index is listed twice"

check {
  for l in levels {
    if l.index > maxLevel {
      fail(l, "level {l.index} is above maxLevel {maxLevel}")
    }
  }
}

test "the bare and a substituted package pass" {
  expect package passes
  expect package { levels: levels[0..2] } passes
}

test "each stage's findings are captured" {
  expect package { levels: levels + levels } fails E3204
  expect package { rewards: { gem { label: "Gem" } } } fails E3501
  expect package { levels: [{ index: 3, exp: 5 }] } fails rising
  expect package { levels: levels + [levels[1]] } fails uniqueIndex
  expect package { maxLevel: 1 } fails "level 2 is above maxLevel 1"
}

test "a failing passes lists the capture" {
  expect package { levels: [levels[1], { index: 3, exp: 5 }, levels[1]], maxLevel: 1, rewards: { gem { label: "Gem" } } } passes
}
-- tests.txt --
a "the bare and a substituted package pass": passed true
a "each stage's findings are captured": passed true
a "a failing passes lists the capture": passed false

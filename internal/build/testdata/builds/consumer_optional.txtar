DECISIONS 343: a root may be both optional and consumer; absent here, its copy is a consumer output: not written, no W8024; the copy under @out is written.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
    admin: "../admin"
  }
  optional_roots: [admin]
  consumer_roots: [admin]
}
-- a/a.canon --
/// A.
package a

/// V.
let v: Int = 1

emit json { out: ["@out/", "@admin/json/"] }
-- build.txt --
0 errors, 0 warnings in 1 package (…)
output @out/v.json 0

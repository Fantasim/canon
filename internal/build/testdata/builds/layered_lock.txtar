DECISIONS 196, LOCK.md §6.1: a build with layers writes its outputs but never canon.lock.
-- layers --
knights
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
  }
}
-- a/a.canon --
/// A.
package a

/// Tier.
record Tier {
  /// Weight.
  weight: Int = 1
}

/// Tiers.
let tiers: stable table Tier = { low {} }

emit json { out: "@out/" }
-- a/knights.canon --
package a
layer knights

amend tiers {
  low.weight: 3
}
-- build.txt --
0 errors, 0 warnings in 1 package (…)
output @out/tiers.json 0

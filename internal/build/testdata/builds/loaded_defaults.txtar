DECISIONS 173, WIRE.md §5.4, EVALUATION.md §13: the defaults of loaded records are evaluated
as a literal's are (an enum member, `[]`, an expression over an earlier field, parentheses),
through bare load, load.dir and load.csv alike, each value `default` at its default expression;
an omitted optional without default is `default` at its field declaration. A hard error in a
default is reported at it and poisons the load's value.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
  }
}
-- a/a.canon --
/// A.
package a

/// Mode.
enum Mode { off, local_budget }

/// Row.
record Row {
  /// Name.
  name: String
  /// Base.
  base: Int = 2
  /// Mode.
  mode: Mode = local_budget
  /// Tags.
  tags: [String] = []
  /// Twice the base.
  twice: Int = base * 2
  /// Label.
  label: String = ("szName")
  /// Note.
  note: String?

  warn mode == off at mode else "{name}: mode {mode}"
  warn tags.len() > 0 at tags else "{name}: tags {tags}"
  warn twice == 0 at twice else "{name}: twice {twice}"
  warn label == "" at label else "{name}: label {label}"
  warn note != none at note else "{name}: no note"
}

/// Broken.
record Broken {
  /// Name.
  name: String
  /// Out of range.
  pick: Int = [1][5]
}

/// One row, from JSON.
let one: Row = load("one.json")

/// Rows, one per file.
let dir: [Row] = load.dir("rows/*.json")

/// Rows, from CSV.
let csv: [Row] = load.csv("rows.csv", header: true)

/// Poisoned by its default.
let broken: Broken = load("one.json", partial: true)
-- a/one.json --
{"name": "one", "base": 5}
-- a/rows/r.json --
{"name": "dir"}
-- a/rows.csv --
name,base
csv,7

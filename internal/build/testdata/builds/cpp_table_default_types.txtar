CODEGEN.md §5.1, §5.13: a types-mode cpp decoder cannot write a non-empty table default (a row needs a record literal): check reports E8019 RecordConstant at the field and the build stops there, no internal error.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    gen: "gen"
  }
}
-- a/a.canon --
/// A.
package a

/// A slot.
record Slot {
  /// How many.
  n: Int
}

/// A shelf.
record Shelf {
  /// Its slots.
  extra: table Slot = { a { n: 1 } }
}

emit cpp { out: "@gen/a", namespace: "a", mode: types }
-- build.txt --
error[E8019]  a/a.canon:13:3
  emit cpp in types mode cannot generate a constant of a record or variant type

1 error, 0 warnings in 1 package (…)

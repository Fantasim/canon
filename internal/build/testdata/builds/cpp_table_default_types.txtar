CODEGEN.md §5.13, DECISIONS 386: a types-mode cpp decoder builds a non-empty table default (its rows records) with the baked filler's statements: check reports nothing and the build writes the C++ (formerly E8019 RecordDefault).
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    gen: "gen"
  }
}
-- a/a.canon --
/// A.
package a

/// A slot.
record Slot {
  /// How many.
  n: Int
}

/// A shelf.
record Shelf {
  /// Its slots.
  extra: table Slot = { a { n: 1 } }
}

emit cpp { out: "@gen/a", namespace: "a", mode: types }

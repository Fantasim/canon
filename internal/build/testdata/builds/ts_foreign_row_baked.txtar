DECISIONS 278, 289, 323; CODEGEN.md §2.8: a ts data emit holding, in a plain field, a record that another package emits rows of (b's table) in a baked ts emit builds: a reads b's record with its own reader, and the row record's interface declares id? and retired? (formerly E8018 at a's emit and E8019 ForeignDataRecord at the field).
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    gen: "gen"
  }
}
-- b/b.canon --
/// B.
package b

/// An item.
record Item {
  /// Weight.
  w: Int
}

/// Items.
let items: table Item = {
  sword { w: 1 }
}

emit ts { out: "@gen/ts/b.ts" }
-- a/a.canon --
/// A.
package a

import b { Item }

/// A place.
record Place {
  /// Held.
  held: Item
}

/// The place.
let place: Place = { held: { w: 2 } }

emit ts { out: "@gen/ts/a.ts", mode: data }
emit json { out: "gen/json/" }
-- build.txt --
0 errors, 0 warnings in 2 packages (…)
output @gen/ts/a.ts 0
output @gen/ts/b.ts 0
output a/gen/json/place.json 0

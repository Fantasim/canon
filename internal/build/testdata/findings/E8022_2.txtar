CODEGEN.md §2.8 "This machine" (DECISIONS 332): project.local.canon moves @gen alone; a cpp copy inside the project including a copy under @gen is E8022, the project's directory being the first end of the relative path.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    gen: "../gen"
  }
}
-- project.local.canon --
project acme {
  roots {
    gen: "../work/gen"
  }
}
-- ../work/gen/README --
-- core/core.canon --
/// Core.
package core

/// A colour.
enum Tone { red, blue }

emit cpp { out: "@gen/core", namespace: "acme::core", mode: types }
-- app/app.canon --
/// App.

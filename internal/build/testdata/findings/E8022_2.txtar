  /// Its colour.
  tone: Tone
}

emit cpp { out: "out/cpp", namespace: "acme::app", mode: types }
-- findings.txt --
error[E8022]  app/app.canon:12:17
  app/out/cpp reaches @gen/core by a relative path computed from project.canon, but this machine places gen elsewhere relative to project acme: place both as project.canon does (project.local.canon or --root), or the generated path would break


DECISIONS 264, 244, EVALUATION.md §2.1 item 3, §12.2: `a` alone is selected; after its values,
stage A forces what P's bound folded, in fold order: b.N first, which reads b.L. The budget runs
out inside N's force, so E4401 is at N, not at L (a reversed order) nor before a's values.
-- select --
a
-- check-only --
-- project.canon --
project acme {
  canon: "0.1"
  budget: 20
}
-- b/b.canon --
/// B.
package b

/// Node.
record Node {
  /// Name.
  name: String
}

/// Link.
record Link {
  /// To.
  to: ref Node
}

/// Tree.
record Tree {
  /// Nodes.
  nodes: [Node] keyed by name
  /// Links.
  links: [Link]
}

/// An orphan link.
const L = Link { to: "x" }

/// How many.
const N = [L, L].len()
-- a/a.canon --
/// A.
package a

import b

/// A thing.
record P {
  /// Its name.
  name: String(1..)
  /// Its x.
  x: Int(0..=b.N)
}

/// Things.
let ps: table P = {}
-- a/ps/one.canon --
package a

entry ps.one {
  name: "One"
  x: 1
}
-- a/ps/two.canon --
package a

entry ps.two {
  name: "Two"
  x: 2
}
-- findings.txt --
error[E4401]  b/b.canon:28:11
  N: evaluation budget of 20 steps exhausted
  heaviest: N (8 steps)

1 error, 0 warnings in 1 package (…)

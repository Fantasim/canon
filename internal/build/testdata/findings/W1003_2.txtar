-- project.canon --
project acme {
  canon: "0.1"
}
-- Shared/s.canon --
/// S.
package Shared

/// V.
let v: Int = 1
-- a/a.canon --
/// A.
package a

import Shared as Other_Name

/// Rec.
record Rec(Max_Flag: Bool) {
  /// Field.
  Bad_Field: Int

  /// Method.
  fn Do_It(self, An_Arg: Int) -> Int { return An_Arg }
}

/// Top.
let Top_Level: Int = 1

/// Fn.
fn Do_Thing(Param_One: Int) -> Int {
  let Local_Name = Param_One
  var Other_Local = Local_Name
  for Loop_Var in [1, 2] {
    Other_Local = Loop_Var
  }
  return [1, 2].map(Lam_Var => Lam_Var).len() + Other_Local
}

/// Fine.
let fineOk: Int = 1

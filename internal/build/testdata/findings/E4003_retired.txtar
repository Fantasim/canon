TYPES.md §9.3, §6.3, EVALUATION.md §7.1, log-2026-11-01 "NOTENTRY report": self.retired read directly,
and self.id read through a method called bare and on self, each on pl[0], a plain list's element and no
entry: E4003 at each selection read, the run aborted. ta's entry gets its normal verdict: live, so
isRetired fails there alone.
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// A row.
record Row {
  /// Its code.
  code: String

  /// Its key.
  fn key(self) -> String { return self.id }

  check isRetired: self.retired else "{code} is live"

  check bare: key() != "" else "no key"

  check onSelf: self.key() != "" else "no key"
}

/// The rows.
let ta: table Row = { a { code: "a" } }

/// Rows that are no entries.
let pl: [Row] = [{ code: "p" }]

/// A.
package a

/// A row.
record Row {
  /// Its code.
  code: String

  check named: self.id != "" else "no id"
}

/// The rows.
let ta: table Row = { a { code: "a" } }

/// A row's maker.
record Maker {
  /// Its code.
  code: String = "m"

  /// A row made by this maker.
  export fn row(self) -> Row { return { code: code } }
}

/// The makers.
let makers: table Maker = { m {} }

emit json { out: "@out/" }

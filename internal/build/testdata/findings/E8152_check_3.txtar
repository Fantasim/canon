CODEGEN.md §2.3, DECISIONS 355: canon check counts Go's <out>/rt as a directory the Go emit writes into: a text file rt.go written there collides with the Go runtime file.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
  }
  go_module {
    out: "example.com/out"
  }
}
-- a/a.canon --
/// A.
package a

/// V.
let v: Int = 1

emit go { out: "@out/gen" }
-- b/b.canon --
/// B.
package b

/// The runtime's name.
@text("rt.go")
export fn rt() -> String { return "package rt\n" }

emit text { out: "@out/gen/rt" }
-- check-only --
-- findings.txt --
error[E8152]  b/b.canon:8:18
  outputs collide: @out/gen/rt/rt.go and @out/gen/rt/rt.go

1 error, 0 warnings in 2 packages (…)

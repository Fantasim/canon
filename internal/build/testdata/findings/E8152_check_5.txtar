WIRE.md §8.1, DECISIONS 355: canon check names a json emit's files from its layout, file mode included: a file-mode emit and a directory-mode emit writing one file collide, as in canon build.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
  }
}
-- a/a.canon --
/// A.
package a

/// V.
let v: Int = 1

emit json { out: "@out/v.json", values: [v] }
-- b/b.canon --
/// B.
package b

/// V.
let v: Int = 2

emit json { out: "@out/" }
-- check-only --
-- findings.txt --
error[E8152]  b/b.canon:7:18
  outputs collide: @out/v.json and @out/v.json

1 error, 0 warnings in 2 packages (…)

CODEGEN.md §2.4 "Stray generated files", DECISIONS 356: a plain build warns of a JSON file whose $schema names the selected package a, in the directory a's emit writes into, that no emit writes; a file with no marker, a hidden one and a runtime file in a directory outputs land in are not reported.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
  }
}
-- a/a.canon --
/// A.
package a

/// V.
let v: Int = 1

emit json { out: "@out/" }
-- out/old.json --
{
  "$schema": "a.Old@0123abcd",
  "value": 1
}
-- out/notes.json --
{"note": "hand-written"}
-- out/.hidden.json --
{
  "$schema": "a.Hidden@0123abcd",
  "value": 1
}
-- out/canon_runtime.h --
// GENERATED by canon: C++ runtime rt_v1. DO NOT EDIT.
-- findings.txt --
warning[W8030]  a/a.canon:7:18
  @out/old.json carries the generated marker of a, but no emit of this build writes it: delete it

0 errors, 1 warning in 1 package (…)

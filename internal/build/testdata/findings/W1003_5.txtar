/// A.
package a

/// Reward.
variant Reward {
  gold {
    /// Amount.
    amount: Int
  }
  nothing
}

/// Worth.
fn worth(r: Reward) -> Int {
  return match r {
    gold(The_Gold) => The_Gold.amount
    nothing => 0
  }
}

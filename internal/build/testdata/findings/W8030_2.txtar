CODEGEN.md §2.4 "Stray generated files", DECISIONS 356: a Go file left by a renamed package, whose marker names a package the project no longer has, is a stray in the directory of the Go emit and of its rt; the emit's own files are not.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
  }
  go_module {
    out: "example.com/out"
  }
}
-- a/a.canon --
/// A.
package a

/// V.
let v: Int = 1

emit go { out: "@out/gen" }
-- out/gen/old.gen.go --
// Code generated by canon from old/. DO NOT EDIT.

package gen
-- out/gen/rt/old.go --
// Code generated by canon from old/. DO NOT EDIT.

package rt
-- findings.txt --
warning[W8030]  a/a.canon:7:16
  @out/gen/old.gen.go carries the generated marker of old, but no emit of this build writes it: delete it

warning[W8030]  a/a.canon:7:16
  @out/gen/rt/old.go carries the generated marker of old, but no emit of this build writes it: delete it

0 errors, 2 warnings in 1 package (…)

TYPES.md §9.3, EVALUATION.md §7.1, log-2026-11-01 "NOTENTRY report": a Row held in a field of a
table's entry is no entry itself: the check reading self.id on it is E4003 at the selection.
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// A row.
record Row {
  /// Its code.
  code: String

  check named: self.id != "" else "no id"
}

/// The rows.
let ta: table Row = { a { code: "a" } }

/// A holder of a row.
record Holder {
  /// Its row.
  row: Row
}

/// The holders.
let holders: table Holder = { h { row: { code: "r" } } }
-- findings.txt --
error[E4003]  a/a.canon:9:16
  holders.h.row: .id of a value that is not an entry of a table or keyed list

1 error, 0 warnings in 1 package (…)

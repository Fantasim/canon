DECISIONS 343: --only-root --check for a consumer root that is absent and cannot be created is E1013 too, not E8023.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    admin: "../nowhere/admin"
  }
  consumer_roots: [admin]
}
-- a/a.canon --
/// A.
package a

/// V.
let v: Int = 1

emit json { out: "@admin/json/" }
-- check --
-- only-root --
admin
-- findings.txt --
error[E1013]  project.canon:4:5
  root "admin" ("../nowhere/admin") is not a directory on this machine: clone the repository there, point to it in project.local.canon, or list the root in optional_roots in project.canon

1 error, 0 warnings in 1 package (…)

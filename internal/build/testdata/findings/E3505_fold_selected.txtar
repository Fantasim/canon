DECISIONS 264, EVALUATION.md §2.1 item 3, §5: `a` alone is selected, and only P's bound, a phase-2
fold, reads `b.N`, which reads the orphan ref `b.L`. Stage A forces both again after the selected
values, so stage B verifies them: the E3505 of b/b.canon is reported as under `canon check`.
-- select --
a
-- check-only --
-- project.canon --
project acme {
  canon: "0.1"
}
-- b/b.canon --
/// B.
package b

/// Node.
record Node {
  /// Name.
  name: String
}

/// Link.
record Link {
  /// To.
  to: ref Node
}

/// Tree.
record Tree {
  /// Nodes.
  nodes: [Node] keyed by name
  /// Links.
  links: [Link]
}

/// An orphan link.
const L = Link { to: "x" }

/// How many.
const N = [L, L].len()
-- a/a.canon --
/// A.
package a

import b

/// A thing.
record P {
  /// Its x.
  x: Int(0..=b.N)
}

/// Things.
let ps: [P] = [{ x: 1 }]
-- findings.txt --
error[E3505]  b/b.canon:25:22

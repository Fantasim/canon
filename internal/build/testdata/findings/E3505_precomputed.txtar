DECISIONS 324, EVALUATION.md §2.3, §3.4, §5: a precomputed result is verified like an expect subject. A
level-1 ref its fn builds outside any instance of its owner is E3505, with no value path, under the
precomputation's frame; the result is a missing receiver.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
  }
}
-- a/a.canon --
/// A.
package a

/// Node.
record Node {
  /// Name.
  name: String
}

/// Link.
record Link {
  /// To.
  to: ref Node
}

/// Tree.
record Tree {
  /// Nodes.
  nodes: [Node] keyed by name
  /// Links.
  links: [Link]
}

/// Hold.
record Hold {
  /// N.
  n: Int = 1

  /// A link no tree encloses.
  export fn orphan(self) -> Link { return { to: "x" } }
}

/// Holds.
let holds: table Hold = { h {} }

emit json { out: "@out/" }
-- findings.txt --
error[E3505]  a/a.canon:30:49
  ref Node has no enclosing Tree to resolve against
  in Hold.orphan() (a/a.canon:30)


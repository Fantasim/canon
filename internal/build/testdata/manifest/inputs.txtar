WIRE.md §10 (LOD-11), §2.3: the manifests of check, build --target json and test, the
layer dev active: every source parsed and lock read, the files the loads read under their written
display (the root res lies inside the project), the load.dir glob, the asset directories listed,
one line per declared root (out serves only an emit); res/unread.json, res/icons/unused/ and art/
are never read and are not in it.
-- layers --
dev
-- project.canon --
project acme {
  canon: "0.1"

  roots {
    out: "out"
    res: "res"
  }
}
-- items/items.canon --
/// Items.
package items

/// An item.
record Item {
  /// Name.
  name: String
  /// Icon.
  icon: asset("@res/icons", ext: [png])
}

/// Items, one per file.
let items: [Item] = load.dir("@res/items/*.json")

/// A configuration.
record Conf {
  /// Limit.
  limit: Int = 3
}

/// The configuration.
let conf: Conf = load("data/conf.json")

test "two items" {
  expect items.len() == 2
}
-- items/dev.canon --
package items
layer dev

amend conf {
  limit: 4
}
-- items/data/conf.json --
{"limit": 2}
-- other/other.canon --
/// Other.
package other

/// N.
let n: Int = 1

emit json { out: "@out/" }
-- other/canon.lock --
# canon.lock v1
-- res/items/a.json --
{"name": "a", "icon": "a.png"}
-- res/items/b.json --
{"name": "b", "icon": "sub/b.png"}
-- res/items/notes.txt --
not matched
-- res/unread.json --
{}
-- res/icons/a.png --
-- res/icons/sub/b.png --
-- res/icons/unused/c.png --
-- art/d.png --
-- manifest.txt --

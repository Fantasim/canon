CONFORMANCE.md §6.5: a translated fn that recurses without end exceeds the call-depth limit on
every vector, each its own E9009, in check and build alike.
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// Never returns.
export fn spin(n: Int) -> Int { return spin(n) }

emit cpp { out: "out/", namespace: "acme::gen", mode: data }
-- build.txt --
error[E9009]  a/a.canon:5:11
  conformance vector 1 of spin exceeds the call-depth limit

error[E9009]  a/a.canon:5:11
  conformance vector 2 of spin exceeds the call-depth limit

error[E9009]  a/a.canon:5:11
  conformance vector 3 of spin exceeds the call-depth limit

error[E9009]  a/a.canon:5:11
  conformance vector 4 of spin exceeds the call-depth limit

error[E9009]  a/a.canon:5:11
  conformance vector 5 of spin exceeds the call-depth limit

5 errors, 0 warnings in 1 package (…)

EVALUATION.md §1, CONFORMANCE.md §6.1, DECISIONS 204: the tests run only to collect calls, so
nothing they meet is reported: a failing expect, a hard error that stops a test (the calls before
it kept), an imported value only a test reads, whose verification fails (E3501 unreported).
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// A status.
record Status {
  /// Its label.
  label: String
}

/// The statuses.
let statuses: table Status = {
  open { label: "Open" }
}

/// A status no table holds: only b's tests read it.
let initial: ref Status = "draft"
-- b/b.canon --
/// B.
package b

import a

/// Doubles n.
export fn double(n: Int) -> Int { return n * 2 }

test "calls, fails, then stops" {
  expect double(2) == 5
  expect double(3) == 6
  let zero = double(0)
  let z = 1 / zero
  expect double(4) == 8
}

test "reads the dangling status" {
  let s = a.initial
  expect double(1) == 2
}

emit cpp { out: "out/", namespace: "acme::gen", mode: data }
-- select --
b

EVALUATION.md §1, DECISIONS 204: a supported load that only b's test forces reports its finding
into bags the test collection throws away: nothing is reported, and b builds.
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// An item.
record Item {
  /// Its count.
  n: Int
}

/// The items, one file each: x.json does not decode.
let items: [Item] = load.dir("data/*.json")
-- a/data/x.json --
{"n": "many"}
-- b/b.canon --
/// B.
package b

import a

/// Doubles n.
export fn double(n: Int) -> Int { return n * 2 }

test "reads the items" {
  let k = a.items.len()
  expect double(k) == 2
}

emit cpp { out: "out/", namespace: "acme::gen", mode: data }
-- select --
b
-- build.txt --
0 errors, 0 warnings in 1 package (…)
output b/out/b.gen.cpp 0
output b/out/b.gen.h 0
output b/out/b_conformance.gen.cpp 0
output b/out/canon_runtime.h 0
output b/out/canon_runtime_json.h 0
== content of b/out/b_conformance.gen.cpp
// GENERATED by canon from b/. DO NOT EDIT.
// Conformance vectors of package b, computed by the Canon evaluator.
#include "b.gen.h"

#include <cstdint>
#include <cstdio>
#include <string_view>

namespace acme::gen::conformance {

namespace {

std::string_view g_code;  // first evaluation error of the current call, empty if none

void Capture(std::string_view code, std::string_view /*message*/) {
    if (g_code.empty()) g_code = code;
}

struct DoubleVector {
    int64_t n;
    int64_t want;
    std::string_view code;  // expected error code; empty when `want` is expected
};

constexpr DoubleVector kDouble[] = {
    {canon::kIntMin, 0, "E4101"},
    {-1, -2, ""},
    {0, 0, ""},
    {1, 2, ""},
    {canon::kIntMax, 0, "E4101"},
};

}  // namespace

int RunBConformance() {
    int failures = 0;
    const canon::EvalErrorHandler previous = canon::SetEvalErrorHandler(&Capture);
    for (const DoubleVector& v : kDouble) {
        g_code = std::string_view();
        const int64_t got = Double(v.n);
        if (g_code != v.code || (v.code.empty() && got != v.want)) {
            std::fprintf(stderr,
                         "b: double(n=%lld) = %lld [%.*s], canon says %lld [%.*s]\n",
                         static_cast<long long>(v.n), static_cast<long long>(got),
                         static_cast<int>(g_code.size()), g_code.data(), static_cast<long long>(v.want),
                         static_cast<int>(v.code.size()), v.code.data());
            ++failures;
        }
    }
    canon::SetEvalErrorHandler(previous);
    return failures;
}

}  // namespace acme::gen::conformance

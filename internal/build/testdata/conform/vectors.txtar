CONFORMANCE.md §6, §7, EVALUATION.md §1 phase 7: a translated method and a translated package fn
get their vectors from the package's test calls; the cpp emit writes them into the conformance file.
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// A healing potion.
record Potion {
  /// Hit points restored.
  heal: Int

  /// What a player missing missingHp gets back.
  export fn healFor(self, missingHp: Int) -> Int { return min(heal, max(missingHp, 0)) }
}

/// Twice n.
export fn double(n: Int) -> Int { return n * 2 }

test "healFor never overheals" {
  let p: Potion = { heal: 500 }
  expect p.healFor(200) == 200
  expect p.healFor(-5) == 0
}

emit cpp { out: "out/", namespace: "acme::gen", mode: data }
-- build.txt --
0 errors, 0 warnings in 1 package (…)
output a/out/a.gen.cpp 0
output a/out/a.gen.h 0
output a/out/a_conformance.gen.cpp 0
output a/out/canon_runtime.h 0
output a/out/canon_runtime_json.h 0
== content of a/out/a_conformance.gen.cpp
// GENERATED by canon from a/. DO NOT EDIT.
// Conformance vectors of package a, computed by the Canon evaluator.
#include "a.gen.h"

#include <cstdint>
#include <cstdio>
#include <string_view>

namespace acme::gen::conformance {

namespace {

std::string_view g_code;  // first evaluation error of the current call, empty if none

void Capture(std::string_view code, std::string_view /*message*/) {
    if (g_code.empty()) g_code = code;
}

struct PotionHealForVector {
    int64_t heal;
    int64_t missingHp;
    int64_t want;
    std::string_view code;  // expected error code; empty when `want` is expected
};

constexpr PotionHealForVector kPotionHealFor[] = {
    {500, 200, 200, ""},
    {500, -5, 0, ""},
    {500, canon::kIntMin, 0, ""},
    {500, -1, 0, ""},
    {500, 0, 0, ""},
    {500, 1, 1, ""},
    {500, 499, 499, ""},
    {500, 500, 500, ""},
    {500, 501, 500, ""},
    {500, canon::kIntMax, 500, ""},
};

struct DoubleVector {
    int64_t n;
    int64_t want;
    std::string_view code;  // expected error code; empty when `want` is expected
};

constexpr DoubleVector kDouble[] = {
    {canon::kIntMin, 0, "E4101"},
    {-1, -2, ""},
    {0, 0, ""},
    {1, 2, ""},
    {canon::kIntMax, 0, "E4101"},
};

}  // namespace

int RunAConformance() {
    int failures = 0;
    const canon::EvalErrorHandler previous = canon::SetEvalErrorHandler(&Capture);
    for (const PotionHealForVector& v : kPotionHealFor) {
        g_code = std::string_view();
        const int64_t got = detail::Potion_healFor(v.heal, v.missingHp);
        if (g_code != v.code || (v.code.empty() && got != v.want)) {
            std::fprintf(stderr,
                         "a: Potion.healFor(heal=%lld, missingHp=%lld) = %lld [%.*s], canon says %lld [%.*s]\n",
                         static_cast<long long>(v.heal), static_cast<long long>(v.missingHp),
                         static_cast<long long>(got), static_cast<int>(g_code.size()), g_code.data(),
                         static_cast<long long>(v.want), static_cast<int>(v.code.size()), v.code.data());
            ++failures;
        }
    }
    for (const DoubleVector& v : kDouble) {
        g_code = std::string_view();
        const int64_t got = Double(v.n);
        if (g_code != v.code || (v.code.empty() && got != v.want)) {
            std::fprintf(stderr,
                         "a: double(n=%lld) = %lld [%.*s], canon says %lld [%.*s]\n",
                         static_cast<long long>(v.n), static_cast<long long>(got),
                         static_cast<int>(g_code.size()), g_code.data(), static_cast<long long>(v.want),
                         static_cast<int>(v.code.size()), v.code.data());
            ++failures;
        }
    }
    canon::SetEvalErrorHandler(previous);
    return failures;
}

}  // namespace acme::gen::conformance

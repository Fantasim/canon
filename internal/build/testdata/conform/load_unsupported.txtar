DECISIONS 196 (meta/decisions/log-2026-09-24.md, build wiring): a load form M3 does not read (a
load.dir match whose format is not json), forced only by b's test while its calls are
collected, fails check and build alike with build.ErrLoad.
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// Raw numbers.
let raw: [Int] = load.dir("x.txt")
-- a/x.txt --
1
-- b/b.canon --
/// B.
package b

import a

/// Doubles n.
export fn double(n: Int) -> Int { return n * 2 }

test "reads raw" {
  let k = a.raw.len()
  expect double(k) == 2
}

emit cpp { out: "out/", namespace: "acme::gen", mode: data }
-- select --
b
-- build.txt --
check error (load error true, internal false): load is not supported by this compiler yet (a load.dir file whose format is not json): a/a.canon:5:18
build error (load error true, internal false): load is not supported by this compiler yet (a load.dir file whose format is not json): a/a.canon:5:18

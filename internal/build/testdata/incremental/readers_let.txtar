EVALUATION.md §8.1, IMPLEMENTATION-PLAN §7.6 (NFR-02), log-2026-09-29 M4 P12-r, P18: b holds a's
entries through a let of m, a package it imports but that is not selected, so m is never
traversed: b.again read m.all, which read a.items. a.items is not alone, and stage C meets its
entries as a cold run does.
-- project.canon --
project acme {
  canon: "0.1"
}
-- a/a.canon --
/// A.
package a

/// A part.
record Part {
  /// Size.
  size: Int

  check size < 50 else "size {size}"
}

/// An item.
record Item {
  /// Weight.
  weight: Int
  /// Its part.
  part: Part

  check weight < 50 else "weight {weight}"
}

/// Items.
let items: table Item = {}
-- a/items/one.canon --
package a

entry items.one {
  weight: 1
  part: { size: 60 }
}
-- a/items/two.canon --
package a

entry items.two {
  weight: 70
  part: { size: 2 }
}
-- a/items/three.canon --
package a

entry items.three {
  weight: 3
  part: { size: 3 }
}
-- m/m.canon --
/// M.
package m

import a

/// Every item.
let all: [a.Item] = a.items.values()
-- b/b.canon --
/// B.
package b

import a
import m

/// Every item again, through m.
let again: [a.Item] = m.all

IMPLEMENTATION-PLAN §7.6 (NFR-02), EVALUATION.md §3.1: the memo's reads case as a project: an
entry reads a loaded value, another loads; the JSON files are edited too (log-2026-09-29 M4 U8-r).
-- project.canon --
project acme {
  canon: "0.1"

  roots {
    resource: "resource"
  }
}
-- a/a.canon --
/// A.
package a

/// A configuration.
record Cfg {
  /// Bonus.
  bonus: Int
}

/// The configuration.
let cfg: Cfg = load("@resource/cfg.json")

/// An item.
record Item {
  /// Cost.
  cost: Int = 5
}

/// Items.
let items: table Item = {}
-- a/e1.canon --
package a

entry items.one { cost: cfg.bonus * 2 }
-- a/e2.canon --
package a

entry items.two { cost: 3 }
-- a/e3.canon --
package a

entry items.three { cost: load("@resource/n.json") }
-- resource/cfg.json --
{"bonus": 4}
-- resource/n.json --
7

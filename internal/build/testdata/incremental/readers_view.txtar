EVALUATION.md §1 (phase 8), §8.1, IMPLEMENTATION-PLAN §7.6 (NFR-02), log-2026-09-29 M4 P12-r,
P18: only b's view reads a.items, in phase 8, after stage C; b's values never do. a.items is
alone, so its unchanged entries replay stage C, and the view model is a cold run's.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    out: "out"
  }
}
-- a/a.canon --
/// A.
package a

/// A part.
record Part {
  /// Size.
  size: Int

  check size < 50 else "size {size}"
}

/// An item.
record Item {
  /// Weight.
  weight: Int
  /// Its part.
  part: Part

  check weight < 50 else "weight {weight}"
}

/// Items.
let items: table Item = {}
-- a/items/one.canon --
package a

entry items.one {
  weight: 1
  part: { size: 60 }
}
-- a/items/two.canon --
package a

entry items.two {
  weight: 70
  part: { size: 2 }
}
-- a/items/three.canon --
package a

entry items.three {
  weight: 3
  part: { size: 3 }
}
-- b/b.canon --
/// B.
package b

import a

/// A pick.
record Pick {
  /// Count.
  n: Int

  check n < 50 else "count {n}"
}

/// Picks.
let picks: table Pick = {}

view Pick {
  title "{n} of {a.items.one.weight}"
}

emit view { out: "@out/b.view.json" }
-- b/picks/p.canon --
package b

entry picks.p {
  n: 60
}

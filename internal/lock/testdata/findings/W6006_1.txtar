-- teamboard/taxonomy.canon --
package teamboard

/// Every entry of the board's taxonomy, trimmed to its key.
record Row {
  /// Shown to people.
  label: String = ""
}

let intents: stable table Row = {
  issue {}
  idea {}
}

let flags: stable table Row = {
  blocking {}
  sensitive {}
}

let statuses: stable table Row = {
  open {}
  blocked {}
  taken {}
  fixed {}
  verified {}
  wont_do {}
  duplicate {}
}

let columns: stable table Row = {
  unclaimed {}
  taken {}
  fixed {}
  done {}
}

let severities: stable table Row = {
  low {}
  normal {}
  critical {}
}

let areaGroups: stable table Row = {
  in_game {}
  out_game {}
  internal {}
}

let areas: stable table Row = {
  game {}
  balance {}
  website {}
  resource_studio {}
  game_server {}
  client {}
  resource {}
  sovcommon {}
  admin_panel {}
  analytics {}
  team_board {}
  internal {}
}

LOCK.md §4.2: a table with two @stable fields, both locked; the second field's value changes, and
only that field reports it.
-- p/canon.lock --
# canon.lock v1
field  p.statuses.code  1  open
field  p.statuses.code  2  done
field  p.statuses.rank  10  open
field  p.statuses.rank  20  done
table  p.statuses  done
table  p.statuses  open
-- p/p.canon --
package p

/// A status.
record Status {
  /// Its code on the wire.
  code: UInt16 @stable
  /// Its rank, also kept forever.
  rank: UInt16 @stable
}

let statuses: stable table Status = {
  open { code: 1, rank: 10 }
  done { code: 2, rank: 30 }
}
-- findings.txt --
error[E6002]  p/p.canon:13:25
  stable value rank of done changed from 20 to 30

1 error, 0 warnings in 1 package (…)

GRAMMAR.md §5.10: statements in function, check and test bodies.
-- a/a.canon --
package a

record R {
  xs: [Int]

  fn total(self, from: Int = 0) -> Int {
    let n: Int = from
    var acc = 0
    acc += 1
    acc -= 1
    acc *= 2
    acc /= 2
    xs[0] = acc
    for i, x in xs.enumerate() {
      if x > 10 { break } else if x < 0 { continue } else { acc = acc + x }
    }
    while acc > 100 { acc = acc - 1 }
    match kind {
      low, mid => { return 0 }
      high(h) => h
      none => 1
      _ => acc
    }
    return
  }

  check {
    if xs.isEmpty() { fail(xs, "empty") }
    warn(xs, "look")
  }
  warn many: xs.len() <= 10 at xs else "{xs.len()} items"
}

test "totals" {
  expect R { xs: [] }.total() == 0
  expect f() fails "boom"
  expect f() warns many
  expect f() passes
}

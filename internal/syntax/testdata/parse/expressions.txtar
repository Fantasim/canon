GRAMMAR.md §5.11, §6.3: operators, precedence, lambdas, shorthand, postfix steps and folding.
-- a/a.canon --
package a

let ops = a + b * c - d / e % f
let logic = not a in b and c < d or e ?? f ?? g
let ranges = [0.., ..=256, 1..=9, xs[i + 1..], xs[a..b]]
let lambdas = [x => x + 1, (a, b) => a * b, _ => 0, () => 1, x => y => x]
let short = items.map(.name.len()).filter(.default)
let chain = w?.item.id!.x[0](1)
let folded = [-5, -0.0, -9223372036854775808, -1.5.abs(), -(5), -x.f, - 90s, 2.5e-6, 0x1F, 1_000]
let typed = [Point { x: 1, y: 2 }, Reward.item { id: 1 }, nothing {}]
let loads = [load("a.json"), load.dir("d/*.json", at: "items", partial: true)]
let choose = if a { 1 } else if b { 2 } else { 3 }
let matched = match e.param {
  monster(m) => m.id
  item, quest => 0
  none => 1
  _ => { x: 2 }
}
let isCase = v is Reward.item and w is item
let comp = [x * 2 for x in xs if x > 0 let y = x]
let mapComp = { k: v for k, v in pairs }
let keyed = { "Cap": [a, b], (name): v, ...base, retired old @deprecated("gone") { }, open { tone: warning } }
let selfish = self.items
let multiline = items
  .filter(w => w.kind1 == "IK1_WEAPON")
  ?? []

GRAMMAR.md §5.10, EVALUATION.md §10.5: after `expect`, `package` starts a package subject, bare
or with substitutions on one line or one per line, always followed by an outcome; `Icon.package`
after `expect` stays an expression.
-- a/a.canon --
package a

enum Icon {
  package
  file
}

let levels: [Int] = [1, 2, 3]
let cap: Int = 2

test "package subjects" {
  expect package passes
  expect package { levels: [1] } fails uniqueIndex
  expect package { levels: levels + [4], cap: 3, } warns "above the cap"
  expect package {
    levels: []
    cap: 0
  } fails E3204
  expect Icon.package == Icon.file
  expect Icon.package passes
}

GRAMMAR.md §2.6: plain, raw and multiline strings, escapes, interpolations and format specs.
-- a/a.canon --
package a

let plain = "tab\tnew\nquote\" brace\{ \} {{lit}} smile\u{1F600}"
let interp = "{heal:,} HP, {ratio:.2}, {delta:+}, {x:+,.20} {"in{x}"}"
let nested = "outer {f("inner {y}", n: 1)} end"
let braces = "{ {a: 1}.a }"
let raw = r"C:\path\{x}"
let help = """
  First line.
    Indented line.

  Last {x} line with "quotes" and \"""
  """
let rawml = r"""
    keep \n {x}
  back
  """
let empty = """
  """
let badspec = "{x:q}"

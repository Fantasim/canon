GRAMMAR.md §5.3, §5.4, §5.6: declarations, modifiers, annotations and doc attachment.
-- a/a.canon --
/// Package doc.
package a.b

import c.d as e { F, G }
import h

/// A constant.
local const LIMIT = 7

@reload
@files("items/{kind}/{id}.canon")
let potions: [Potion] keyed by id = load.dir("data/*.json")

@deprecated("gone") retired entry items.OLD { cost: 1 }
entry levels.3 { exp: 10 }

/// A record.
record Pair(t: Type) @json(case: snake) @cpp(struct: "Pair", header: "pair.h", access: fields) {
  /// Left side.
  left: t
  right: t = none @json("r")
    @deprecated("use left")
  env: input String from env "HOME"

  /// Sum.
  @go(name: "Sum")
  export fn sum(self) -> Int { return 1 }

  check left != right else "same"
}

enum Level ordered @codes(UInt8) { LOW = 1 @json("low"), retired MID = -2, HIGH = "high" }

variant Reward @json(tag: "type") {
  gold
  item @json("Item") { id: Int }
  retired old
  fn value(self) -> Int { return 0 }
}

widget time_of_day(value: TimeOfDay) default
widget share(value: Int, siblings: [Int],)

view Item.IK1_WEAPON {
  title "{name}"
  plural "items"
  menu items icon gem
  field title "Title"
  field
  check "Check" { icon: flame }
  group g "G" "help" advanced when kind is IK1_WEAPON { show "A" "{a}", show id "B" "{b}", x }
}

emit go { package: "teamboard", out: "out/" }

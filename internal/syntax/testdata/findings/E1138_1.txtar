GRAMMAR.md §2.3: a quoted word that is not quotable is E1138 and reads as a bad expression.
-- a/a.canon --
package a

let a = `check`
let b = `plain`
let c = `none`
let d = `true`
let e = `_`
let f = `check` { r: 2 }
let g = [`check` { r: 2 }]

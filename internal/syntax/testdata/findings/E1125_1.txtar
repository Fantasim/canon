GRAMMAR.md §4.3: a reserved word names a declaration.
-- a/a.canon --
package a.match

import b as let

const if = 1
let for = 2
type while = Int
record in { type: Int }
enum not { A }
variant or { c }
widget as(value: Int)

fn is(match: Int) -> Int {
  let var = 1
  for none_, else in [] { }
  return 1
}

record S(return: Int) {
  fn true(self) -> Int { return 1 }
}

let f = [1].map(break => 1)

GRAMMAR.md §5.10, EVALUATION.md §10.5: a package subject's braces hold at least one `IDENT ":"
expr` substitution, its `{` is on the `package` line and it needs an outcome; each is E1116,
one per item. `package` right after `expect` is never a name. The E1117 at line 11 comes from
recovery: the `{ … } passes` left on the next line is read as a statement of its own.
-- a/a.canon --
package a

let levels: [Int] = [1]

test "broken package subjects" {
  expect package {} passes
  expect package
  expect package { levels: [2] }
  expect package { a.b: 1 } passes
  expect package
  { levels: [] } passes
  expect package.levels == [1]
}
-- findings.txt --

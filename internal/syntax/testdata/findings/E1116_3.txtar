  expected "{", "fails", "warns", "passes"; found NL

error[E1116]  a/a.canon:8:33
  expected "fails", "warns", "passes"; found NL

error[E1116]  a/a.canon:9:21
  expected ":"; found .

error[E1116]  a/a.canon:10:17
  expected "{", "fails", "warns", "passes"; found NL

error[E1117]  a/a.canon:11:18
  missing separator: put "," or a new line between items

error[E1116]  a/a.canon:12:17
  expected "{", "fails", "warns", "passes"; found .


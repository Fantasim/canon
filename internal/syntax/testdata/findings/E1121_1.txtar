GRAMMAR.md §6.7: a positional argument after a named one, or a name given twice.
-- a/a.canon --
package a

let a = f(x: 1, 2)
let b = f(x: 1, x: 2)
let c = load("f.json", at: "a", at: "b")

record R {
  d: Int @json(path: "p", "x")
  e: Int @json("a", "b")
}

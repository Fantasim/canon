TYPES.md §11.4: a dependent value is stored only where the same type function is expected.
-- a/a.canon --
package a

local enum K { num, text }

local record Ev {
  k: K
}

local type P(e: Ev) = match e.k {
  num => Int
  text => String
}

local type Q(e: Ev) = match e.k {
  num => Int
  text => String
}

local record R {
  ev: Ev
  p: P(ev)
  q: Q(ev)
}

local fn swap(r: R) -> R {
  return { ev: r.ev, p: r.q, q: r.q }
}

local fn keep(r: R) -> R {
  return { ev: r.ev, p: r.p, q: r.q }
}
-- findings.txt --
error[E3804]  a/a.canon:26:25
  a.P(*) is not available on a dependent value (Q(*))


DECISIONS 362, 339, CODEGEN.md §2.1: each name of a cpp or ts emit's `open` is a public enum the package declares (`open`): not a record, a local enum, an unknown name or another package's enum; an element that is no bare word is `kind`.
-- c/c.canon --
package c

import b { Far }

/// A thing.
record Thing {
  /// Its size.
  n: Int
}

local enum Hidden { x, y }

/// A destination.
enum Dst { str, sta }

emit cpp { out: "@sovcommon/c", mode: types, open: [Thing, Hidden, Missing, Far, "Dst", Dst] }
-- t/t.canon --
package t

import b { Far }

/// A thing.
record Thing {
  /// Its size.
  n: Int
}

local enum Hidden { x, y }

/// A destination.
enum Dst { str, sta }

emit ts { out: "@sovcommon/t.ts", mode: types, open: [Thing, Hidden, Missing, Far, "Dst", Dst] }
-- b/b.canon --
package b

/// Far away.
enum Far { one, two }

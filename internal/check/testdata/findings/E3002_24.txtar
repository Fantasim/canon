EVALUATION.md §10.5, DECISIONS 398, CHK-05: a value of a package subject is checked against its let's type: `[Item]` into a `table Item` let.
-- a/a.canon --
package a

record Item {
  weight: Int
}

let items: table Item = {
  one { weight: 1 }
}

test "mismatch" {
  expect package { items: [Item { weight: 2 }] } passes
}

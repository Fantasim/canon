CODEGEN.md §2.9, DECISIONS 294: @text on a let is E8021 position (it stands at a top-level declaration, so it is no E1118).
-- a/a.canon --
package a

/// Doc.
@text("v.sql")
let v: String = "SELECT 1;"

emit text { out: "@generated/sql" }

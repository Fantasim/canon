TYPES.md §9.1, DECISIONS 316: two lists keyed by refs to each other have no base key type: E3012 at each.
-- a/a.canon --
package a

local record A {
  b: ref bs
}

local record B {
  a: ref as1
}

local let as1: [A] keyed by b = []
local let bs: [B] keyed by a = []

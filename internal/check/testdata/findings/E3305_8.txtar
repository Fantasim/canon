TYPES.md §1, §5.1, §5.2, DECISIONS 364: the items of an undecided literal are checked against the error type, which hides only what depends on the missing expected type (a bare name that could be a member or a key, `none`, `[]`, a lambda, arithmetic of literals); every finding any expected type would give is still reported: an arity error, an unknown function, an unknown member, a typed literal's own field, an unknown name compared or in arithmetic, two literals compared. Under a declared type that does not resolve the same holds.
-- a/a.canon --
package a

local record R {
  a: Int
}

local fn f(x: Int) -> Int { return x }

local let r0: R = { a: 1 }

local let reported = {
  a: f(1, 2),
  b: nofn(1),
  c: r0.zz,
  d: R { a: "x" },
  e: nope == 1,
  g: 1 + nope,
  h: 2 * 3.5 + other,
  i: 1 == 2,
  j: [none != gone],
}

local let silent = { a: warning, b: none, c: [], d: x => 1, e: 1 + 2 }

local let declared: Nope = { k: lost < 1 }

local let bare: Nope = gone2 == 1

local let listed: [Nope] = [gone3 == 1]

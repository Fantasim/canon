TYPES.md §9.3, §15 (DECISIONS 465): `self.retired` in a table element's field default reads its entry, which a default cannot: E3010 entryKey.
-- a/a.canon --
package a

local record Ent {
  n: Int = 1
  gone: Bool = self.retired
}

local let ents: table Ent = {
  x {}
}

TYPES.md §7.1, CONFORMANCE.md §3, ADR-0023 §9.9: `%` is defined on integers only; on Float or Duration it is E3007, in a let and in a translated fn.
-- a/a.canon --
package a

local let f: Float = 5.5 % 2.0

local let d: Duration = 5s % 2s

local let i: Int = 5 % 2

export fn modF(a: Float, b: Float) -> Float { return a % b }

export fn modD(a: Duration, b: Duration) -> Duration { return a % b }

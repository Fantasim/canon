TYPES.md §2, §1, §10.2 (log-2026-09-29 "progen operators for view/i18n codes", E3401 at doubleOptional): a `ref X??` field is E3401 once the ref's target is found at the end of the package's step 2, whether X is inferred (`load.defines`) or annotated, alone or inside a list; a ref whose target resolves to nothing has only its own finding (one defect, one finding).
-- a/a.canon --
package a

local let texts = load.defines("@resource/defs.h", prefix: "TID_")

/// An item.
local record Item {
  /// Its key.
  id: String
}

local let items: [Item] keyed by id = []

/// A model.
local record Model {
  /// Its name text.
  nameText: ref texts?? = none
  /// Its item.
  item: ref items?? = none
  /// Its texts.
  more: [ref texts]?? = none
  /// Nothing.
  nope: ref nothing?? = none
  /// A count.
  n: Int?? = none
}

/// A tree node, ref to its own kind (level 1: Tree.nodes).
local record Node {
  /// Its parent.
  parent: ref Node?? = none
}

/// A tree of nodes.
local record Tree {
  /// Its nodes.
  nodes: table Node
}

/// A parameter typed as a doubly-optional ref.
local fn g(r: ref items??) -> Int {
  return 1
}

/// A parameter typed as a function whose own parameter is a doubly-optional ref.
local fn byRef(f: fn(ref items??) -> Int) -> Int {
  return 1
}

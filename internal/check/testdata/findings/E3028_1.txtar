TYPES.md §13.2, §1: there are no unions of types, only `A | "lit" | …`. Each alternative after the
first written as a type is E3028, naming that type (`Stage | String`, `String | Int`); a first
alternative without a string wire form is E3002 on its own, an independent mistake, so
`Int | String` is E3002 at `Int` and E3028 at `String`. An alternative holding the error type is not
judged again (`String | Strin` is E2102 only).
-- a/a.canon --
package a

local enum Stage { one, two }

local let u: Int | String = 3

local let v: Int | Bool | String = 3

local type W = String | Strin

local type X = Stage | String

local type Y = Int | "x" | Bool

local type Z = String | Int | "x"

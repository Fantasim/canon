TYPES.md §11.2: a type function's scrutinee rooted at no parameter (a let), through `?.`, or not a path, names the scrutinee.
-- a/a.canon --
package a

local enum K { num, text }

local record Ev {
  k: K
}

local let x: Ev = { k: num }

local type FromLet(e: Ev) = match x.k {
  _ => Int
}

local type Chained(e: Ev) = match e?.k {
  _ => Int
}

local type Called(e: Ev) = match e.k.name() {
  _ => Int
}

TYPES.md §1, §10.2, §13.2: a literal union met while its ref chain still resolves stays due, so its E3002 is still reported and the record holding it is still broken: `z`, a value of `H`, gets no finding of its own here (evaluation reports it as the W4001 of a broken record, as when no value met the union early).
-- a/a.canon --
package a

local record J {
  n: Int
}

local record C {
  b: ref J
}

local record D {
  c: ref cs
}

local record H {
  u: ref ds | "y"
}

local let cs: [C] keyed by b = [{ b: 1 }]

local let ds: [D] keyed by c = [{ c: 1 }]

local let x = [H { u: "X1" }]

local let js: [J] keyed by n = [{ n: 1 }]

local let z: H = { u: "q" }
-- findings.txt --
error[E3002]  a/a.canon:16:6
  expected String, found ref a.ds

error[E3008]  a/a.canon:23:11
  cannot infer the type of this expression; add a type

2 errors, 0 warnings in 1 package (…)

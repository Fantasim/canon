package a

local enum Q {
  a
  b
}

local record E {
  kind: Q
}

local record R {
  r: ref ens
  w: Int = 0
}

local record J {
  n: Int
}

local record K {
  j: ref js
}

local record H {
  rs: [R] keyed by r
}

local record T {
  w: Int = 0
}

local let ens: [E] keyed by kind = [{ kind: a }, { kind: b }]

local let rs: [R] keyed by r = [{ r: a }]

local let js: [J] keyed by n = [{ n: 9 }]

local let ks: [K] keyed by j = [{ j: 9 }]

local let hr: H = { rs: [{ r: a }] }

local let tab: table T = {
  y {}
}

local let oq: Q? = a

local let on: Int? = 9

local let ore: ref ens? = a

local let orj: ref js? = 9

local let ort: ref tab? = y

local let ojs: ref js? = 9

local let ors: ref rs? = a

local let ohr: ref hr.rs? = a

local let rhr: ref hr.rs = a

local let oneEnum: E = ens[oq]

local let oneInt: J = js[on]

local let chainEnum: R = rs[oq]

local let chainInt: K = ks[on]

local let ownRef: R = rs[ore]

local let ownIntRef: K = ks[orj]

local let ownTable: T = tab[ort]

local let ownInt: J = js[ojs]

local let ownChain: R = rs[ors]

local let ownHasKey: Bool = rs.hasKey(ors)

local let proved: Bool = ens[oq!] == ens[a] and rs[oq!] == rs[a] and rs[ors!] == rs[a]

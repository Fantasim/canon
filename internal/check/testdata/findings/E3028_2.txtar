TYPES.md §13.2: E3028 names the alternative's type: a list, an optional,
a refined String, an alias of String and a type function application, after a first alternative
that has a string wire form (a ref keyed by name, a dependent type).
-- a/a.canon --
package a

local enum K { name, off }

local type P(k: K) = match k {
  name => String
  off => Never
}

local record Row {
  v: Int
}

local let rows: table Row = {
  A { v: 1 }
}

local type Name = String

local type R1 = ref rows | [String]

local type R2 = String | String?

local type R3 = String | String(1..) | Name

local record D {
  k: K
  d: P(k) | "none" | P(k)
}

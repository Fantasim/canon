TYPES.md §11.1: a type function given too many arguments.
-- a/a.canon --
package a

local enum K { num, text }

local record Ev {
  k: K
}

local type P(e: Ev) = match e.k {
  num => Int
  text => String
}

local record R {
  ev: Ev
  p: P(ev, ev)
}
-- findings.txt --
error[E3806]  a/a.canon:16:7
  P takes 1 arguments of types a.Ev


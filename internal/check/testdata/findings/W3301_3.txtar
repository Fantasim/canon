TYPES.md §16, VIEWMODEL.md §3.5, G16 (log-2026-09-28 "check follow-ups 4 review"): a deprecated studio member used by `icon:` or `tone:`, bare or qualified by its enum (`Icon.gem`, resolved without an import), or by a view's `menu m icon i`, is W3301 at that use. A qualified name the studio's enum does not declare (`Icon.ruby`) is views' E1610, silent here.
-- studio/studio.canon --
package studio

/// Menus.
enum Menu {
  items
  old @deprecated("use items")
}

/// Icons.
enum Icon {
  gem
  gear @deprecated
}

/// Tones.
enum Tone {
  info
  warm @deprecated("use info")
}
-- a/a.canon --
package a

/// A cut.
local enum Cut { round, square, oval }

view Cut {
  round { icon: Icon.gem, tone: Tone.info }
  square { icon: Icon.gear, tone: Tone.warm }
  oval { icon: gear, tone: warm }
}

/// A gem.
local record Gem {
  /// Its cut.
  cut: Cut
}

view Gem {
  menu old icon gear
  cut { help: "The cut." }
}

/// A shape.
local enum Shape { flat }

view Shape {
  flat { icon: Icon.ruby, tone: Tone.cold }
}

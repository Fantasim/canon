TYPES.md §3.3, §4.1, DECISIONS 318, 493: against a `ref C` whose keys are known statically, step 1 comes first; when it finds no entry, steps 2 to 6 find the name, and a name in scope that is not a value of the ref is E3027, as with dynamic keys: `{ t: z }`, `ref tab = z` and `ref tab = s` (`value`), `ref tab = pick` (`notValue`). A table's key is a String, so the message says to write the key as a string. Where the ref's key, read at its leaf, is an integer, a name that is not a value gets the typed form (`notValueTyped`), at one level (`ref js = pick`, `{ j: pick }`) and through a chain (`ref ks = pick`). Only a literal is a key in a ref position, so a value there that is no ref gets the literal form (`valueRefLiteral`): `ref js = q`, `ref js = n`, `{ j: n }`, `ref ks = bo`; a literal (`ref js = 9`) is the key.
-- a/a.canon --
package a

local enum Q {
  a
  b
}

local record J {
  n: Int
}

local record K {
  j: ref js
}

local record T {
  w: Int = 0
}

local record U {
  t: ref tab
}

local let js: [J] keyed by n = [{ n: 9 }]

local let ks: [K] keyed by j = [{ j: 9 }]

local let tab: table T = {
  y {}
}

local let z: Int = 1

local let s: String = "y"

local let q: Q = a

fn pick() -> Q {
  return Q.a
}

local let fieldValue: U = { t: z }

local let refValue: ref tab = z

local let refString: ref tab = s

local let refNotValue: ref tab = pick

local let named: U = { t: y }

local let intNotValue: ref js = pick

local let intField: K = { j: pick }

local let chainNotValue: ref ks = pick

local let bo: Bool = true

local let n: Int = 9

local let intEnum: ref js = q

local let intValue: ref js = n

local let intFieldValue: K = { j: n }

local let chainValue: ref ks = bo

local let intLiteral: ref js = 9

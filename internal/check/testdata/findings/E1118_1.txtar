GRAMMAR.md §8.3, DECISIONS 279(a): `@ts(bigint)` stands on a field with an integer position outside a ref (the integer, list elements, map keys and values, optional contents); on a field whose integers are all refs' keys, or that holds no integer, it is E1118. The accepted fields below hold an integer, an optional one, a list of them, a map key and a map value beside a ref.
-- a/a.canon --
package a

local record K {
  n: Int @ts(bigint)
  o: Int? = none @ts(bigint)
  l: [UInt64] = [] @ts(bigint)
  k: {Int: String} = {} @ts(bigint)
  v: {ref ks: Int} = {} @ts(bigint)
}

local let ks: [K] keyed by n = [ { n: 1 } ]

local record H {
  r: ref ks @ts(bigint)
  rs: [ref ks] = [] @ts(bigint)
  s: String = "" @ts(bigint)
  m: {ref ks: String} = {} @ts(bigint)
  inner: K? = none @ts(bigint, name: "inside")
}

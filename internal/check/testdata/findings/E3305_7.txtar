TYPES.md §5.2, §1: each undecided literal that is its own root reports its own E3305 (two list elements; a literal led by a spread of a non-record, its nested `{}` silent); a literal led by a spread that is already an error reports nothing more. An undecided literal's items are checked against the error type, so a bare name in them may be a contextual name of the missing type and is not judged (§4.1).
-- a/a.canon --
package a

local fn xs() -> [Int] { return [1] }

local let two = [{ a: 1 }, { b: {} }]

local let named = { e: warning }

local fn f() -> Int {
  let r = { ...xs(), c: {} }
  let s = { ...nope, d: {} }
  return 1
}

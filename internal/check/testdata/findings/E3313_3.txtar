-- a/a.canon --
package a

local record Mode {
  secret: input String from env "SECRET"
  on: input Bool from env "ON"
  label: String
}

/// The mode.
let mode: Mode = { label: "x" }

view Mode {
  title "{label} {secret}"
  search { secret }
  show "Secret" "{secret.len()}"
  label { when: on }
}

WIRE.md §4.2, DECISIONS 405: nul on a plain enum's wire, an @codes enum's @json, a variant's tag: and a case's wire.
-- a/a.canon --
package a

local enum E { a = "x\u{0}", b }

local enum C @codes(Int32) { a = 1 @json("y\u{0}"), b = 2 }


local variant V @json(tag: "t\u{0}") {
  one @json("c\u{0}") { n: Int }
}

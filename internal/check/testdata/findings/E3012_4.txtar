TYPES.md §9.1, DECISIONS 316: a list keyed by a ref to itself has no base key type: E3012; so has a local list keyed by a ref to it (judged after resolution), whose chain of keys never ends either.
-- a/a.canon --
package a

local record N {
  p: ref ns
}

local let ns: [N] keyed by p = []

local fn f() -> Int {
  let local1: [N] keyed by p = []
  return local1.len()
}

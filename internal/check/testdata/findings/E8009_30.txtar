DECISIONS 362, 339, CODEGEN.md §2.1: `open` of a cpp or ts emit needs mode types; the default mode baked and a written data mode are refused (`openMode`), naming the emit's target.
-- c/c.canon --
package c

/// A destination.
enum Dst { str, sta }

emit cpp { out: "@sovcommon/c", open: [Dst] }
-- d/d.canon --
package d

/// A destination.
enum Dst { str, sta }

emit cpp { out: "@sovcommon/d", mode: data, open: [Dst] }
-- t/t.canon --
package t

/// A destination.
enum Dst { str, sta }

emit ts { out: "@sovcommon/t.ts", open: [Dst] }
-- u/u.canon --
package u

/// A destination.
enum Dst { str, sta }

emit ts { out: "@sovcommon/u.ts", mode: embedded, open: [Dst] }

TYPES.md §11.1: a field's type may not use the field itself.
-- a/a.canon --
package a

local enum K { num, text }

local record Ev {
  k: K
}

local type P(e: Ev) = match e.k {
  num => Int
  text => String
}

local record R {
  ev: Ev
  own: P(own)
}

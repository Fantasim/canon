STDLIB.md §5, TYPES.md §4.1, DECISIONS 317, 456: on a keyed list keyed by a ref, a literal of the chain's leaf key is a key, so on the left of `in`, contains or indexOf it is E3026 (whose message names hasKey), as it is on a list keyed by its leaf type: through `ks` (keyed by `ref js`, `js` keyed by an Int; 1 level), `ls` (keyed by `ref ks`; 2 levels), `ts` (a String leaf, keyed by `ref ss`), `us` (keyed by `ref ts`, 2 levels) and `ps` (a table leaf).
-- a/a.canon --
package a

local record J {
  n: Int
}

local record K {
  j: ref js
}

local record L {
  k: ref ks
}

local record S {
  s: String
}

local record T {
  r: ref ss
}

local record U {
  t: ref ts
  w: Int = 0
}

local record E {
  w: Int = 0
}

local record P {
  e: ref tab
}

local let js: [J] keyed by n = [{ n: 9 }]

local let ks: [K] keyed by j = [{ j: 9 }]

local let ls: [L] keyed by k = [{ k: 9 }]

local let ss: [S] keyed by s = [{ s: "x" }]

local let ts: [T] keyed by r = [{ r: "x" }]

local let us: [U] keyed by t = [{ t: "x" }]

local let tab: table E = {
  p {}
}

local let ps: [P] keyed by e = [{ e: p }]

local let one: Bool = 9 in ks or ks.contains(9) or ks.indexOf(9) != none

local let two: Bool = 9 in ls or ls.contains(9)

local let str: Bool = "x" in ts

local let tbl: Bool = "p" in ps

local let strTwo: Bool = "x" in us or us.contains("x")

TYPES.md §13.2: the alternatives after the first are string literals, the first has a string wire form, `Never | "default"` accepts only "default", and a union compares only with its literals and its alternative.
-- a/a.canon --
package a

local enum Stage { one, two }

local type NotLiteral = Stage | Stage
local type NoWire = Int | "x"
local type OnlyDefault = Never | "default"
local type Key = Stage | "default"

local let fine: OnlyDefault = "default"
local let other: OnlyDefault = "other"

local fn same(k: Key) -> Bool {
  return k == "default" and k == one and k != "other"
}

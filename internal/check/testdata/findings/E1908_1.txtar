EVALUATION.md §9.2: one layer sets a path twice.
-- a/a.canon --
package a

local record Cfg {
  port: Int
}

local let cfg: Cfg = { port: 1 }
-- a/dev.layer.canon --
package a
layer dev

amend cfg {
  port: 2
  port: 3
}
-- findings.txt --
error[E1908]  a/dev.layer.canon:6:3
  amend path port is set twice in layer dev

1 error, 0 warnings in 1 package (…)

TYPES.md §11.1, DECISIONS 307: each type argument is checked against its parameter's type: a field of another type is E3806, and so is an optional one given to a parameterized record; given to a type function an optional is accepted (its none computes Never); a ref to an entry of the parameter's type dereferences.
-- a/a.canon --
package a

local enum K { num, text }

local record Ev {
  k: K
}

local type P(e: Ev) = match e.k {
  num => Int
  text => String
}

local record H(e: Ev) {
  n: Int = 0
}

local record Item {
  ev: Ev
}

local let evs: table Ev = {
  one { k: num }
}

local record R {
  ev: Ev
  maybe: Ev? = none
  item: Item
  byRef: ref evs
  wrong: P(item)
  optional: P(maybe)
  held: H(maybe)
  deref: P(byRef)
}
-- findings.txt --
error[E3806]  a/a.canon:31:12
  P takes 1 arguments of types a.Ev

error[E3806]  a/a.canon:33:11
  H takes 1 arguments of types a.Ev

2 errors, 0 warnings in 1 package (…)

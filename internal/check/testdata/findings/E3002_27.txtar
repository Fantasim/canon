TYPES.md §3.5, EVALUATION.md §9.2, DECISIONS 456: an amend path's `.k` segment on a keyed list whose key is a ref with a String leaf (`ts`, keyed by `ref ss`) or a table leaf (`ps`, keyed by `ref tab`) is the entry with key `k`, as `xs.k` is in an expression, so the value at `.k.w` is checked against the entry's field type: E3002 for a String where an Int is expected, never E1905.
-- a/a.canon --
package a

local record S {
  s: String
}

local record T {
  r: ref ss
  w: Int = 0
}

local record E {
  w: Int = 0
}

local record P {
  e: ref tab
  w: Int = 0
}

local let ss: [S] keyed by s = [{ s: "x" }]

local let ts: [T] keyed by r = [{ r: "x", w: 7 }]

local let tab: table E = {
  p {}
}

local let ps: [P] keyed by e = [{ e: p, w: 9 }]
-- a/dev.layer.canon --
package a
layer dev

amend ts {
  x.w: "no"
}

amend ps {
  p.w: "no"
}
-- findings.txt --
error[E3002]  a/dev.layer.canon:5:8
  expected Int, found String

error[E3002]  a/dev.layer.canon:9:8
  expected Int, found String

2 errors, 0 warnings in 1 package (…)

error[E3201]  a/dev.layer.canon:6:12
  256 does not fit UInt8
  expected by a/a.canon:14 (ids: [UInt8])

error[E3201]  a/dev.layer.canon:7:6
  1000 does not fit UInt8
  expected by a/a.canon:4 (b: UInt8)

error[E3201]  a/dev.layer.canon:8:15
  257 does not fit UInt8
  expected by a/a.canon:9 (size: UInt8)


API.md §4.4 F12, ERRORS.md §1.5 (`source`), EVALUATION.md §9.2, TYPES.md §7.2: an amendment's literal value names the field declaration at its path, whose type it was checked against (a case's field on a variant); an element of a list field names the list field; a literal key of a keyed list on the path names its `keyed by` field.
-- a/a.canon --
package a

local record B {
  b: UInt8
  v: Int
}

local variant Shape {
  dot { size: UInt8 }
}

local record Cfg {
  port: UInt8
  ids: [UInt8]
  bs: [B] keyed by b
  shape: Shape
}

local let cfg: Cfg = { port: 1, ids: [1], bs: [{ b: 1, v: 1 }], shape: dot { size: 1 } }
-- a/dev.layer.canon --
package a
layer dev

amend cfg {
  port: 300
  ids[#0]: 256
  bs[1000].v: 2
  shape.size: 257
}
-- findings.txt --

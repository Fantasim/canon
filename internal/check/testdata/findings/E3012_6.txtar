TYPES.md §9.1, DECISIONS 316: a cycle of three lists keyed by refs has no base key type: E3012 at each, and at a list keyed by a ref into the cycle, whose target's key never reaches a base type either.
-- a/a.canon --
package a

local record A {
  b: ref bs
}

local record B {
  c: ref cs
}

local record C {
  a: ref as1
}

local record D {
  a: ref as1
}

local let as1: [A] keyed by b = []
local let bs: [B] keyed by c = []
local let cs: [C] keyed by a = []
local let ds: [D] keyed by a = []

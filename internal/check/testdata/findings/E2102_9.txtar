TYPES.md §1, §5.2 (log-2026-09-28 "progen triage"): a typed literal `Name { … }` checked against the error type is silent, whatever `Name` would name (a case, a record, nothing) and whatever it holds: the only finding is the one that made the type an error.
-- a/a.canon --
package a

local record Big {
  n: Int
}

local variant V {
  big { n: Int }
}

local let u: Nope = big { n: 1, s: [{ a: X }] }

local let w: Nope2 = Big { n: 1 }

local let x: [Nope3] = [Nope4 { n: 1 }]

local record Holder {
  k: Nope5
}

local let h: Holder = { k: big { s: [{ a: X }] } }

local let t: table Nope6 = {
  a { kind: big { s: [{ a: X }] } }
}

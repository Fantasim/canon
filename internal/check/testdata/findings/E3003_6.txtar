TYPES.md §11.4, §8.1, DECISIONS 306: `.code` on a dependent value whose branches are all enums needs `@codes` on every branch: E3003 otherwise (not E3804).
-- a/a.canon --
package a

local enum K { a, b }

local enum Coded @codes(UInt8) { x = 1, y = 2 }

local enum Plain { x, y }

local type F(k: K) = match k {
  a => Coded
  b => Plain
}

local record Row {
  k: K
  f: F(k)
}

local fn code(r: Row) -> Int {
  return r.f.code
}
-- findings.txt --
error[E3003]  a/a.canon:20:14
  a.F(*) has no member code


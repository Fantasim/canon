TYPES.md §3.7: a public record's field types and its methods' parameters and results may not name a local record, variant, enum or alias, by value or nested in a list, map, optional or table; E2111 at each type expression naming one.
-- a/a.canon --
package a

local record Stone {
  n: Int
}

local enum Cut { round, square }

local type Weight = Int

/// A gem.
record Gem {
  /// Its stone.
  stone: Stone
  /// Its cuts.
  cuts: [Cut]?
  /// Its weights.
  weights: {String: Weight}
  /// Its stones.
  stones: table Stone

  /// Whether it has cut c.
  fn has(self, c: Cut) -> Stone? { return none }
}

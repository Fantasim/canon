TYPES.md §4.1, §9.1, STDLIB.md §5, EVALUATION.md §9.2, DECISIONS 318, 490: a key of an integer type has no string form, so a name in scope that is not a value of it is E3027 whose message says to write a key of that type, never a string: at one level (`js[q]`, `js[pick]`, `js.hasKey(q)`, keyed by Int) and through a chain read at its leaf (`ks[q]`, `ks[Q]`, keyed by `ref js`), in an expression and an amend path alike. A String or table key keeps the string hint (`tab[n]`), an enum key the member hint (`ens[n]`).
-- a/a.canon --
package a

local enum Q {
  a
  b
}

local record E {
  kind: Q
}

local record J {
  n: Int
}

local record K {
  j: ref js
  w: Int = 0
}

local record M {
  ks: [K] keyed by j
}

local record T {
  w: Int = 0
}

local let ens: [E] keyed by kind = [{ kind: a }, { kind: b }]

local let js: [J] keyed by n = [{ n: 9 }]

local let ks: [K] keyed by j = [{ j: 9 }]

local let mk: M = { ks: [{ j: 9 }] }

local let tab: table T = {
  y {}
}

local let q: Q = a

local let n: Int = 9

fn pick() -> Q {
  return Q.a
}

local let oneValue: J = js[q]

local let oneNotValue: J = js[pick]

local let oneHasKey: Bool = js.hasKey(q)

local let chainValue: K = ks[q]

local let chainNotValue: K = ks[Q]

local let tableValue: T = tab[n]

local let enumValue: E = ens[n]
-- a/dev.layer.canon --
package a
layer dev

amend mk {
  ks[q].w: 1
}

amend mk {
  ks[pick].w: 2
}

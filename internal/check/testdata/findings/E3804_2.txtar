TYPES.md §11.4: arithmetic on a dependent value.
-- a/a.canon --
package a

local enum K { num, text }

local record Ev {
  k: K
}

local type P(e: Ev) = match e.k {
  num => Int
  text => String
}

local record R {
  ev: Ev
  p: P(ev)

  check p + 1 > 0 else "negative"
}
-- findings.txt --
error[E3804]  a/a.canon:18:9
  + is not available on a dependent value (P(*))


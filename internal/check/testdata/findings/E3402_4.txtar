TYPES.md §6.6, §6.5: facts of a var assigned in a loop body are killed at its start, so arithmetic on it is on an optional.
-- a/a.canon --
package a

local fn f(start: Int?, xs: [Int?]) -> Int {
  var at = start
  if at == none {
    return 0
  }
  var n = 0
  for x in xs {
    n += at
    at = x
  }
  return n
}

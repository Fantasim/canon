TYPES.md §7.5, DECISIONS 493: an operand of `==` or `!=` checked against the other operand's ref type is no key position, so a value that is no ref compared with a ref is E3002 in either order, with static keys (`ref tab`) and dynamic keys (`ref js`) alike.
-- a/a.canon --
package a

local enum Q {
  a
  b
}

local record J {
  n: Int
}

local record T {
  w: Int = 0
}

local let js: [J] keyed by n = [{ n: 9 }]

local let tab: table T = {
  y {}
}

local let q: Q = a

local let s: String = "y"

local let ri: ref tab = y

local let rj: ref js = 9

local let static: Bool = ri == q or q == ri or ri != s or s != ri

local let dynamic: Bool = rj == q or q == rj or rj != s or s != rj
-- findings.txt --

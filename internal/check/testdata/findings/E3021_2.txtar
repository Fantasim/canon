TYPES.md §13.1, §11.2: a type function reaching itself through a union alternative with no record on the way is E3021, and it is broken: its uses (`==`, an out-of-union literal) report nothing more.
-- a/a.canon --
package a

local enum K { num, text }

local record Ev {
  k: K
}

local type SK(e: Ev) = SK(e) | "x"

local record R {
  ev: Ev
  s: SK(ev) = "x"
  t: SK(ev) = "zz"
  u: SK(ev) = 3
}

local fn same(r: R, q: R) -> Bool {
  return r.s == q.s and r.s == "x"
}
-- findings.txt --
error[E3021]  a/a.canon:9:12
  type alias SK refers to itself

1 error, 0 warnings in 1 package (…)

DECISIONS 362, 339, CODEGEN.md §2.1: an empty `open` of a cpp or ts emit is refused (`openEmpty`); a value that is no list is `kind`.
-- c/c.canon --
package c

/// A destination.
enum Dst { str, sta }

emit cpp { out: "@sovcommon/c", mode: types, open: [] }
-- d/d.canon --
package d

/// A destination.
enum Dst { str, sta }

emit cpp { out: "@sovcommon/d", mode: types, open: Dst }
-- t/t.canon --
package t

/// A destination.
enum Dst { str, sta }

emit ts { out: "@sovcommon/t.ts", mode: types, open: [] }
-- u/u.canon --
package u

/// A destination.
enum Dst { str, sta }

emit ts { out: "@sovcommon/u.ts", mode: types, open: Dst }

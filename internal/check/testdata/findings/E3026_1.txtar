STDLIB.md §5, TYPES.md §5.1 (`x in xs`), DECISIONS 317: `in`, contains and indexOf on a keyed list or a table take an element only; a key there (a literal or value of the key type, a bare name no scope has, a static entry name) is E3026, whose message names hasKey. A value of neither type stays E3002. A bare name no scope has on a collection with no name of its own (a parameter) is E3026 alone, never E2102 too; on an implicit receiver (`.contains(k)`) E3026 takes its implicit form.
-- a/a.canon --
package a

local record Row {
  id: Int
  name: String
}

local let rows: [Row] keyed by id = [{ id: 1, name: "one" }]

local record Flag {
  label: String
}

local let flags: table Flag = {
  blocking { label: "b" }
}

local fn listKeys(n: Int) -> Bool {
  return 1 in rows or n in rows or rows.contains(n) or rows.indexOf(1) != none
}

local fn tableKeys(s: String) -> Bool {
  return blocking in flags or s in flags or flags.contains("blocking") or flags.indexOf(sensitive) != none
}

local fn neither(b: Bool) -> Bool {
  return b in rows
}

local fn onParameter(xs: [Flag] keyed by label) -> Bool {
  return wolf in xs
}

local fn implicit(ls: [[Row] keyed by id]) -> [[Row] keyed by id] {
  return ls.filter(.contains(1))
}

CODEGEN.md §2.9, DECISIONS 300: a @text fn is a file, not API: a call from another declaration, of its package or another, is E8021 called; the @text fn itself is fine.
-- a/a.canon --
package a

/// Doc.
@text("v.sql")
export fn v() -> String { return "SELECT 1;" }

/// Twice.
export fn twice() -> String { return v() + v() }

emit text { out: "@generated/sql" }

DECISIONS 428, GRAMMAR.md §5.10, TYPES.md §12.7: an assignment target that is no name, possibly indexed (a literal, a call, a parenthesized var, an indexed literal), is E3017 `target` at the target; a target the parser refused (a recovery node), indexed or not, reports nothing more (TYPES.md §1). A var and an element of one stay assignable.
-- a/a.canon --
package a

local fn lit(n: Int) -> Int {
  var i = n
  1 = 0
  return i
}

local fn call(n: Int) -> Int {
  var i = n
  lit(1) = 0
  return i
}

local fn paren(n: Int) -> Int {
  var i = n
  (i) = 0
  return i
}

local fn indexed(n: Int) -> Int {
  var xs = [n]
  [1][0] = 0
  xs[0] = n
  return xs[0]
}

local fn bad(n: Int) -> Int {
  var i = n
  `foo` = 0
  #[0] = 1
  return i
}

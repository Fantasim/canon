TYPES.md §6.5: parentheses end a chain, so `(w?.item).id` reads a field of an optional.
-- a/a.canon --
package a

local record Item {
  code: String
}

local record Weapon {
  item: Item
}

local fn f(w: Weapon?) -> String {
  return (w?.item).code
}

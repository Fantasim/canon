TYPES.md §12.1, §3.2, §3.6: a method written twice in a variant body outside any case is E2106 once, at the refused duplicate, as in a record; only the method kept is judged against the cases' names (a case method of its name is E2106, `kind` is E2105).
-- a/a.canon --
package a

local variant Reward {
  item {
    count: Int

    fn label(self) -> String { return "item" }
  }

  fn label(self) -> String { return "a" }

  fn label(self) -> String { return "b" }

  fn kind(self) -> Int { return 1 }

  fn kind(self) -> Int { return 2 }
}

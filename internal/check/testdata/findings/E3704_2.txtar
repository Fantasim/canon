TYPES.md §13.4 (DECISIONS 330): an asset root is a string literal without interpolation, so the
directories a package lists are known from its sources; a raw string is one.
-- a/a.canon --
package a

const DIR = "Icon"

local type Interpolated = asset("{DIR}/Item", ext: [dds])
local type Raw = asset(r"Icon/Item", ext: [dds])

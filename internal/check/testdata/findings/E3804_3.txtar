TYPES.md §11.4: a dependent value passed where another type is expected.
-- a/a.canon --
package a

local enum K { num, text }

local record Ev {
  k: K
}

local type P(e: Ev) = match e.k {
  num => Int
  text => String
}

local fn twice(n: Int) -> Int { return n * 2 }

local record R {
  ev: Ev
  p: P(ev)

  check twice(p) > 0 else "negative"
}
-- findings.txt --
error[E3804]  a/a.canon:20:15
  Int is not available on a dependent value (P(*))


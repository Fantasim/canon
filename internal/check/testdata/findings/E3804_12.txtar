TYPES.md §4.3, STDLIB.md §3, DECISIONS 372: `F(a…).named(s)` and `F(a…).named` are E3804: name the enum.
-- a/a.canon --
package a

local enum Kind { coin, gem }

local enum Coin { copper, silver }

local record Ev {
  kind: Kind
}

local type F(e: Ev) = match e.kind {
  coin => Coin
  _ => Kind
}

local let called = F(Ev { kind: coin }).named("copper")
local let bare = F(Ev { kind: coin }).named

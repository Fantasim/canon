WIRE.md §4.2, DECISIONS 405: a wire name written in source holds no U+0000: a field's @json("w"), a path: segment and a pairs: template are E3316 nul.
-- a/a.canon --
package a

local record P {
  k: String
  v: Int
}

local record R {
  a: Int = 0 @json("x\u{0}y")
  b: Int = 0 @json(path: "p.q\u{0}")
  c: [P](..=2) = [] @json(pairs: ["k{i}\u{0}", "v{i}"])
}

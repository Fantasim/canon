TYPES.md §12.6, §1: a binding E3603 refuses (on an enum member, in an arm of several patterns, in a statement match) has the error type; its uses report nothing more.
-- a/a.canon --
package a

local enum E { p, q }

local variant V {
  one {
    n: Int = 0
  }
  two
}

local fn f(e: E) -> Int {
  return match e {
    p(x) => x.n
    q => 0
  }
}

local fn g(v: V) -> Int {
  return match v {
    one(x), two(x) => x.n
  }
}

local fn h(v: V) -> Int {
  var r = 0
  match v {
    one(x) => { r = x.n }
    two => { r = 1 }
    nope(z) => { r = z.n }
  }
  return r
}

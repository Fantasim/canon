TYPES.md §3.3, §5.1, §1, DECISIONS 333: an unknown name compared with a literal is E2102, not E3008, in every position that checks such a comparison: a refinement predicate of a let and of a field (`where weigth > 0`; `it.weigth` is E3003, §3.5), a field default (`weigth < 5`, and `weigth + 1` against `Int`), a function body (with the parameter as the hint), and a view's template, show line and `when:` (VIEWMODEL.md §3.4).
-- a/a.canon --
package a

local let x: Int where weigth > 0 = 3
local let y: Int where it.weigth > 0 = 3

local record Pos {
  weight: Int where weigth > 0
  sum: Int = weigth + 1
  light: Bool = weigth < 5
}

local fn heavy(weight: Int) -> Bool {
  return weigth > 5
}

local record Box {
  weight: Int
}

view Box {
  title "{weigth}"
  show "Light" "{weigth < 5}"
  weight "Weight" { when: weigth < 5 }
}

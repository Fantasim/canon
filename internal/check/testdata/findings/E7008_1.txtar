WIRE.md §6.1 E7008 (DECISIONS 330): the path of every load form is a string literal without
interpolation, raw or not; an interpolation, a name, an operation or a missing path is refused.
-- a/a.canon --
package a

const DIR = "data"
const NAME = "data/x.txt"

local let interpolated: String = load.text("{DIR}/x.txt")
local let named: String = load.text(NAME)
local let missing: String = load.text()
local let joined: String = load.text("data/" + "x.txt")
local let dir: [String] = load.dir("{DIR}/*.json")
local let raw: String = load.text(r"data/x.txt")
local let plain: String = load.text("data/x.txt")

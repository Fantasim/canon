CODEGEN.md §2.9, DECISIONS 336: a `@text` result of `String?` through an alias or a refinement is well placed too; only the fn with a parameter, whose result is such an optional, is E8021 position.
-- a/a.canon --
package a

/// Maybe SQL.
type MaybeSql = String?

/// Doc.
@text("v.sql")
export fn v() -> MaybeSql { return "x" }

/// Doc.
@text("w.sql")
export fn w() -> String(1..)? { return "x" }

/// Doc.
@text("z.sql")
export fn z(n: Int) -> MaybeSql { return "x" }

emit text { out: "@generated/sql" }

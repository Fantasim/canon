TYPES.md §13.1, §11.5: a type function reaching itself through a dependent map's value, no record on the way, is E3021 and broken; its uses report nothing more.
-- a/a.canon --
package a

local enum K { num, text }

local record Ev {
  k: K
}

local let evs: table Ev = {
  one { k: num }
}

local type F(e: Ev) = match e.k {
  num => {k in evs: F(k)}
  text => String
}

local record R {
  ev: Ev
  f: F(ev) = "zz"
}

local fn same(r: R, q: R) -> Bool {
  return r.f == q.f
}
-- findings.txt --
error[E3021]  a/a.canon:13:12
  type alias F refers to itself


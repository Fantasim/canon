TYPES.md §4.3, §11.1, DECISIONS 306, 307: the arguments of `F(a…).members` and `F(a…).typeName` are ordinary expressions checked against F's parameters: a wrong count, a wrong type, an optional (refused in value position) or a named argument is E3806.
-- a/a.canon --
package a

local enum K { a, b }

local enum E { x, y }

local type F(k: K) = match k {
  a => E
  b => K
}

local fn maybe() -> K? {
  return none
}

local let none0 = F().members
local let two = F(a, b).members
local let wrong: String = F(1).typeName
local let optional = F(maybe()).members
local let named = F(k: a).members

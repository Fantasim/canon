STDLIB.md §6, DECISIONS 338: map union takes a map of the receiver's key and value types, else E3002, as the list union (§4.2) does for a wrong argument.
-- a/a.canon --
package a

local let m: {String: Int} = { "a": 1 }

local let names: {String: String} = { "a": "x" }

local let byInt: {Int: Int} = { 1: 1 }

local let xs: [Int] = [1]

local let words: [String] = ["x"]

local let badValue: {String: Int} = m.union(names)

local let badKey: {String: Int} = m.union(byInt)

local let notMap: {String: Int} = m.union(xs)

local let listBad: [Int] = xs.union(words)

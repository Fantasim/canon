TYPES.md §11.2: a result refinement of a type function may not use its parameters (a range bound, a where predicate).
-- a/a.canon --
package a

local record Ev {
  max: Int
}

local type F(e: Ev) = Int(..e.max)
local type G(e: Ev) = Int where it < e.max

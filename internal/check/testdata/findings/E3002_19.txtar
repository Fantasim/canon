STDLIB.md §5, DECISIONS 317: a key (hasKey, get, find, `xs[k]`) is a value of the key type, or a ref T into this same collection; a ref into another collection of the same element type is E3002, never compared by its key text.
-- a/a.canon --
package a

local record M {
  hp: Int
}

local let ms: table M = {
  wolf { hp: 1 }
}

local let others: table M = {
  wolf { hp: 2 }
}

local record S {
  name: String
}

local record Z {
  spawns: [S] keyed by name
}

local let z: Z = { spawns: [{ name: "a" }] }

local let y: Z = { spawns: [{ name: "a" }] }

local fn keys(o: ref others, w: ref y.spawns) -> Bool {
  return ms.hasKey(o) or ms.get(o) != none or ms.find(o) != none or ms[o].hp > 0 or z.spawns.hasKey(w)
}

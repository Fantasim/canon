TYPES.md §12.6: a pattern that is not a member of the scrutinee.
-- a/a.canon --
package a

local enum E { a, b }

local fn f(e: E) -> Int {
  return match e {
    a => 1
    b => 2
    c => 3
  }
}
-- findings.txt --
error[E3603]  a/a.canon:9:5
  c is not a member of a.E


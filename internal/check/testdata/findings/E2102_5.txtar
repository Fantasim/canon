TYPES.md §1: a name found nowhere is E2102 and the error type; inside a list, map or optional (`[invalid]`) it is a wildcard (§6.2), so storing, returning, passing, joining or calling a method on such a value reports nothing more (no E3002); the values of a map comprehension over it (`[invalid]`) flatten to the error type (progen nightly, E2102 "unknown name": no `expected [[invalid]], found [invalid]`). The error type is a wildcard only where it stands: an independent mismatch around it is still E3002 (`[invalid]` where an `Int` is expected, `5` where `[invalid]` is, a list where a map is).
-- a/a.canon --
package a

local fn one(xs: [Int]) -> Int {
  return xs.len()
}

local fn f() -> [Int] {
  let xs = [nope]
  let m = { "a": nope }
  let o = if true { nope } else { none }
  let ys: [Int] = xs
  let n: {String: Int} = m
  let p: Int? = o
  let q = one(xs) + one([nope])
  let r = if true { xs } else { [1] }
  let s: [String] = xs.map(x => x)
  let t = xs.contains(1) and [nope].contains("a")
  let u = xs.sum() + max(xs.len(), 1)
  let v: [Int] = xs + [1]
  let byName = { k: w.ids for k, w in nope }
  let flat: [Int] = byName.values().flatten().unique()
  return xs
}

local fn g(xs: [Nope]) -> Int {
  let o: Int = xs
  return xs
}


TYPES.md §6.6: an assignment kills the facts of a var, the right side checked first.
-- a/a.canon --
package a

local fn f(start: Int?, next: Int?) -> Int {
  var at = start
  if at != none {
    at = next
    return at
  }
  return 0
}

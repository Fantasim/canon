TYPES.md §5.1 (index `xs[i]`; context-dependent operands), §4.1: an index is checked against its expected type, and arithmetic of context-dependent operands checked against a type other than Int, Float or a list is E3008: a String key (`ss[1 + 1]`) and a ref key (`ks[1 + 9]`, keyed by `ref js`; only a literal is a key of it, §4.1).
-- a/a.canon --
package a

local record S {
  s: String
}

local record J {
  n: Int
}

local record K {
  j: ref js
}

local let ss: [S] keyed by s = [{ s: "x" }]

local let js: [J] keyed by n = [{ n: 9 }]

local let ks: [K] keyed by j = [{ j: 9 }]

local let str: S = ss[1 + 1]

local let byRef: K = ks[1 + 9]

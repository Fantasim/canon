TYPES.md §5.1 (index `xs[i]`; context-dependent operands), §4.1, DECISIONS 456: an index is checked against its expected type, and arithmetic of context-dependent operands checked against a type other than Int, Float or a list is E3008: a String key (`ss[1 + 1]`). A list keyed by a ref is checked against its chain's leaf, as one level is, so `ks[1 + 9]` (keyed by `ref js`, an Int leaf) is no finding, as `js[1 + 9]` is not.
-- a/a.canon --
package a

local record S {
  s: String
}

local record J {
  n: Int
}

local record K {
  j: ref js
}

local let ss: [S] keyed by s = [{ s: "x" }]

local let js: [J] keyed by n = [{ n: 9 }]

local let ks: [K] keyed by j = [{ j: 9 }]

local let str: S = ss[1 + 1]

local let byRef: K = ks[1 + 9]
-- findings.txt --
error[E3008]  a/a.canon:21:23
  cannot infer the type of this expression; add a type

1 error, 0 warnings in 1 package (…)

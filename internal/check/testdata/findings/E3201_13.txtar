API.md §4.4 F12, ERRORS.md §1.5 (`source`), TYPES.md §6.2, §7.2, §12.7: in a block, a typed `let` or `var` names its own declaration, an assignment names the var's, and a returned value names the fn's result type, as evaluation names them.
-- a/a.canon --
package a

local fn f(n: Int) -> UInt8 {
  let y: UInt8 = 300
  var z: UInt8 = 301
  z = 302
  let w = 1
  if n > w {
    return 303
  }
  return y + z
}

local let r: UInt8 = f(1)

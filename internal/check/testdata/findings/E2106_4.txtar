TYPES.md §12.1, §3.2: a case method named like a method written in the variant body outside any case is E2106, at the later of the two declarations (no override), whichever comes first in the source.
-- a/a.canon --
package a

local variant Reward {
  item {
    count: Int

    fn label(self) -> String { return "item" }
  }
  nothing

  fn label(self) -> String { return "reward" }
}

local variant Prize {
  fn name(self) -> String { return "prize" }

  cup {
    size: Int

    fn name(self) -> String { return "cup" }
  }
}
-- findings.txt --
error[E2106]  a/a.canon:11:6
  label is declared twice (first at a/a.canon:7)

error[E2106]  a/a.canon:20:8
  name is declared twice (first at a/a.canon:15)

2 errors, 0 warnings in 1 package (…)

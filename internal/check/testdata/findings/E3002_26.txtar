TYPES.md §4.1, STDLIB.md §5, DECISIONS 456: a literal key of a keyed list keyed by a ref is checked against the list's key type, so a literal that is not of the chain's leaf key's type is E3002 there, in `xs[k]`, get, find and hasKey, as it is as an entry's key field: a string through `ks` (keyed by `ref js`, `js` keyed by an Int) and `ls` (keyed by `ref ks`), an integer through `ts` (keyed by `ref ss`, a String leaf) and `ps` (keyed by `ref tab`, a table leaf).
-- a/a.canon --
package a

local record J {
  n: Int
}

local record K {
  j: ref js
}

local record L {
  k: ref ks
}

local record S {
  s: String
}

local record T {
  r: ref ss
}

local record E {
  w: Int = 0
}

local record P {
  e: ref tab
}

local let js: [J] keyed by n = [{ n: 9 }]

local let ks: [K] keyed by j = [{ j: 9 }]

local let ls: [L] keyed by k = [{ k: 9 }]

local let ss: [S] keyed by s = [{ s: "x" }]

local let ts: [T] keyed by r = [{ r: "x" }]

local let tab: table E = {
  p {}
}

local let ps: [P] keyed by e = [{ e: p }]

local let one: Bool = ks["9"] == ks[9] or ks.hasKey("9") or ls.get("9") != none or ls.find("9") != none

local let two: Bool = ts[1] == ts["x"] or ts.hasKey(1) or ps.get(1) != none or ps[1] == ps["p"]

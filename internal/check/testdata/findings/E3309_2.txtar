TYPES.md §4.1, §6.2, §7.5, DECISIONS 493: a ref into another collection is a wrong type wherever a ref is expected, whatever the keys of either collection, never a key named by the value's name. Comparing refs into two keyed lists (dynamic keys), or a table's ref with a keyed list's, is E3309 in either order; returning or binding a ref into another collection, optional or not, is E3002, as it is between two tables.
-- a/a.canon --
package a

local record Node {
  n: Int
}

local let one: [Node] keyed by n = []

local let two: [Node] keyed by n = []

local let tab: table Node = {}

local let oo: ref one? = 1

local fn lists(a: ref one, b: ref two) -> Bool {
  return a == b or b == a
}

local fn mixed(a: ref tab, b: ref two) -> Bool {
  return a == b or b == a
}

local fn returned(a: ref one) -> ref two {
  return a
}

local let bound: ref two = oo

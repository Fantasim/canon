TYPES.md §1, §5.2, DECISIONS 364: a misplaced item is checked against the error type, which hides only what depends on the missing expected type (a bare name, `none`); every finding any expected type would give is still reported beside E3320.
-- a/a.canon --
package a

local record R {
  a: Int
}

local fn f(x: Int) -> Int { return x }

local let r0: R = { a: 1 }

local let r: R = {
  a: 1,
  "b": f(1, 2),
  "c": nofn(1),
  "d": r0.zz,
  "e": R { a: "x" },
  "g": nope == 1,
  "h": 1 + nope,
  "i": warning,
  "j": none,
}

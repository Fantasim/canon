DECISIONS 339, 362, CODEGEN.md §2.1: `open` is an option of the go, cpp and ts emits only; on a json, view or text emit it is an unknown option.
-- a/a.canon --
package a

/// A destination.
enum Dst { str, sta }

/// The destinations, as text.
@text("dst.txt")
export fn dsts() -> String { return "str" }

emit json { out: "@sovcommon/a", open: [Dst] }

emit view { out: "@generated/a.view.json", open: [Dst] }

emit text { out: "@generated/text", open: [Dst] }

DECISIONS 339, CODEGEN.md §2.1: `open` is a go option; on a cpp or ts emit it is an unknown option.
-- a/a.canon --
package a

/// A destination.
enum Dst { str, sta }

emit cpp { out: "@sovcommon/a", mode: types, open: [Dst] }

emit ts { out: "@sovcommon/a.ts", mode: types, open: [Dst] }

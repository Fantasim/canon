-- a/a.canon --
package a

/// Doc.
@text("v.sql")
export fn v() -> String { return "SELECT 1;" }

/// Apply.
local fn apply(f: fn() -> String) -> String { return f() }

/// Bound.
local fn bound() -> String {
  let g = v
  return apply(g) + apply(v)
}

check {
  if v().isEmpty() {
    fail(v(), "empty")
  }
}

test "the file's text" {
  expect v() == "SELECT 1;"
}

emit text { out: "@generated/sql" }
-- b/b.canon --
package b

import a

/// Apply.
local fn apply(f: fn() -> String) -> String { return f() }

/// Other.
local fn other() -> String { return apply(a.v) }

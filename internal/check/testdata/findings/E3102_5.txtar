TYPES.md §9.3, §4.1, DECISIONS 456: an entry key of a keyed list keyed by a ref is a literal of the chain's leaf key, so a key written twice in source is the static E3102 at every depth, as on a list keyed by its leaf type. `ks` is keyed by `ref js` and `ls` by `ref ks`, `js` keyed by an Int: an integer entry key written twice (two entries, and a literal element then an entry) is E3102 through `ks` (1 level) and `ls` (2 levels). The same holds for a String leaf (`ts` keyed by `ref ss`) and a table leaf (`ps` keyed by `ref tab`).
-- a/a.canon --
package a

local record J {
  n: Int
}

local record K {
  j: ref js
  w: Int = 0
}

local record L {
  k: ref ks
  w: Int = 0
}

local record S {
  s: String
}

local record T {
  r: ref ss
  w: Int = 0
}

local record E {
  w: Int = 0
}

local record P {
  e: ref tab
  w: Int = 0
}

local let js: [J] keyed by n = [{ n: 9 }, { n: 10 }]

local let ks: [K] keyed by j = [{ j: 9 }]

entry ks.10 {}
entry ks.10 { w: 1 }
entry ks.9 { w: 2 }

local let ls: [L] keyed by k = [{ k: 9 }]

entry ls.10 {}
entry ls.10 { w: 1 }
entry ls.9 { w: 2 }

local let ss: [S] keyed by s = [{ s: "x" }, { s: "y" }]

local let ts: [T] keyed by r = [{ r: "x" }]

entry ts.y {}
entry ts.y { w: 1 }
entry ts.x { w: 2 }

local let tab: table E = {
  p {}
  q {}
}

local let ps: [P] keyed by e = [{ e: p }]

entry ps.q {}
entry ps.q { w: 1 }
entry ps.p { w: 2 }
-- findings.txt --
error[E3102]  a/a.canon:40:10
  key 10 is used twice (first at a/a.canon:39)

error[E3102]  a/a.canon:41:10
  key 9 is used twice (first at a/a.canon:37)

error[E3102]  a/a.canon:46:10
  key 10 is used twice (first at a/a.canon:45)

error[E3102]  a/a.canon:47:10
  key 9 is used twice (first at a/a.canon:43)

error[E3102]  a/a.canon:54:10
  key y is used twice (first at a/a.canon:53)

error[E3102]  a/a.canon:55:10
  key x is used twice (first at a/a.canon:51)

error[E3102]  a/a.canon:65:10
  key q is used twice (first at a/a.canon:64)

error[E3102]  a/a.canon:66:10
  key p is used twice (first at a/a.canon:62)


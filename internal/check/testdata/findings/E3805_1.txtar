TYPES.md §11.1: a field type using a later field.
-- a/a.canon --
package a

local enum K { num, text }

local record Ev {
  k: K
}

local type P(e: Ev) = match e.k {
  num => Int
  text => String
}

local record R {
  p: P(ev)
  ev: Ev
}
-- findings.txt --
error[E3805]  a/a.canon:15:8
  field type may only use earlier fields: ev


TYPES.md §11.1, DECISIONS 307: an optional argument given to a parameterized record `R(args)` stays E3806; a type function takes it.
-- a/a.canon --
package a

local enum K { a, b }

local record Ev {
  k: K
}

local record H(e: Ev) {
  n: Int = 0
}

local type P(e: Ev) = match e.k {
  a => Int
  b => String
}

local record R {
  maybe: Ev?
  held: H(maybe)
  typed: P(maybe)
}

TYPES.md §11.4 "Literals": a literal given to a dependent field is checked against the union of the branches; a Bool, a Float, a Duration or a list literal no branch accepts is E3002, in a field, a default and a literal union over the dependent type.
-- a/a.canon --
package a

local enum K { num, text, off }

local record Ev {
  k: K
}

local type P(e: Ev) = match e.k {
  num => Int
  text => String
  off => Never
}

local type Names(e: Ev) = match e.k {
  num => String
  text => K
  off => Never
}

local record R {
  ev: Ev
  p: P(ev)
  q: Names(ev) | "all" = 2.5
}

local let bad: [R] = [
  { ev: { k: num }, p: true },
  { ev: { k: num }, p: 2.5 },
  { ev: { k: num }, p: 3s },
  { ev: { k: num }, p: [1] },
  { ev: { k: num }, p: 1, q: false },
]

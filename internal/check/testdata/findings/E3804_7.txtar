TYPES.md §13.2, §11.4: a literal union over a dependent type, or an applied type function whose body is one (its expansion, §13.1, log-2026-09-28 reading 2), compares with its literals and its dependent alternative, through a union nested in it too (`SK2`; another union value is E3007_5); another string literal is E3002 and any other value E3804.
-- a/a.canon --
package a

local enum K { num, text }

local record Ev {
  k: K
}

local type P(e: Ev) = match e.k {
  num => String
  text => K
}

local type SK(e: Ev) = P(e) | "default"

local type SK2(e: Ev) = SK(e) | "y"

local record R {
  ev: Ev
  p: P(ev)
  s: P(ev) | "default" = "default"
  k: SK(ev) = "default"
  k2: SK2(ev) = "y"
}

local fn fine(r: R) -> Bool {
  return r.s == "default" and r.s != r.p and r.k == "default" and r.k != r.p
}

local fn other(r: R) -> Bool {
  return r.s == "other" or r.k == "other"
}

local fn number(r: R) -> Bool {
  return r.s == 3 or r.k != 3 or r.k2 == 3
}

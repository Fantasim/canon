TYPES.md §13.2, §11.4: a literal union over a dependent type, or an applied type function whose body is one, compares with its literals, the same union and its dependent alternative; another string literal is E3002 and any other value E3804.
-- a/a.canon --
package a

local enum K { num, text }

local record Ev {
  k: K
}

local type P(e: Ev) = match e.k {
  num => String
  text => K
}

local type SK(e: Ev) = P(e) | "default"

local record R {
  ev: Ev
  p: P(ev)
  s: P(ev) | "default" = "default"
  k: SK(ev) = "default"
}

local fn fine(r: R) -> Bool {
  return r.s == "default" and r.s != r.p and r.k == "default" and r.k != r.p and r.s == r.s
}

local fn other(r: R) -> Bool {
  return r.s == "other" or r.k == "other"
}

local fn number(r: R) -> Bool {
  return r.s == 3 or r.k != 3
}
-- findings.txt --
error[E3002]  a/a.canon:28:17
  expected a.P(*) | "default", found String

error[E3002]  a/a.canon:28:35
  expected a.SK(*), found String

error[E3804]  a/a.canon:32:10
  == is not available on a dependent value (P(*))

error[E3804]  a/a.canon:32:22
  != is not available on a dependent value (SK(*))


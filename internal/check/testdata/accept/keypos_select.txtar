TYPES.md §3.5, DECISIONS 456: `xs.k` on a keyed list whose key is a ref reads its chain's leaf key: it is the entry with key `k` when that leaf is a String or a table id, exactly as on a String-keyed list or a table: through `ts` (keyed by `ref ss`, a String leaf; 1 level), `us` (keyed by `ref ts`; 2 levels) and `ps` (keyed by `ref tab`, a table leaf).
-- a/a.canon --
package a

local record S {
  s: String
}

local record T {
  r: ref ss
  w: Int = 0
}

local record U {
  t: ref ts
  w: Int = 0
}

local record E {
  w: Int = 0
}

local record P {
  e: ref tab
  w: Int = 0
}

local let ss: [S] keyed by s = [{ s: "x" }]

local let ts: [T] keyed by r = [{ r: "x", w: 7 }]

local let us: [U] keyed by t = [{ t: "x", w: 8 }]

local let tab: table E = {
  p {}
}

local let ps: [P] keyed by e = [{ e: p, w: 9 }]

local let str: Int = ts.x.w

local let strTwo: Int = us.x.w

local let tbl: Int = ps.p.w

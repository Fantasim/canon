TYPES.md §11.5, STDLIB.md §6, DECISIONS 408 (amends 338): union on a kept dependent map takes and returns its type: {x in nodes: P(x)} read through a field, an optional {x in evs: L(x)}? through `?.union`, and a toMap of such optionals; a plain map, a dependent-KEY map {SK(like): Int} and a toMap of dependent values that read no key keep union; == between a dependent map and a literal, an empty literal or another map is allowed. Its dependent keys are written qualified (Tone.soft): a symbolic key names no object for Info (dependent_test.go).
-- a/a.canon --
package a

/// A tone.
enum Tone { soft, loud }

/// A kind.
enum K { num, col, text }

/// A node.
record Node {
  /// Its kind.
  k: K
}

/// Nodes.
let nodes: table Node = { a { k: num }, b { k: text }, c { k: col } }

/// A value per node kind.
type P(e: Node) = match e.k {
  num => Int
  col => Tone
  text => String
}

/// A key per node kind.
type SK(e: Node) = match e.k {
  col => Tone
  _ => String
}

/// Ev.
record Ev {
  /// Max.
  max: Int
}

/// Evs.
let evs: table Ev = {
  a { max: 3 }
}

/// L, of an ev.
record L(e: Ev) {
  /// Lim.
  lim: Int = e.max
}

/// A holder.
record H {
  /// Its name.
  name: String
  /// The node its keys and value follow.
  like: ref nodes
  /// By node.
  by: {x in nodes: P(x)} = {}
  /// By key.
  ks: {SK(like): Int} = {}
  /// A value.
  p: P(like)?
  /// Maybe counts.
  counts: {String: Int}?
  /// Maybe by ev.
  byEv: {x in evs: L(x)}?
}

let hs: [H] = [{ name: "h", like: c, by: { a: 1, c: soft }, ks: { Tone.soft: 1 } }]

local let plain: {String: Int} = { "a": 1 }

local let plainUnion: {String: Int} = plain.union({ "b": 2 })

local let plainEq: Bool = plain == { "a": 1 }

local let keyUnion = hs[0].ks.union({ Tone.loud: 8 })

local let valueMap = hs.toMap(h => h.name, h => h.p)

local let valueUnion = valueMap.union(valueMap)

local let optUnion = hs[0].counts?.union({ "b": 2 })

local let depUnion = hs[0].by.union({ b: "w" })

local let depEq: Bool = hs[0].by == { a: 1 }

local let depEmpty: Bool = hs[0].by == {}

local let depBoth: Bool = hs[0].by == hs[0].by

local let byEvs = hs.toMap(h => h.name, h => h.byEv)

local let byEvsUnion = byEvs.union(byEvs)

local let optDep = hs[0].byEv?.union({ a: {} })

TYPES.md §9: keyed lists, tables, maps and their methods; `.a` on a keyed-list field of any record value is a key (Info.Keys); hasKey takes a key, `in`, contains and indexOf an element (STDLIB.md §5, DECISIONS 317).
-- a/a.canon --
package a

local record Row {
  id: Int
  name: String
}

local record Named {
  name: String
  n: Int
}

local let rows: [Row] keyed by id = [
  { id: 1, name: "one" }
]

local let named: [Named] keyed by name = [
  { name: "a", n: 1 }
]

local let byName: {String: [Row]} = rows.groupBy(.name)

local record Shelf {
  named: [Named] keyed by name = []
}

local let shelves: [Shelf] = [{ named: [{ name: "a", n: 1 }] }]

local let fromField: Int = shelves[0].named.a.n

local fn find(id: Int) -> Row? {
  return rows.get(id)
}

local fn lookup() -> Int {
  return named.a.n + named["a"].n + named.at(0).n
}

local fn hasOne() -> Bool {
  return rows.hasKey(1) and rows.at(0) in rows and rows.contains(rows.at(0)) and rows.indexOf(rows.at(0)) != none
}

local fn positions() -> [Int] {
  return [i for i, r in rows.enumerate()]
}

local fn sorted() -> [Row] {
  return rows.sortBy(r => r.name).reverse()
}

local fn total(m: {String: Int}) -> Int {
  var n = 0
  for k, v in m {
    n += v
  }
  return n + m.values().sum()
}

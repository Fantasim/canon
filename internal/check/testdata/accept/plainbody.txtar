TYPES.md §11.4, §13.1: `F(*)` is only a match-bodied type function; an application of one with any other body is its expansion, parameters erased (an alias with parameters is transparent, log-2026-09-28 reading 2), so `Count(ev)` with `Count(e) = Int(0..10)` is an `Int(0..10)`: arithmetic on it, a comparison, a method reading it and passing it where an `Int` is expected are all accepted (none of them is E3804).
-- a/a.canon --
package a

local enum K { a, b }

local record Ev {
  k: K
}

local type Count(e: Ev) = Int(0..10)

local record R {
  ev: Ev
  c: Count(ev) = 1

  fn doubled(self) -> Int {
    return self.c * 2
  }
}

local fn plus(n: Int) -> Int {
  return n + 1
}

local fn f(x: R) -> Int {
  let more = x.c + 1
  if x.c > 3 {
    return plus(x.c)
  }
  return x.doubled() + more
}

local let r: R = { ev: { k: a }, c: 4 }

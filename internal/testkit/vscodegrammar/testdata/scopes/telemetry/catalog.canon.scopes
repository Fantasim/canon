1:0-7 "package" keyword.other.canon
1:8-17 "telemetry" entity.name.namespace.canon
3:0-88 "// catalog.json: the whole catalogue as data, for tools that are not C++ or Go (the HTML" comment.line.double-slash.canon
4:0-51 "// catalogue, the lake gates). Its shape, format 1:" comment.line.double-slash.canon
5:0-2 "//" comment.line.double-slash.canon
6:0-38 "//   { \"format\": 1, \"contract\": <int>," comment.line.double-slash.canon
7:0-79 "//     \"provenance\": [ { \"name\", \"type\" } ],          the prefix of every table" comment.line.double-slash.canon
8:0-78 "//     \"events\": [ {                                   every type, in id order" comment.line.double-slash.canon
9:0-103 "//       \"id\", \"table\", \"retired\": false, \"version\", \"since\", \"tier\", \"producers\": [<name>], \"enqueue\"," comment.line.double-slash.canon
10:0-52 "//       \"hasInstanceId\", \"wireSize\", \"description\"," comment.line.double-slash.canon
11:0-93 "//       \"columns\": [ { \"name\", \"type\", \"kind\", \"nullable\", \"since\", \"retiredIn\", \"enum\" } ]," comment.line.double-slash.canon
12:0-86 "//       \"ledger\": [ { \"kinds\": null | { \"column\", \"values\": [<member>] }, \"currency\"," comment.line.double-slash.canon
13:0-84 "//                     \"bucket\", \"sign\", \"token\", \"leg\", \"filter\", \"amount\", \"item\"," comment.line.double-slash.canon
14:0-86 "//                     \"player\", \"counterparty\", \"counted\", \"dedupOf\", \"untilVersion\"," comment.line.double-slash.canon
15:0-35 "//                     \"note\" } ] }" comment.line.double-slash.canon
16:0-90 "//       | { \"id\", \"table\", \"retired\": true } ],       a tombstone: the id is never reused" comment.line.double-slash.canon
17:0-85 "//     \"enums\": [ { \"name\", \"view\", \"values\": [ { \"code\", \"name\", \"retired\" } ] } ] }" comment.line.double-slash.canon
18:0-2 "//" comment.line.double-slash.canon
19:0-89 "// Columns are in wire order with the header first; a retired column stays where it stood" comment.line.double-slash.canon
20:0-89 "// and has a `retiredIn`. Every string is printable ASCII (Text), so escaping `\\` and `\"`" comment.line.double-slash.canon
21:0-88 "// is all JSON needs. Two-space indentation, keys in the order above, one final newline." comment.line.double-slash.canon
23:0-25 "/// `s` as a JSON string." comment.line.documentation.canon

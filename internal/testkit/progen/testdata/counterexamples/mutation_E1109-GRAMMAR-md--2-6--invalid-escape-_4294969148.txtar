    label: "Resource Studio"
    minRole: maintainer
  }
  client {
    group: in_game
    tone: series_1
    icon: monitor
    label: "Game client"
    minRole: maintainer
  }
  resource {
    group: in_game
    tone: series_1
    icon: database
    label: "Game data (Resource)"
    minRole: maintainer
  }
  admin_panel {

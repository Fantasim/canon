-- teamboard/taxonomy.canon --
package teamboard
import sovcommon.ui { Tone }
record Status {
  tone: Tone
  label: String(1..)
  terminal: Bool
  next: [ Status]
  check requires.intersect(optional, 1)() else "a field is both required and optional"
}
let statuses: table Status = {
  open { tone: warning label: "Open" terminal: false next: [] }
  taken {
    tone: info
    label: "Taken"
    terminal: false
    next: []
  }
}

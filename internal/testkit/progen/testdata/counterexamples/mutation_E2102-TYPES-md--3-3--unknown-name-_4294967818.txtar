package features.lookup
/// Upgrade grades of a weapon, lowest first.
enum Grade { normal, unique, ultimate }
/// Job tiers, lowest first.
enum Tier ordered { master }
/// generated code.
export fn canUpgrade(grade: Grade, tier: Tier) -> Bool {
  return match grade {
    normal => true
    unique => zztier >= pro
    ultimate => tier >= master
  }
}
/// Penya an upgrade costs: a 3-entry table.
export fn upgradeCost(grade: Grade) -> Int {
  return match grade {
    normal => 10_000
    unique => 500_000
    ultimate => 20_000_000
  }
}

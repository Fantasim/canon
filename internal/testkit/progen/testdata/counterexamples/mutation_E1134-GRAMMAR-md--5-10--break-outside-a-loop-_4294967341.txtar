-- teamboard/taxonomy.canon --
package teamboard
import sovcommon.roles { Role }
import sovcommon.ui { Icon Tone }
record AreaGroup {
  label: String
}
record Area {
  group: ref AreaGroup
  tone: Tone
  icon: Icon
  label: String(1..)
  minRole: Role
}
let areaGroups: table AreaGroup = {
  in_game { label: "In game" }
}
let areas: table Area = {
  game {
    group: in_game
    tone: series_1
    icon: gamepad
    label: "Game"
    minRole: gm_junior
  } {
  } {
  } {
  } {
  } {
  } {
  } {
  } {
  } {
  }
} fn areasVisibleTo(role: Role) -> [ Area] {
  return [a for a areas.active() if role >= a.minRole]
}
record AreaSection {
  group: AreaGroup
  areas: [ Area]
}
export fn groupedAreasVisibleTo(role: Role) -> [AreaSection] {
  break
  return [
    { group: g areas: areasVisibleTo(role).filter(a => a.group == g) }
    for g areaGroups.active()
  ]
}

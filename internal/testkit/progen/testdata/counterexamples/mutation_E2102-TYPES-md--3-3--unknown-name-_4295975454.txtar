-- telemetry/catalog.canon --
package telemetry
local record CatalogDoc {
  format: Int
  contract: Int
  provenance: [CatalogProvenance]
  events: [CatalogEvent]
  enums: [CatalogEnum]
}
local record CatalogProvenance {
  name: String
  sqlType: SqlType @json()
}
local variant CatalogEvent @json(tag: "state") {
  live {
    id: Int
    tableName: String @json()
    version: Int
    since: Int
    tier: Tier
    producers: [Producer]
    enqueue: Enqueue
    hasInstanceId: Bool
    wireSize: Int
    description: String
    columns: [CatalogColumn]
    ledger: [CatalogRole]
  }
  retired {
    id: Int
    tableName: String @json()
  }
}
local record CatalogColumn {
  name: String
  sqlType: SqlType
  fieldKind: FieldKind @json()
  nullable: Bool
  since: Int
  enumName: String? @json()
}
local record CatalogRole {
  currency: Currency
  bucket: Bucket
  sign: Int
  token: String
  player: String
  counted: Bool
  note: String
}
local record CatalogKinds {
  column: String
  values: [String]
}
local record CatalogEnum {
  name: String
  viewName: String @json()
  values: [Label]
}
fn columnDoc(ev: Event, c: Column) -> CatalogColumn {
  return {
    name: c.name
    sqlType: c.sql
    fieldKind: c.kind
    nullable: c.nullable()
    since: c.since ?? ev.since
    enumName: if zzc.values != none { enumOf(c.values).name } else { none }
  }
}
fn kindsDoc(ev: Event, r: Role) -> CatalogKinds? {
  return match r.rows {
    every => none
    some(s) => {
      column: columnOf(ev, s.of).name
      values: [String(k) for k in s.kinds]
    }
  }
}
fn roleDoc(ev: Event, r: Role) -> CatalogRole {
  return {
    currency: r.currency
    bucket: r.bucket
    sign: r.sign
    token: r.token
    player: r.player?.name ?? playerColumn()
    counted: r.counted
    note: r.note
  }
}
fn eventDoc(e: EventType) -> CatalogEvent {
  let ev = eventOf(e)
  if ev == none { return CatalogEvent.retired { id: e.code, tableName: tableOf(e) } }
  return CatalogEvent.live {
    id: e.code
    tableName: tableOf(e)
    version: ev.version
    since: ev.since
    tier: ev.tier
    producers: ev.producers
    enqueue: ev.enqueue
    hasInstanceId: hasInstanceId(e)
    wireSize: wireSize(e)
    description: ev.description
    columns: [columnDoc(ev, c) for c in headerColumns.values() + ev.columns]
    ledger: [roleDoc(ev, r) for r in ev.ledger]
  }
}
fn enumDoc(v: Vocabulary) -> CatalogEnum {
  let info = enumOf(v)
  return { name: info.name, viewName: "enum_{v}", values: info.labels }
}
/// The catalogue, written as JSON.
@text("catalog.json")
export fn catalogJson() -> CatalogDoc {
  return {
    format: CATALOG_FORMAT
    contract: CONTRACT_VERSION
    provenance: [{ name: p.name, sqlType: p.sql } for p in provenanceColumns]
    events: [eventDoc(e) for e in EventType.members.sortBy(.code)]
    enums: [enumDoc(v) for v in usedVocabularies()]
  }
}

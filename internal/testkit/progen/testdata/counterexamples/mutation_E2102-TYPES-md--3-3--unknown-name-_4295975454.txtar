-- telemetry/sql.canon --
package telemetry
fn usedVocabularies() -> [Vocabulary] {
  return [c.values for e in liveEvents() for c in events[e].columns if c.values != none].unique()
}
fn sqlStr(s: String) -> String { return s.replace("'", "''") }
fn enumView(v: Vocabulary) -> String {
  let rows = ["    ({l.code}, {(l.name)})" for l in enumOf(v).labels].join(",\n")
  return "-- {(v)}\n) AS t(value, name);\n"
}
/// map, then the event catalogue.
export fn enumsSql() -> String {
  let views = [enumView(v) for v in usedVocabularies()].join("\n")
  let columnRows = [
    "    ({((e))}, {(c.name)}, {((c.values).name)}, {("enum_{c}")})"
    for e in liveEvents()
    for c in events[e].columns
    if c.values != none
  ].join(",\n")
  let catalogRows = [
    "    ({((e))}, {(((e)))}, {(e)}, {(e)})"
    for e in liveEvents()
  ].join(",\n")
  return views
}
-- telemetry/telemetry.canon --
package telemetry
const CONTRACT_VERSION = 2
const CATALOG_FORMAT = 3
/// and its id. Ids are never reused: a removed event is `retired` and the lock keeps its id.
enum EventType @codes(UInt8) {
  item_created = 11
  item_consumed = 31
  penya_drops = 70
  trade_penya = 71
  server_lifecycle = 110
  farm_events = 151
  sovereign_events = 152
}
/// A ring's drop and WARN policy, carried per event. It does not size the ring.
enum Tier @codes(UInt8) {
  HOT = 0
  WARM = 1
  COOL = 2
  TINY = 3
  READONLY = 4
}
/// A process that owns telemetry rings. The code is the top byte of a producer_id.
enum Producer @codes(UInt8) {
  WorldServer = 1
  CoreServer = 2
  DatabaseServer = 3
}
/// How the client enqueues an event.
enum Enqueue {
  generated
}
/// A lake column type (DuckDB). The name is the SQL spelling.
enum SqlType { UTINYINT, USMALLINT, UINTEGER, UBIGINT, TINYINT, SMALLINT, INTEGER, BIGINT, FLOAT }
/// How a column travels on the wire and lands in the lake.
enum FieldKind {
  ts
  id
  scalar
  enum8
}
/// A snake_case SQL identifier.
type Ident = String
/// One column of an event table, in wire order.
record Column {
  /// The SQL column name, also the struct field name.
  name: Ident
  /// The lake type; its byte width is the wire width.
  sql: SqlType
  /// How the column is streamed.
  kind: FieldKind = scalar
  /// The telemetry enum an `enum8` column holds.
  values: Vocabulary?
  /// The version that added the column; none: present from the table's first known version.
  since: Int(2..)?
  /// is appended as NULL, and leaves the wire.
  retiredIn: Int(2..)?
  fn nullable() -> Bool { return kind != ts and kind != id }
  fn width() -> Int { return sqlWidth(sql) }
}
let headerColumns: [Column] keyed by name = [
]
fn playerColumn() -> String { return headerColumns.first(c => c.kind == id)!.name }
/// batch, at which version. Never on the wire as a field.
record ProvenanceColumn {
  /// Its SQL name.
  name: Ident
  /// Its SQL type, never NULL.
  sql: SqlType
}
let provenanceColumns: [ProvenanceColumn] keyed by name = [
]
fn sqlWidth(t: SqlType) -> Int {
  return match t {
    UTINYINT, TINYINT => 1
    USMALLINT, SMALLINT => 2
    UINTEGER, INTEGER, FLOAT => 4
    UBIGINT, BIGINT => 8
  }
}
/// database snapshot; `none` documents a table that moves nothing.
enum Currency { gold, item, nothing = "none" }
/// The direction of a leg, from the player's point of view.
enum Bucket { mint, sink, transfer, nothing = "none" }
/// Which side of a single-row transfer a leg reads.
variant Rows {
  every
  some {
    /// The vocabulary whose column splits the rows.
    of: Vocabulary
    /// The members covered.
    kinds: [ Member(of)](1..)
  }
}
/// One ledger leg a table's rows contribute, or the statement that they move nothing.
record Role {
  /// The rows it covers.
  rows: Rows = every
  /// What moves.
  currency: Currency
  /// Mint, sink or transfer.
  bucket: Bucket
  /// +1 credit, -1 debit, 0: the amount is already signed (or there is none).
  sign: Int(-1..=)
  /// The stable vocabulary the economy panel groups on.
  token: Ident
  /// The side a single-row transfer reads; none for a table with one row per side.
  amount: Column?
  /// For item legs: the column naming the item.
  item: Column?
  /// Whose ledger the leg lands on; none: the header's player_id.
  player: Column?
  /// The other side, if any.
  counterparty: Column?
  /// Summed into the reconciliation (true), or real telemetry that must not be summed.
  counted: Bool
  /// The token this row would double-count with.
  untilVersion: Int(1..)?
  /// Why, citing a function, never a line number.
  note: String
}
/// One telemetry table: the rows of one event type.
record Event {
  /// What one row records.
  description: String
  /// The current layout version: the wire version byte and the lake's event_version.
  version: UInt8(1..)
  /// start at 2, its floor; their earlier history is lost.
  since: Int(1..) = 1
  /// Ring policy.
  tier: Tier
  /// The processes that own a ring for it (none: read-only history).
  producers: [Producer] = []
  /// How the client enqueues it.
  enqueue: Enqueue = generated
  /// The body columns after the header, in wire order, retired ones where they stood.
  columns: [Column] keyed by name
  /// What its rows mean to the ledgers; empty: no ledger at all.
  ledger: [Role] = []
  /// is covered by some role (L-0111), so a new kind cannot ship without a ledger decision.
  ledgerKinds: Column?
  check since <= version at since
    else "version {version} is older than the first known version {since}"
  check {
    for c in columns {
      if c.since != none and (c.since <= since or c.since > version) {
      }
    }
    for v in since + 1..version + 1 {
      if columns.any(c => c.since == v or c.retiredIn == v) {
      }
    }
    for r in ledger {
      for col in [r.amount, r.item] {
        if col != none and col.retiredIn != none {
          if r.untilVersion == none or r.untilVersion >= col.retiredIn {
            fail(
              r,
              "the role reads {col.name}, retired in {col.retiredIn}: bound it with untilVersion"
            )
          }
        }
      }
      match r.rows {
        some(s) => {
        }
        every => {}
      }
    }
    if ledgerKinds != none {
      if ledgerKinds.values == none {
      } else {
        var covered: [String] = []
        for r in ledger {
          match r.rows {
            every => { covered += liveNames(ledgerKinds.values) }
            some(s) => {
            }
          }
        }
        for n in liveNames(ledgerKinds.values) {
        }
      }
    }
  }
  fn layout(self, v: Int) -> [Column] {
    return [
      c
      for c in columns
    ]
  }
  fn tableColumns() -> [Column] {
    return headerColumns.values() + layout(version) + [c for c in columns if c.retiredIn != none]
  }
}
fn columnOf(e: Event, v: Vocabulary) -> Column { return e.columns.first(c => c.values == v)! }
fn eventOf(e: EventType) -> Event? { return events.get(e) }
fn liveEvents() -> [EventType] { return EventType.members.filter(e => e.retired).sortBy(.code) }
/// 20, whose table is not recorded, the event's name.
export fn tableOf(e: EventType) -> String { return e.name }
/// Whether `e`'s current layout has the item_instance_id column.
export fn hasInstanceId(e: EventType) -> Bool {
  let ev = eventOf(e)
  return ev != none and "item_instance_id" in ev.layout(ev.version).map(.name)
}
/// The packed size of `e`'s current struct: header plus live body columns.
export fn wireSize(e: EventType) -> Int {
  let ev = eventOf(e)
  if ev == none { return 0 }
  return headerColumns.map(.width()).sum() + ev.layout(ev.version).map(.width()).sum()
}
-- telemetry/vocab.canon --
package telemetry
/// What happened in a farm. All ten kinds are WorldServer hooks with one FarmManager caller.
enum FarmEventKind @codes(UInt8) {
}
/// One fact of a reign, CoreServer only (SovereignManager).
enum SovereignEventKind @codes(UInt8) {
}
/// Which seat. A mirror of Sovereign::SovereignRole, mapped by an explicit switch.
enum SovereignRole @codes(UInt8) {
}
/// Which doctrine the sovereign picked. A mirror of Sovereign::DoctrineType.
enum SovereignDoctrine @codes(UInt8) {
}
/// minister buff slots, separate quotas.
enum SovereignPower @codes(UInt8) {
}
/// A producer's boot or clean stop. A Start with no Stop before a later boot is a crash.
enum LifecycleKind @codes(UInt8) { Start = 1, Stop = 2 }
/// (trimmed: 14 of 62).
enum GrantKind @codes(UInt8) {
  EVENT_REWARD = 16
}
/// (`enum_<name>`).
enum Vocabulary {
  farm_event_kind
  sovereign_event_kind
  sovereign_role
  sovereign_doctrine
  sovereign_power
  lifecycle_kind
  grant_kind
}
/// A member of vocabulary `v`: what a ledger role splitting on a `v` column names.
type Member(v: Vocabulary) = match v {
  farm_event_kind => FarmEventKind
  sovereign_event_kind => SovereignEventKind
  sovereign_role => SovereignRole
  sovereign_doctrine => SovereignDoctrine
  sovereign_power => SovereignPower
  lifecycle_kind => LifecycleKind
  grant_kind => GrantKind
}
local record Label {
  code: Int
  name: String
  isRetired: Bool @json()
}
local record EnumInfo {
  name: String
  labels: [Label]
}
fn enumOf(v: Vocabulary) -> EnumInfo {
  let labels =
    Member(v).members.map(m => Label { code: m.code, name: m.name, isRetired: m.retired })
  return { name: Member(v).typeName, labels: labels.sortBy(.code) }
}
fn liveNames(v: Vocabulary) -> [String] {
  return [l.name for l in enumOf(v).labels if l.isRetired]
}

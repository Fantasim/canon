package game.items
local let attributes = load.defines("@resource/Server/Define/defineAttribute.h", prefix: "DST_")
/// would have made it legal, this one refuses it.
enum WeaponType @codes(UInt32) {
}
/// A stat an item raises, and by how much.
record StatBonus {
  /// The stat raised (a DST_* define).
  attribute: ref attributes
  /// How much it is raised.
  value: Int
}
/// propItem.json's `defaults` block; "=" on the wire means "not set".
record Item {
  /// Format version of the row (nVer). The loader ignores it.
  nameKey: String(/^IDS_/) = "IDS_PROPITEM_TXT_030168" @json()
}
/// material cannot carry an attack speed.
variant ItemKind @json(tag: "dwItemKind1") {
  IK1_WEAPON {
    /// The sub-kind, with its own fields.
    kind2: GeneralKind @json()
  }
}
/// the studio orders a material's fields by what materials set.
variant GeneralKind @json(tag: "dwItemKind2") {
  IK2_MATERIAL {
    /// What the material is used for.
    restores: [StatBonus](..=6) = [] @json(pairs: ["dwDestParam{i}", "{}nAdjParamVal{i}"])
  }
}

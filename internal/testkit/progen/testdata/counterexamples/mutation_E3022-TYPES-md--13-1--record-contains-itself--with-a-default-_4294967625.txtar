package service.resourcestudio
/// expanded: Canon has no environment. Machine-specific paths belong in a layer.
type Path = String(1..)
/// Where the studio reads and caches files.
record Paths {
  /// The tool is local by design (ADR-0005 d.1).
  readOnly: Bool = false
}
/// Generation features.
record Gen {
  /// Entered right before the action and never stored (ADR-0005).
  apiKey: input String(1..) from env "RESOURCESTUDIO_GEMINI_KEY"
  /// Itself.
  zzSelf: Gen = {}
}

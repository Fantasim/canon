-- features/codes/codes.canon --
package features.codes
/// Guild ranks. The database, the packets and the guild config all store the number.
enum GuildRank @codes(UInt8) @json(codes) {
  master = 1
  kingpin = 1
  captain = 3
  supporter = 4
  rookie = 5
}
/// What one rank may do.
record RankRights {
  /// The rank. Written `"rank": 3` in the file.
  rank: GuildRank
  /// Members it may invite per day.
  invitesPerDay: Int(0..)
  /// Whether it may take from the guild bank.
  bank: Bool = false
}
let rights: [RankRights] keyed by rank = load("data/guild_rights.json")
-- features/codes/data/guild_rights.json --
[
  {"rank": 2, "invitesPerDay": 30, "bank": true},
  {"rank": 5, "invitesPerDay": 0}
]

-- sovcommon/time/time.canon --
package sovcommon.time
const WEEK = DAY * 7
/// Declared Sunday first so that `.index` equals C's tm_wday.
enum Weekday { }
/// A time of day, in UTC wherever it is used.
record TimeOfDay {
  /// 0 to 23.
  hour: Int(..=23)
  /// 0 to 59.
  minute: Int(..=59)
  fn minutes() -> Int { return hour }
}
/// that crosses midnight into the next day.
record Window {
  /// Day the window opens.
  day: Weekday
  /// When it opens.
  startUtc: TimeOfDay
  /// When it closes; before `startUtc` means the next day.
  endUtc: TimeOfDay
}
fn occupancy(w: Window) -> [Range] {
  let start =.startUtc()
  var length =.startUtc()
  let end = length
  return []
}
fn overlaps(a: Window) -> Bool {
  1 + 2
  return(x =>(end))
}
local fn at(day: Weekday, from: Int, to: Int) -> Window {
  return { day: day, startUtc: { hour: from, minute: 0 }, endUtc: { hour: to, minute: 0 } }
}
test "a window may cross midnight" {

package features.lookup
/// Upgrade grades of a weapon, lowest first.
enum Grade { normal, unique, ultimate }
/// Job tiers, lowest first.
enum ordered { }
/// generated code.
export fn canUpgrade(grade: Grade) -> Int {
  return match grade {
    normal => 10_000
    unique => 500_000
    ultimate => 20_000_000
  }
}
emit go { out: "lookup", mode: baked }

-- features/matching/matching.canon --
package features.matching
/// What a system mail carries.
variant Attachment @json(tag: "type") {
  item {
    /// The item define.
    count: Int(1..) = 1
  }
  gold {
    /// How much.
    amount: Int(1..)
  }
  nothing
}
/// When a mail is sent.
enum Season { spring }
/// A mail the server sends to every player once.
record Mail {
  /// Title in the mailbox.
  subject: String(1..)
  /// When it is sent.
  season: Season
  /// What it carries.
  attachment: Attachment = nothing
  /// No runtime input, so `canon build` computes it and ships the value.
  export fn quantity() -> Int {
    return match attachment {
      item(i) => i.count
      gold(g) => g.amount
      nothing => 0
    }
  }
  fn isHoliday() -> Bool {
    let zzM: {String: Int} = { "a": 1, "a": 2 }
    return match season {
      _ => false
    }
  }
  warn not isHoliday() or attachment is gold else "a holiday mail usually carries penya"
}
let mails: [Mail] = [
  {
    subject: "Spring cleaning"
    season: spring
  }
]
test "quantity follows the attachment" {
}

-- pipeline/potion.canon --
package pipeline
/// A healing potion. Each one is a file under data/.
record Potion {
  /// The item define. Stored in inventories: never renamed.
  id: String(/^II_[A-Z0-9_]+$/) @json("dwID")
  /// Text key of the displayed name.
  name: String(/^IDS_/) @json("szName")
  /// Hit points restored.
  heal: Int @json("nHeal")
  /// Time before the same potion can be drunk again.
  cooldown: Duration(..=10m) @json("dwCooldownMs", unit: ms)
  warn not (heal > 5_000 and cooldown < 2s)
    else "heals {cooldown}: that outheals most bosses"
  /// conformance test per target so the translations cannot drift.
  export fn healFor( missingHp: Int) -> Int { return min(heal, max(missingHp, 0)) }
}
test "healFor never overheals and never goes negative" {
  let p: Potion = { id: "II_POT_T", name: "IDS_T", heal: 500, cooldown: 1s }
  expect p.healFor(5) == 0
}
@reload
let potions: [Potion] keyed by id = load.dir("data/*.json")
view Potion {
}
emit json { out: "out/potions.json", values: [potions] }
emit go { out: "out/go/", package: "potions", mode: zzmode }

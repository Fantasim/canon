package game.items
local let sounds = load.defines("@resource/Server/Define/defineSound.h", prefix: "SND_")
/// would have made it legal, this one refuses it.
enum WeaponType {
}
/// A stat an item raises, and by how much.
record StatBonus {
  /// The stat raised (a DST_* define).
  value: Int
  /// Added.
  zzFn: (fn(Int) -> Int)? = none
}
/// material cannot carry an attack speed.
variant ItemKind {
  IK1_WEAPON {
    /// Weapon family.
    stats: [StatBonus](..=6) = [] @json(pairs: ["dwDestParam{i}", "nAdjParamVal{i}"])
    /// Property flags; a bitmask on the wire.
    attackSound: ref sounds? = none @json()
  }
  IK1_GENERAL {
    /// The sub-kind, with its own fields.
    kind2: GeneralKind @json()
  }
}
/// the studio orders a material's fields by what materials set.
variant GeneralKind @json(tag: "dwItemKind2") {
  IK2_MATERIAL {
    /// Wait before the next one can be eaten.
    cooldown: Duration? = none @json()
  }
}

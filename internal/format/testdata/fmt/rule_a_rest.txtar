FORMATTER.md §7.1, §7.3 and DECISIONS 170: a later group without a single-line bit counts flat
(§7.1); rule A moves a value that does not fit to the next line.
-- in.canon --
package p

let f = (aaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbb) => ccccccccccccccccccc.ddddddddddddddddddddddd.eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
fn g() -> Int {
  xs[f(aaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbb)] = { aaaaaaaa: 1, bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb: 2 }
  return 1
}
-- want --
package p

let f = (
  aaaaaaaaaaaaaa,
  bbbbbbbbbbbbbbbbbbbbbb,
) => ccccccccccccccccccc.ddddddddddddddddddddddd.eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
fn g() -> Int {
  xs[f(aaaaaaaaaaaaaaaaaaaaaaa, bbbbbbbbbbbbbbbbbbbbbbbbbbb)] = {
    aaaaaaaa: 1
    bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb: 2
  }
  return 1
}

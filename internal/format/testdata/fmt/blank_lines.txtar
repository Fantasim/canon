FORMATTER.md §4: at most one blank line; none at the start or end of the file, after an
opening brace or before a closing one; kept between items when the input had one.


-- in.canon --


package p
const A = 1



const B = 2
const C = 3
record R {

  a: Int


  b: Int

}



-- want --
package p

const A = 1

const B = 2
const C = 3
record R {
  a: Int

  b: Int
}

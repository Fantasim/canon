FORMATTER.md §5 and §7.2: operators, postfix steps and lambdas.
-- in.canon --
package p

let a = - -5
let b = -(x)
let c = x?.f?.g
let d = xs.map(.name).join(", ")
let e = .a.b().c()
let f = a..b
let g = ..=256
let h = 1..
let i = x is Reward.item
let j = not a in b
let k = if a { 1 } else if b { 2 } else { 3 }
let l = if a {
  1
} else { 2 }
let m = (a, b) => a + b
let n = load.defines("@x/y.h", prefix: "MI_")
let o = Point { x: 0, y: 0 }
let p = { ...base, "Cap": [a, b], (name): v }
let q = xs[i + 1..]
let r = match x { a, b => 1, _ => 2 }
let s = a.. .x
-- want --
package p

let a = --5
let b = -(x)
let c = x?.f?.g
let d = xs.map(.name).join(", ")
let e = .a.b().c()
let f = a..b
let g = ..=256
let h = 1..
let i = x is Reward.item
let j = not a in b
let k = if a { 1 } else if b { 2 } else { 3 }
let l = if a {
  1
} else {
  2
}
let m = (a, b) => a + b
let n = load.defines("@x/y.h", prefix: "MI_")
let o = Point { x: 0, y: 0 }
let p = { ...base, "Cap": [a, b], (name): v }
let q = xs[i + 1..]
let r = match x { a, b => 1, _ => 2 }
let s = a.. .x

FORMATTER.md §6.1 and §7.2: a statement block is single-line only with one statement; an if
chain is single-line only when every block is; expect keeps its verdict on the subject's line.
-- in.canon --
package p

fn f(x: Int) -> Int { return x }
fn g(x: Int) -> Int { let y = x
  return y }
fn h(x: Int) -> Int {
  var t = 0
  for i, v in xs { t += v }
  while t > 0 { t -= 1 }
  match x {
    a => { return 1 }
    _ => log(2)
  }
  if x > 0 { return 1 } else if x < 0 { return 2 } else {
    return 3
  }
}

test "t" {
  expect {
    ...sample
    schedule: [at(Mon, 20, 22), at(Mon, 21, 23)]
  } fails "overlaps an earlier window"
  expect { ...sample, schedule: [at(Mon, 20, 22), at(Mon, 22, 23)] } passes
}
-- want --
package p

fn f(x: Int) -> Int { return x }
fn g(x: Int) -> Int {
  let y = x
  return y
}
fn h(x: Int) -> Int {
  var t = 0
  for i, v in xs { t += v }
  while t > 0 { t -= 1 }
  match x {
    a => { return 1 }
    _ => log(2)
  }
  if x > 0 {
    return 1
  } else if x < 0 {
    return 2
  } else {
    return 3
  }
}

test "t" {
  expect {
    ...sample
    schedule: [at(Mon, 20, 22), at(Mon, 21, 23)]
  } fails "overlaps an earlier window"
  expect { ...sample, schedule: [at(Mon, 20, 22), at(Mon, 22, 23)] } passes
}

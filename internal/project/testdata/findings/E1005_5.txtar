GRAMMAR.md §7.1 (DECISIONS 439): an out_templates target given twice, and a root twice under one target.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    admin: "../admin"
  }
  out_templates {
    go: {
      admin: "a/{dir}"
    }
    ts: {
      admin: "a/{dotted}.ts"
      admin: "b/{dotted}.ts"
    }
    go: {
      admin: "c/{dir}"
    }
  }
}

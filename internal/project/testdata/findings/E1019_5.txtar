GRAMMAR.md §7.1 (DECISIONS 439, 424): a template character outside A-Z a-z 0-9 . _ - and /: a raw string keeps its braces as text.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    admin: "../admin"
    web: "../web"
  }
  out_templates {
    go: {
      admin: r"x/{dir}"
      web: "gen/a b/{dir}"
    }
  }
}

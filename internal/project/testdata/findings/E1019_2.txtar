GRAMMAR.md §7.1 (DECISIONS 439): an interpolation that is not a bare {dir} or {dotted}: a format spec, a call.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    admin: "../admin"
    web: "../web"
  }
  out_templates {
    go: {
      admin: "gen/{dir:5}"
      web: "gen/{f()}/{dotted}"
    }
  }
}

GRAMMAR.md §7.1: a go_module key that is not a declared root; an empty and a spaced module path.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    a: "../a"
    b: "../b"
  }
  go_module {
    c: "example.com/c"
    a: ""
    b: "example.com/ b"
  }
}

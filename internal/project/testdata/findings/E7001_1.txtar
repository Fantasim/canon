WIRE.md §2.1, §2.2: absolute, backslashed, empty-segment and escaping paths.
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    services: "../.."
  }
}
-- paths --
pipeline /abs/x.json
pipeline C:/x.json
pipeline out\potions.json
pipeline a//b
pipeline @services//x
pipeline @services/..//teamboard
pipeline @services/../teamboard
pipeline ../../outside.json
. 

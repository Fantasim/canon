-- names/names.canon --
/// Names.
package names

/// A role.
enum Role { user, admin }

emit go { out: "@features/names", package: "name", mode: baked }
-- club/club.canon --
/// Clubs.
package club

import names { Role }

/// A stat bonus.
record Bonus {
  /// The stat.
  stat: Int
  /// Its value.
  value: Int
}

/// A shape.
variant Shape @json(tag: "shape") {
  /// A circle.
  circle {
    /// Its radius.
    radius: Int

    /// Its area times n.
    export fn scaled(self, n: Int) -> Int { return radius * n }
  }
  /// A dot.
  dot
}

/// A member.
record Member {
  /// Its code.
  code: Int @stable
  /// Its role.
  role: Role
  /// Its friend.
  friend: ref members?
  /// Its bonuses.
  bonuses: [Bonus](..=2) @json(pairs: ["stat{i}", "value{i}"])
  /// Its shape.
  shape: Shape @json(inline)
  /// A nested key.
  deep: Int @json(path: "a.b")
}

/// A club.
record Club {
  /// Its name.
  title: String
  /// Its captain.
  captain: ref members
}

/// The members.
@reload
let members: stable table Member = {
  ann { code: 1, role: admin, bonuses: [], shape: dot, deep: 1 }
  bob { code: 2, role: user, friend: ann, bonuses: [{ stat: 1, value: 2 }], shape: circle { radius: 2 }, deep: 2 }
}

/// The club.
@reload
let club: Club = { title: "c", captain: ann }

/// Settings.
record Settings {
  /// Its title.
  title: String
}

/// The settings.
@go(name: "ReadSettings")
let settings: Settings = { title: "s" }

emit go { out: "@features/club", package: "club", mode: data }
emit json { out: "out/" }

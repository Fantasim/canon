-- names/names.canon --
/// Names.
package names

/// A role.
enum Role { user, admin }

/// A badge.
record Badge {
  /// Its role.
  role: Role
  /// Its level.
  level: Int = 1
}

emit go { out: "@features/names", package: "name", mode: baked }
-- club/club.canon --
/// Clubs.
package club

import names { Role, Badge }

/// A stat bonus.
record Bonus {
  /// The stat.
  stat: Int
  /// Its value.
  value: Int
}

/// A shape.
variant Shape @json(tag: "shape") {
  /// A circle.
  circle {
    /// Its radius.
    radius: Int

    /// Its area times n.
    export fn scaled(self, n: Int) -> Int { return radius * n }
  }
  /// A dot.
  dot
}

/// A member.
record Member {
  /// Its code.
  code: Int
  /// Its role.
  role: Role = admin
  /// Its badge.
  badge: Badge?
  /// Its bonuses.
  bonuses: [Bonus](..=2) = [] @json(pairs: ["stat{i}", "value{i}"])
  /// Its shape.
  shape: Shape @json(inline)
  /// A nested key.
  deep: Int = 4 @json(path: "a.b")
  /// A wait.
  wait: Duration? = 2s @json("waitSec", unit: s)
  /// Points by role.
  points: {Role: Int} = {}
  /// A field named like an import types mode writes.
  utf8: Int = 0
  /// Another.
  json: Int = 0
}

/// A club.
record Club {
  /// Its name.
  title: String
  /// Its members.
  members: table Member
}

test "scaled doubles" {
  let c: Shape = circle { radius: 2 }
  expect match c { circle(x) => x.scaled(2), dot => 0 } == 4
}

emit go { out: "@features/club", package: "club", mode: types }

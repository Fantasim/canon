CONFORMANCE.md §2.1 (log-2026-09-24 "gen/go translated fns"): gen/go writes a translated fn returning an entry named through its table (`tiers.high`), in baked and data mode, with the plan's names.
-- b/b.canon --
/// Tiers.
package b

/// A tier.
record Tier {
  /// Its rank.
  rank: Int
}

/// The tiers.
let tiers: table Tier = {
  low { rank: 1 }
  high { rank: 2 }
}

/// The tier for n.
export fn tierFor(n: Int) -> ref Tier { return if n > 1 { tiers.high } else { tiers.low } }

emit go { out: "@features/b", package: "b", mode: data }
emit json { out: "out/" }
-- b.tiers.json --
{ "low": { "rank": 1 }, "high": { "rank": 2 } }

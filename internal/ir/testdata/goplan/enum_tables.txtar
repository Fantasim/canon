CODEGEN.md §3.4, §3.5, §5.2; decisions 383, 393: the package-level tables of an enum's methods are planned exactly as written: a variant with a case wire that is not its name gets a wires table for its kind enum, a closed enum with equal wires keeps one, an enum whose wires are its names has none, and an enum without a member has the names, keys and found tables.
-- tables/tables.canon --
/// Tables.
package tables

/// A shape.
variant Shape @json(tag: "shape") {
  /// A circle.
  circle @json("round") {
    /// Its radius.
    radius: Int
  }
  /// A dot.
  dot
}

/// Equal wires.
enum Twin { a = "x", b = "x" }

/// Wires are the names.
enum Same { p, q }

/// No member.
enum Empty { }

emit go { out: "@features/tables", package: "tables", mode: baked }

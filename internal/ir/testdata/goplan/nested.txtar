-- b/b.canon --
/// Shelves.
package b

/// A slot.
record Slot {
  /// How many.
  n: Int
}

/// A shelf.
record Shelf {
  /// Its slots by id.
  slots: table Slot
  /// Spare slots.
  spare: (table Slot)?
}

/// The shelf.
let shelf: Shelf = { slots: { a { n: 1 } }, spare: none }

emit go { out: "@features/b", package: "b" }
emit json { out: "out/" }

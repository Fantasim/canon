-- lib/lib.canon --
/// Shelves.
package lib

/// A slot.
record Slot {
  /// How many.
  n: Int
}

/// A shelf.
record Shelf {
  /// Its slots by id.
  slots: table Slot
  /// Weights by name.
  weights: {String: Int}
}

emit go { out: "@features/lib", package: "lib", mode: baked }
-- app/app.canon --
/// Rooms.
package app

import lib { Shelf }

/// A room.
record Room {
  /// Its shelf.
  shelf: Shelf
}

/// The room.
let room: Room = { shelf: { slots: { a { n: 1 } }, weights: { "x": 2 } } }

emit go { out: "@features/app", package: "app", mode: data }
emit json { out: "out/" }

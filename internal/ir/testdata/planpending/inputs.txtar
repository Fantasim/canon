CODEGEN.md §3.4, §5.12, §7.7 (log-2026-09-24 "gen/go runtime inputs landed": collision-free slots): LoadInputs, Go's slots input_<T>_<store> with _OK and _Pattern, inputsLoaded_ and LoadInputs' errs, C++'s detail::AInputs with a namespace per class and AInputsLoaded; Gen.flagX and GenFlag.x, code (with a pattern) and codePattern, A_b.c and A.b_c never share a slot. An input field has a getter and no storage.
-- a/a.canon --
package a

/// Generator settings.
record Gen {
  /// A flag.
  flagX: input Bool? from env "FLAG_X"
  /// A code.
  code: input String(/^[a-z]+$/) from env "CODE"
  /// Its pattern.
  codePattern: input String? from env "CODE_PATTERN"
  /// A size.
  size: Int
}

/// More settings.
record GenFlag {
  /// A number.
  x: input Int? from env "GEN_FLAG_X"
}

/// Underscored.
record A_b {
  /// A number.
  c: input Int? from env "C"
}

/// Plain.
record A {
  /// A number.
  b_c: input Int? from env "B_C"
}

/// Everything.
record Root {
  /// The generator.
  gen: Gen
  /// The flag.
  genFlag: GenFlag
  /// Underscored.
  ab: A_b
  /// Plain.
  a: A
}

/// The settings.
let settings: Root = { gen: { size: 1 }, genFlag: {}, ab: {}, a: {} }

emit go { out: "@features/a", package: "a" }
emit cpp { out: "@features/ac", namespace: "a", mode: data }
emit json { out: "out/" }
-- a.settings.json --
{ "gen": { "size": 1 }, "genFlag": {}, "ab": {}, "a": {} }

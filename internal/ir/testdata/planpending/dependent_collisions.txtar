package a

/// A kind.
enum K { a_b @go(name: "KOne") @cpp(name: "one"), aB @go(name: "KTwo") @cpp(name: "two"), c }

/// A payload.
type P(k: K) = match k { a_b => Int, aB => String, c => Never }

/// Named like the branch enum.
record PBranch {
  /// Its size.
  n: Int
}

emit go { out: "@features/a", package: "a" }
emit cpp { out: "@features/ac", namespace: "a", mode: data }

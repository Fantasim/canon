TYPES.md §7.4 ("both are checked"), EVALUATION.md §11.3 step 3, CODEGEN.md §7.7: an input through an alias chain has one Go pattern slot per pattern, innermost first, input_<T>_<store>_Pattern then _Pattern2 and _Pattern3, each declared in the package scope; C++ adds MatchPattern once.
-- a/a.canon --
package a

/// A lower-case code.
type Code = String(/^[a-z]+$/)

/// A short code.
type Short = Code(/^.{1,4}$/)

/// Settings.
record Gen {
  /// A short code, with a pattern of its own.
  code: input Short(/^a/)? from env "CODE"
  /// A lower-case code.
  plain: input Code? from env "PLAIN"
}

/// The settings.
let settings: Gen = {}

emit go { out: "@features/a", package: "a" }
emit cpp { out: "@features/ac", namespace: "a", mode: data }
emit json { out: "out/" }
-- a.settings.json --
{}

CODEGEN.md §2.11, §5.9, DECISIONS 435: only a baked go emit has a build function to cut, so build<Last>_<N> is reserved there alone; in data mode a name equal to build<Last>_0, here an imported package's Go package, is no collision.
-- b/b.canon --
package b

/// A rank.
enum Rank { low, high }

emit go { out: "@features/b", package: "buildA_0", mode: baked }
-- a/a.canon --
package a

import b { Rank }

/// A row.
record Thing {
  /// Its key.
  n: Int
  /// Its rank.
  rank: Rank
}

/// The rows.
let rows: [Thing] keyed by n = [{ n: 1, rank: Rank.low }]

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/" }
-- a.rows.json --
[{ "n": 1, "rank": "low" }]

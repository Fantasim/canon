DECISIONS 213, CODEGEN.md §3.5: a broken record of an unselected package sharing a C++ namespace never meets the selected package's own record of that name (no E8005 across the namespace).
-- selected.txt --
a
-- a/a.canon --
package a

/// A tone.
record Tone {
  /// Its level.
  level: Int
}

/// The tone.
let tone: Tone = { level: 1 }

emit cpp { out: "@features/a", namespace: "shared", mode: data }
emit json { out: "out/" }
-- a.tone.json --
{ "level": 1 }
-- b/b.canon --
package b

/// A tone.
record Tone {
  /// A function.
  zzFn: fn(Int) -> Int
}

emit cpp { out: "@features/b", namespace: "shared", mode: data }
-- findings.txt --
error[E3306]  b/b.canon:6:9
  a function type is not allowed here

1 error, 0 warnings in 2 packages (…)

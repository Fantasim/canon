DECISIONS 213, TYPES.md §1, §12.1 (DECISIONS 226): a broken variant-level export fn is a broken declaration, so stage E refuses nothing on it (no VariantMethod).
-- a/a.canon --
package a

/// A reward.
variant Reward {
  /// Some gold.
  gold {
    /// How much.
    amount: Int
  }
  /// Nothing.
  nothing

  /// What it is worth.
  export fn worth(self) -> Int { return "much" }
}

emit go { out: "@features/a", package: "a" }

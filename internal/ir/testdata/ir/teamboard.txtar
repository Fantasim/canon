fn canTransition(from: ref(String coll=0 teamboard.statuses[] keyed=false local=false), to: ref(String coll=0 teamboard.statuses[] keyed=false local=false)) -> Bool kind=lookup doc="sovcommon's CanTransition."
  domain 0: [open, taken, fixed, verified, wont_do, duplicate]
  domain 1: [open, taken, fixed, verified, wont_do, duplicate]
  cells: [false, true, false, false, true, true, true, false, true, false, true, true, true, false, false, true, false, false, true, false, false, false, false, false, true, false, false, false, false, false, true, false, false, false, false, false]
fn columnOf(s: ref(String coll=0 teamboard.statuses[] keyed=false local=false)) -> opt(ref(String coll=0 teamboard.columns[] keyed=false local=false)) kind=lookup doc="sovcommon's ColumnOf. `none` for a status no active column claims (only a retired\nstatus can be in that case), like the `(Column, bool)` it replaces."
  domain 0: [open, taken, fixed, verified, wont_do, duplicate]
  cells: [unclaimed, taken, fixed, done, done, done]

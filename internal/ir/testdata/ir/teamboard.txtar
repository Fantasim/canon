  cells: [[], [game, balance, website, team_board], [game, balance, website, team_board], [game, balance, website, resource_studio, client, resource, team_board], [game, balance, website, resource_studio, client, resource, team_board], [game, balance, website, resource_studio, game_server, client, resource, sovcommon, admin_panel, analytics, team_board, internal]]
fn groupedAreasVisibleTo(role: sovcommon.roles.Role) -> list(teamboard.AreaSection) kind=lookup doc="sovcommon's GroupedAreasVisibleTo: headers only for groups with a visible area."
  domain 0: [member, gm_junior, gm_senior, maintainer, owner, admin]
  cells: [[], [AreaSection{group: in_game, areas: [game, balance]}, AreaSection{group: out_game, areas: [website]}, AreaSection{group: internal, areas: [team_board]}], [AreaSection{group: in_game, areas: [game, balance]}, AreaSection{group: out_game, areas: [website]}, AreaSection{group: internal, areas: [team_board]}], [AreaSection{group: in_game, areas: [game, balance, client, resource]}, AreaSection{group: out_game, areas: [website]}, AreaSection{group: internal, areas: [resource_studio, team_board]}], [AreaSection{group: in_game, areas: [game, balance, client, resource]}, AreaSection{group: out_game, areas: [website]}, AreaSection{group: internal, areas: [resource_studio, team_board]}], [AreaSection{group: in_game, areas: [game, balance, game_server, client, resource]}, AreaSection{group: out_game, areas: [website]}, AreaSection{group: internal, areas: [resource_studio, sovcommon, admin_panel, analytics, team_board, internal]}]]

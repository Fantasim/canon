package a

/// A reward.
variant Reward {
  /// Some gold.
  gold {
    /// How much.
    amount: Int
  }
  /// Nothing.
  nothing
}

/// A holder.
record R {
  /// Its key.
  k: String
  /// A gold reward, if any.
  c: Reward.gold?
}

/// The holders.
let rs: [R] keyed by k = [{ k: "a" }]

emit json { out: "@features/a/data/" }
emit ts { out: "@features/a/a.ts", mode: data }

CODEGEN.md §4.2: gen/cpp in types mode writes a table field of its own package's record, but not of another package's: TableField at that field.
-- b/b.canon --
package b

/// A point.
record Point {
  /// Across.
  x: Int
}

emit cpp { out: "@features/b", namespace: "b", mode: types }
-- a/a.canon --
package a

import b { Point }

/// A shelf.
record Shelf {
  /// Points by name.
  points: table Point
}

emit cpp { out: "@features/a", namespace: "a", mode: types }

CODEGEN.md §5.6, DECISIONS 278: a dependent value in a map a ts data loader reads has no discriminant to read it with: DependentType at the field, from check, not a crash of the build.
-- a/a.canon --
package a

/// A goal.
enum Goal { kill, collect }

/// A target.
type Target(g: Goal) = match g {
  kill => String
  collect => Int
}

/// An objective.
record O {
  /// Its id.
  id: String
  /// The goal.
  goal: Goal
  /// Targets by name.
  m: {String: Target(goal)} = {}
}

/// The objectives.
let os: [O] keyed by id = [{ id: "a", goal: kill, m: { "x": "wolf" } }]

emit json { out: "@features/a/data/" }
emit ts { out: "@features/a/a.ts", mode: data }

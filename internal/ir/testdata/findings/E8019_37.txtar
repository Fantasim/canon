EVALUATION.md §1, WIRE.md §5.9: a ref into a list keyed by a field of an enum written as its codes is written as that code, so a union of it is not a string union (check accepts it: TYPES §13.2 counts every enum as string-wired); gen/go's data loader refuses it.
-- a/a.canon --
package a

/// A tone.
enum Tone @codes(UInt8) @json(codes) { soft = 1, loud = 2 }

/// A colour.
record Colour {
  /// Its tone.
  tone: Tone
}

/// The colours.
let colours: [Colour] keyed by tone = [{ tone: soft }]

/// A cap.
record Cap {
  /// The colour.
  colour: ref colours | "auto"
}

/// The caps.
let caps: table Cap = {
  one { colour: "auto" }
}

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/" }
-- a.colours.json --
[{"tone": 1}]
-- a.caps.json --
{"one": {"colour": "auto"}}
-- findings.txt --
error[E8019]  a/a.canon:18:3
  emit go in data mode cannot generate a literal union whose wire form is not a string

1 error, 0 warnings in 1 package (…)

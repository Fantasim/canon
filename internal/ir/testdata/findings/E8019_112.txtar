/// R.
package r

/// An item.
record Item {
  /// Its name.
  name: String
}

/// The items.
let items: table Item = {
  a { name: "a" }
}

emit go { out: "@features/r/go", package: "r", mode: data }
emit cpp { out: "@features/r/cpp", namespace: "r", mode: data }
emit json { out: "out/r/" }
-- p/p.canon --
/// P.
package p

import r { items }

/// A holder.
record Holder {
  /// N.
  n: Int
  /// A price per item.
  export fn price(self, it: ref items) -> Int { return self.n }
}

emit go { out: "@features/p/go", package: "p" }
emit cpp { out: "@features/p/cpp", namespace: "p" }

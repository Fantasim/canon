EVALUATION.md §1, CODEGEN.md §5.9, DECISIONS 312: gen/go's data loader reads a map in a class it decodes, keys as WIRE.md §5.8 (a literal union too), but a dependent map is DependentType; Loose, held by no value, is not decoded and is fine.
-- a/a.canon --
package a

/// A kind.
enum Kind { a, b }

/// A status.
record S {
  /// Label.
  label: String
}

/// The statuses.
let statuses: table S = {
  open { label: "Open" }
}

/// A rate.
record Rate(s: S) {
  /// Value.
  value: Int
}

/// A row.
record Row {
  /// The cells.
  cells: {Kind | "all": Int}
  /// By status.
  by: {s in statuses: Rate(s)}
}

/// Not held by any value.
record Loose {
  /// By status.
  by: {s in statuses: Rate(s)}
}

/// The rows.
let rows: table Row = {
  one { cells: {"all": 1}, by: { open: { value: 1 } } }
}

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/" }
-- a.rows.json --
{"one": {"cells": {"all": 1}, "by": {"open": {"value": 1}}}}

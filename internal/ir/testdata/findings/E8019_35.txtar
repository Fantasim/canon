EVALUATION.md §1, decision 219: gen/go's data loader reads no case used as a type, in a class it decodes (Row); Loose, which no value holds, is not decoded and its case field has a Go type.
-- a/a.canon --
package a

/// A shape.
variant Shape {
  /// A dot.
  dot
  /// A box.
  box {
    /// Its side.
    side: Int
  }
}

/// A row.
record Row {
  /// The box.
  b: Shape.box
}

/// Held by no value.
record Loose {
  /// The box.
  b: Shape.box
}

/// The rows.
let rows: table Row = {
  one { b: { side: 1 } }
}

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/" }
-- a.rows.json --
{"one": {"b": {"side": 1}}}
-- findings.txt --
error[E8019]  a/a.canon:17:3
  emit go in data mode cannot generate a case used as a type

1 error, 0 warnings in 1 package (…)

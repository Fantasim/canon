package a

/// A first.
record First {
  /// Its second.
  second: Second?
}

/// A second.
record Second {
  /// Its first.
  first: First
}

/// The first.
let first: First = { second: none }

emit cpp { out: "@features/a", namespace: "a", mode: data }
emit json { out: "out/" }

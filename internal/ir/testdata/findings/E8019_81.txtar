DECISIONS 284: a stored method whose result is a list of its own record reaches its receiver by value through the list: refused for baked Go, judged on types (the list is empty here).
-- a/a.canon --
package a

/// A node.
record Node {
  /// Its key.
  id: String

  /// Its children.
  export fn children(self) -> [Node] { return [] }
}

/// The nodes.
let nodes: [Node] keyed by id = [{ id: "x" }]

emit go { out: "@features/a", package: "a", mode: baked }
-- findings.txt --
error[E8019]  a/a.canon:9:13
  emit go in baked mode cannot generate a by-value cycle of records through a stored method result; return a ref to the record instead


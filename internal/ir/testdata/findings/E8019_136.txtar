CODEGEN.md §5.1, DECISIONS 453: gen/cpp refuses a constant holding a record (RecordConstant); an optional record is that one finding, not also OptionalConstant (DependentConstant > RecordConstant > OptionalConstant, RefConstant).
-- a/a.canon --
package a

/// A box.
record Box {
  /// V.
  v: Int
}

/// An outer.
record Outer {
  /// Inner.
  inner: Box?
}

/// An optional record constant.
const OB = Outer { inner: Box { v: 1 } }.inner

emit cpp { out: "@features/a", namespace: "a", mode: data }
-- a.OB.json --
{"v": 1}

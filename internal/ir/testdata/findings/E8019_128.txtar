CODEGEN.md §5.1, DECISIONS 453: gen/cpp writes no constant of a ref type: RefConstant.
-- a/a.canon --
package a

/// Events.
enum Event {
  /// A.
  a
  /// B.
  b
}

/// A row.
record Row {
  /// Event.
  event: Event
  /// N.
  n: Int
}

/// Rows.
let rows: [Row] keyed by event = [
  { event: a, n: 1 },
  { event: b, n: 2 },
]

/// A holder.
record Holder {
  /// A ref.
  r: ref rows
}

/// A ref constant.
const R = Holder { r: a }.r

emit cpp { out: "@features/a", namespace: "a" }
-- a.R.json --
"a"

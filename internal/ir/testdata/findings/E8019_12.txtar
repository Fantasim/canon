EVALUATION.md §1, CODEGEN.md §5.9: gen/go's data loader decodes a stored method's result from its `$` key, and the decoder of another package's record is unexported there: ForeignDataRecord, precomputed or lookup.
-- b/b.canon --
package b

/// A point.
record Point {
  /// Across.
  x: Int
}

emit go { out: "@features/b", package: "b", mode: data }
-- a/a.canon --
package a

import b { Point }

/// A tone.
enum Tone { soft, loud }

/// A place.
record Place {
  /// Where.
  x: Int

  /// Its point.
  export fn point(self) -> Point { return { x: x } }

  /// Its point per tone.
  export fn pointFor(self, t: Tone) -> Point { return { x: x } }
}

/// The places.
let places: table Place = {
  one { x: 1 }
}

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/" }
-- a.places.json --
{"one": {"x": 1}}
-- findings.txt --
error[E8019]  a/a.canon:14:13
  emit go in data mode cannot generate a record or variant of another package read by a data loader

error[E8019]  a/a.canon:17:13
  emit go in data mode cannot generate a record or variant of another package read by a data loader

2 errors, 0 warnings in 2 packages (…)

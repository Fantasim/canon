EVALUATION.md §1, CODEGEN.md §5.6, DECISIONS 350: a discriminant read through a ref is decided at build time by a key→branch table, except through a ref into a @reload value, whose reload may add keys the binary's table lacks: the field stays DependentType, in both loaders.
-- a/a.canon --
package a

/// A kind.
enum K { one, two }

/// An event.
record Ev {
  /// Its kind.
  k: K
}

/// The events.
@reload
let evs: table Ev = { x { k: one } }

/// A payload.
type P(e: Ev) = match e.k { one => Int, two => String }

/// A thing.
record Thing {
  /// Its event.
  ev: ref evs
  /// Its payload.
  p: P(ev)
}

/// The things.
let things: table Thing = {
  a { ev: x, p: 1 }
}

emit go { out: "@features/a", package: "a", mode: data }
emit cpp { out: "@features/ac", namespace: "a", mode: data }
emit json { out: "out/" }
-- a.evs.json --
{"x": {"k": "one"}}
-- a.things.json --
{"a": {"ev": "x", "p": 1}}
-- findings.txt --
error[E8019]  a/a.canon:24:3
  emit cpp in data mode cannot generate a dependent value decided through an optional, a record parameter, a ref into a `@reload` value or a ref into an enclosing record's table field; decide it by an enum field of the same record, or by a ref into a let that is not `@reload`

error[E8019]  a/a.canon:24:3
  emit go in data mode cannot generate a dependent value decided through an optional, a record parameter, a ref into a `@reload` value or a ref into an enclosing record's table field; decide it by an enum field of the same record, or by a ref into a let that is not `@reload`


decisions 180, 194: baked go does not generate a ref into a load.defines table yet, so check refuses the field that holds one, matching what build would refuse.
-- a/a.canon --
package a

local let kinds = load.defines("@features/a/kinds.h")

/// A rule.
record Rule {
  /// Its kind.
  kind: ref kinds
}

emit go { out: "@features/a", package: "a" }

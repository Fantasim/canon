package a

/// A row.
record Row {
  /// Its key.
  k: Int
}

/// The first rows.
let foo_bar: [Row] keyed by k = [{ k: 1 }]

/// The second rows.
let fooBar: [Row] keyed by k = [{ k: 2 }]

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/" }

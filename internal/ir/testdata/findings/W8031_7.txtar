CODEGEN.md §2.10, DECISIONS 278, EVALUATION.md §13.1: a ts data emit writes a record's constant field default with its stored method results (precompute.go), so a marked result of the default's receiver is W8031, named after the method, at the leaf.
-- a/a.canon --
package a

/// Inner.
record Inner {
  /// N.
  n: Int

  /// Its place.
  export fn place(self) -> Int { return 4 }
}

/// Outer.
record Outer {
  /// Its inner.
  inner: Inner = { n: 1 }
}

emit ts { out: "@features/a/a.ts", mode: data }

CODEGEN.md §2.8, DECISIONS 343, 347: b's only go copy lies under the consumer root admin, which only `canon build --only-root admin` writes; a's copy under the ordinary root lib uses b.Tone, so no build of a writes the code it imports (E8004 consumerCopy).
-- project.canon --
project acme {
  canon: "0.1"
  roots {
    lib: "lib"
    admin: "admin"
  }
  consumer_roots: [admin]
  go_module {
    lib: "example.com/lib"
    admin: "example.com/admin"
  }
}
-- b/b.canon --
package b

/// A colour.
enum Tone { red, blue }

emit go { out: "@admin/b/" }
-- a/a.canon --
package a

import b { Tone }

/// A badge.
record Badge {
  /// Its colour.
  tone: Tone
}

emit go { out: "@lib/a/" }
-- findings.txt --
error[E8004]  a/a.canon:11:16
  package b is used by this go copy under root lib, but its only go copy is under consumer root admin, which builds alone: give the go emit of b a copy under lib

1 error, 0 warnings in 2 packages (…)

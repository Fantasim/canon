DECISIONS 282, CODEGEN.md §5.13: a default that does not fold and whose type takes an argument (the
earlier field ev, or a dependent map's key) is computed, so types mode refuses it like L's own default
reading its parameter.
-- a/a.canon --
package a

/// Ev.
record Ev {
  /// Max.
  max: Int = 5
}

/// Evs.
let evs: table Ev = { a {}, b { max: 7 } }

/// L.
record L(e: Ev) {
  /// Its event's max.
  top: Int = e.max
}

/// R.
record R {
  /// Ev.
  ev: ref evs
  /// L of ev.
  l: L(ev) = {}
  /// Many, none by default: a constant.
  ls: [L(ev)] = []
  /// By key: L of each key.
  dm: {k in evs: L(k)} = { a: {} }
}

emit go { out: "@features/a", package: "a", mode: types }
-- findings.txt --
error[E8014]  a/a.canon:15:3
  types mode cannot emit the computed default of L.top: there is no data to read it from

error[E8014]  a/a.canon:23:3
  types mode cannot emit the computed default of R.l: there is no data to read it from

error[E8014]  a/a.canon:27:3
  types mode cannot emit the computed default of R.dm: there is no data to read it from

3 errors, 0 warnings in 1 package (…)

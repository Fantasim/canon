package a

/// A tone.
enum Tone { soft, loud }

/// An item.
record Item {
  /// Its level.
  n: Int

  /// Its level, or zero when the tones differ.
  export fn mix(self, Tone: Tone, other: Tone) -> Int { return if Tone == other { n } else { 0 } }
}


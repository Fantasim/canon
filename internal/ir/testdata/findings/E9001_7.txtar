CONFORMANCE.md §2.2: a `match` is named by its head; a format spec by its interpolation.
-- a/a.canon --
package a

/// A tone.
enum Tone { soft, loud }

/// A level.
export fn level(t: Tone, n: Int) -> Int {
  return match t {
    soft => n
    loud => n * 2
  }
}

/// A padded n.
export fn padded(n: Int) -> String { return "{n:,}" }

emit go { out: "@features/a", package: "a" }

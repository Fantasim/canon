GRAMMAR.md §8.3, DECISIONS 390: @cpp(defines:) on a local constant or a local enum is E1118, since no defines header writes a local declaration; the same annotation on a public one is fine.
-- a/a.canon --
package a

/// Local.
@cpp(defines: "")
local const A = 1

/// Public.
@cpp(defines: "")
const B = 2

/// Local.
local enum E @cpp(defines: "E_") {
  /// A member.
  x
}

/// Public.
enum F @cpp(defines: "F_") {
  /// A member.
  y
}

emit cpp { out: "@features/a", namespace: "a", mode: data }
-- findings.txt --
error[E1118]  a/a.canon:4:1
  @cpp is not allowed on this local

error[E1118]  a/a.canon:12:14
  @cpp is not allowed on this local


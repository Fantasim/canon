-- a/a.canon --
package a

/// Shapes.
enum Shape {
  /// Count.
  count
  /// Place.
  place
}

/// A param by shape.
type Param(s: Shape) = match s {
  count => Int
  place => String
}

/// A holder.
record Holder {
  /// A shape.
  shape: Shape
  /// A dependent value.
  p: Param(shape)
}

/// A dependent constant.
const P = Holder { shape: count, p: 3 }.p

emit go { out: "@features/a", package: "a" }

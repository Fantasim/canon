package a

/// A kind.
enum K { one, two }

/// A payload that never holds a value.
type P(k: K) = match k { one => Never, two => Never }

/// A shape.
variant Shape {
  /// A circle.
  circle
  /// A point.
  point {
    /// Whether it is at the origin.
    export fn atOrigin(self) -> Bool { return true }
  }
}

emit ts { out: "@features/a/a.ts" }

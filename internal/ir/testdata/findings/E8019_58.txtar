CODEGEN.md §5.6, DECISIONS 278, 350: a ts loader decides a discriminant read through a ref by a build-time table, except through a ref into a @reload value (a reload may add keys): DependentType at the field, from check, not a crash of the build.
-- a/a.canon --
package a

/// A goal.
enum Goal { kill, collect }

/// A target.
type Target(g: Goal) = match g {
  kill => String
  collect => Int
}

/// A goal holder.
record G {
  /// The goal.
  goal: Goal
}

/// The goals.
@reload
let gs: table G = {
  k { goal: kill }
}

/// An objective.
record O {
  /// Its id.
  id: String
  /// Its goal, by ref.
  g: ref gs
  /// The target of that goal.
  t: Target(g.goal)
}

/// The objectives.
let os: [O] keyed by id = [{ id: "a", g: k, t: "wolf" }]

emit json { out: "@features/a/data/" }
emit ts { out: "@features/a/a.ts", mode: data }

package a

/// A status.
record S {
  /// Label.
  label: String
}

/// The statuses.
let statuses: table S = {
  open { label: "Open" }
}

/// A rate.
record Rate(s: S) {
  /// Value.
  value: Int
}

/// Rates.
record Rates {
  /// By status.
  byStatus: {s in statuses: Rate(s)}
}

/// The rates.
let rates: Rates = { byStatus: { open: { value: 1 } } }

emit json { out: "@features/a/data/" }
emit ts { out: "@features/a/a.ts", mode: data }

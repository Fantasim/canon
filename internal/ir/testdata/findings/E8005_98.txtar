CODEGEN.md §7.9, ERRORS.md E8005 (DECISIONS 442, amends 403): a name the generator fixes (the members every container and access struct has, the access struct's Data and Build, its own name, the members of an entry) is `foreignFixed`, whose only way out is a use of a type of the defining package; no @cpp(name:) renames it, and one finding is made for each item that declares it.
-- a/a.canon --
package a

/// Words; the defines keep the names.
enum Word @cpp(defines: "") {
  /// Spelled like b's container and access struct member.
  Get
  /// Spelled like b's access struct member.
  Build
  /// Spelled like b's access struct.
  BAccess
  /// Spelled like b's entry member.
  GetId
}

emit cpp { out: "@features/a", namespace: "a", mode: types }
-- b/b.canon --
package b

/// A tier.
record Tier {
  /// Its rank.
  rank: Int
}

/// The tiers.
let tiers: table Tier = {
  one { rank: 1 }
}

emit cpp { out: "@features/b", namespace: "b", mode: baked }
emit json { out: "out/" }
-- b.tiers.json --
{ "one": { "rank": 1 } }

EVALUATION.md §1, CODEGEN.md §4.2: gen/cpp has no type for a list of optional elements either.
-- a/a.canon --
package a

/// A row.
record Row {
  /// The cells.
  cells: [Int?]
}

/// The rows.
let rows: table Row = {
  one { cells: [1, none] }
}

emit cpp { out: "@features/a", namespace: "a", mode: data }
emit json { out: "out/" }
-- a.rows.json --
{"one": {"cells": [1, null]}}

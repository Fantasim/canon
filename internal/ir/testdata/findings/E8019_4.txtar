EVALUATION.md §1, CODEGEN.md §5.6, §5.7 (gen/go dependentDiscFormat): baked gen/go writes a dependent value in the branch its record's fields select (ir.DiscFields), so a selected value whose dependent field's argument is a record parameter is DependentType at the value.
-- a/a.canon --
package a

/// A kind.
enum K { one, two }

/// A payload.
type P(k: K) = match k { one => Int, two => String }

/// A limit.
record L(k: K) {
  /// Its payload.
  p: P(k)
}

/// A thing.
record Thing {
  /// Its kind.
  k: K
  /// Its limit.
  l: L(k)
}

/// Holds a payload through its limit.
let full: Thing = { k: one, l: { p: 1 } }

emit go { out: "@features/a", package: "a" }
-- a.full.json --
{"k": "one", "l": {"p": 1}}
-- findings.txt --
error[E8019]  a/a.canon:24:5
  emit go in baked mode cannot generate a dependent type


package a

/// A tier.
record Tier {
  /// Its rank.
  rank: Int
}

/// The tiers.
let tiers: table Tier = {
  low { rank: 1 }
  high { rank: 2 }
}

/// A member.
record Member {
  /// Its tier.
  tier: ref Tier

  /// Its tier, whatever n.
  export fn tierAt(self, n: Int) -> ref Tier { return self.tier }
}


CONFORMANCE.md §2.2 (log-2026-09-24 "gen/go translated fns"): a translated body may call a lookup function, but one whose result is optional holds no value of the portable subset, so the call is refused.
-- a/a.canon --
package a

/// Maybe a bonus.
export fn bonus(big: Bool) -> Int? { return if big { 1 } else { none } }

/// A score.
export fn score(n: Int) -> Int {
  let b = bonus(n > 1)
  return n
}

emit go { out: "@features/a", package: "a" }
-- findings.txt --
error[E9001]  a/a.canon:8:11
  bonus(n > 1) is not allowed in translated function score: it is outside the portable subset


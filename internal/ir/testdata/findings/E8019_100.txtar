EVALUATION.md §1, CODEGEN.md §5.6, §5.9, DECISIONS 312: a dependent key in a map a data loader reads is DependentType (not MapField), for both generators.
-- a/a.canon --
package a

/// A goal.
enum Goal { kill, collect }

/// A name.
type Name(g: Goal) = match g {
  kill => String
  collect => String
}

/// An objective.
record O {
  /// The goal.
  goal: Goal
  /// Counts by a name of the goal.
  m: {Name(goal): Int}
}

/// The objective.
let o: O = { goal: kill, m: { "x": 1 } }

emit go { out: "@features/a", package: "a", mode: data }
emit cpp { out: "@features/ac", namespace: "a", mode: data }
emit json { out: "out/" }

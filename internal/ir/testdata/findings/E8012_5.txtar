decisions 180, 194, 37: gen/go writes no ref into a load.defines table in data mode either (no define value getter nor table yet), so check refuses the field that holds one, as build would.
-- a/a.canon --
package a

local let kinds = load.defines("@features/a/kinds.h")

/// A rule.
record Rule {
  /// Its kind.
  kind: ref kinds
}

emit go { out: "@features/a", package: "a", mode: data }

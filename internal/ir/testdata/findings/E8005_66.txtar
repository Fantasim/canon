CODEGEN.md §7.9, DECISIONS 389, 390: a constant and an enum member giving one define name are E8005, reported at the later declaration, the constant here.
-- a/a.canon --
package a

/// First kinds.
enum First @cpp(defines: "X_") {
  /// One.
  one
}

/// A constant named like the define.
@cpp(defines: "X_")
const one = 1

emit cpp { out: "@features/a", namespace: "a", mode: data }
-- findings.txt --
error[E8005]  a/a.canon:11:7
  #define X_one is written for both a.First.one and one; change one prefix, or rename one declaration


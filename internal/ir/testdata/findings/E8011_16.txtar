CODEGEN.md §3.4, DECISIONS 388: a record whose name is a macro of <cstddef> is a C++ class of that name, so E8011 `macro` at the record.
-- a/a.canon --
package a

/// A pointer value.
record NULL {
  /// Its size.
  size: Int
}

emit cpp { out: "@features/a", namespace: "a", mode: data }

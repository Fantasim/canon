EVALUATION.md §1, CODEGEN.md §5.10: baked Go enumerates a lookup's ref domain from its own package's tables, so a parameter into another package's table is ForeignTableLookupParam.
-- b/b.canon --
package b

/// A status.
record Status {
  /// Its label.
  label: String
}

/// The statuses.
let statuses: table Status = {
  open { label: "Open" }
}

emit go { out: "@features/b", package: "b" }
-- b.statuses.json --
{"open": {"label": "Open"}}
-- a/a.canon --
package a

import b { statuses }

/// A weight per status.
export fn weight(s: ref statuses) -> Int { return 1 }

emit go { out: "@features/a", package: "a" }
-- findings.txt --
error[E8019]  a/a.canon:6:18
  emit go in baked mode cannot generate a lookup whose parameter is a ref into a table of another package

1 error, 0 warnings in 2 packages (…)

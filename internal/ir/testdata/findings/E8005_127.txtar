-- a/a.canon --
package a

/// A shape.
enum Shape { count, place, none_ }

/// An event row.
record E2 {
  /// Its key.
  k: Int
  /// Its shape.
  shape: Shape
}

/// Events.
let ee2: [E2] keyed by k = [{ k: 1, shape: count }, { k: 2, shape: place }]

/// A parameter, by shape.
type Param(s: Shape) = match s {
  count => Int(0..)
  place => String
  none_ => Never
}

/// A reward.
record Reward {
  /// Its event.
  ev: ref ee2
  /// A parameter, decided through the event.
  by_ev: Param(ev.shape)? @json(none: 0) @ts(name: "first")
  /// The same parameter again.
  byEv: Param(ev.shape)? @json(none: 0) @ts(name: "second")
}

emit ts { out: "@features/a/a.ts", mode: types }

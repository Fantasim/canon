EVALUATION.md §1, CODEGEN.md §5.8: gen/go's data resolver has no walk for a lookup method's cells holding a ref resolved at load.
-- a/a.canon --
package a

/// A tone.
enum Tone { soft, loud }

/// A thing.
record Thing {
  /// Its key.
  a: Int
  /// Its peer.
  peer: ref things

  /// Itself per tone.
  export fn me(self, t: Tone) -> Thing { return self }
}

/// The things.
let things: [Thing] keyed by a = [{ a: 1, peer: 1 }]

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/" }
-- a.things.json --
[{"a": 1, "peer": 1}]
-- findings.txt --
error[E8019]  a/a.canon:14:13
  emit go in data mode cannot generate a lookup method whose result holds a ref resolved at load

1 error, 0 warnings in 1 package (…)

-- user/user.canon --
package user

import base { Tone, badges }
import base as b

/// An award.
record Award {
  /// Its code.
  code: String
  /// A tone.
  tone: Tone
  /// A badge.
  badge: ref badges
  /// Its badge, read by this module.
  copy: b.Badge
  /// Its own badge.
  mine: Badge
}

/// The award's own badge, named like base.Badge.
record Badge {
  /// Its note.
  note: String
}

/// Named like the Members table of base.Tone: base.ToneMembers lives in its namespace.
record ToneMembers {
  /// X.
  x: Int
}

/// Named like this module's reader of base.Badge.
record Reader @ts(name: "read_base_Badge") {
  /// X.
  x: Int
}

/// Named like the id type of base.badges: base.BadgeId lives in its namespace.
record BadgeId {
  /// X.
  x: Int
}

/// The awards.
let awards: [Award] keyed by code = [{ code: "a", tone: red, badge: gold, copy: { label: "g" }, mine: { note: "n" } }]

emit json { out: "@features/user/data/" }
emit ts { out: "@features/user/user.ts", mode: data }

EVALUATION.md §1, CODEGEN.md §4.1 (gen/go stringWire): gen/go's data loader reads no literal union over a ref yet; gen/cpp holds it as its string (DECISIONS 387), so only the go emit is refused.
-- a/a.canon --
package a

local let kinds = load.defines("@features/a/kinds.h")

/// A rule.
record Rule {
  /// Its kind, or none.
  c: ref kinds | "none"
}

/// The rules.
let rules: table Rule = {
  one { c: "none" }
}

emit go { out: "@features/a", package: "a", mode: data }
emit cpp { out: "@features/ac", namespace: "a", mode: data }
emit json { out: "out/" }

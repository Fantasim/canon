SPEC.md §15.5: @reload on a value whose type only contains the legacy struct through a nested record and a list, not directly (a map field is E8019 in cpp data mode).
-- a/a.canon --
package a

/// An item.
record Item @cpp(struct: "ItemProp", header: "ItemProp.h", access: fields) {
  /// Its key.
  id: String
}

/// A bundle of items by slot.
record Bundle {
  /// The items, in slot order.
  bySlot: [Item]
}

/// The bundle.
@reload let bundle: Bundle = { bySlot: [{ id: "sword" }] }

emit cpp { out: "out/", mode: data }
emit json { out: "out/" }
-- findings.txt --
error[E8201]  a/a.canon:16:13
  @reload on bundle: Item maps onto legacy struct ItemProp in fields mode, whose pointers legacy code keeps

1 error, 0 warnings in 1 package (…)

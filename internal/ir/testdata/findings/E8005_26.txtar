package a

/// A tone.
enum Tone { soft, loud }

/// An item.
record Item {
  /// Its level.
  n: Int

  /// Its tone.
  export fn tone(self) -> Tone { return if n > 1 { Tone.loud } else { Tone.soft } }
}

/// The item.
let item: Item = { n: 2 }

emit cpp { out: "@features/a", namespace: "a", mode: data }
emit json { out: "out/" }

package a

/// A slot.
record Slot {
  /// How many.
  n: Int
}

/// A shelf.
record Shelf {
  /// Its slots.
  slots: table Slot
}

/// The shelf.
let shelf: Shelf = { slots: { a { n: 1 } } }

emit cpp { out: "@features/a", namespace: "a", mode: data }
emit json { out: "out/" }

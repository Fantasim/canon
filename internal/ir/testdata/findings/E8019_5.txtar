EVALUATION.md §1 (stage E, CODEGEN.md §5.9): gen/go's indexValues refuses a table of a foreign record whether or not this emit selects it.
-- b/b.canon --
package b

/// A point.
record Point {
  /// Across.
  x: Int
}

emit go { out: "@features/b", package: "b" }
-- a/a.canon --
package a

import b { Point }

/// A count.
let count: Int = 1

/// Every point.
let points: table Point = {
  one { x: 1 }
}

emit go { out: "@features/a", package: "a", values: [count] }
-- a.count.json --
1
-- a.points.json --
{ "one": { "x": 1 } }
-- findings.txt --
error[E8019]  a/a.canon:9:5
  emit go in baked mode cannot generate a value of a record, variant or table of another package

1 error, 0 warnings in 2 packages (…)

EVALUATION.md §1 (stage E, CODEGEN.md §5.9): baked Go cannot literal-ize a precomputed fn's result of another package's record.
-- b/b.canon --
package b

/// A point.
record Point {
  /// Across.
  x: Int
}

emit go { out: "@features/b", package: "b" }
-- a/a.canon --
package a

import b { Point }

/// The origin.
export fn origin() -> Point { return { x: 0 } }

emit go { out: "@features/a", package: "a" }
-- a.origin.calls.json --
{"": {"x": 0}}
-- findings.txt --
error[E8019]  a/a.canon:6:11
  emit go in baked mode cannot generate a value of a record, variant or table of another package

1 error, 0 warnings in 2 packages (…)

CODEGEN.md §5.9, §7.9, ERRORS.md E8005 (DECISIONS 403; log-2026-11-01 E8005-ID review): a's macro GetTiers is both b's table id GetTiers and the table's accessor GetTiers, two origins, so two findings at the table: foreignId for the id, foreignDefine for the accessor, which the value's @cpp(name:) renames.
-- a/a.canon --
package a

/// Words; the defines keep the names.
enum Word @cpp(defines: "") {
  /// Spelled like b's table id and its accessor.
  GetTiers
}

emit cpp { out: "@features/a", namespace: "a", mode: types }
-- b/b.canon --
package b

/// A tier.
record Tier {
  /// Its rank.
  rank: Int
}

/// The tiers; the id of the first is a's macro.
let tiers: table Tier = {
  GetTiers { rank: 1 }
  other { rank: 2 }
}

emit cpp { out: "@features/b", namespace: "b", mode: baked }
-- b.tiers.json --
{ "GetTiers": { "rank": 1 }, "other": { "rank": 2 } }

CODEGEN.md §2.8, §5.6, DECISIONS 305, 320, 350: app's go data loader reads lib's Ev with app's own reader, and Ev's payload is decided through a ref into kinds, a @reload value a reload may add keys to, so no build-time table decides it: E8019 `DependentType` at app's value that reads Ev, naming the way out. lib's data emit loads only kinds, which holds no Ev.
-- lib/lib.canon --
/// The library.
package lib

/// A kind.
enum K { one, two }

/// A kind entry.
record KindEntry {
  /// Its kind.
  k: K
}

/// The kinds.
@reload
let kinds: table KindEntry = {
  first { k: one }
}

/// A payload.
type P(k: K) = match k { one => Int, two => String }

/// An event.
record Ev {
  /// Its kind entry.
  kind: ref kinds
  /// Its payload, decided through the ref.
  p: P(kind.k)
}

emit go { out: "@features/lib/go", package: "lib", mode: data }
emit json { out: "out/lib/" }
-- app/app.canon --
/// The app.
package app

import lib { Ev }

/// The app's event.
let ev: Ev = { kind: first, p: 1 }

emit go { out: "@features/app/go", package: "app", mode: data }
emit json { out: "out/" }

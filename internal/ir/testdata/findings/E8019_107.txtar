  /// Its width.
  width: Int
}

/// The slots.
let slots: table Slot = {
  wide { width: 2 }
}

emit go { out: "@features/lib/go", package: "lib", mode: data }
emit json { out: "out/" }
-- app/app.canon --
/// The app.
package app

import core { tiers }
import lib { slots }

/// A tier's bonus: its parameter refs core's baked table.
export fn bonus(t: ref tiers) -> Int { return 1 }

/// A slot's cost: its parameter refs lib's table, which has no id enum.
export fn cost(s: ref slots) -> Int { return 2 }

emit go { out: "@features/app/go", package: "app" }

-- core/core.canon --
/// The core.
package core

/// A tier.
record Tier {
  /// Its rank.
  rank: Int
}

/// The tiers.
let tiers: table Tier = {
  low { rank: 1 }
}

emit go { out: "@features/core/go", package: "core" }
-- lib/lib.canon --
/// The library.
package lib

/// A slot.

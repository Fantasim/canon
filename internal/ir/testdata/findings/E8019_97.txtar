EVALUATION.md §1, CODEGEN.md §5.9, DECISIONS 312: gen/go's data loader decodes a record of another package with that package's unexported decoder, so it refuses one as a map's value as well: ForeignDataRecord, not a loader that fails to build.
-- b/b.canon --
package b

/// A point.
record Point {
  /// Across.
  x: Int
}

emit go { out: "@features/b", package: "b", mode: data }
-- a/a.canon --
package a

import b { Point }

/// A place.
record Place {
  /// Points by name.
  far: {String: Point}
  /// Maybe more.
  more: [{String: Point}] = []
}

/// The places.
let places: table Place = {
  one { far: { "p": { x: 1 } } }
}

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/" }
-- a.places.json --
{"one": {"far": {"p": {"x": 1}}}}
-- findings.txt --
error[E8019]  a/a.canon:8:3
  emit go in data mode cannot generate a record or variant of another package read by a data loader

error[E8019]  a/a.canon:10:3
  emit go in data mode cannot generate a record or variant of another package read by a data loader

2 errors, 0 warnings in 2 packages (…)

CODEGEN.md §5.13: types mode has no data for a precomputed fn or a computed default.
-- a/a.canon --
package a

/// An answer.
export fn answer() -> Int { return 42 }

/// A range of levels.
record Span {
  /// The first level.
  low: Int
  /// The last level.
  high: Int = low + 10
}

emit cpp { out: "@features/a", namespace: "a", mode: types }

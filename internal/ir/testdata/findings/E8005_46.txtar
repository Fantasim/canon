CODEGEN.md §2.8, §3.5, DECISIONS 279(b): the stage-E name plan reserves the names of every package a TypeScript file reaches through other packages' types, as it imports them: a's own record Tag meets c.Tag, which a reaches through b.Badge's map of tags, so it is E8005 from check, not a crash of the build.
-- c/c.canon --
package c

/// A tag.
record Tag {
  /// Its text.
  t: String
}

emit ts { out: "@features/c/c.ts", mode: types }
-- b/b.canon --
package b

import c { Tag }

/// A badge.
record Badge {
  /// Its label.
  label: String
  /// Its tags.
  tags: {String: Tag} = {}
}

emit ts { out: "@features/b/b.ts", mode: types }
-- a/a.canon --
package a

import b { Badge }

/// Named like c.Tag.
record Tag {
  /// Its badge.
  badge: Badge
}

/// One tag.
let one: Tag = { badge: { label: "o", tags: { "k": { t: "x" } } } }

emit ts { out: "@features/a/a.ts" }
-- findings.txt --
error[E8005]  a/a.canon:6:8
  ts: Tag is generated for both c.Tag and a.Tag

1 error, 0 warnings in 3 packages (…)

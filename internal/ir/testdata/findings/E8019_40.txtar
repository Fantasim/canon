EVALUATION.md §1, CODEGEN.md §5.6 (gen/go dependentNestedFormat): a list of dependent values is DependentType at a field gen/go's data loader reads; gen/cpp reads each element with the field's discriminant.
-- a/a.canon --
package a

/// A kind.
enum K { one, two }

/// A payload.
type P(k: K) = match k { one => Int, two => String }

/// A thing.
record Thing {
  /// Its kind.
  k: K
  /// Its payloads.
  ps: [P(k)]
}

/// The things.
let things: table Thing = {
  a { k: one, ps: [1, 2] }
}

emit go { out: "@features/a", package: "a", mode: data }
emit cpp { out: "@features/ac", namespace: "a", mode: data }
emit json { out: "out/" }
-- a.things.json --
{"a": {"k": "one", "ps": [1, 2]}}

DECISIONS 203, 182: a go emit in data mode has no name plan yet, but its @go(name:) overrides are still checked.
-- a/a.canon --
package a

/// A tone.
enum Tone { a @go(name: "toneA"), b }

emit go { out: "@features/a", package: "a", mode: data }
-- findings.txt --
error[E8011]  a/a.canon:4:13
  toneA is not a valid go identifier for @go(name:)


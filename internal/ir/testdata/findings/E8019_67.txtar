CODEGEN.md §5.6, §5.13, DECISIONS 278: a ts reader fills an absent key with the field's default, and a dependent value's branch is decided by its discriminant at run time, so a dependent field with a present default is DependentType (as gen/cpp); none, or an empty list, is written.
-- a/a.canon --
package a

/// A kind.
enum K { one, two }

/// A payload.
type P(k: K) = match k { one => Int, two => String }

/// A rule.
record Rule {
  /// The kind.
  k: K
  /// A payload, 3 by default.
  p: P(k) = 3
  /// None by default.
  q: P(k)? = none
  /// Empty by default.
  r: [P(k)] = []
}

emit ts { out: "@features/a/a.ts", mode: types }

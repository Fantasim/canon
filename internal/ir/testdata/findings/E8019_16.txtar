EVALUATION.md §1, CODEGEN.md §7.6: gen/cpp's loader reads every class of the package and refuses a map (nlohmann::json keeps no key order), held by a value or not, a field or a stored result.
-- a/a.canon --
package a

/// A row.
record Row {
  /// The cells.
  cells: {String: Int}

  /// Its totals.
  export fn totals(self) -> {String: Int} { return cells }
}

/// A holder.
record H {
  /// A count.
  n: Int
}

/// The holders.
let hs: table H = {
  one { n: 1 }
}

emit cpp { out: "@features/a", namespace: "a", mode: data }
emit json { out: "out/" }
-- a.hs.json --
{"one": {"n": 1}}

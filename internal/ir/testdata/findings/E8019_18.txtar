EVALUATION.md §1, WIRE.md §5.9: a literal union whose first arm is an enum written as its codes has no string wire form; gen/go's data loader reads only string unions.
-- a/a.canon --
package a

/// A tone.
enum Tone @codes(UInt8) @json(codes) { soft = 1, loud = 2 }

/// A cap.
record Cap {
  /// The tone.
  tone: Tone | "auto"
}

/// The caps.
let caps: table Cap = {
  one { tone: "auto" }
}

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/" }
-- a.caps.json --
{"one": {"tone": "auto"}}
-- findings.txt --
error[E8019]  a/a.canon:9:3
  emit go in data mode cannot generate a literal union whose wire form is not a string

1 error, 0 warnings in 1 package (…)

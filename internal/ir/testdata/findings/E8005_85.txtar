-- defs/defs.canon --
package defs

/// Words; the defines keep the names.
enum Word @cpp(defines: "") {
  /// app's constant, named like this package.
  defs
  /// app's row class of lib's Book.
  BookRow
  /// The getter BookRow inherits from lib's Book.
  GetRank
  /// app's reader of lib's Book.
  Read_Lib_Book
  /// The define table of lib's monsters.
  kMonstersDefines
}

emit cpp { out: "@features/defs", namespace: "defs", mode: types }
-- kinds/kinds.canon --
package kinds

/// A kind, so that kinds is a package of the project.
enum Kind { one }
-- lib/lib.canon --
package lib

local let monsters = load.defines("@features/lib/monsters.h")

/// A book.
record Book {
  /// Its rank.
  rank: Int
  /// Its monster.
  monster: ref monsters
}

emit cpp { out: "@features/lib", namespace: "lib", mode: types }
-- app/app.canon --
package app

import lib { Book }

/// A constant named like the package defs.
const defs = 1

/// Books, a table named like the package kinds.
let kinds: table Book = {
  one { rank: 1, monster: "M" }
}

emit cpp { out: "@features/app", namespace: "app", mode: data }
emit json { out: "out/" }

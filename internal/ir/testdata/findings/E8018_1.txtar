CODEGEN.md §2.8: a data-mode emit decodes a record of a package emitted in baked mode.
-- b/b.canon --
package b

/// A point.
record Point {
  /// Across.
  x: Int
}

emit go { out: "@features/b", package: "b" }
-- a/a.canon --
package a

import b { Point }

/// A place.
record Place {
  /// Its key.
  id: String
  /// Where it is.
  at: Point
}

/// Every place.
let places: [Place] keyed by id = [{ id: "home", at: { x: 1 } }]

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/" }

package a

/// A thing.
record Thing {
  /// Its id.
  a: Int
}

/// The things.
@reload
let things: [Thing] keyed by a = [{ a: 1 }]

/// A limit.
const STORE = 1

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/" }

EVALUATION.md §1, CODEGEN.md §5.5, decision 219: a case without fields has no Go type, so baked Go refuses a field of that case type: CaseField.
-- a/a.canon --
package a

/// A shape.
variant Shape {
  /// A dot.
  dot
  /// A box.
  box {
    /// Its side.
    side: Int
  }
}

/// A row.
record Row {
  /// The dot.
  d: Shape.dot
}

emit go { out: "@features/a", package: "a" }

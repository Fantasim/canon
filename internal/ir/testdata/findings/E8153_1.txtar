WIRE.md §8.1: a value of a data-mode emit that the package's emit json does not write.
-- a/a.canon --
package a

/// A place.
record Place {
  /// Its key.
  id: String
}

/// Every place.
let places: [Place] keyed by id = [{ id: "home" }]

/// The other places.
let others: [Place] keyed by id = []

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/", values: [others] }
-- findings.txt --
error[E8153]  a/a.canon:10:5
  places is emitted in data mode but not written by emit json

1 error, 0 warnings in 1 package (…)

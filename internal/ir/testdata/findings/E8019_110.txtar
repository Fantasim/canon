/// R.
package r

/// An item.
record Item {
  /// Its name.
  name: String
}

/// The items.
let items: table Item = {
  a { name: "a" }
}

emit ts { out: "@features/r.ts", mode: data }
emit json { out: "out/r/" }
-- p/p.canon --
/// P.
package p

import r { items }

/// A holder.
record Holder {
  /// N.
  n: Int
  /// A price per item.
  export fn price(self, it: ref items) -> Int { return self.n }
}

emit ts { out: "@features/p.ts" }
-- q/q.canon --
/// Q.
package q

import p { Holder }

/// Q holders.
let qs: table Holder = {
  y { n: 2 }
}

emit ts { out: "@features/q.ts", mode: data }
emit json { out: "out/q/" }

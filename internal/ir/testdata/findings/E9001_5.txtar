CONFORMANCE.md §2.2: a path of self through a ref reads a collection.
-- a/a.canon --
package a

/// A tier.
record Tier {
  /// Its rank.
  rank: Int
}

/// The tiers.
let tiers: table Tier = {
  low { rank: 1 }
  high { rank: 2 }
}

/// A member.
record Member {
  /// Its tier.
  tier: ref Tier

  /// Its weight for n.
  export fn weight(self, n: Int) -> Int { return self.tier.rank * n }
}

emit go { out: "@features/a", package: "a" }

CODEGEN.md §2.8: a go emit uses a type of a package that has no go emit.
-- b/b.canon --
package b

/// A colour.
enum Tone { red, blue }
-- a/a.canon --
package a

import b { Tone }

/// A badge.
record Badge {
  /// Its colour.
  tone: Tone
}

emit go { out: "@features/a", package: "a" }
-- findings.txt --
error[E8004]  a/a.canon:11:6
  b.Tone of package b is used by this go emit, but b has no go emit

1 error, 0 warnings in 2 packages (…)

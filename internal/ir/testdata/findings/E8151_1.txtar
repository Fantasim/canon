WIRE.md §5.9, §8.1: a value whose record holds a function is written to JSON.
-- a/a.canon --
package a

/// A rule.
record Rule {
  /// How it scores.
  score: fn(Int) -> Int
}

/// The rule.
let rule: Rule = { score: x => x * 2 }

emit json { out: "out/" }

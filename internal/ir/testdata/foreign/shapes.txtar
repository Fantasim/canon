-- shapes/kinds/kinds.canon --
/// Kinds.
package shapes.kinds

/// A flag.
record Flag {
  /// Its name.
  name: String
}

emit go { out: "@features/kinds/go", package: "kinds", mode: baked }
emit cpp { out: "@features/kinds/cpp", namespace: "shapes::kinds", mode: baked }
-- shapes/lib/lib.canon --
/// The library.
package shapes.lib

import shapes.kinds { Flag }

local let monsters = load.defines("@features/lib/monsters.h")

/// A kind.
enum K { num, flag }

/// A role.
enum Role { member, admin }

/// A payload.
type P(k: K) = match k { num => Int, flag => Flag }

/// A part.
record Part {
  /// Its label.
  label: String
}

/// A widget.
record Widget {
  /// Its kind.
  k: K
  /// Its payload.
  p: P(k)
  /// Its monster.
  monster: ref monsters
  /// Its hint.
  hint: String?
  /// Its parts, entries of its own table.
  parts: table Part
  /// By role.
  export fn rank(self, r: Role) -> Int { return match r { member => 1, admin => 2 } }
}

/// A mood.
variant Mood {
  /// Calm, with no field.
  calm {
    /// Its score, stored.
    export fn score(self) -> Int { return 1 }
  }
  /// Angry.
  angry {
    /// How much.
    level: Int
  }
}

emit go { out: "@features/lib/go", package: "lib", mode: baked }
emit cpp { out: "@features/lib/cpp", namespace: "shapes::lib", mode: baked }
-- shapes/store/store.canon --
/// A store, in data mode.
package shapes.store

/// An item.
record Item {
  /// Its label.
  label: String
  /// The next item, resolved by this package's loader.
  next: ref items?
}

/// The items.
let items: table Item = {
  a { label: "a" }
}

emit go { out: "@features/store/go", package: "store", mode: data }
emit cpp { out: "@features/store/cpp", namespace: "shapes::store", mode: data }
emit json { out: "out/" }
-- shapes/app/app.canon --
/// The app.
package shapes.app

import shapes.lib { Widget, Mood, P, K }
import shapes.store { Item }

/// A screen.
record Screen {
  /// Its kind.
  k: K
  /// Its gadget.
  gadget: Widget
  /// Its mood.
  mood: Mood
  /// Its payload.
  p: P(k)
  /// Its item.
  item: Item
}

/// The screens.
let screens: table Screen = {
  home { k: num, gadget: { k: num, p: 1, monster: "M", parts: {} }, mood: calm, p: 2, item: { label: "x" } }
}

/// The widgets, baked by the cpp emit.
let widgets: table Widget = {
  w { k: num, p: 1, monster: "M", parts: {} }
}

emit go { out: "@features/app/go", package: "app", mode: data, values: [screens] }
emit cpp { out: "@features/app/cpp", namespace: "shapes::app", mode: baked }

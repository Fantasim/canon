-- game/core/core.canon --
/// The core vocabulary.
package game.core

import game.tone { Tone }

/// A status.
record Status {
  /// Its label.
  label: String
}

/// The statuses.
let statuses: table Status = {
  open { label: "Open" }
}

/// A level band.
record LevelRange {
  /// Lowest.
  min: Int
  /// Highest.
  max: Int
  /// Labels.
  labels: [String] = []
  /// Its tone.
  tone: Tone
  /// Its status, resolved by game.core's baked hook.
  status: ref statuses
  /// Its width.
  export fn width(self) -> Int { return self.max - self.min }
}

/// A reward.
variant Reward {
  /// Coins.
  coins {
    /// How many.
    amount: Int
  }
  /// Nothing.
  nothing
}

/// A marker whose getters meet a row's own.
record Marker {
  /// Its code: Go Record(), C++ GetId(), TS retired.
  code: String @go(name: "Record") @cpp(name: "GetId") @ts(name: "retired")
  /// Its size, a TS property named like a row's id.
  @ts(name: "id")
  export fn size(self) -> Int { return 1 }
}

emit go { out: "@features/core/go", package: "core", mode: baked }
emit cpp { out: "@features/core/cpp", namespace: "game::core", mode: baked }
emit ts { out: "@features/core/core.ts", mode: baked }
-- game/world/world.canon --
/// The world.
package game.world

import game.core { LevelRange, Reward, Marker }

/// A zone.
record Zone {
  /// Its levels.
  levels: LevelRange
  /// Its reward.
  reward: Reward
  /// Its markers.
  markers: table Marker
}

/// The zones.
let zones: table Zone = {
  forest {
    levels: { min: 1, max: 5, tone: soft, status: open }
    reward: coins { amount: 3 }
    markers: { gate { code: "g" } }
  }
}

/// Level bands.
let bands: table LevelRange = {
  low { min: 1, max: 5, tone: soft, status: open }
}

/// The start band.
let start: LevelRange = { min: 1, max: 2, tone: loud, status: open }

emit go { out: "@features/world/go", package: "world", mode: data }
emit cpp { out: "@features/world/cpp", namespace: "game::world", mode: data }
emit ts { out: "@features/world/world.ts", mode: data }
-- game/shop/shop.canon --
/// A shop, baked.
package game.shop

import game.core { LevelRange }

/// A deal.
record Deal {
  /// Its band.
  band: LevelRange
}

/// Today's deal.
let deal: Deal = { band: { min: 2, max: 3, tone: loud, status: open } }

emit go { out: "@features/shop/go", package: "shop", mode: baked }
emit cpp { out: "@features/shop/cpp", namespace: "game::shop", mode: baked }

DECISIONS 213, CODEGEN.md §3.5 (log-2026-11-01): a ts emit whose mode check refused (E8009) reports a name collision only when the plan of every mode (baked, embedded, data, types) has it: two @ts(name:) overrides, or a type and an override taking its name, clash in every mode; a let and a const overridden alike clash in baked mode only.
-- a/a.canon --
package a

/// A.
record A @ts(name: "W") {
  /// N.
  n: Int
}

/// B.
record B @ts(name: "W") {
  /// N.
  n: Int
}

/// X.
record X {
  /// N.
  n: Int
}

/// Y.
record Y @ts(name: "X") {
  /// N.
  n: Int
}

/// An enum.
enum Color { red }

/// Z.
record Z @ts(name: "Color") {
  /// N.
  n: Int
}

/// One.
@ts(name: "same")
let one: A = { n: 1 }

/// Two.
@ts(name: "same")
const TWO = 2

emit ts { out: "@features/a.ts", mode: zzmode }
-- findings.txt --
error[E8005]  a/a.canon:10:8
  ts: W is generated for both a.A and a.B; rename one of them with @ts(name:)

error[E8005]  a/a.canon:22:8
  ts: X is generated for both a.X and a.Y; rename one of them with @ts(name:)

error[E8005]  a/a.canon:31:8
  ts: Color is generated for both a.Color and a.Z; rename one of them with @ts(name:)

error[E8009]  a/a.canon:44:40
  invalid mode zzmode for emit ts: expected one of baked, embedded, data, types

4 errors, 0 warnings in 1 package (…)

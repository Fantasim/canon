DECISIONS 213, CODEGEN.md §3.5 (log-2026-11-01): a go emit whose mode check refused (E8009) reports a name collision only when the plan of every mode gen/go writes (baked, data, types) has it: two @go(name:) overrides, or a type and an override taking its name, clash in every mode; a let and a const overridden alike, and the id types two tables of one record share in data and types mode, do not.
-- a/a.canon --
package a

/// A.
record A @go(name: "W") {
  /// N.
  n: Int
}

/// B.
record B @go(name: "W") {
  /// N.
  n: Int
}

/// X.
record X {
  /// N.
  n: Int
}

/// Y.
record Y @go(name: "X") {
  /// N.
  n: Int
}

/// An enum.
enum Color { red }

/// Z.
record Z @go(name: "Color") {
  /// N.
  n: Int
}

/// One.
@go(name: "Same")
let one: A = { n: 1 }

/// Two.
@go(name: "Same")
const TWO = 2

/// A displayed text.
record Label {
  /// Its text.
  text: String
}

/// The names of regions.
let regionNames: table Label = {
  north { text: "North" }
}

/// The names of stages: a second table of the same record.
let stageNames: table Label = {
  first { text: "First" }
}

emit go { out: "@features/a", package: "a", mode: zzmode }
-- findings.txt --
error[E8005]  a/a.canon:10:8
  go: W is generated for both a.A and a.B; rename one of them with @go(name:)

error[E8005]  a/a.canon:22:8
  go: X is generated for both a.X and a.Y; rename one of them with @go(name:)

error[E8005]  a/a.canon:31:8
  go: Color is generated for both a.Color and a.Z; rename one of them with @go(name:)

error[E8009]  a/a.canon:60:51
  invalid mode zzmode for emit go: expected one of baked, embedded, data, types

4 errors, 0 warnings in 1 package (…)

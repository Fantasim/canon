DECISIONS 456, CODEGEN.md §5.6, §5.8, §5.9 (WIRE.md §5.8, §5.9): a go emit holds a ref into a keyed list keyed by a ref into a keyed list keyed by an enum whose wire is not its name (Tone.second is "z2") at that enum, in every mode and position: nb (baked) reads the key off its entries through the chain and finds by the enum; nr (data) and nt (types) decide a dependent type by a branch table keyed by the enum, and read a ref, a list of refs, a map keyed by a ref and a union over one by the enum's wire; nl (data with @reload) checks each position against the chain with the ref check's text. fl and fu (baked) hold another package's record whose optional ref over the chain is absent; nb also holds a dependent type whose branch is a ref over a chain ending in an Int. lb (data, string ids) and sb (baked) hold a dependent branch that is a ref over a chain ending in lb's table, one level and two, and an optional ref over it absent. probe_test.go loads the files the json emit wrote, one file per refused key.
-- nb/nb.canon --
/// NB.
package nb

/// A tone, its second member written differently on the wire.
enum Tone { first, second = "z2", third }

/// Shape.
enum Shape { count, place, none_ }

/// A tone row.
record A {
  /// Its tone.
  id: Tone
  /// Shape.
  shape: Shape
}

/// A ref to a tone row.
record B {
  /// The tone.
  a: ref aa
}

/// A ref to a B.
record C {
  /// The B.
  b: ref bs
  /// Shape.
  shape: Shape
}

/// A parameter, by shape.
type Param(s: Shape) = match s {
  count => Int(0..)
  place => String
  none_ => Never
}

/// The holder.
record H {
  /// One.
  f: ref cs
  /// Many.
  fs: [ref cs]
  /// By.
  fm: {ref cs: Int}
  /// Union.
  fu: ref cs | "none"
  /// Event.
  ev: ref cs
  /// Optional.
  fo: ref cs?
  /// Param.
  param: Param(ev.shape)? @json(none: 0)
}

/// Tones.
let aa: [A] keyed by id = [ { id: first, shape: none_ }, { id: second, shape: count }, { id: third, shape: place } ]

/// Bs.
let bs: [B] keyed by a = [ { a: second }, { a: third } ]

/// Cs.
let cs: [C] keyed by b = [ { b: second, shape: count }, { b: third, shape: place } ]

/// The holder value.
let h: H = { f: second, fs: [third, second], fm: { second: 1 }, fu: third, ev: second, param: 3 }

/// An integer row.
record I1 {
  /// Key.
  k: Int
}

/// Integer rows.
let nums: [I1] keyed by k = [ { k: 5 }, { k: 20 } ]

/// A ref to an integer row.
record I2 {
  /// Key.
  k: ref nums
}

/// Refs to integer rows.
let refs: [I2] keyed by k = [ { k: 5 }, { k: 20 } ]

/// A pick, by shape: an integer row ref, or a name.
type Pick(s: Shape) = match s {
  count => ref refs
  place => String
  none_ => Never
}

/// A pick holder.
record P {
  /// Shape.
  s: Shape
  /// Pick.
  pick: Pick(s)
}

/// The pick holder value.
let p: P = { s: count, pick: 20 }

/// A choice by shape.
export fn choice(s: Shape) -> ref cs? { return match s { count => second, place => third, none_ => none } }

emit go { out: "@features/nb", package: "nb", mode: baked }

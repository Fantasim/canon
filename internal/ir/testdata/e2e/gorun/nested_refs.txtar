-- nl/nl.canon --
/// NL.
package nl

/// A tone, its second member written differently on the wire.
enum Tone { first, second = "z2", third }

/// A tone row.
record A {
  /// Its tone.
  id: Tone
}

/// A ref to a tone row.
record B {
  /// The tone.
  a: ref aa
}

/// A ref to a B.
record C {
  /// The B.
  b: ref bs
}

/// The holder.
record H {
  /// One.
  f: ref cs
  /// Many.
  fs: [ref cs]
  /// By.
  fm: {ref cs: Int}
  /// Union.
  fu: ref cs | "none"
  /// Unions.
  fus: [ref cs | "none"]
}

/// Tones.
@reload
let aa: [A] keyed by id = [ { id: first }, { id: second }, { id: third } ]

/// Bs.
@reload
let bs: [B] keyed by a = [ { a: second }, { a: third } ]

/// Cs.
@reload
let cs: [C] keyed by b = [ { b: second }, { b: third } ]

/// The holder value.
@reload
let h: H = { f: second, fs: [third, second], fm: { second: 1 }, fu: third, fus: ["none", second] }

emit go { out: "@features/nl", package: "nl", mode: data }
emit json { out: "out/" }

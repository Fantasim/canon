DECISIONS 387, CODEGEN.md §4.1, §5.8, §5.13, WIRE.md §5.8, §5.9: the same Exchange and Paint in a baked (ub), a data (ud) and a types (ut) go emit hold `ref exchanges | "PENYA"` and `ref paints | "none"` (a keyed list keyed by an enum whose wire is not its name) as a Go string: the ref arm and the literal arm, optional, through an alias, in a list, in a list of optionals and as a map key. ub writes them; ud's loader accepts a literal or checks the key where a plain ref is checked (the refs resolve into the holding container; an enum key is read with its Parse), with the ref check's text, and checks each present element of a list of optional refs (DECISIONS 385); ut's decoders read them unchecked. probe_test.go reads each back.
-- ub/ub.canon --
/// UB.
package ub

/// A pick: an exchange, or the currency.
type Pick = ref exchanges | "PENYA"

/// An exchange.
record Exchange {
  /// What is given.
  give: ref exchanges | "PENYA"
  /// What may be taken.
  take: Pick?
  /// Through the alias.
  alias: Pick
  /// Every pick.
  all: [Pick]
  /// Counts by pick.
  counts: {Pick: Int}
  /// Picks that may be missing.
  maybe: [Pick?] = []
  /// Exchanges that may be missing.
  refs: [(ref exchanges)?] = []
}

/// A colour.
enum Colour { red, green = "GREEN" }

/// A paint.
record Paint {
  /// Its colour.
  c: Colour
  /// A pick.
  p: ref paints | "none"
  /// Picks.
  ps: [ref paints | "none"] = []
  /// By pick.
  by: {ref paints | "none": Int} = {}
}

/// The exchanges.
let exchanges: table Exchange = {
  a { give: b, take: "PENYA", alias: "PENYA", all: [a, "PENYA"], counts: { b: 1, "PENYA": 2 }, maybe: [none, b, "PENYA"], refs: [b, none] }
  b { give: "PENYA", alias: a, all: [], counts: {} }
}

/// The paints.
let paints: [Paint] keyed by c = [{ c: red, p: green, ps: [red, "none"], by: { green: 1, "none": 2 } }, { c: green, p: "none" }]

emit go { out: "@features/ub", package: "ub" }
-- ud/ud.canon --
/// UD.
package ud

/// A pick: an exchange, or the currency.
type Pick = ref exchanges | "PENYA"

/// An exchange.

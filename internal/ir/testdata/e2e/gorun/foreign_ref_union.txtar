-- lib/lib.canon --
/// The library.
package lib

/// An item.
record Item {
  /// Its weight.
  w: Int
}

/// The items.
let items: table Item = {
  sword { w: 3 }
}

/// An offer.
record Offer {
  /// What is given.
  give: ref items | "PENYA"
  /// What may be taken.
  take: (ref items | "PENYA")?
  /// Every pick.
  all: [ref items | "PENYA"] = []
  /// Counts by pick.
  counts: {ref items | "PENYA": Int} = {}
}

emit go { out: "@features/lib", package: "lib" }
-- bk/bk.canon --
/// Baked.
package bk

import lib { Offer }

/// The offer.
let offer: Offer = { give: sword, take: "PENYA", all: [sword, "PENYA"], counts: { "PENYA": 1, sword: 2 } }

emit go { out: "@features/bk", package: "bk" }

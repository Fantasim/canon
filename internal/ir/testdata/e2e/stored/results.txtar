  "rows": [
    {"id": "x", "weight": 3, "shape": {"kind": "box", "side": 4, "$grade": {"points": 4, "$next": 5}}, "$graded": {"points": 3, "$next": 4}, "$gradeFor": {"reader": {"points": 0, "$next": 1}, "writer": {"points": 3, "$next": 4}}},
    {"id": "y", "weight": 5, "shape": {"kind": "box", "side": 6, "$grade": {"points": 6, "$next": 7}}, "$graded": {"points": 5, "$next": 6}, "$gradeFor": {"reader": {"points": 0, "$next": 1}, "writer": {"points": 5, "$next": 6}}}
  ],
  "$fns": {
    "best": {
      "points": 9,
      "$next": 10
    },
    "roleGrade": {
      "reader": {
        "points": 1,
        "$next": 2
      },
      "writer": {
        "points": 2,
        "$next": 3
      }
    }
  }
}

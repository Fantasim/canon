-- a/a.canon --
/// A.
package a

/// A column.
record Column {
  /// Its title.
  title: String
}

/// The columns.
let columns: table Column = {
  todo { title: "To do" }
  done { title: "Done" }
}

/// The column for n.
export fn pick(n: Int) -> ref columns { return if n > 0 { todo } else { done } }

test "pick" {
  expect pick(1) == todo
  expect pick(0) == done
}

emit cpp { out: "@gen/a", namespace: "a", mode: baked }

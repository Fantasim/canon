/// A.
package a

/// A point.
record Point {
  /// Its n.
  n: Int
}

/// A shape.
variant Shape {
  /// A dot.
  dot {
    /// Its size.
    size: Int
  }
  /// Nothing.
  blank
}

/// The points.
let points: {String: Point} = {"a": {n: 1}, "b": {n: 2}}

/// The shapes.
let shapes: {String: Shape} = {"x": Shape.dot { size: 3 }, "y": Shape.blank}

emit cpp { out: "@gen/a", namespace: "a", mode: baked }

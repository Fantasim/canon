/// A.
package a

/// A point.
record Point {
  /// Across.
  x: Int
}

/// A marker.
record Marker {
  /// Where it is.
  at: Point = { x: 1 }
  /// Where they are.
  all: [Point] = [{ x: 2 }]
  /// Where it was.
  trail: [Point] = []
}

emit cpp { out: "@gen/cpp/a", namespace: "a", mode: types }

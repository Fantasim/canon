-- a/a.canon --
/// A.
package a

import b { Item }

/// A mood.
enum Mood { calm, angry }

/// A colour.
record Colour {
  /// Its name.
  name: String
}

/// The colours.
let colours: table Colour = {
  red { name: "Red" }
}

/// The numbers.
@text("ints.json")
export fn ints() -> [Int?] { return [1, none] }

/// The counts.
@text("counts.json")
export fn counts() -> {String: Int?} { return { "a": none, "b": 2 } }

/// The items.
@text("items.json")
export fn items() -> [Item?] { return [{ n: 1 }, none] }

/// The picks.
@text("picks.json")
export fn picks() -> [ref colours | "auto"] { return [red, "auto"] }

/// The items by mood.
@text("moods.json")
export fn moods() -> {Mood: Item?} { return { calm: none, angry: { n: 2 } } }

emit go { out: "@features/a/go", package: "a", mode: types }
emit cpp { out: "@features/a/cpp", namespace: "a", mode: types }
emit ts { out: "@features/a/a.ts", mode: types }
emit text { out: "out/a" }

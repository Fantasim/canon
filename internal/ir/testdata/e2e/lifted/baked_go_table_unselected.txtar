DECISIONS 320, 323 (CODEGEN.md §2.8, §5.14): checks and builds, its Go vetting and its C++ and TypeScript compiling; formerly E8019_5, refused: EVALUATION.md §1 (stage E, CODEGEN.md §5.9): gen/go's indexValues refuses a table of a foreign record whether or not this emit selects it.
-- b/b.canon --
package b

/// A point.
record Point {
  /// Across.
  x: Int
}

emit go { out: "@features/b", package: "b" }
-- a/a.canon --
package a

import b { Point }

/// A count.
let count: Int = 1

/// Every point.
let points: table Point = {
  one { x: 1 }
}

emit go { out: "@features/a", package: "a", values: [count] }
-- a.count.json --
1
-- a.points.json --
{ "one": { "x": 1 } }
-- findings.txt --
0 errors, 0 warnings in 2 packages (…)

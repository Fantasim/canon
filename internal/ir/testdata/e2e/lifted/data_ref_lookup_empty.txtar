package b

/// A tier.
record Tier {
  /// Its rank.
  rank: Int
}

/// The tiers.
let tiers: table Tier = {
  low { rank: 1 }
  high { rank: 2 }
}

/// A band.
record Band {
  /// Its base.
  base: Int
  /// Its bonus for a tier.
  export fn bonus(self, t: ref tiers) -> Int { return self.base }
}


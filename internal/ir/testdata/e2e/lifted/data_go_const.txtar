DECISIONS 320, 323 (CODEGEN.md §2.8, §5.14): checks and builds, its Go vetting and its C++ and TypeScript compiling; formerly E8019_10, refused: EVALUATION.md §1, CODEGEN.md §5.1: constants are written in every mode, so a constant holding a record of another package is CrossPackageBakedValue in data mode too.
-- b/b.canon --
package b

/// A point.
record Point {
  /// Across.
  x: Int
}

emit go { out: "@features/b", package: "b", mode: data }
-- a/a.canon --
package a

import b { Point }

/// The origins.
const origins = [Point { x: 0 }]

emit go { out: "@features/a", package: "a", mode: data }
-- a.origins.json --
[{"x": 0}]
-- findings.txt --
warning[W1003]  a/a.canon:6:7
  const name "origins" should be UPPER_SNAKE

0 errors, 1 warning in 2 packages (…)

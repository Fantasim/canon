DECISIONS 320, 323 (CODEGEN.md §2.8, §5.14): checks and builds, its Go vetting and its C++ and TypeScript compiling; formerly E8019_25, refused: EVALUATION.md §1, CODEGEN.md §5.9: gen/go's data loader decodes a record of another package with that package's unexported decoder, so it refuses one wherever it reads it: a field of a class it decodes, the rows of a keyed list.
-- b/b.canon --
package b

/// A point.
record Point {
  /// Across.
  x: Int
}

emit go { out: "@features/b", package: "b", mode: data }
-- a/a.canon --
package a

import b { Point }

/// A place.
record Place {
  /// Where.
  at: Point
}

/// The places.
let places: table Place = {
  one { at: { x: 1 } }
}

/// The points.
let points: [Point] keyed by x = [{ x: 1 }]

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/" }
-- a.places.json --
{"one": {"at": {"x": 1}}}
-- a.points.json --
[{"x": 1}]
-- findings.txt --
0 errors, 0 warnings in 2 packages (…)

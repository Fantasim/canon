-- b/b.canon --
package b

/// A goal.
enum Goal { kill, visit }

/// A target.
type Target(g: Goal) = match g {
  kill => String
  visit => Int
}

/// A pin.
record Pin {
  /// Where.
  place: String
}

/// The pins.
let pins: [Pin] keyed by place = [{ place: "x" }]

emit json { out: "@features/b/data/" }
emit ts { out: "@features/b/b.ts", mode: data }
-- a/a.canon --
package a

import b { Pin, Goal, Target }

/// A holder.
record Holder {
  /// A pin.
  pin: Pin
  /// A goal.
  goal: Goal
  /// A target of the goal.
  target: Target(goal)
}

/// The holder.
let holder: Holder = { pin: { place: "x" }, goal: kill, target: "t" }

emit json { out: "@features/a/data/" }
emit ts { out: "@features/a/a.ts", mode: data }

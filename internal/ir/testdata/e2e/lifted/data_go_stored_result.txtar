DECISIONS 320, 323 (CODEGEN.md §2.8, §5.14): checks and builds, its Go vetting and its C++ and TypeScript compiling; formerly E8019_12, refused: EVALUATION.md §1, CODEGEN.md §5.9: gen/go's data loader decodes a stored method's result from its `$` key, and the decoder of another package's record is unexported there: ForeignDataRecord, precomputed or lookup.
-- b/b.canon --
package b

/// A point.
record Point {
  /// Across.
  x: Int
}

emit go { out: "@features/b", package: "b", mode: data }
-- a/a.canon --
package a

import b { Point }

/// A tone.
enum Tone { soft, loud }

/// A place.
record Place {
  /// Where.
  x: Int

  /// Its point.
  export fn point(self) -> Point { return { x: x } }

  /// Its point per tone.
  export fn pointFor(self, t: Tone) -> Point { return { x: x } }
}

/// The places.
let places: table Place = {
  one { x: 1 }
}

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/" }
-- a.places.json --
{"one": {"x": 1}}

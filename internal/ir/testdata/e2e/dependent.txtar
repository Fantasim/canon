CODEGEN.md §5.6, §2.8, EVALUATION.md §1: a project whose dependent types stage E passes builds, and its Go (data and baked) and C++ (data) outputs compile: package a in data mode (optional, list, Bool and match-path discriminants), package b baked for Go, holding a's dependent type across packages and baking its own (a Bool discriminant, a match path, a list).
-- project.canon --
project demo {
  canon: "0.1"
  roots {
    gen: "gen"
  }
  go_module {
    gen: "example.com/gen"
  }
}
-- a/a.canon --
/// A.
package a

/// A kind.
enum K { one, two, text, gone }

/// A tag.
record Tag {
  /// Its label.
  label: String
}

/// The tags.
let tags: table Tag = {
  red { label: "red" }
}

/// A payload.
type P(k: K) = match k { one => Int, two => ref tags, text => String, gone => Never }

/// A switch payload.
type Q(on: Bool) = match on { false => Int, true => String }

/// An event.
record Ev {
  /// Its kind.
  k: K
}

/// A payload read through an event.
type R(e: Ev) = match e.k { one => Int, _ => String }

/// A thing.
record Thing {
  /// Its kind.
  k: K
  /// Its payload.
  p: P(k)?
  /// Its required payload.
  q: P(k)
}

/// Several payload shapes, which both data loaders read.
record Loose {
  /// Its kind.
  k: K
  /// Its payloads.
  ps: [P(k)]
  /// Whether it is on.
  on: Bool
  /// Its switch payload.
  sw: Q(on)
  /// Its event.
  ev: Ev
  /// Its event payload.
  r: R(ev)
}

/// The things.
let things: table Thing = {
  a { k: one, p: 1, q: 2 }
  b { k: text, p: "y", q: "z" }
  d { k: text, q: "x" }
}

/// The loose ones.
let looses: table Loose = {
  l { k: one, ps: [1, 2], on: true, sw: "s", ev: { k: two }, r: "t" }
}

emit go { out: "@gen/go/a", package: "a", mode: data }
emit cpp { out: "@gen/cpp/a", namespace: "a", mode: data }
emit json { out: "@gen/data/a/" }
-- b/b.canon --
/// B.
package b

import a { K, P }

/// A switch.
type S(on: Bool) = match on { false => Int, true => String }

/// An event.
record Ev {
  /// Whether it is on.
  on: Bool
}

/// A payload read through an event.
type T(e: Ev) = match e.on { false => Float, true => String }

/// A rule.
record Rule {
  /// Its kind.
  k: K
  /// Its payload, of another package's dependent type.
  v: P(k)?
  /// Whether it is on.
  on: Bool
  /// Its switch payload.
  s: S(on)?
  /// Its event.
  ev: Ev
  /// Its payloads by the event.
  ts: [T(ev)]
}

/// A rule without payloads.
let rule: Rule = { k: gone, on: false, ev: { on: false }, ts: [] }

/// A rule whose own payloads are baked (CODEGEN.md §5.6).
let full: Rule = { k: gone, on: false, s: 3, ev: { on: false }, ts: [1.5, 2.0] }

emit go { out: "@gen/go/b", package: "b" }
emit cpp { out: "@gen/cpp/b", namespace: "b", mode: data }
emit json { out: "@gen/data/b/" }

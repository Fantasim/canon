DECISIONS 340: b declares an enum and has no go emit at all, only a json one; a's @text result {Dst: Int} reaches b through the enum alone: no decoder and no finding, never a generator failure.
-- b/b.canon --
/// B.
package b

/// A destination.
enum Dst { str, sta }

/// The counts.
let counts: {Dst: Int} = { str: 1 }

emit json { out: "out/b/" }
-- a/a.canon --
/// A.
package a

import b { Dst }

/// Counts by destination.
@text("counts.json")
export fn counts() -> {Dst: Int} { return { str: 1 } }

emit go { out: "@features/a/go", package: "a", mode: types }
emit text { out: "out/a" }

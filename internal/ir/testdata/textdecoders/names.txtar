DECISIONS 340, CODEGEN.md §3.4: a's record R has a field b and a translated fn taking a parameter b. a's @text result [b.Item] gets no decoder (Item's computed default has no types-mode data), so a imports no package b and every name of R stays b, never b_ (the escape of a name an import takes).
-- b/b.canon --
/// B.
package b

/// An item.
record Item {
  /// The base.
  base: Int
  /// Twice the base.
  price: Int = base * 2
}

emit go { out: "@features/b/go", package: "b" }
-- a/a.canon --
/// A.
package a

import b { Item }

/// A record.
record R {
  /// A number.
  b: Int

  /// Twice b.
  export fn twice(self, b: Int) -> Int { return b * 2 }
}

/// The items.
@text("items.json")
export fn items() -> [Item] { return [{ base: 2 }] }

emit go { out: "@features/a/go", package: "a", mode: types }
emit text { out: "out/a" }

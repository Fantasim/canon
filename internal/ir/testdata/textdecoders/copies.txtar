DECISIONS 340, CODEGEN.md §2.8: b's go emit has two copies, under @features and @pipeline_go. a, under @sovcommon, reaches b.Item only through a @text result and has no copy of b to use (E8004 noCopy for an ordinary use): no decoder, no import, no finding. c, under @features, uses b's copy there: DecodeItemsFile.
-- b/b.canon --
/// B.
package b

/// An item.
record Item {
  /// Its number.
  n: Int
}

emit go { out: ["@features/b/go", "@pipeline_go/b"], package: "b" }
-- a/a.canon --
/// A.
package a

import b { Item }

/// The items.
@text("items.json")
export fn items() -> [Item] { return [{ n: 1 }] }

emit go { out: "@sovcommon/a/go", package: "a", mode: types }
emit text { out: "out/a" }
-- c/c.canon --
/// C.
package c

import b { Item }

/// The items.
@text("items.json")
export fn items() -> [Item] { return [{ n: 1 }] }

emit go { out: "@features/c/go", package: "c", mode: types }
emit text { out: "out/c" }

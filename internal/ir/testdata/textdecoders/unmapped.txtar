DECISIONS 340, CODEGEN.md §2.8: b's go emit writes under @source, which go_module does not map (b's own E8007; E8007 for an ordinary use too). a reaches b.Item only through a @text result: no decoder, no import, and a adds no finding of its own.
-- b/b.canon --
/// B.
package b

/// An item.
record Item {
  /// Its number.
  n: Int
}

emit go { out: "@source/b/go", package: "b" }
-- a/a.canon --
/// A.
package a

import b { Item }

/// The items.
@text("items.json")
export fn items() -> [Item] { return [{ n: 1 }] }

emit go { out: "@features/a/go", package: "a", mode: types }
emit text { out: "out/a" }

package a

/// A reward.
variant Reward {
  /// Gold.
  gold
  /// An item.
  item {
    /// How many.
    count: Int
  }
}

/// The kind of gold.
const K = Reward.gold.kind

/// A list of kinds.
const KS = [Reward.gold.kind]

emit ts { out: "@features/a/a.ts" }

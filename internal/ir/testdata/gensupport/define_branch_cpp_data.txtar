-- a/a.canon --
package a

local let kinds = load.defines("@features/a/kinds.h")

/// A kind.
enum K { one, two }

/// A payload.
type P(k: K) = match k { one => ref kinds, two => String }

/// A rule.
record Rule {
  /// Its kind.
  k: K
  /// Its payload.
  p: P(k)
}

emit cpp { out: "@features/ac", namespace: "a", mode: data }

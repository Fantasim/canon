Decision 37, clean: DECISIONS 385, CODEGEN.md §4.2: gen/cpp holds a list of optional elements as std::vector<std::optional<T>>, its data loader reading null as none.
-- a/a.canon --
package a

/// A row.
record Row {
  /// The cells.
  cells: [Int?]
}

/// The rows.
let rows: table Row = {
  one { cells: [1, none] }
}

emit cpp { out: "@features/a", namespace: "a", mode: data }
emit json { out: "out/" }

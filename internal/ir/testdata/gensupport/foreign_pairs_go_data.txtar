Decision 37, clean: gen/go's data loader reads another package's pairs record slot by slot, with no decoder into its make hook (DECISIONS 323).
-- b/b.canon --
package b

/// A bonus.
record Bonus {
  /// The stat.
  stat: Int
  /// The amount.
  amount: Int
}

emit go { out: "@features/b", package: "b", mode: data }
emit json { out: "out/b/" }
-- a/a.canon --
package a

import b { Bonus }

/// An item.
record Item {
  /// Its bonuses.
  stats: [Bonus](..=2) = [] @json(pairs: ["s{i}", "a{i}"])
}

/// The items.
let items: table Item = {
  one { stats: [{ stat: 1, amount: 2 }] }
}

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/a/" }
-- a.items.json --
{"one": {"s0": 1, "a0": 2}}

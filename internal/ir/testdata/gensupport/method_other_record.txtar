Decision 37, clean: a stored method returning another record makes no cycle (RecordCycleThroughMethod).
-- a/a.canon --
package a

/// A stat.
record Stat {
  /// Its value.
  v: Int
}

/// A node.
record Node {
  /// Its value.
  v: Int

  /// Its best stat (not `stat`: a getter Stat would change the meaning of the class Stat, E8005).
  export fn best(self) -> Stat { return { v: v } }
}

emit cpp { out: "@features/a", namespace: "a", mode: data }
emit json { out: "out/a/" }

Decision 37, clean: DECISIONS 387, CODEGEN.md §4.1, §5.13: a cpp types-mode emit holds a literal union over a ref into a table as its string, read unchecked.
-- a/a.canon --
package a

/// A colour.
record Colour {
  /// Its name.
  name: String
}

/// The colours.
let colours: table Colour = {
  red { name: "Red" }
}

/// A pick.
record Pick {
  /// A colour, or auto.
  c: ref colours | "auto"
}

emit cpp { out: "@features/ac", namespace: "a", mode: types }

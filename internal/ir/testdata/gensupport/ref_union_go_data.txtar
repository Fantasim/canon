Decision 37, clean: DECISIONS 387, CODEGEN.md §4.1, §5.8: gen/go's data loader reads a literal union over a ref as its string (over a load.defines ref, one it looks up nowhere), as gen/cpp does.
-- a/a.canon --
package a

local let kinds = load.defines("@features/a/kinds.h")

/// A rule.
record Rule {
  /// Its kind, or none.
  c: ref kinds | "none"
}

/// The rules.
let rules: table Rule = {
  one { c: "none" }
}

emit go { out: "@features/a", package: "a", mode: data }
emit cpp { out: "@features/ac", namespace: "a", mode: data }
emit json { out: "out/" }

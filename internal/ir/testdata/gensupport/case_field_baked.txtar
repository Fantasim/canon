package a

/// A shape.
variant Shape {
  /// A dot.
  dot
  /// A box.
  box {
    /// Its side.
    side: Int
  }
}

/// A row.
record Row {
  /// The box.
  b: Shape.box
}

emit go { out: "@features/a", package: "a" }

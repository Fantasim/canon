package a

/// A row.
record Row {
  /// The cells.
  cells: {String: Int?}
}

/// Held by no value.
record Loose {
  /// The cells.
  cells: {String: Int?}
}

/// The rows.
let rows: table Row = {
  one { cells: {"a": 1} }
}

emit go { out: "@features/a", package: "a", mode: data }
emit json { out: "out/" }

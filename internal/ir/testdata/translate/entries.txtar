CONFORMANCE.md §2.1 (log-2026-09-24 "gen/go translated fns"): a table entry named through its table (`tiers.high`) is a statically named entry, returned as its key like a bare `high`.
-- a/a.canon --
/// Tiers.
package a

/// A tier.
record Tier {
  /// Its rank.
  rank: Int
}

/// The tiers.
let tiers: table Tier = {
  low { rank: 1 }
  high { rank: 2 }
}

/// The tier for n.
export fn tierFor(n: Int) -> ref Tier { return if n > 1 { tiers.high } else { tiers.low } }

emit go { out: "@features/a", package: "a" }

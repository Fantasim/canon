CONFORMANCE.md §2.2, decision 194: a refused comparison still has its operands translated, so the Float its template interpolates is E9005 too; a `let` whose value needs a conversion outside the subset is named by the `let`.
Round 3 (decision 194 without cascades): inside a refused construct, only codes of another cause
(E9005 here) are reported, never a second E9001; a receiver, arguments and match-arm values are
still translated. Under E9004 only returned values skip their conversion: the `let` keeps its E9001.
-- a/a.canon --
package a

/// A tone.
enum Tone { soft, loud }

/// A bag.
record Bag {
  /// Its items.
  items: [Int]

  /// The first item, plus n.
  export fn first(self, n: Int) -> Int { return self.items[0] + n }
}

/// Whether the label of x sorts first.
export fn first(x: Float) -> Bool { return "{x}" < "b" }

/// n, kept optional.
export fn kept(n: Int) -> Int {
  let y: Int? = n
  return n
}

/// Whether s starts with the label of x.
export fn prefixed(s: String, x: Float) -> Bool { return s.startsWith("{x}") }

/// A label per tone.
export fn named(t: Tone, x: Float) -> String {
  return match t {
    soft => "{x}"
    loud => "b"
  }
}

/// x with two decimals.
export fn decimals(x: Float) -> String { return "{x:.2}" }

/// Maybe n, through a local.
export fn maybe(n: Int) -> Int? {
  let y: Int? = n
  return y
}

emit go { out: "@features/a", package: "a" }

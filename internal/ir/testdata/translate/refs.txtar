CONFORMANCE.md §2.1, §2.2: a translated function returns a ref as its key, written as a table entry; it calls a lookup function with one.
-- a/a.canon --
/// Tiers.
package a

/// A tier.
record Tier {
  /// Its rank.
  rank: Int
}

/// The tiers.
let tiers: table Tier = {
  low { rank: 1 }
  high { rank: 2 }
}

/// Whether a tier is the top one.
export fn isTop(t: ref Tier) -> Bool { return t == high }

/// The tier for n.
export fn tierFor(n: Int) -> ref Tier { return if n > 1 and isTop(high) { high } else { low } }

emit go { out: "@features/a", package: "a" }
-- bodies.txt --
package a dir=a
fn isTop file=a.canon order=0 kind=lookup
fn tierFor file=a.canon order=1 kind=translated
  body (if:ref(String coll=0 a.tiers[] keyed=false local=false) (and:Bool (>:Bool param0:Int 1:Int) (call isTop:Bool high:ref(String coll=0 a.tiers[] keyed=false local=false)))
    then high:ref(String coll=0 a.tiers[] keyed=false local=false)
    else low:ref(String coll=0 a.tiers[] keyed=false local=false))

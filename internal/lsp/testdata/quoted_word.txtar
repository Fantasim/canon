Quoted words (DECISIONS 378, GRAMMAR §2.3, ADR-0021 §2.6): definition and hover on a quoted
reserved word `if` in a layer file answer as on a bare member. The enum lives in another package
(v), which the layer file cannot import; the member is still found. Line 4 of the layer file is
"  word: `if`"; character 9 is the `i`.
-- proj/project.canon --
project acme {
  canon: "0.1"
}
-- proj/v/v.canon --
package v

/// A word.
enum Word { plain, if, while, in }
-- proj/p/p.canon --
package p

import v { Word }

/// The config.
let conf: Conf = { word: plain }

/// A conf.
record Conf {
  /// Its word.
  word: Word
}
-- proj/p/dev.layer.canon --
package p
layer dev

amend conf {
  word: `if`
}
-- script --
initialize
send {"jsonrpc":"2.0","method":"initialized","params":{}}
open proj/p/p.canon
wait
open proj/p/dev.layer.canon
wait
send {"jsonrpc":"2.0","id":1,"method":"textDocument/definition","params":{"textDocument":{"uri":"$URI/proj/p/dev.layer.canon"},"position":{"line":4,"character":9}}}
send {"jsonrpc":"2.0","id":2,"method":"textDocument/hover","params":{"textDocument":{"uri":"$URI/proj/p/dev.layer.canon"},"position":{"line":4,"character":9}}}
send {"jsonrpc":"2.0","id":3,"method":"shutdown"}
send {"jsonrpc":"2.0","method":"exit"}
-- transcript --
> initialize
< {"jsonrpc":"2.0","id":0,"result":{"capabilities":{"positionEncoding":"utf-16","textDocumentSync":{"openClose":true,"change":1},"hoverProvider":true,"definitionProvider":true,"referencesProvider":true,"documentFormattingProvider":true},"serverInfo":{"name":"canon"}}}
> send {"jsonrpc":"2.0","method":"initialized","params":{}}
> open proj/p/p.canon
> wait
> open proj/p/dev.layer.canon
> wait
> send {"jsonrpc":"2.0","id":1,"method":"textDocument/definition","params":{"textDocument":{"uri":"$URI/proj/p/dev.layer.canon"},"position":{"line":4,"character":9}}}
< {"jsonrpc":"2.0","id":1,"result":{"uri":"$URI/proj/v/v.canon","range":{"start":{"line":3,"character":19},"end":{"line":3,"character":21}}}}
> send {"jsonrpc":"2.0","id":2,"method":"textDocument/hover","params":{"textDocument":{"uri":"$URI/proj/p/dev.layer.canon"},"position":{"line":4,"character":9}}}
< {"jsonrpc":"2.0","id":2,"result":{"contents":{"kind":"markdown","value":"```canon\nif: v.Word\n```"},"range":{"start":{"line":4,"character":8},"end":{"line":4,"character":12}}}}
> send {"jsonrpc":"2.0","id":3,"method":"shutdown"}
< {"jsonrpc":"2.0","id":3,"result":null}
> send {"jsonrpc":"2.0","method":"exit"}
= <nil>

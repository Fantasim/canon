A map literal's bare-name key and an amend line's `.k` naming an element of a keyed list
(DECISIONS 470, IMPLEMENTATION-PLAN §4.7 NameKeys, §8.4 Features, CLI.md §3.8, §4): definition
goes from the key `shield` of `weights` (0-based line 18, character 34) to the element, as from the ref
`one`; references there list Refs' places, the map key among them; a key read through a ref chain
(`byK`, line 42, character 27: `ks` keyed by `ref js`, DECISIONS 456) goes to the element of
`ks`; the amend line's `.shield` (layer line 4, character 2) goes to the element too; and the
amend line's `.x` after an entry (layer line 8, character 11: `one.subs.x`, a key of the field
collection `Holder.subs`) goes, by the line's static path, to the element `x` of `many[one]`'s
subs, and references there list it. A map literal's key inside an amend line's value (`shelf`'s
`weights: { shield: 4 }`, layer line 12, character 13) goes to the element, as in the source.
-- proj/project.canon --
project acme {
  canon: "0.1"
}
-- proj/a/a.canon --
/// A.
package a

/// An item.
record Item {
  /// Its id.
  id: String
  /// Its weight.
  weight: Int = 1
}

/// Items, keyed by id.
let items: [Item] keyed by id = [
  { id: "sword" },
  { id: "shield", weight: 3 },
]

/// Weights by item.
let weights: {ref items: Int} = { shield: 2, sword: 1 }

/// One.
let one: ref items = shield

/// A j.
record J {
  /// Its n.
  n: String
}

/// A k.
record K {
  /// Its j.
  j: ref js
}

/// Js.
let js: [J] keyed by n = [{ n: "second" }]

/// Ks.
let ks: [K] keyed by j = [{ j: second }]

/// By k.
let byK: {ref ks: Int} = { second: 1 }

/// A sub.
record Sub {
  /// Its name.
  name: String
  /// Its w.
  w: Int = 0
}

/// A holder.
record Holder {
  /// Its id.
  id: String
  /// Its subs.
  subs: [Sub] keyed by name = []
}

/// Many.
let many: [Holder] keyed by id = [{ id: "one", subs: [{ name: "x" }] }]

/// A shelf.
record Shelf {
  /// Its weights.
  weights: {ref items: Int}
}

/// The shelf.
let shelf: Shelf = { weights: {} }
-- proj/a/dev.layer.canon --
package a
layer dev

amend items {
  shield.weight: 5
}

amend many {
  one.subs.x.w: 4
}

amend shelf {
  weights: { shield: 4 }
}

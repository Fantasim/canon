A key of a keyed list keyed by `ref C` (`ts: [T] keyed by k`, `k: ref items`) names the element it
looks up, in every form (DECISIONS 487, 488; 316, 484): go-to-definition goes to that list's
element, and references are that element's set, `.k` and `[k]` alike, in an expression and in an
amend line, at a let's static path (`h.ts`) and after an entry step (`many.one.ts`). A selector key
(`[items.shield]`) and a key of a map or dependent map (`{ref ks: Int}`, `{i in ks: Int}`, `ks`
keyed by a ref itself) name C's entry (487). The analysis has no layer active (IMPLEMENTATION-PLAN
§8.4), so the amend lines are read inactive. Known gap, outside internal/lsp: a key with no static
path (a record field's default, `ws[shield]` and `ws.shield`) cannot name each instance's element
(DECISIONS 285), so `ws[shield]` answers C's entry and `ws.shield` null, as before.
-- proj/project.canon --
project acme {
  canon: "0.1"
}
-- proj/a/a.canon --
/// A.
package a

/// An item.
record Item {
  /// Its id.
  id: String
}

/// Items.
let items: [Item] keyed by id = [
  { id: "sword" },
  { id: "shield" },
]

/// A T.
record T {
  /// Its key.
  k: ref items
  /// Its n.
  n: Int = 0
  /// Its m.
  m: Int = 0
  /// Its o.
  o: Int = 0
}

/// An H.
record H {
  /// Its ts.
  ts: [T] keyed by k
}

/// A holder.
record Holder {
  /// Its id.
  id: String
  /// Its ts.
  ts: [T] keyed by k = []
}

/// Many.
let many: [Holder] keyed by id = [
  { id: "one", ts: [{ k: shield }] },
  { id: "two", ts: [{ k: shield }] },
]

/// The h.
let h: H = { ts: [{ k: shield, n: 0 }] }

/// E1.
let e1: Int = h.ts.shield.n

/// E2.
let e2: Int = h.ts[shield].n

/// E3.
let e3: Int = many.one.ts.shield.n

/// E4.
let e4: Int = many.one.ts[shield].n

/// E5.
let e5: Int = h.ts[items.shield].n

/// E6.
let e6: Int = many.one.ts[items.shield].n

/// Ks.
let ks: [T] keyed by k = [{ k: shield }]

/// An S.
record S {
  /// By ks.
  byK: {ref ks: Int}
  /// Dependent.
  dep: {i in ks: Int}
}

/// The s.
let s: S = { byK: { shield: 1 }, dep: { shield: 2 } }

/// A V.
record V {
  /// Its id.
  id: String
  /// Its ws.
  ws: [T] keyed by k
  /// A default by index.
  v: Int = ws[shield].n
  /// A default by selector.
  u: Int = ws.shield.n
}

/// Vs.
let vs: [V] keyed by id = [
  { id: "a", ws: [{ k: shield }] },
  { id: "b", ws: [{ k: shield }] },
]
-- proj/a/dev.layer.canon --
package a
layer dev

amend h {
  ts.shield.n: 1
}

amend h {
  ts[shield].m: 2
}

amend many {
  one.ts.shield.n: 3
}

amend many {
  one.ts[shield].m: 4
}

amend h {
  ts[items.shield].o: 5
}

amend many {
  one.ts[items.shield].o: 6
}

amend s {
  byK[shield]: 7
}

amend s {
  dep[shield]: 8
}

Definition and references through a keyed list, `[T] keyed by` (IMPLEMENTATION-PLAN §8.4
Features, CLI.md §3.8, §4): from a ref's key, definition goes to the element and references
list Refs' places of the element, after the element with includeDeclaration.
-- proj/project.canon --
project acme {
  canon: "0.1"
}
-- proj/a/a.canon --
/// A.
package a

/// An item.
record Item {
  /// Its id.
  id: String
  /// Its weight.
  weight: Int = 1
}

/// Items, keyed by id.
let items: [Item] keyed by id = [
  { id: "sword" },
  { id: "shield", weight: 3 },
]

/// Picks.
let picks: [ref items] = ["shield", "sword"]

/// One.
let one: ref items = "shield"
-- script --
initialize
send {"jsonrpc":"2.0","method":"initialized","params":{}}
open proj/a/a.canon
wait
send {"jsonrpc":"2.0","id":1,"method":"textDocument/definition","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"position":{"line":18,"character":28}}}
send {"jsonrpc":"2.0","id":2,"method":"textDocument/references","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"position":{"line":18,"character":28},"context":{"includeDeclaration":true}}}
send {"jsonrpc":"2.0","id":3,"method":"textDocument/references","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"position":{"line":18,"character":38},"context":{"includeDeclaration":false}}}
send {"jsonrpc":"2.0","id":4,"method":"shutdown"}
send {"jsonrpc":"2.0","method":"exit"}

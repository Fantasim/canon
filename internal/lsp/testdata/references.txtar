Find references is `canon refs` (IMPLEMENTATION-PLAN §8.4 Features, CLI.md §3.8, §4, API.md
§5.3): the fixture of internal/cli/testdata/commands/refs_kinds.txtar, without a layer. From the
entry's declaration or a ref's key naming it, the same list in Refs' order (value, key, code,
check, view; TestReferencesMatchRefs compares it with Refs), after the entry's own location
with includeDeclaration (§8.4); from an enum member, after its name. A let is not a target: null.
-- proj/project.canon --
project acme {
  canon: "0.1"
}
-- proj/r/r.canon --
/// R.
package r

/// A tone.
enum Tone { calm, loud = "LOUD" }

/// A status.
record Status {
  /// Its tone.
  tone: Tone = calm
  /// Where it goes.
  next: [ref statuses] = []
  /// A fallback.
  fallback: ref statuses = done

  check not (tone == loud and next.contains(done)) else "done follows a loud status"
}

/// Statuses.
let statuses: table Status = {
  open { next: [done] }
  done { tone: loud }
}

/// Weights.
let weights: {ref statuses: Int} = { open: 1, done: 2 }

/// Chosen.
let chosen: Status = { tone: calm }

/// Whether a status is done.
fn isDone(s: ref statuses) -> Bool {
  return s == done
}

check statuses.done.tone == loud else "done is loud"

view Status {
  show "Done" "{statuses.done.tone}"
}
-- proj/r/dev.layer.canon --
package r
layer dev

amend chosen {
  fallback: done
}
-- proj/q/q.canon --
/// Q.
package q

import r { statuses }

/// Elsewhere.
let far: [ref statuses] = [done]
-- script --
initialize
send {"jsonrpc":"2.0","method":"initialized","params":{}}
open proj/r/r.canon
wait
send {"jsonrpc":"2.0","id":1,"method":"textDocument/references","params":{"textDocument":{"uri":"$URI/proj/r/r.canon"},"position":{"line":21,"character":2},"context":{"includeDeclaration":true}}}
send {"jsonrpc":"2.0","id":2,"method":"textDocument/references","params":{"textDocument":{"uri":"$URI/proj/r/r.canon"},"position":{"line":20,"character":16},"context":{"includeDeclaration":false}}}
send {"jsonrpc":"2.0","id":3,"method":"textDocument/references","params":{"textDocument":{"uri":"$URI/proj/r/r.canon"},"position":{"line":4,"character":19},"context":{"includeDeclaration":true}}}
send {"jsonrpc":"2.0","id":4,"method":"textDocument/references","params":{"textDocument":{"uri":"$URI/proj/r/r.canon"},"position":{"line":19,"character":6},"context":{"includeDeclaration":true}}}
send {"jsonrpc":"2.0","id":5,"method":"shutdown"}
send {"jsonrpc":"2.0","method":"exit"}

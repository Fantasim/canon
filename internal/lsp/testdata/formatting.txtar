Formatting is `canon fmt` (IMPLEMENTATION-PLAN §8.4 Features, CLI.md §3.6, §4, API.md §14): a
buffer not in the canonical layout gets one edit replacing its whole text; project.canon is
formatted as a project file; a JSON document is not formatted (null); a buffer with a syntax
error is refused, as fmt leaves such a file unchanged (RequestFailed); a canonical one gets none.
-- proj/project.canon --
project acme {
    canon: "0.1"
}
-- proj/a/a.canon --
/// A.
package a
/// N.
let   n: Int=1 // é中😀
-- proj/a/n.json --
[1,2]
-- edits/broken.canon --
/// A.
package a

let = 1
-- edits/canonical.canon --
/// A.
package a

/// N.
let n: Int = 1 // é中😀
-- script --
initialize
send {"jsonrpc":"2.0","method":"initialized","params":{}}
open proj/a/a.canon
open proj/project.canon
open proj/a/n.json
wait
send {"jsonrpc":"2.0","id":1,"method":"textDocument/formatting","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"options":{"tabSize":4,"insertSpaces":true}}}
send {"jsonrpc":"2.0","id":2,"method":"textDocument/formatting","params":{"textDocument":{"uri":"$URI/proj/project.canon"},"options":{"tabSize":4,"insertSpaces":true}}}
send {"jsonrpc":"2.0","id":3,"method":"textDocument/formatting","params":{"textDocument":{"uri":"$URI/proj/a/n.json"},"options":{"tabSize":4,"insertSpaces":true}}}
change proj/a/a.canon edits/broken.canon
wait
send {"jsonrpc":"2.0","id":4,"method":"textDocument/formatting","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"options":{"tabSize":4,"insertSpaces":true}}}
change proj/a/a.canon edits/canonical.canon
wait
send {"jsonrpc":"2.0","id":5,"method":"textDocument/formatting","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"options":{"tabSize":4,"insertSpaces":true}}}
send {"jsonrpc":"2.0","id":6,"method":"shutdown"}
send {"jsonrpc":"2.0","method":"exit"}
-- transcript --

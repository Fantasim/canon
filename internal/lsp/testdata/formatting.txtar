> wait
< {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"$URI/proj/a/a.canon","diagnostics":[]}}
> send {"jsonrpc":"2.0","id":5,"method":"textDocument/formatting","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"options":{"tabSize":4,"insertSpaces":true}}}
< {"jsonrpc":"2.0","id":5,"result":[]}
> send {"jsonrpc":"2.0","id":6,"method":"shutdown"}
< {"jsonrpc":"2.0","id":6,"result":null}
> send {"jsonrpc":"2.0","method":"exit"}
= <nil>

> send {"jsonrpc":"2.0","id":2,"method":"textDocument/hover","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"position":{"line":3,"character":17}}}
< {"jsonrpc":"2.0","id":2,"result":{"contents":{"kind":"markdown","value":"```canon\nn: Int\n```\n\nN.\n\nValue:\n```canon\n1\n```"},"range":{"start":{"line":3,"character":17},"end":{"line":3,"character":18}}}}

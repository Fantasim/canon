> send {"jsonrpc":"2.0","method":"initialized","params":{}}
> open proj/a/a.canon
> wait
< {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"$URI/data/names.json","diagnostics":[{"range":{"start":{"line":0,"character":9},"end":{"line":0,"character":10}},"severity":1,"code":"E7110","source":"canon","message":"expected a string for String, found a number"}]}}
< {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"$URI/proj/a/counts.json","diagnostics":[{"range":{"start":{"line":0,"character":4},"end":{"line":0,"character":9}},"severity":1,"code":"E7110","source":"canon","message":"expected a number for Int, found a string"}]}}
< {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"$URI/proj/a/kinds.h","diagnostics":[{"range":{"start":{"line":1,"character":0},"end":{"line":1,"character":1}},"severity":1,"code":"E7102","source":"canon","message":"X redefined with a different value (2, first 1 at a/kinds.h:1)"}]}}
< {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"$URI/proj/a/rows.csv","diagnostics":[{"range":{"start":{"line":2,"character":0},"end":{"line":2,"character":1}},"severity":1,"code":"E7108","source":"canon","message":"CSV cell \"x\" is not a valid Int"}]}}

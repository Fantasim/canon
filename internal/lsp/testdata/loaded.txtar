Findings in loaded files are published though the files are not open (IMPLEMENTATION-PLAN §8.4
Sync, CLI.md §4, DECISIONS 274): a JSON file under a root outside the project directory, a JSON
file beside its package, a CSV file, a C header. Columns after non-ASCII text are UTF-16 units (§8.4
Positions): ["é中😀", 1] puts 1 at byte column 15, UTF-16 character 9. Fixing the files on the
disk and notifying a watched-file change clears them with empty lists.
-- proj/project.canon --
project acme {
  canon: "0.1"

  roots {
    data: "../data"
  }
}
-- proj/a/a.canon --
/// A.
package a

/// One row.
record Row {
  /// A count.
  n: Int
}

/// Names.
let names: [String] = load("@data/names.json")

/// Counts.
let counts: [Int] = load("counts.json")

/// Rows.
let rows: [Row] = load.csv("rows.csv", header: true)

/// Kinds.
local let kinds = load.defines("kinds.h")
-- proj/a/counts.json --
[1, "two", 3]
-- proj/a/rows.csv --
n
1
x
-- proj/a/kinds.h --
#define X 1
#define X 2
-- data/names.json --
["é中😀", 1]
-- fixed/names.json --
["é中😀", "one"]
-- fixed/counts.json --
[1, 2, 3]
-- fixed/rows.csv --
n
1
2
-- fixed/kinds.h --
#define X 1
#define Y 2
-- script --
initialize
send {"jsonrpc":"2.0","method":"initialized","params":{}}
open proj/a/a.canon
wait
write data/names.json fixed/names.json
write proj/a/counts.json fixed/counts.json
write proj/a/rows.csv fixed/rows.csv
write proj/a/kinds.h fixed/kinds.h
send {"jsonrpc":"2.0","method":"workspace/didChangeWatchedFiles","params":{"changes":[]}}
wait
send {"jsonrpc":"2.0","id":9,"method":"shutdown"}
send {"jsonrpc":"2.0","method":"exit"}

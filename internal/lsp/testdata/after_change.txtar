Hover and definition sent right after a change, before any pass (IMPLEMENTATION-PLAN §8.4 Sync,
Features): the change is an overlay as soon as it is received, so both read the new text, its
names moved and its values changed. Both texts have no finding, so no pass publishes.
-- proj/project.canon --
project acme {
  canon: "0.1"
}
-- proj/a/a.canon --
/// A.
package a

/// N.
let n: Int = 1

/// M.
let m: Int = n
-- edits/moved.canon --
/// A.
package a

/// The first.
let first: Int = 5

/// N, after first.
let n: Int = first + 1

/// M.
let m: Int = n
-- script --
initialize
send {"jsonrpc":"2.0","method":"initialized","params":{}}
open proj/a/a.canon
wait
change proj/a/a.canon edits/moved.canon
send {"jsonrpc":"2.0","id":1,"method":"textDocument/hover","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"position":{"line":7,"character":4}}}
send {"jsonrpc":"2.0","id":2,"method":"textDocument/definition","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"position":{"line":10,"character":13}}}
wait
send {"jsonrpc":"2.0","id":3,"method":"shutdown"}
send {"jsonrpc":"2.0","method":"exit"}
-- transcript --
> initialize
< {"jsonrpc":"2.0","id":0,"result":{"capabilities":{"positionEncoding":"utf-16","textDocumentSync":{"openClose":true,"change":1},"hoverProvider":true,"definitionProvider":true,"referencesProvider":true,"documentFormattingProvider":true},"serverInfo":{"name":"canon"}}}
> send {"jsonrpc":"2.0","method":"initialized","params":{}}
> open proj/a/a.canon
> wait
> change proj/a/a.canon edits/moved.canon
> send {"jsonrpc":"2.0","id":1,"method":"textDocument/hover","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"position":{"line":7,"character":4}}}
< {"jsonrpc":"2.0","id":1,"result":{"contents":{"kind":"markdown","value":"```canon\nn: Int\n```\n\nN, after first.\n\nValue:\n```canon\n6\n```"},"range":{"start":{"line":7,"character":4},"end":{"line":7,"character":5}}}}
> send {"jsonrpc":"2.0","id":2,"method":"textDocument/definition","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"position":{"line":10,"character":13}}}
< {"jsonrpc":"2.0","id":2,"result":{"uri":"$URI/proj/a/a.canon","range":{"start":{"line":7,"character":4},"end":{"line":7,"character":5}}}}
> wait
> send {"jsonrpc":"2.0","id":3,"method":"shutdown"}
< {"jsonrpc":"2.0","id":3,"result":null}
> send {"jsonrpc":"2.0","method":"exit"}
= <nil>

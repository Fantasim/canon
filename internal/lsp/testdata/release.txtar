A project lives while one of its buffers is open (DECISIONS 368, CLI.md §4): a buffer closed while
another stays open is checked from the disk again; the last one closed releases the project and
clears its findings; a buffer opened again opens it anew.
-- proj/project.canon --
project acme {
  canon: "0.1"
}
-- proj/a/a.canon --
/// A.
package a

/// N.
let n: Int = "x"
-- proj/b/b.canon --
/// B.
package b

/// M.
let m: Int = 1
-- edits/broken.canon --
/// B.
package b

/// M.
let m: Bool = 1
-- script --
initialize
send {"jsonrpc":"2.0","method":"initialized","params":{}}
open proj/a/a.canon
open proj/b/b.canon
wait
change proj/b/b.canon edits/broken.canon
wait
close proj/b/b.canon
wait
close proj/a/a.canon
wait
open proj/b/b.canon
wait
send {"jsonrpc":"2.0","id":9,"method":"shutdown"}
send {"jsonrpc":"2.0","method":"exit"}

The server opens each project as the CLI does, with no --root: project.local.canon places its
roots (CLI.md §4, SPEC §3.1, GRAMMAR.md §7.2, DECISIONS 332). Its buffer is a project file,
never a source (no E1127): an edited one is an overlay whose own findings (E1014, E1013 local)
stop the project as project.canon's do; fixed, the findings return; it is formatted as a
project file. Below the root, a file of that name is an ordinary source (GRAMMAR.md §5.2).
-- proj/project.canon --
project acme {
  canon: "0.1"
  roots {
    src: "../Source"
  }
}
-- proj/project.local.canon --
project acme {
  roots {
    src: "../work/Source"
  }
}
-- work/Source/n.json --
3
-- proj/a/a.canon --
/// A.
package a

/// N.
let n: Int = load("@src/n.json")

/// M.
let m: Int = "x"
-- proj/b/project.local.canon --
/// B.
package b

/// K.
let  k: Int=2
-- edits/key.canon --
project acme {
  canon: "0.1"
}
-- edits/nowhere.canon --
project acme {
  roots {
    src: "../nowhere"
  }
}
-- edits/loose.canon --
project acme {
  roots: {
      src:   "../work/Source"
  }
}
-- script --
initialize
send {"jsonrpc":"2.0","method":"initialized","params":{}}
open proj/project.local.canon
wait
change proj/project.local.canon edits/key.canon
wait
change proj/project.local.canon edits/nowhere.canon
wait
change proj/project.local.canon edits/loose.canon
wait
send {"jsonrpc":"2.0","id":1,"method":"textDocument/formatting","params":{"textDocument":{"uri":"$URI/proj/project.local.canon"},"options":{"tabSize":4,"insertSpaces":true}}}
open proj/b/project.local.canon
wait
send {"jsonrpc":"2.0","id":2,"method":"textDocument/formatting","params":{"textDocument":{"uri":"$URI/proj/b/project.local.canon"},"options":{"tabSize":4,"insertSpaces":true}}}
send {"jsonrpc":"2.0","id":9,"method":"shutdown"}
send {"jsonrpc":"2.0","method":"exit"}

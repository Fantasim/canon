send {"jsonrpc":"2.0","id":9,"method":"textDocument/hover","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"position":{"line":2,"character":0}}}
open proj/a/dev.layer.canon
wait
send {"jsonrpc":"2.0","id":11,"method":"textDocument/hover","params":{"textDocument":{"uri":"$URI/proj/a/dev.layer.canon"},"position":{"line":3,"character":7}}}
send {"jsonrpc":"2.0","id":10,"method":"shutdown"}
send {"jsonrpc":"2.0","method":"exit"}

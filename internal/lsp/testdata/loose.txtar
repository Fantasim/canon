A .canon file in no project gets syntax diagnostics only (IMPLEMENTATION-PLAN §8.4 Transport):
a parse error is published, a type error is not, closing the buffer clears it. A file of
another kind in no project gets none.
-- loose/x.canon --
/// X.
package x

/// N.
let n: Int = "not checked"

/// é.
let = 1
-- loose/x.json --
[1,
-- edits/fixed.canon --
/// X.
package x

/// N.
let n: Int = "not checked"
-- script --
initialize
send {"jsonrpc":"2.0","method":"initialized","params":{}}
open loose/x.canon
open loose/x.json
wait
change loose/x.canon edits/fixed.canon
wait
change loose/x.canon loose/x.canon
wait
close loose/x.canon
close loose/x.json
wait
send {"jsonrpc":"2.0","id":9,"method":"shutdown"}
send {"jsonrpc":"2.0","method":"exit"}
-- transcript --
> initialize
< {"jsonrpc":"2.0","id":0,"result":{"capabilities":{"positionEncoding":"utf-16","textDocumentSync":{"openClose":true,"change":1},"hoverProvider":true,"definitionProvider":true,"referencesProvider":true,"documentFormattingProvider":true},"serverInfo":{"name":"canon"}}}
> send {"jsonrpc":"2.0","method":"initialized","params":{}}
> open loose/x.canon
> open loose/x.json
> wait
< {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"$URI/loose/x.canon","diagnostics":[{"range":{"start":{"line":7,"character":4},"end":{"line":7,"character":5}},"severity":1,"code":"E1116","source":"canon","message":"expected IDENT; found ="}]}}
> change loose/x.canon edits/fixed.canon
> wait
< {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"$URI/loose/x.canon","diagnostics":[]}}
> change loose/x.canon loose/x.canon
> wait
< {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"$URI/loose/x.canon","diagnostics":[{"range":{"start":{"line":7,"character":4},"end":{"line":7,"character":5}},"severity":1,"code":"E1116","source":"canon","message":"expected IDENT; found ="}]}}
> close loose/x.canon
> close loose/x.json
> wait
< {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"$URI/loose/x.canon","diagnostics":[]}}
> send {"jsonrpc":"2.0","id":9,"method":"shutdown"}
< {"jsonrpc":"2.0","id":9,"result":null}
> send {"jsonrpc":"2.0","method":"exit"}
= <nil>

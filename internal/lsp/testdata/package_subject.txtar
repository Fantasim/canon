Definition and hover on the target of an `expect package` substitution (CLI.md §4,
EVALUATION.md §10.5 item 1, DECISIONS 398): the target is a use of the let, so definition goes
to the let and hover shows it; the value on the right of the colon is an ordinary expression.
-- proj/project.canon --
project acme {
  canon: "0.1"
}
-- proj/a/a.canon --
/// A.
package a

/// The base price.
let base: Int(0..) = 10

/// The price with tax.
let taxed: Int(0..) = base + base / 10

test "a substitution target" {
  expect package { base: 50, taxed: base * 2 } passes
}
-- script --
initialize
send {"jsonrpc":"2.0","method":"initialized","params":{}}
open proj/a/a.canon
wait
send {"jsonrpc":"2.0","id":1,"method":"textDocument/definition","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"position":{"line":10,"character":20}}}
send {"jsonrpc":"2.0","id":2,"method":"textDocument/hover","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"position":{"line":10,"character":20}}}
send {"jsonrpc":"2.0","id":3,"method":"textDocument/definition","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"position":{"line":10,"character":30}}}
send {"jsonrpc":"2.0","id":4,"method":"textDocument/hover","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"position":{"line":10,"character":30}}}
send {"jsonrpc":"2.0","id":5,"method":"textDocument/definition","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"position":{"line":10,"character":37}}}
send {"jsonrpc":"2.0","id":6,"method":"textDocument/hover","params":{"textDocument":{"uri":"$URI/proj/a/a.canon"},"position":{"line":10,"character":37}}}
send {"jsonrpc":"2.0","id":7,"method":"shutdown"}
send {"jsonrpc":"2.0","method":"exit"}

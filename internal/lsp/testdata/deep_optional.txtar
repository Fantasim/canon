Definition and references on a deep key read through optional fields (IMPLEMENTATION-PLAN §8.4
Features; DECISIONS 473, 477): `aa.second.oo?.x?.inn?.q` names second's q, its references
are that element and its reads, never first's q; through third, which holds none, it names nothing.
`aa.second.oo!.x.inn!.q` names the same q and x: `!` reads the present value as `?.` does.
-- proj/project.canon --
project acme {
  canon: "0.1"
}
-- proj/a/a.canon --
/// A.
package a

/// T.
record T {
  /// k.
  k: String
}

/// S.
record S {
  /// k.
  k: String
  /// inn.
  inn: ([T] keyed by k)?
}

/// A.
record A {
  /// id.
  id: String
  /// oo.
  oo: ([S] keyed by k)?
}

/// aa.
let aa: [A] keyed by id = [
  { id: "first", oo: [{ k: "x", inn: [{ k: "q" }] }] },
  { id: "second", oo: [{ k: "x", inn: [{ k: "q" }] }] },
  { id: "third" },
]

/// r0.
let r0: T? = aa.second.oo?.x?.inn?.q

/// r1.
let r1: T? = aa.third.oo?.x?.inn?.q

/// r2.
let r2: T = aa.second.oo!.x.inn!.q

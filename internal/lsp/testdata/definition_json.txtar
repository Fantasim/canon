Go to definition starting inside a loaded JSON buffer (IMPLEMENTATION-PLAN §8.4 Features: "from
a `ref` value to the entry, including into JSON"; CLI.md §4): a ref string stated in drops.json,
open, goes to the entry of items.json, not open; so does a ref map key of weights.json, open too. References
start there too (CLI.md §3.8). A string that is no ref, and a field name, give null; hover in JSON
offers nothing. The ref on line 1 follows "é中😀": 4 UTF-16 units, 9 bytes (§8.4 Positions).
-- proj/project.canon --
project acme {
  canon: "0.1"
}
-- proj/a/a.canon --
/// A.
package a

/// An item.
record Item {
  /// Its name.
  name: String
}

/// Items, loaded.
let items: table Item = load("items.json")

/// A drop.
record Drop {
  /// A note.
  note: String
  /// What drops.
  item: ref items
}

/// Drops, loaded.
let drops: [Drop] = load("drops.json")

/// Weights, by item.
let weights: {ref items: Int} = load("weights.json")
-- proj/a/items.json --
{
  "sword": { "name": "Sword" },
  "shield": { "name": "Shield" }
}
-- proj/a/drops.json --
[
  { "note": "é中😀", "item": "sword" },
  { "note": "x", "item": "shield" }
]
-- proj/a/weights.json --
{"shield": 2}
-- script --
initialize
send {"jsonrpc":"2.0","method":"initialized","params":{}}
open proj/a/drops.json
open proj/a/weights.json
wait
send {"jsonrpc":"2.0","id":1,"method":"textDocument/definition","params":{"textDocument":{"uri":"$URI/proj/a/drops.json"},"position":{"line":1,"character":31}}}
send {"jsonrpc":"2.0","id":2,"method":"textDocument/definition","params":{"textDocument":{"uri":"$URI/proj/a/drops.json"},"position":{"line":2,"character":26}}}
send {"jsonrpc":"2.0","id":3,"method":"textDocument/definition","params":{"textDocument":{"uri":"$URI/proj/a/drops.json"},"position":{"line":1,"character":14}}}
send {"jsonrpc":"2.0","id":4,"method":"textDocument/definition","params":{"textDocument":{"uri":"$URI/proj/a/drops.json"},"position":{"line":1,"character":22}}}
send {"jsonrpc":"2.0","id":5,"method":"textDocument/definition","params":{"textDocument":{"uri":"$URI/proj/a/weights.json"},"position":{"line":0,"character":3}}}
send {"jsonrpc":"2.0","id":6,"method":"textDocument/references","params":{"textDocument":{"uri":"$URI/proj/a/drops.json"},"position":{"line":1,"character":31},"context":{"includeDeclaration":true}}}
send {"jsonrpc":"2.0","id":7,"method":"textDocument/hover","params":{"textDocument":{"uri":"$URI/proj/a/drops.json"},"position":{"line":1,"character":31}}}
send {"jsonrpc":"2.0","id":8,"method":"shutdown"}
send {"jsonrpc":"2.0","method":"exit"}

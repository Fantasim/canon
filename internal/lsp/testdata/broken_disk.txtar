A project.canon broken on the disk when its project is first opened (IMPLEMENTATION-PLAN §8.4
Sync, log-2026-10-02 L1): the project opens over the open buffers, so the buffer's errors are
published, and once the buffer is fixed the project opens and the other files are checked;
broken again in the buffer, its own findings return.
-- proj/project.canon --
project acme {
  canon: "0.1"
  colour: 1
}
-- proj/a/a.canon --
/// A.
package a

/// N.
let n: Int = "x"
-- edits/fixed.canon --
project acme {
  canon: "0.1"
}
-- edits/other.canon --
project acme {
  canon: "0.1"
  shade: 2
}
-- script --
initialize
send {"jsonrpc":"2.0","method":"initialized","params":{}}
open proj/project.canon
wait
change proj/project.canon edits/fixed.canon
wait
change proj/project.canon edits/other.canon
wait
send {"jsonrpc":"2.0","id":9,"method":"shutdown"}
send {"jsonrpc":"2.0","method":"exit"}

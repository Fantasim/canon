EVALUATION.md §10.1: test names are unique within a package (E5005); the second declaration is
reported at its name.
-- teamboard/tests.canon --
package teamboard

test "same" {
  expect 1 == 1
}

test "other" {
  expect 1 == 1
}

test "same" {
  expect 1 == 1
}
-- findings.txt --
error[E5005]  teamboard/tests.canon:11:6

VIEWMODEL.md G16: a tone the studio package does not declare is E1610 (tone).
-- studio/studio.canon --
/// The studio vocabulary.
package studio

/// Menus.
enum Menu { items, system }

/// Icons.
enum Icon { gem, gear }

/// Tones.
enum Tone { info, danger }

/// A unit.
record UnitSpec {
  /// Appended.
  suffix: String = ""
}

/// Units.
let units: table UnitSpec = {
  hp { suffix: " HP" }
  pct { suffix: " %" }
}

/// Numbered steps.
widget ordered_steps(value: [_])

/// A weight and its share.
widget weight_share(value: Int, siblings: [Int])
-- a/a.canon --
package a

local variant Reward {
  gold { amount: Int }
  gem { carats: Int }
}

view Reward {
  gold "Gold" { tone: warm }
  gem "Gem" { tone: info }
}
-- findings.txt --
error[E1610]  a/a.canon:9:23
  unknown tone warm: not declared in studio package studio


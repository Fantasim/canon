-- studio/studio.canon --
/// The studio vocabulary.
package studio

/// Menus.
enum Menu { items, system }

/// Icons.
enum Icon { gem, gear }

/// Tones.
enum Tone { info, danger }

/// A unit.
record UnitSpec {
  /// Appended.
  suffix: String = ""
}

/// Units.
let units: table UnitSpec = {
  hp { suffix: " HP" }
  pct { suffix: " %" }
}

/// Numbered steps.
widget ordered_steps(value: [_])

/// A weight and its share.
widget weight_share(value: Int, siblings: [Int])
-- a/a.canon --
package a

local enum Rarity { common, rare }

local record Item {
  label: String
  rarity: Rarity
}

view Item {
  title "{label}"
  menu items icon gem
  columns { label, rarity, label 120 }
  filters { rarity, rarity multi }
  search { label }
  title "{rarity}"
  menu system icon gear
  columns { rarity }
  filters { rarity }
  search { rarity }
}

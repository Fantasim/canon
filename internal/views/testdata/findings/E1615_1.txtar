VIEWMODEL.md G14: an unescaped `{` in a plain text is E1615: a label, a group label and intro, a show label, `singular`, `plural`, `help`, `placeholder` and `none`; `{{` and the templates are not.
-- a/a.canon --
package a

local record Item {
  label: String?
  count: Int
}

view Item {
  title "{count} {{items}}"
  singular "an {count}"
  plural "{count}s"
  show "Count {count}" "{count}"
  group main "Main {count}" "The {count}" {
    count "Count {{x}}"
  }
  label "Label {count}" { help: "The {count}", placeholder: "{count}", none: "No {count}" }
}

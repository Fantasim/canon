VIEWMODEL.md §3.5 (log-2026-09-28 check follow-ups 2): a literal-only property given an expression of the right type is E1613 (literal): `hidden` and `readonly` take `true` or `false`, `help`, `placeholder`, `none` and `step` a string; `when` takes an expression, and a literal in parentheses is a literal.
-- a/a.canon --
package a

const TIP = "A tip"

local record Item {
  count: Int
  flag: Bool
  note: String
  label: String?
  steps: [Int]
  size: Int

  fn doubled(self) -> Int {
    return count * 2
  }
}

view Item {
  count { hidden: count > 1, help: note }
  flag { readonly: flag, placeholder: TIP }
  label { none: TIP, when: flag }
  steps { step: TIP }
  size { hidden: (false), help: ("Size") }
  doubled { hidden: flag }
}

VIEWMODEL.md G8: a name matching case fields of different types (refinements kept) is E1628, naming each case; case fields of one type are fine.
-- a/a.canon --
package a

local variant Kind {
  weapon {
    power: Int
    label: String
  }
  food {
    power: Int(0..=10)
    label: String
  }
  gem {
    power: String
  }
}

local record Item {
  kind: Kind @json(inline)
}

view Item {
  power "Power"
  label "Label"
}

VIEWMODEL.md G11: a field named `key` or `index` hides the magic name; the first template of a view using it is W1604, once per name.
-- a/a.canon --
package a

local record Named {
  key: String
  index: Int
}

local let byName: {String: Named} = {}

view Named {
  title "{key} #{index}"
  subtitle "{key}"
  show "Where" "{index}"
}

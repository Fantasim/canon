VIEWMODEL.md G4: a view declared outside the package of its target is E1603, its target named with its package; its items are not checked.
-- b/b.canon --
/// B.
package b

/// An item.
record Item {
  /// Its label.
  label: String
}
-- a/a.canon --
package a

import b { Item }

view Item {
  title "{label}"
  nothing "Nothing"
}

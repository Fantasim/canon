-- studio/studio.canon --
/// The studio vocabulary.
package studio

/// Menus.
enum Menu { items, system }

/// Icons.
enum Icon { gem, gear }

/// Tones.
enum Tone { info, danger }

/// A unit.
record UnitSpec {
  /// Appended.
  suffix: String = ""
}

/// Units.
let units: table UnitSpec = {
  hp { suffix: " HP" }
  pct { suffix: " %" }
}

/// Numbered steps.
widget ordered_steps(value: [_])

/// A weight and its share.
widget weight_share(value: Int, siblings: [Int])
-- a/a.canon --
package a

local enum Rarity { common, rare }

local variant Reward {
  gold { amount: Int }
  gem { carats: Int }
}

local record Item {
  label: String
}

view Item {
  lable "Label"
  group main "Main" { labl }
  columns { labol }
  filters { lbl }
}

view Reward {
  silver "Silver"
  columns { weight }
}

view Rarity {
  epic "Epic"
}

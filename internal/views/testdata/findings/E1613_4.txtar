-- studio/studio.canon --
/// The studio vocabulary.
package studio

/// Menus.
enum Menu { items, system }

/// Icons.
enum Icon { gem, gear }

/// Tones.
enum Tone { info, danger }

/// A unit.
record UnitSpec {
  /// Appended.
  suffix: String = ""
}

/// Units.
let units: table UnitSpec = {
  hp { suffix: " HP" }
  pct { suffix: " %" }
}

/// Numbered steps.
widget ordered_steps(value: [_])

/// A weight and its share.
widget weight_share(value: Int, siblings: [Int])
-- a/a.canon --
package a

local variant Kind {
  weapon { attack: Int }
  food { heal: Int }
}

local record Item {
  cost: Int
  kind: Kind @json(inline)
}

view Kind.weapon {
  attack { help: "Damage" }
}

view Item {
  cost { unit: hp }
  group main "Main" {
    cost { unit: pct }
    attack { help: "Its damage" }
  }
}

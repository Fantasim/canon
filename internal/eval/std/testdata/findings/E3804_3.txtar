Evaluated, no internal error: TYPES.md §11.4, DECISIONS 338: a record literal typed against a dependent value's static view (P(*), whose record branch Sub(e) needs P's argument) outside a place giving its arguments (a dependent field, its list, a declaration of the dependent type) is E3804, once, its items checked silently: a union argument (a map from a list of dependent maps, a toMap of dependent values, one whose literal sets a field a check reads), an == operand and a list literal compared (each an internal error before). union on a dependent map is E3804 once, a chained union adding nothing.
-- a/a.canon --
package a

/// K.
enum K { num, sub }

/// Node.
record Node {
  /// K.
  k: K
  /// Max.
  max: Int = 5
}

/// Nodes.
let nodes: table Node = { a { k: sub }, d { k: sub, max: 7 }, n { k: num } }

/// Sub, of a node.
record Sub(e: Node) {
  /// Limit, the node's max unless given.
  lim: Int = e.max

  check lim <= e.max else "lim {lim} above {e.max}"
}

/// P.
type P(e: Node) = match e.k {
  num => Int
  sub => Sub(e)
}

/// Holder.
record Holder {
  /// Like.
  like: ref nodes
  /// P.
  p: P(like)
  /// Ps.
  ps: [P(like)] = [{}]
  /// By node.
  by: {x in nodes: P(x)} = {}
}

/// Holders.
let hs: [Holder] = [{ like: a, p: {}, by: { a: {} } }, { like: d, p: { lim: 1 } }]

local let vm = hs.toMap(h => "{h.like.max}", h => h.p)

local let lst = hs.map(.by)

local let m = hs[0].by

local let viaMapped = hs.map(.by)[0].union({ d: {} })

local let viaValues = vm.union({ "z": {} })

local let viaChecked = vm.union({ "z": { lim: 2 } })

local let eqMapped: Bool = hs.map(.by)[1] == { d: {} }

local let eqList: Bool = lst == [{ a: {} }]

local let chained = hs[0].by.union({ d: {} }).union({ a: {} })

/// A.
package a

/// Levels.
let levels: [Int] = [1, 2, 3]

/// Their count.
let total: Int = levels.len()

test "isolation" {
  expect package { levels: [] } passes
  expect levels.len() == 3
  expect total == 3
  expect package passes
  expect package { levels: [7] } passes
}

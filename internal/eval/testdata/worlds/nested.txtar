EVALUATION.md §10.5 item 2, §4.3, §7.3: conversions and taint are the world's own. A substituted
copy is converted and stored again deep, by its declared types, as its literals stored each part:
a field outside its refinement (E3204, E3206), an entry of another list where a ref is declared, in
a field, a list, a map or an optional (E3503), and a repeated key (E3102) are found again and marked
in the world, so a let reading such a part is tainted and its hard error silent, exactly as in a
fresh build: substituting each let with itself gives the bare findings.
-- a/a.canon --
/// A.
package a

/// Level.
record Level {
  /// Index.
  index: Int(0..=24)
}

/// Item.
record Item {
  /// Key.
  k: String
  /// Weight.
  w: Int
}

/// Holder.
record Holder {
  /// An item.
  r: ref items
}

/// Box: refs in a list, a map and an optional, a Float32 and a where refinement.
record Box {
  /// Refs in a list field.
  rs: [ref items]
  /// Refs in a map field.
  m: {String: ref items}
  /// An optional ref.
  o: ref items?
  /// A positive float32.
  f: Float32(0.0..)
  /// Even.
  e: Int where it % 2 == 0
}

/// Items.
let items: [Item] keyed by k = [{ k: "a", w: 1 }]

/// Others.
let others: [Item] keyed by k = [{ k: "b", w: 2 }, { k: "c", w: 3 }, { k: "d", w: 4 }, { k: "e", w: 5 }, { k: "f", w: 6 }]

/// A list of refs at the top level holding an entry of others.
let picks: [ref items] = [other(3)]

/// Each slot of a box holding an entry of others or a value outside its refinement.
let boxes: [Box] = [{ rs: [other(4)], m: { "x": other(5) }, o: other(6), f: zeroF() - 1.5, e: zero() + 1 }]

/// A level below its refinement.
let levels: [Level] = [{ index: zero() - 1 }, { index: 3 }]

/// An entry of others where an item is declared.
let held: [Holder] = [{ r: others.first()! }]

/// A key given twice.
let dups: [Item] keyed by k = [{ k: "a", w: 1 }, { k: word(), w: 2 }]

/// Reads the invalid index, then fails.
let d1: Int = [levels[0].index].len() + [1][4]

/// Reads the invalid ref, then fails.
let d2: Int = [held[0].r].len() + [1][4]

/// Reads the repeated key, then fails.
let d3: Int = [dups.last()!.k].len() + [1][4]

/// Reads the top-level list's ref, then fails.
let d4: Int = [picks[0]].len() + [1][4]

/// Reads the list field's ref, then fails.
let d5: Int = [boxes[0].rs[0]].len() + [1][4]

/// Reads the map field's ref, then fails.
let d6: Int = [boxes[0].m["x"]].len() + [1][4]

/// Reads the optional ref, then fails.
let d7: Int = [boxes[0].o].len() + [1][4]

/// Reads the Float32, then fails.
let d8: Int = [boxes[0].f].len() + [1][4]

/// Reads the odd number, then fails.
let d9: Int = [boxes[0].e].len() + [1][4]

/// The entry of others of weight w.
local fn other(w: Int) -> Item { return others.filter(o => o.w == w).first()! }

/// Zero, known only once evaluated.
local fn zero() -> Int { return 0 }

/// Zero as a Float, known only once evaluated.
local fn zeroF() -> Float { return 0.0 }

/// A key, known only once evaluated.
local fn word() -> String { return "a" }

test "fresh" {
  expect package passes
}

test "each let substituted with itself" {
  expect package { levels: levels, held: held, dups: dups, picks: picks, boxes: boxes } passes
}

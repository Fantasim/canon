STDLIB.md §5 "Membership", DECISIONS 317 (amending 314): on a table or keyed list, `x in xs`,
`xs.contains(x)` and `xs.indexOf(x)` take an element only: a `T` (by equality) or a `ref T` (by
identity). A key is tested with `xs.hasKey(k)`, the same answer as `xs.get(k) != none`: a value
or ref of the key type, a bare key, or an entry converting to the key type (an entry of `KT`'s
target); a value that is not such an entry has no key (`false`, no finding). Every expect below
passes.
-- a/a.canon --
package a

record M {
  hp: Int
}

let ms: table M = {
  wolf { hp: 1 }
  bear { hp: 2 }
}

let others: table M = {
  wolf { hp: 1 }
}

record S {
  m: ref ms
  n: Int
}

record Z {
  spawns: [S] keyed by m
}

let z: Z = { spawns: [{ m: wolf, n: 2 }] }

let ss: [S] keyed by m = [{ m: wolf, n: 2 }]

record Q {
  name: String
  v: Int
}

let qs: [Q] keyed by name = [{ name: "a", v: 1 }]

record P {
  m: ref pool
  n: Int
}

let pool: table P = {
  a { m: a, n: 1 }
  b { m: a, n: 2 }
}

let ks: [P] keyed by m = [{ m: a, n: 3 }]

test "hasKey takes a ref of the key type" {
  let r: ref ms = ms.wolf
  let b: ref ms = ms.bear
  expect z.spawns.hasKey(r)
  expect not z.spawns.hasKey(b)
  expect ss.hasKey(r)
  expect z.spawns.get(r) != none
  expect z.spawns.get(b) == none
  expect z.spawns.hasKey(r) == (z.spawns.get(r) != none)
  expect z.spawns.hasKey(b) == (z.spawns.get(b) != none)
}

test "hasKey takes a bare key" {
  expect z.spawns.hasKey(wolf)
  expect not z.spawns.hasKey(bear)
}

test "an entry converting to the key type is a key" {
  expect z.spawns.hasKey(ms.wolf)
  expect not z.spawns.hasKey(ms.bear)
  expect z.spawns.get(ms.wolf) != none
}

test "a value of the target's type that is not an entry of it has no key" {
  let m: M = { hp: 1 }
  expect not z.spawns.hasKey(m)
  expect z.spawns.get(m) == none
  expect not z.spawns.hasKey(others.wolf)
  expect z.spawns.get(others.wolf) == none
}

test "a ref of the key type into a collection of T is an element, its key a hasKey" {
  let r: ref pool = pool.a
  let q: ref pool = pool.b
  expect ks.hasKey(r)
  expect not ks.hasKey(q)
  expect ks.hasKey(pool.a)
  expect not (r in ks)
  expect not ks.contains(r)
  expect ks.indexOf(r) == none
  expect not (pool.a in ks)
  expect ks.at(0) in ks
}

test "a T is an element, by equality" {
  let same: P = { m: pool.a, n: 3 }
  let other: P = { m: pool.a, n: 1 }
  expect same in ks
  expect not (other in ks)
  expect ks.contains(same)
  expect not ks.contains(other)
}

test "an element is found by equality" {
  let s: S = { m: ms.wolf, n: 2 }
  let t: S = { m: ms.wolf, n: 3 }
  expect s in z.spawns
  expect not (t in z.spawns)
  expect z.spawns.at(0) in z.spawns
  expect z.spawns.contains(s)
  expect z.spawns.indexOf(s) == 0
  expect z.spawns.indexOf(t) == none
}

test "a ref to the element type is an element, by identity" {
  let f: ref ss = ss.at(0)
  expect f in ss
  expect ss.contains(f)
  expect ss.indexOf(f) == 0
  expect not (f in z.spawns)
  expect not z.spawns.contains(f)
}

test "a table takes an entry or a ref into it as an element, a String key in hasKey" {
  let w: ref ms = ms.wolf
  let o: ref others = others.wolf
  expect w in ms
  expect ms.wolf in ms
  expect not (o in ms)
  expect ms.contains(w)
  expect ms.indexOf(ms.bear) == 1
  expect ms.hasKey("wolf")
  expect not ms.hasKey("fox")
  expect ms.hasKey(w)
  expect ms.hasKey(k: "bear")
}

test "a String key of a keyed list" {
  expect qs.hasKey("a")
  expect not qs.hasKey("b")
  expect qs.get("a") != none
  expect qs.find("b") == none
}

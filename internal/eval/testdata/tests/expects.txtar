EVALUATION.md §10.3 and §10.4: every expect form; a failing expect does not stop the test,
a hard error outside a subject does; a subject reading a poisoned value fails, naming it.
-- a/a.canon --
package a

record Box {
  size: Int(0..10)
  label: String = "box"

  check big: size < 8 else "box {label} is too big"
  warn size > 0 else "empty box"
}

let boxes: [Box] = [{ size: 1 }]
local let broken: Int = 1 / (boxes.len() - 1)

fn half(n: Int) -> Int { return n / 2 }

fn label() -> String { return "" }

test "expect forms" {
  expect half(4) == 2
  expect half(4) == 3
  expect Box { size: 9 } fails big
  expect Box { size: 9 } fails "too big"
  expect Box { size: 9 } fails E5001
  expect Box { size: 0 } warns "empty"
  expect Box { size: 1 } passes
  expect Box { size: half(22) } fails E3204
  expect half(boxes.len() / 0) == 0
  expect broken == 0
  expect half(4) == 2 and half(4) == 3
  expect label() == "x"
}

test "a hard error stops the test" {
  let x = boxes.len() / 0
  expect x == 1
}

test "a poisoned read stops the test and names the value" {
  let y = broken + 1
  expect y == 2
}

local let long: String = "abcdef"

/// Holds a string.
record Holder {
  /// Short.
  s: String(..3)
}

local let invalid: Holder = { s: long }

test "a tainted test still captures its findings" {
  let s = invalid.s
  expect boxes[5] fails E4002
}

test "a broken test does not run" {
  expect nothing == 1
}

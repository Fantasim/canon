EVALUATION.md §10.4, DECISIONS 448: an error finding a test's own statements produce outside every
expect (a refinement at a let's and at a call's storage point, a key given twice) fails the test
without stopping it, each finding once (§14), before a stopping error; a static warning in a
statement neither fails the test nor shows; inside an expect the finding stays the expect's.
-- a/a.canon --
package a

local let one: Int = 1

local fn nine() -> Int { return 9 }

local fn within(n: Int(0..=5)) -> Int { return n }

test "a let" {
  let x: Int(0..=5) = nine()
  expect x == 9
}

test "a call, twice" {
  for i in [1, 2] {
    let y = within(nine() + i - i)
  }
  expect one == 1
}

test "a key given twice" {
  let m: {Int: Int} = { i - i: i for i in [1, 2] }
  expect one == 1
}

test "an error, then a stop" {
  let x: Int(0..=5) = nine()
  let z = [1][nine()]
  expect z == 1
}

test "a warning" {
  let w = one ?? 2
  expect w == 1
}

test "inside an expect" {
  expect within(nine()) == 9
}
-- outcomes.txt --

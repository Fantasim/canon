/// Mails.
package features.matching

/// A mail.
record Mail {
  /// Its subject.
  subject: String
  /// Whether it is sent on a holiday.
  fn isHoliday() -> Bool {
    let zzMap: {String: Int} = { a: 1 }
    return zzMap == {}
  }
  warn isHoliday() else "a holiday mail usually carries penya"
}

/// The mails.
let mails: [Mail] = [{ subject: "Spring cleaning" }]

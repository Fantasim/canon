TYPES.md §15 (E3015), DECISIONS 210: a key dereference reads its table's let, so a fold reaching
one stops without a finding (the let is never forced) and the checker reports E3015.
-- a/a.canon --
/// A.
package a

/// An item.
record Item {
  /// Its power.
  power: Int = 1
}

/// The items.
let items: table Item = { sword {} }

/// Holds an item.
record Holder {
  /// The item.
  r: ref Item
}

/// The cap.
const CAP = Holder { r: sword }.r.power

/// A potion.
record Potion {
  /// Hit points restored.
  heal: Int(..=CAP)
}
-- findings.txt --
error[E3015]  a/a.canon:25:16
  this refinement bound must be a constant expression


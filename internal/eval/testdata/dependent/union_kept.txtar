TYPES.md §11.5, STDLIB.md §6, DECISIONS 408: a kept dependent map read through a field keeps its type: union with a literal binds x to each key, so d: {} builds Sub(d) with its own max, and == or != with a literal compares values built against P(key); a value that fits no branch at its key is E3802 where the union is stored.
-- a/a.canon --
package a

local enum K { num, sub }

local record Node {
  k: K
  max: Int = 5
}

local let nodes: table Node = { a { k: sub }, d { k: sub, max: 7 }, n { k: num } }

local record Sub(e: Node) {
  lim: Int = e.max
}

local type P(e: Node) = match e.k {
  num => Int
  sub => Sub(e)
}

local record H {
  by: {x in nodes: P(x)} = {}
}

local let hs: [H] = [{ by: { a: {}, n: 1 } }]
local let merged: {x in nodes: P(x)} = hs[0].by.union({ d: {}, n: 2 })
local let same: [Bool] = [hs[0].by == { a: {}, n: 1 }, hs[0].by != { a: { lim: 4 }, n: 1 }]
local let bad: {x in nodes: P(x)} = hs[0].by.union({ d: 3 })
-- dump.txt --
a.nodes = {a: Node{k: sub, max: 5}, d: Node{k: sub, max: 7}, n: Node{k: num, max: 5}}
a.hs = [H{by: {a: Sub{lim: 5}, n: 1}}]
a.merged = {a: Sub{lim: 5}, n: 1, d: Sub{lim: 7}}
a.same = [true, true]
a.bad = {a: Sub{lim: 5}, n: 1, d: 3}

error[E3802]  a/a.canon:28:57
  bad[d]: value does not match P(x) = a.Sub(e)
  expected by a/a.canon:28 (P(x))


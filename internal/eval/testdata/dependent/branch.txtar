TYPES.md §11.4, DECISIONS 171: a record literal given to a dependent field is classified against
the first branch that takes it; that branch's applied record binds the type function's argument
where the literal sits (a field, a list item, a dependent map's key, a default, through a nested
type function, a top-level let), without computing the branch, which verification judges (TYPES.md §11.6).
EVALUATION.md §2.2 (orchestrator log, W1 gate lift calls): the argument is evaluated first.
-- a/a.canon --
/// A.
package a

/// K.
enum K { num, sub, deep }

/// Node.
record Node {
  /// K.
  k: K
  /// Max.
  max: Int = 5
}

/// Nodes.
let nodes: table Node = { a { k: num }, b { k: sub }, c { k: deep, max: 2 } }

/// Sub, of a node.
record Sub(e: Node) {
  /// Limit, the node's max unless given.
  lim: Int = e.max

  check lim <= e.max else "lim {lim} above {e.max} of {e.k}"
}

/// P.
type P(e: Node) = match e.k {
  num => Int
  sub => Sub(e)
  deep => Q(e)
}

/// P2: its only record branch is Q's.
type P2(e: Node) = match e.k {
  deep => Q(e)
  _ => Int
}

/// Q, nested.
type Q(n: Node) = match n.k {
  deep => Sub(n)
  _ => Never
}

/// Holder.
record Holder {
  /// Like.
  like: ref nodes
  /// P, written before its argument in the literals.
  p: P(like)
  /// Ps.
  ps: [P(like)] = [{}, { lim: 1 }]
  /// By node.
  by: {x in nodes: P(x)} = {}
  /// Defaulted.
  d: P(like) = {}
  /// Through P2 then Q.
  q: P2(like) = {}
}

/// Holders.
let hs: [Holder] = [
  { p: { lim: 9 }, like: b },
  { like: a, p: 3, by: { b: {}, c: { lim: 7 } } },
  { like: c, p: {} },
]

/// A dependent map at the top level: its binder is its declared type's.
let top: {x in nodes: P(x)} = { c: {}, b: { lim: 4 } }

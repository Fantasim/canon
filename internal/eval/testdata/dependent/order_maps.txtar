EVALUATION.md §5, DECISIONS 408, 446: independent kept-map literals are judged in recording order, so a budget that runs out among them stops at the same literal as before (sweep.txt: each budget whose findings change).
-- a/a.canon --
/// A.
package a

local enum E { a, retired b, c }

local enum K @codes(UInt8) { x = 7, retired y = 1, z = 3 }

local record Node {
  k: E
}

local let nodes: table Node = { p { k: a }, q { k: c } }

local type P(e: Node) = match e.k {
  a => Int
  b => Int
  c => String
}

local let m: {x in nodes: P(x)} = { p: 1 }
local let e1: Bool = m == { q: 1 }
local let e2: Bool = m == { q: 2, p: 3 }
local let e3: Bool = m != { p: 4, q: "z" }
-- dump.txt --
a.nodes = {p: Node{k: a}, q: Node{k: c}}
a.m = {p: 1}
a.e1 = false
a.e2 = false
a.e3 = true

error[E3802]  a/a.canon:21:32
  [q]: value does not match P(x) = String
  expected by a/a.canon:20 (P(x))

error[E3802]  a/a.canon:22:32
  [q]: value does not match P(x) = String
  expected by a/a.canon:20 (P(x))


-- a/a.canon --
/// A.
package a

/// Tier.
record Tier {
  /// Weight.
  weight: Int = 1
}

/// Config.
record Config {
  /// Name.
  name: String
  /// Port.
  port: Int = 8080
  /// Tags.
  tags: [String] = ["x", "y"]
  /// Tiers.
  tiers: table Tier = {}
  /// Limits.
  limits: {String: Int} = {}
  /// Doubled, through a lambda.
  doubled: [Int] = [1, 2].map(x => 7)
}

/// Secrets.
record Gen {
  /// Key.
  key: input String? from env "A_KEY"
}

/// Server, read from JSON.
record Server {
  /// Port.
  port: Int
  /// Host.
  host: String
  /// Note.
  note: String?
}

/// A literal.
let lit: Int = 7

/// Passed along.
let alias: Int = lit

/// Computed at the top.
let sum: Int = lit + 1

/// A config.
let cfg: Config = {
  name: "main"
  tiers: {
    /// Low.
    low { weight: 2 }
  }
  limits: { "x": 3 }
}

/// A spread copy.
let copy: Config = { ...cfg, port: 9 }

/// Twice.
fn twice(n: Int) -> Int {
  return n * 2
}

/// Builds.
fn build(n: Int) -> Config {
  return { name: "built", port: twice(n) }
}

/// Built by functions.
let made: Config = build(4)

/// Its only field is an input.
let gen: Gen = {}

/// Written, its note absent.
let here: Server = { port: 1, host: "x" }

/// Loaded.
let srv: Server = load("@resource/srv.json")

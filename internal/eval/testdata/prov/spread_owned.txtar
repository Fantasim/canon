-- a/a.canon --
/// A.
package a

/// K.
enum K { num, sub }

/// Node.
record Node {
  /// K.
  k: K
  /// Max.
  max: Int = 5
}

/// Nodes.
let nodes: table Node = { a { k: num }, b { k: sub, max: 3 } }

/// Sub, of a node.
record Sub(e: Node) {
  /// Limit.
  lim: Int = e.max

  check lim <= e.max else "lim {lim} above {e.max}"
}

/// P.
type P(e: Node) = match e.k {
  num => Int
  sub => Sub(e)
}

/// Item.
record Item {
  /// Name.
  name: String
  /// W.
  w: Int(0..5) = 1
}

/// Many: verification converts its list of dependent values; it owns items.
record Many {
  /// Like.
  like: ref nodes
  /// Subs.
  subs: [P(like)]
  /// Items.
  items: [Item] keyed by name
  /// Pick.
  pick: ref Item
}

/// Holder: verification charges its dependent field; it owns items.
record Holder {
  /// Like.
  like: ref nodes
  /// Sub.
  sub: P(like)
  /// Items.
  items: [Item] keyed by name
  /// Pick.
  pick: ref Item
}

/// Outer.
record Outer {
  /// Many.
  many: Many
  /// Holder.
  h: Holder
  /// Label.
  label: String = ""
}

/// Group: its entries own items, and verification converts each.
record Group {
  /// Ms.
  ms: table Many
}

/// A group.
let g: Group = { ms: { m1 { like: b, subs: [{ lim: 1 }], items: [{ name: "i1" }], pick: "i1" } } }

/// Its copy: each entry takes the copy's identity.
let g2: Group = { ...g }

/// Its entries are tc's under another identity, each the same instance.
let ta: table Many = { a { like: b, subs: [{ lim: 1 }], items: [{ name: "i1" }], pick: "i1" } }

/// Tc, the same instances.
let tc: table Many = ta

/// The base.
let base: Outer = {
  many: { like: b, subs: [{ lim: 1 }, {}], items: [{ name: "i1" }, { name: "i2", w: 4 }], pick: "i2" }
  h: { like: b, sub: { lim: 9 }, items: [{ name: "j1" }], pick: "j1" }
}

/// A copy.
let copy: Outer = { ...base, label: "copy" }

/// Over: its many overridden by a literal, h spread.
let over: Outer = { ...base, many: { like: a, subs: [1], items: [{ name: "i2" }], pick: "i2" } }

/// Copy of copy.
let again: Outer = { ...copy }

/// Reads.
let reads: [Bool] = [copy.many.pick == copy.many.items["i2"], base.many.pick == base.many.items["i2"], copy.many.pick == base.many.pick, copy.many.pick.name == "i2", copy.h.pick == base.h.pick, copy.h.pick == copy.h.items["j1"], over.h.pick == base.h.pick, again.many.pick == base.many.pick, over.many.pick == base.many.pick, over.many.pick == over.many.items["i2"]]

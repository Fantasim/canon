-- a/a.canon --
/// A.
package a

/// K.
enum K { num, sub }

/// Node.
record Node {
  /// K.
  k: K
  /// Max.
  max: Int = 5
}

/// Nodes.
let nodes: table Node = { a { k: num }, b { k: sub, max: 3 } }

/// Sub, of a node.
record Sub(e: Node) {
  /// Limit, the node's max unless given.
  lim: Int = e.max

  check lim <= e.max else "lim {lim} above {e.max}"
}

/// P.
type P(e: Node) = match e.k {
  num => Int
  sub => Sub(e)
}

/// Holder: verification charges its dependent field.
record Holder {
  /// Like.
  like: ref nodes
  /// Sub, dependent.
  sub: P(like)
}

/// Many: verification converts its list of dependent values.
record Many {
  /// Like.
  like: ref nodes
  /// Subs, dependent.
  subs: [P(like)]
}

/// Outer.
record Outer {
  /// H.
  h: Holder
  /// Many.
  many: Many
  /// Label.
  label: String = ""
}

/// The base.
let base: Outer = { h: { like: b, sub: { lim: 9 } }, many: { like: b, subs: [{ lim: 1 }, {}] } }

/// A copy.
let copy: Outer = { ...base, label: "copy" }

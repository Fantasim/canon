-- a/a.canon --
/// A.
package a

/// K.
enum K { num, sub }

/// Node.
record Node {
  /// K.
  k: K
  /// Max.
  max: Int = 5
}

/// Nodes.
let nodes: table Node = { a { k: num }, b { k: sub, max: 3 } }

/// Sub, of a node.
record Sub(e: Node) {
  /// Limit, the node's max unless given.
  lim: Int = e.max

  check lim <= e.max else "lim {lim} above {e.max}"
}

/// P.
type P(e: Node) = match e.k {
  num => Int
  sub => Sub(e)
}

/// Bad: its check fails.
record Bad {
  /// N.
  n: Int

  check n > 0 else "n is {n}"
}

/// Holder.
record Holder {
  /// Like.
  like: ref nodes
  /// Sub, dependent.
  sub: P(like)
  /// Bad.
  bad: Bad
  /// Label.
  label: String = ""
}

/// The base.
let base: Holder = { like: b, sub: { lim: 9 }, bad: { n: 0 } }

/// A copy.
let copy: Holder = { ...base, label: "copy" }

/// A copy of the copy.
let again: Holder = { ...copy, label: "again" }

-- a/a.canon --
/// A.
package a

/// Server.
record Server {
  /// Host.
  host: String = "127.0.0.1"
  /// Port.
  port: Int(1024..=65535) = 8765
  /// URL, derived.
  url: String = "http://{host}:{port}"
}

/// Tier.
record Tier {
  /// Weight.
  weight: Int = 1
}

/// Config.
record Config {
  /// Server.
  server: Server = {}
  /// Extra.
  extra: Tier = {}
  /// Backup.
  backup: Server = {}
  /// Tiers.
  tiers: table Tier = { low {} }
  /// Limits.
  limits: {String: Int} = { "a": 1 }
}

/// Loaded.
record Endpoint {
  /// Port.
  port: Int
  /// Host.
  host: String
}

/// Config.
let config: Config = {}

/// Loaded.
let srv: Endpoint = load("@resource/srv.json")
-- a/dev.canon --
package a
layer dev

amend config {
  server.port: 9000
  extra: { weight: 4 }
  backup.port: 9001
}

amend srv {
  port: 81
}
-- a/louis.canon --
package a
layer louis

amend config {
  server.port: 9100
  extra.weight: 6
  tiers.high: { weight: 5 }
  limits["b"]: 2
  backup: { host: "localhost" }
}
-- resource/srv.json --
{"port": 80, "host": "h"}

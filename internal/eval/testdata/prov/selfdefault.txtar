-- a/a.canon --
/// A.
package a

/// A server.
record Server {
  /// A port.
  port: Int = 80
  /// Its name.
  me: String = "{self.port}"
  /// Twice the port.
  twice: Int = self.port * 2
  /// The port read through parentheses.
  paren: Int = (self).port + 1
}

/// Ev.
record Ev {
  /// Max.
  max: Int = 3
}

/// Reads its parameter, then itself.
record Lim(e: Ev) {
  /// The max.
  lim: Int = e.max
  /// Its label.
  label: String = "{self.lim}/{e.max}"
}

/// Holds an applied record.
record Holder {
  /// Ev.
  ev: Ev = { max: 7 }
  /// Lim.
  lim: Lim(ev) = {}
}

/// V.
variant V {
  /// C.
  c {
    /// N.
    n: Int = 1
    /// M.
    m: String = "{self.n}"
  }
}

/// The server.
let server: Server = { port: 8 }

/// Another server, amended.
let other: Server = {}

/// Holder.
let holder: Holder = {}

/// V.
let v: V = c { n: 4 }
-- a/dev.canon --
package a
layer dev

amend other {
  port: 9
}

-- a/a.canon --
/// A.
package a

/// A mark.
enum Mark @codes(UInt8) { a = 1, b = 2, c = 4 }

/// A pick.
enum K { x, y }

/// Picks x.
let pick: K = x

/// Nothing.
let maybe: Duration? = none

/// Passes a Duration along.
fn id(x: Duration) -> Duration {
  return x
}

/// Fields with wire forms, each given a load.
record Cfg {
  /// Whole, in seconds.
  d: Duration @json(unit: s)
  /// Whole, as 0 or 1.
  b: Bool @json(int)
  /// Whole, 0 for none.
  o: Duration? @json(none: 0)
  /// Whole, one bitmask.
  mk: [Mark] @json(bits)
  /// Elements, in seconds.
  ls: [Duration] @json(unit: s)
  /// Elements, as 0 or 1.
  lf: [Bool] @json(int)
  /// An if branch.
  br: Duration @json(unit: s)
  /// Both sides of ??.
  co: Duration @json(unit: s)
  /// A map value.
  w: {String: Duration} @json(unit: s)
  /// A default.
  df: Duration = load("@resource/five.json") @json(unit: s)
  /// An argument's load is not the field's.
  arg: Duration @json(unit: s)
  /// A match arm, the whole value.
  ma: Duration? @json(none: 0)
  /// Comprehension elements, below.
  nc: [Duration?]? @json(none: 0)
  /// Comprehension elements, in seconds.
  cu: [Duration] @json(unit: s)
  /// Map comprehension values, below.
  nmc: {String: Duration?}? @json(none: 0)
  /// Map comprehension values, in seconds.
  mu: {String: Duration} @json(unit: s)
  /// List elements, below.
  nl: [Duration?]? @json(none: 0)
  /// The whole list.
  nw: [Duration?]? @json(none: 0)
  /// Elements of elements, below.
  nn: [[Duration?]]? @json(none: 0)
  /// The left side of ??, the whole value.
  cl: Duration? @json(none: 0)
  /// The right side of ??, the whole value.
  cr: Duration? @json(none: 0)
  /// An else-if branch, the whole value.
  ei: Duration? @json(none: 0)
  /// A map value through parentheses and an if, below.
  wi: {String: Duration?}? @json(none: 0)
}

/// Every field given a load.
let cfg: Cfg = {
  d: load("@resource/five.json")
  b: load("@resource/one.json")
  o: load("@resource/zero.json")
  mk: load("@resource/five.json")
  ls: [load("@resource/five.json"), (load("@resource/one.json"))]
  lf: [load("@resource/one.json")]
  br: if true { load("@resource/five.json") } else { 1s }
  co: load("@resource/five.json") ?? 1s
  w: { "a": load("@resource/five.json") }
  arg: id(load("@resource/five.json"))
  ma: match pick {
    x => load("@resource/zero.json")
    y => 1s
  }
  nc: [load("@resource/zero.json") for i in [1]]
  cu: [load("@resource/five.json") for i in [1]]
  nmc: { n: load("@resource/zero.json") for n in ["a"] }
  mu: { n: load("@resource/five.json") for n in ["a"] }
  nl: [load("@resource/zero.json")]
  nw: load("@resource/zero.json")
  nn: [[load("@resource/zero.json")]]
  cl: load("@resource/zero.json") ?? 1s
  cr: maybe ?? load("@resource/zero.json")
  ei: if false { 1s } else if true { load("@resource/zero.json") } else { 2s }
  wi: { "a": (if true { load("@resource/zero.json") } else { 1s }) }
}

/// No field: the default unit.
let plain: Duration = load("@resource/five.json")

a:copy.tags[0]
a:copy.lim
a:copy.lim["x"]
a:copy.inner
a:copy.inner.weight
a:copy.tiers
a:copy.tiers.low
a:copy.nodes
a:copy.nodes[n2]
a:copy.pick
a:copy.label
a:copy.picks
a:moved.picks
a:moved.picks[0]
a:bad.few
a:copyBad.few
a:reads
-- a/a.canon --
/// A.
package a

/// Tier.
record Tier {
  /// Weight.
  weight: Int = 1
}

/// Node.
record Node {
  /// Name.
  name: String
}

/// Box.
record Box {
  /// Tags.
  tags: [String]
  /// Limits.
  lim: {String: Int}
  /// Inner.
  inner: Tier
  /// Tiers.
  tiers: table Tier
  /// Nodes.
  nodes: [Node] keyed by name
  /// Pick.
  pick: ref Node
  /// Picks.
  picks: [ref Node]
  /// Label.
  label: String
}

/// Few.
record Few {
  /// At most two.
  few: [Int](..3)
}

/// Keeps.
fn keep(xs: [Int]) -> [Int] {
  return xs.filter(x => true)
}

/// The base.
let base: Box = {
  tags: ["a", "b"]
  lim: { "x": 1 }
  inner: { weight: 2 }
  tiers: {
    /// Low.
    low { weight: 3 }
  }
  nodes: [{ name: "n1" }, { name: "n2" }]
  pick: "n2"
  picks: ["n1"]
  label: "base"
}

/// A spread copy.
let copy: Box = { ...base, label: "copy" }

/// Its nodes replaced: the copied picks still name the source's entries (DECISIONS 410).
let moved: Box = { ...base, nodes: [{ name: "n2" }] }

/// Stores the copied list where it is too long: located at the list's literal.
let short: [String](..2) = copy.tags

/// Stores the copied map where it is too large: located at the map's literal.
let small: {String: Int}(..1) = copy.lim

/// Stores the copied list's elements where they are too short: each at its literal.
let long: [String(2..)] = copy.tags

/// Too many.
let bad: Few = { few: keep([1, 2, 3, 4]) }

/// Copies too many.
let copyBad: Few = { ...bad }

/// Refs into the copied keyed list.
let reads: [Bool] = [copy.pick == copy.nodes["n2"], copy.pick == base.pick, copy.pick.name == "n2", copy.tiers.low.weight == 3]

-- a/a.canon --
/// A.
package a

/// Mode.
enum Mode { off, on }

/// Item.
record Item {
  /// N.
  n: Int = 1
}

/// Items.
let items: table Item = { one {} }

/// Ev.
record Ev {
  /// On.
  on: Bool
}

/// Evs.
let evs: table Ev = { yes { on: true }, no { on: false } }

/// P.
type P(e: Ev) = match e.on {
  true => ref items
  false => Int
}

/// Row.
record Row {
  /// Base.
  base: Int
  /// Mode.
  mode: Mode = on
  /// Tags.
  tags: [String] = ["t"]
  /// Twice the base.
  twice: Int = base * 2
  /// Note.
  note: String?
  /// Ev.
  ev: ref evs
  /// P.
  p: P(ev)
}

/// Rows.
let rows: [Row] = load("@resource/rows.json")
-- resource/rows.json --
[
  {"base": 1, "ev": "no", "p": 4},
  {"base": 3, "twice": 5, "ev": "yes", "p": "one"}
]

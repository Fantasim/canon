/// A.
package a

/// Tier.
record Tier {
  /// Weight.
  weight: Int = 1
}

/// Server.
record Server {
  /// Pick.
  pick: ref Tier = low
  /// X.
  x: Int = 0
  /// W.
  w: Int = if x > 0 { pick.weight } else { 0 }
}

/// Config.
record Config {
  /// Tiers.
  tiers: table Tier = { low { weight: 3 } }
  /// Server.
  server: Server = {}
}

/// Amended.
let config: Config = {}

/// Written.
let written: Config = { tiers: { low { weight: 9 } }, server: { x: 1 } }

EVALUATION.md §9.3: an intermediate key that does not exist is E1905, hard; a layer reading
the let it amends is E4301; a layer adding to a stable table is poisoned and left to lock. Step 2
evaluates the right-hand side before the replace: when both fail, the right-hand side's error is
the one reported.
-- layers --
bad
-- a/a.canon --
/// A.
package a

/// Tier.
record Tier {
  /// Weight.
  weight: Int = 1
}

/// Box.
record Box {
  /// N.
  n: Int = 1
  /// Limits.
  limits: {String: [Int]} = { "a": [1] }
}

/// Tiers.
let tiers: stable table Tier = { low {} }

/// Box.
let box: Box = {}

/// Other.
let other: Box = {}

/// Both: its amendment's value and path both fail.
let both: Box = {}
-- a/bad.canon --
package a
layer bad

amend other {
  limits["zz"][0]: 2
}

amend tiers {
  high: { weight: 5 }
}

amend box {
  n: box.n + 1
}

amend both {
  limits["zz"][0]: both.n
}
-- dump.txt --
a.tiers poisoned
a.box poisoned
a.other poisoned
a.both poisoned
stable amendment: layer bad table "tiers" field ""

error[E1905]  a/bad.canon:5:9
  other: amend path limits["zz"][0]: key zz does not exist

error[E4301]  a/bad.canon:13:6
  box.n: cycle between values: box -> box

error[E4301]  a/bad.canon:17:20
  both.limits[zz]: cycle between values: both -> both

3 errors, 0 warnings in 1 package (…)

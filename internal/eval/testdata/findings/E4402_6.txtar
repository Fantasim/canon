/// A.
package a

local variant Loop {
  step {
    n: Int

    fn back(self) -> Int { return again() }
  }

  fn again(self) -> Int {
    return match self {
      step(s) => s.back()
    }
  }
}

local let y: Int = Loop.step { n: 1 }.again()

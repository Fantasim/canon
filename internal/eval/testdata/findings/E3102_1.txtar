TYPES.md §9.1: a list converted to a keyed list with a key twice (EVALUATION.md §4.3).
-- a/a.canon --
/// A.
package a

/// R.
record R {
  /// K.
  k: String
  /// X.
  x: Int
}

local fn mk(a: String, b: String) -> [R] { return [R { k: a, x: 1 }, R { k: b, x: 2 }] }

local let s: String = "a"

/// V.
let v: [R] keyed by k = mk(s, s)
-- findings.txt --
error[E3102]  a/a.canon:14:23
  v[a].k: key a is used twice (first at a/a.canon:14)


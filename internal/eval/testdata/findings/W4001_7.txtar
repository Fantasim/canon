EVALUATION.md §1, DECISIONS 331: two broken records naming each other, A declared first: each
value reaches both, so A and B each count 2. W4001_8 declares B first and counts the same.
-- a/a.canon --
/// A.
package a

/// A.
record A {
  /// B.
  b: B?
}

/// B.
record B {
  /// A.
  a: A?

  check broken: 1 < "2" else "broken"
}

/// An A.
let x: A = {}

/// A B.
let y: B = {}

-- a/a.canon --
/// A.
package a

local fn fa(n: Int) -> Int {
  if n == 0 { return b }
  return fa(n - 1)
}

local fn fb(n: Int) -> Int {
  if n == 0 { return c }
  return fb(n - 1)
}

local fn fc(n: Int) -> Int {
  if n == 0 { return 0 }
  return fc(n - 1)
}

local let a: Int = fa(4000)

local let b: Int = fb(4000)

local let c: Int = fc(4000)

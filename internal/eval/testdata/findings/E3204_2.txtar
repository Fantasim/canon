  expected by a/a.canon:19 (s: Small)

error[E3204]  a/a.canon:22:19
  r.vs[0]: 30 is outside 0..10
  expected by a/a.canon:10 (vs: [Int(0..10)])

error[E3204]  a/a.canon:22:38
  r.by[a]: 35 is outside 0..10

TYPES.md §7.5, DECISIONS 199: `==` charges a step per pair it compares. Building two trees of
60 levels, each shared 2^60 ways, spends about 1350 of the 1400 steps; comparing them needs
more than the 50 left even when every pair is remembered (at least 2 per level), so the budget
runs out at the `==` whatever the pair memo's threshold.
-- a/a.canon --
/// A.
package a

/// A node.
record Node {
  /// Its children.
  kids: [Node]
}

local fn grow(n: Int) -> Node {
  var x = Node { kids: [] }
  var i = 0
  while i < n {
    x = Node { kids: [x, x] }
    i += 1
  }
  return x
}

local let same: Bool = grow(60) == grow(60)
-- budget --
1400

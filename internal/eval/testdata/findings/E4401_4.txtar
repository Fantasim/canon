TYPES.md §7.5, DECISIONS 197: `==` charges a step per composite pair it visits, so comparing
two trees built apart, each shared 2^30 ways, runs out of budget at the comparison.
-- a/a.canon --
/// A.
package a

/// A node.
record Node {
  /// Its children.
  kids: [Node]
}

local fn grow(n: Int) -> Node {
  var x = Node { kids: [] }
  var i = 0
  while i < n {
    x = Node { kids: [x, x] }
    i += 1
  }
  return x
}

local let same: Bool = grow(30) == grow(30)
-- budget --
1500

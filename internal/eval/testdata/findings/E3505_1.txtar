EVALUATION.md §3.4: dereferencing a level-1 ref no enclosing instance bound.
-- a/a.canon --
/// A.
package a

/// Node.
record Node {
  /// Name.
  name: String
}

/// Link.
record Link {
  /// To.
  to: ref Node
}

/// Tree.
record Tree {
  /// Nodes.
  nodes: [Node] keyed by name
  /// Links.
  links: [Link]
}

local let orphan: Link = { to: "x" }

local let n: String = orphan.to.name

-- a/a.canon --
/// A.
package a

/// One.
const ONE = 1

/// The highest price.
const LIMIT = ONE + ONE + ONE + ONE + ONE + ONE + ONE + ONE + ONE + ONE + ONE + ONE + ONE + ONE

/// A thing sold.
record Item {
  /// Its price.
  price: Int(0..=LIMIT)
}

local fn loop(n: Int) -> Int {
  var i = 0
  while i < n { i += 1 }
  return i
}

local let small: Int = loop(30)

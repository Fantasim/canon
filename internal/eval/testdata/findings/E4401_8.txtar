import b

/// Spends a's budget in b's code.
let viaFn: Int = b.spin(1000)

/// Left unevaluated once a's budget is spent.
let again: Int = b.spin(2)

/// A thing whose default costs.
record Thing {
  /// Its size, costly by default.
  size: Int = [i * 2 for i in 0..1000].len()
}

EVALUATION.md §1, DECISIONS 331: a dependent map whose branch is a broken record reaches it:
`byKind` counts under Gem through the dependent branch of Payload.
-- a/a.canon --
/// A.
package a

/// Gem.
record Gem {
  /// W.
  w: Int = "heavy"
}

/// Kind.
enum Kind { gem, none_ }

/// Holder.
record Holder {
  /// Key.
  key: String
  /// Kind.
  kind: Kind
}

/// Payload.
type Payload(k: Kind) = match k {
  gem => Gem
  none_ => Never
}

/// Holders.
let holders: [Holder] keyed by key = [{ key: "a", kind: gem }]

/// A dependent map.
let byKind: {h in holders: Payload(h.kind)} = { a: { w: 1 } }

EVALUATION.md §9.3 steps 2–4, §3.4: an amended value is poisoned, converted and checked as the
same value written in source: an out-of-range port (E3204), a failed check (E5001), a re-derived
default reading its own or its enclosing instance's ref (E3505), a derived copy with other tiers
(E3501).
-- layers --
dev
-- a/a.canon --
/// A.
package a

/// Tier.
record Tier {
  /// Weight.
  weight: Int = 1
}

/// Server.
record Server {
  /// Host.
  host: String = "127.0.0.1"
  /// Port.
  port: Int(1024..=65535) = 8765

  check host == "127.0.0.1" or host == "localhost"
    else "loopback only"
}

/// Plan.
record Plan {
  /// Tiers.
  tiers: table Tier = { low {} }
  /// Pick.
  pick: ref Tier = low
  /// X.
  x: Int = 0
  /// W.
  w: Int = if x > 0 { pick.weight } else { 0 }
}

/// Served.
record Served {
  /// Pick.
  pick: ref Tier = low
  /// X.
  x: Int = 0
  /// W.
  w: Int = if x > 0 { pick.weight } else { 0 }
}

/// Holder.
record Holder {
  /// Tiers.
  tiers: table Tier = { low { weight: 3 } }
  /// Served.
  served: Served = {}
}

/// Link.
record Link {
  /// To.
  to: ref Tier
}

/// Copying.
record Copying {
  /// Tiers.
  tiers: table Tier = { low {} }
  /// Links.
  links: [Link] = [{ to: "low" }]
  /// X.
  x: Int = 0
  /// A copy with other tiers.
  copy: Copying? = if x > 0 { { tiers: { other {} }, links: links, x: 0 } } else { none }
}

/// Port.
let port: Server = {}

/// Port.
let portWritten: Server = { port: base + 1 }

/// Below the range, known only when evaluated (a literal would break the layer statically).
let base: Int = 79

/// Host.
let open: Server = {}

/// Host.
let openWritten: Server = { host: "0.0.0.0" }

/// Own ref.
let plan: Plan = {}

/// Own ref.
let planWritten: Plan = { tiers: { low { weight: 9 } }, x: 1 }

/// Enclosing ref.
let holder: Holder = {}

/// Enclosing ref.
let holderWritten: Holder = { served: { x: 1 } }

/// Copy.
let copying: Copying = {}

/// Copy.
let copyingWritten: Copying = { x: 1 }
-- a/dev.canon --
package a
layer dev

amend port {
  port: base + 1
}

amend open {
  host: "0.0.0.0"
}

amend plan {
  tiers.low.weight: 9
  x: 1
}

amend holder {
  served.x: 1
}

amend copying {
  x: 1
}

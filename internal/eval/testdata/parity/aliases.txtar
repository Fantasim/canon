EVALUATION.md §4.2, §9.2, §9.3, TYPES.md §7.5, DECISIONS 486: copies share the instance: a let written
into a field is the let's instance, its refs equal the let's entries; a default's copy of its literal
owns its map's ref keys, so an amend path's ref key replaces one; an amended copy is its own instance,
and the entries it leaves unchanged keep their source's identity. hc's twin would be
`{ other: { ...std, m: { low: 3 } } }`, whose written map key fails `contains` against TYPES.md §7.5
(EVAL-CONTAINSEQ, the same on base); the parity harness takes no partial twin, so hc has none yet.
-- layers --
dev
-- a/a.canon --
/// A.
package a

/// Tier.
record Tier {
  /// Weight.
  weight: Int = 1
}

/// Plan.
record Plan {
  /// Tiers.
  tiers: table Tier = { low {} }
  /// Pick.
  pick: ref Tier = low
  /// By tier.
  m: {ref Tier: Int} = { low: 1 }
}

/// The standard plan.
let std: Plan = {}

/// Holder.
record Holder {
  /// Plan, a default.
  plan: Plan = {}
  /// Other.
  other: Plan
}

/// Its default plan amended.
let h: Holder = { other: std }
/// Its default plan amended.
let hWritten: Holder = { plan: { m: { low: 2 } }, other: std }

/// Its copy of std amended.
let hc: Holder = { other: std }

/// Not amended.
let k: Holder = { other: std }
/// Not amended.
let kWritten: Holder = { other: std }

/// Its other plan is std's instance.
let same: [Bool] = [k.other.pick == std.tiers.low, [k.other.pick].contains(std.tiers.low), k.other.m.keys().contains(std.tiers.low)]
/// Its other plan is std's instance.
let sameWritten: [Bool] = [kWritten.other.pick == std.tiers.low, [kWritten.other.pick].contains(std.tiers.low), kWritten.other.m.keys().contains(std.tiers.low)]

/// The amended default plan is its own; the other is std's.
let own: [Bool] = [h.plan.m.keys().contains(h.plan.tiers.low), h.other.pick == std.tiers.low]
/// The amended default plan is its own; the other is std's.
let ownWritten: [Bool] = [hWritten.plan.m.keys().contains(hWritten.plan.tiers.low), hWritten.other.pick == std.tiers.low]

/// The amended copy keeps std's unchanged entries.
let kept: [Bool] = [hc.other.tiers.low == std.tiers.low, hc.other.pick == std.tiers.low, hc.other.pick == hc.other.tiers.low, hc.other.m.keys().contains(hc.other.tiers.low)]
-- a/dev.canon --
package a
layer dev

amend h {
  plan.m[low]: 2
}

amend hc {
  other.m[low]: 3
}

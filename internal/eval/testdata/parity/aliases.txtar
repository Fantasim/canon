a.h = Holder{plan: Plan{tiers: {low: Tier{weight: 1}}, pick: low, m: {low: 2}}, other: Plan{tiers: {low: Tier{weight: 1}}, pick: low, m: {low: 1}}}
a.hWritten = Holder{plan: Plan{tiers: {low: Tier{weight: 1}}, pick: low, m: {low: 2}}, other: Plan{tiers: {low: Tier{weight: 1}}, pick: low, m: {low: 1}}}
a.hc = Holder{plan: Plan{tiers: {low: Tier{weight: 1}}, pick: low, m: {low: 1}}, other: Plan{tiers: {low: Tier{weight: 1}}, pick: low, m: {low: 3}}}
a.k = Holder{plan: Plan{tiers: {low: Tier{weight: 1}}, pick: low, m: {low: 1}}, other: Plan{tiers: {low: Tier{weight: 1}}, pick: low, m: {low: 1}}}
a.kWritten = Holder{plan: Plan{tiers: {low: Tier{weight: 1}}, pick: low, m: {low: 1}}, other: Plan{tiers: {low: Tier{weight: 1}}, pick: low, m: {low: 1}}}
a.same = [true, true, true]
a.sameWritten = [true, true, true]
a.own = [true, true]
a.ownWritten = [true, true]
a.kept = [true, true, true, true]


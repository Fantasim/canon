  tiers[#0].weight: 3
  tiers.high: { weight: 5 }
  xs[-1]: 30
  xs[#0]: 10
  items[7].n: 5
  named.b.n: 6
  named[#0].n: 9
  colors[green]: 2
  shape.r: 4
}

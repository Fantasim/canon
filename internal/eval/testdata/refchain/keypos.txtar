}

local record P {
  e: ref tab
  w: Int = 0
}

local record Q {
  m: ref pool
  w: Int = 0
}

local let js: [J] keyed by n = [{ n: 9 }, { n: 10 }]

local let ss: [S] keyed by s = [{ s: "x" }, { s: "y" }]

local let ts: [T] keyed by r = [{ r: "x", w: 7 }]

local let us: [U] keyed by t = [{ t: "x", w: 8 }]

local let tab: table E = {
  p {}
  q {}
}

local let ps: [P] keyed by e = [{ e: p, w: 9 }]

local let xs: [Int] = [1, 2, 3]

local let pool: table Q = {
  a { m: a, w: 1 }
  b { m: b, w: 2 }
}

local let picked: [Q] keyed by m = [pool.a]

local let q: ref pool = a

let selected: [Int] = [ts.x.w, us.x.w, ps.p.w]

let named: [Bool] = [js.contains(x: js[9]), js.indexOf(x: js[10]) == 1, js.get(k: 9) != none, js.find(k: 11) == none, js.hasKey(k: 10)]

let indexed: [Int] = [xs[1 + 1], xs[-1], js[1 + 9].n]

let own: [Bool] = [picked.a in picked, picked.contains(picked.a), pool.a in picked, picked.hasKey(q), picked.hasKey(b)]

let gone: Int = ts.y.w

let goneTable: Int = ps.q.w

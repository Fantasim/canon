-- a/a.canon --
/// A.
package a

/// K.
enum K { num, rec }

/// A node.
record Node {
  /// Kind.
  k: K
}

/// Nodes.
let nodes: table Node = { a { k: num }, b { k: rec } }

/// Q.
type Q(e: Node) = match e.k {
  num => Int
  rec => String
}

/// R.
record R {
  /// Node.
  m: ref nodes
  /// Value.
  x: Q(m)
}

/// P.
type P(e: Node) = match e.k {
  num => Int
  rec => R
}

/// W.
record W {
  /// Node.
  n: ref nodes
  /// Value.
  v: P(n)
}

/// Ws.
let ws: table W = {}
-- a/e1.canon --
package a

entry ws.one { n: a, v: { m: a, x: "s" } }

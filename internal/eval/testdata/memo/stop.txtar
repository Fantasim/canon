-- a/a.canon --
/// A.
package a

/// No label.
local fn blank() -> String {
  return ""
}

/// Counts to n.
local fn loop(n: Int) -> Int {
  var i = 0
  while i < n { i += 1 }
  return i
}

/// An item.
record Item {
  /// Label.
  label: String(1..)
  /// Cost.
  cost: Int = 5
}

/// Items.
let items: table Item = {}

/// Late.
let late: Int = loop(50)
-- a/e1.canon --
package a

entry items.one { label: blank(), cost: late }

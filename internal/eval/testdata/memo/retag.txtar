EVALUATION.md §4.1, §4.2, DECISIONS 79, 195: an entry puts records it read into a keyed list, which
copies them with their identity: base keeps none, so a replay is the evaluation and the entry is kept.
-- memo --
stored 1 unkept 0
-- a/a.canon --
/// A.
package a

/// A tag.
record Tag {
  /// Name.
  name: String
}

/// Base tags.
let base: [Tag] = [{ name: "x" }, { name: "y" }]

/// An item.
record Item {
  /// Tags.
  tags: [Tag] keyed by name = []
}

/// Items.
let items: table Item = {}
-- a/e1.canon --
package a

entry items.one { tags: base }

EVALUATION.md §3.2 (EVL-06), §7.2, §7.3; IMPLEMENTATION-PLAN §7.6: an entry closing a cycle
(E4301 names the values being forced) or reading an invalid value (a taint) is not kept.
-- memo --
stored 1 unkept 2
-- a/a.canon --
/// A.
package a

/// No label.
local fn blank() -> String {
  return ""
}

/// A label, invalid.
let label: String(1..) = blank()

/// An item.
record Item {
  /// Cost.
  cost: Int = 5
  /// Name.
  name: String = "x"
}

/// Items.
let items: table Item = {}

/// Loops.
record Loop {
  /// N.
  n: Int = 0
}

/// Loops back.
let loops: table Loop = {}
-- a/e1.canon --
package a

entry items.one { name: label }
-- a/e2.canon --
package a

entry items.two { cost: 2 }
-- a/e3.canon --
package a

entry loops.back { n: loops.back.n }

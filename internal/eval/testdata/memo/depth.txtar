-- a/a.canon --
/// A.
package a

/// Sums to n.
local fn sum(n: Int) -> Int {
  return if n == 0 { 0 } else { n + sum(n - 1) }
}

/// Reads the items n frames down.
local fn down(n: Int) -> Int {
  return if n == 0 { items.a.v } else { down(n - 1) }
}

/// An item.
record Item {
  /// V.
  v: Int = 0
}

/// Deep.
let deep: Int = down(9960)

/// Items.
let items: table Item = {}
-- a/e1.canon --
package a

entry items.b { v: 1 }

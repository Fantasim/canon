-- a/a.canon --
/// A.
package a

/// A tag.
record Tag {
  /// Name.
  name: String
}

/// An item.
record Item {
  /// Tags.
  tags: [Tag] keyed by name = []
}

/// Items.
let items: table Item = {}

/// Base tags.
let base: [Tag] = [{ name: "x" }, { name: "y" }]

/// Reads base after.
let names: [Tag] = base
-- a/e1.canon --
package a

entry items.one { tags: base }

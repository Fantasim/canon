package kinds_test

import (
	"testing"

	kinds "example.com/large/kinds"
)

var rows = []struct {
	k    kinds.ShapeKind
	name string
}{
{{range .Rows}}	{kinds.ShapeKind{{.CaseConst}}, {{q .Case}}},
{{end}}}

func TestShapeKind(t *testing.T) {
	for _, c := range rows {
		if c.k.String() != c.name || c.k.Wire() != c.name {
			t.Errorf("%v: String %q Wire %q, want %q", c.k, c.k.String(), c.k.Wire(), c.name)
		}
		if got, ok := kinds.ParseShapeKind(c.name); !ok || got != c.k {
			t.Errorf("ParseShapeKind(%q) = %v, %v", c.name, got, ok)
		}
	}
	if got, ok := kinds.ParseShapeKind("nope"); ok || got != 0 {
		t.Errorf("ParseShapeKind(nope) = %v, %v", got, ok)
	}
	if got := kinds.ShapeKind({{.Count}}).String(); got != "ShapeKind({{.Count}})" {
		t.Errorf("out of range String %q", got)
	}
	if got := kinds.ShapeKind(65535).Wire(); got != "ShapeKind(65535)" {
		t.Errorf("out of range Wire %q", got)
	}
}

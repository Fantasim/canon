CODEGEN.md §5.4, DECISIONS 278: a record its own package writes only as table rows has a required `id`, so another package's baked ts emit cannot write it as a plain value: CrossPackageBakedValue at the value.
-- b/b.canon --
package b

/// A badge.
record Badge {
  /// Its label.
  label: String
}

/// A holder of badges by name.
record Shelf {
  /// Its badges.
  badges: table Badge = {}
}

emit ts { out: "@features/b/b.ts", mode: types }
-- a/a.canon --
package a

import b { Badge }

/// Badges, keyed.
let mine: [Badge] keyed by label = [{ label: "Mine" }]

emit ts { out: "@features/a/a.ts" }
-- findings.txt --
error[E8019]  a/a.canon:6:5
  emit ts in baked mode cannot generate a value of a record, variant or table of another package

1 error, 0 warnings in 2 packages (…)

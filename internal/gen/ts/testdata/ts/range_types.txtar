  const $v29: number | null = $r29 === undefined || $r29 === null ? null : decIn(decInt($r29, $path + ".po.q", -9223372036854776000, 9223372036854776000), $path + ".po.q", 0, 9, true, "0..=9");
  const $r30 = decGet($o, "mo", $path + ".mo", true);
  const $v30: ReadonlyMap<string, number | null> = $r30 === undefined ? /*#__PURE__*/ new CanonMap<string, number | null>([]) : decMap($r30, $path + ".mo", ($k, $p) => $k, ($x, $p) => $x === null ? null : decIn(decInt($x, $p, -9223372036854776000, 9223372036854776000), $p, 0, 9, true, "0..=9"));
  return { n: $v1, u8: $v2, i8: $v3, ex: $v4, f: $v5, f32: $v6, d: $v7, s: $v8, tags: $v9, m: $v10, mi: $v11, me: $v12, mr: $v13, opts: $v14, opt: $v15, mk: $v16, lit: $v17, dfl: $v18, sub: $v19, shape: $v20, flags: $v21, dsel: $v22, dep: $v23, rows: $v24, slots: $v25, ds: $v26, pr: $v27, pd: $v28, po: $v29, mo: $v30 };
}

/** Every position. */
export function decodeProbe(json: unknown): Probe {
  return canonFreeze(readProbe(json, "Probe: $"));
}

export function parseProbe(text: string): Probe {
  return decodeProbe(decParse(text, "Probe", "$"));
}

/** A refined list, a @text result. */
export function decodeCapsFile(json: unknown): ReadonlyArray<number> {
  return canonFreeze(decCountIn(decList(json, "CapsFile: $", ($x, $p) => decIn(decInt($x, $p, -9223372036854776000, 9223372036854776000), $p, 0, 5, true, "0..=5")), "CapsFile: $", -Infinity, 2, true, "..=2"));
}

export function parseCapsFile(text: string): ReadonlyArray<number> {
  return decodeCapsFile(decParse(text, "CapsFile", "$"));
}

CODEGEN.md §5.15, DECISIONS 399: a types-mode decoder refuses a value outside its range or length refinement at every position a refinement can stand: fields, elements, map keys and values, optionals, markers, a literal union's base, dependent branches, record and case fields, bits, pairs, a keyed list and a @text result.
-- a/a.canon --
/// Refinements at every position.
package a

/// Flags, written as one bitmask.
enum Flag @codes(UInt8) { a = 1, b = 2, c = 4 }

/// What a dependent field holds, by flag.
type Pick(f: Flag) = match f {
  a => String(2..=3)
  b => Int(0..=5)
  c => Never
}

/// A nested record.
record Sub {
  /// Its value.
  v: Int(0..=3)
}

/// A slot of the pairs list.
record Slot {
  /// Its count.
  n: Int(0..=3)
  /// Its weight.
  w: Int(0..=3)
}

/// A keyed row.
record Row {
  /// Its key.
  id: Int(0..=9)
}

/// A shape.
variant Shape @json(tag: "kind") {
  /// A circle.
  circle {
    /// Its radius.
    r: Int(0..=2)
  }
  /// A dot.
  dot
}

/// Every position.
record Probe {
  /// A signed integer.
  n: Int(1..=120)
  /// An unsigned byte: both sides are implied by its width.
  u8: UInt8(0..=255)
  /// A signed byte whose upper bound lies above its width.
  i8: Int8(0..=300)
  /// An exclusive upper bound.
  ex: Int(..5)
  /// A float.
  f: Float(0.0..1.0)
  /// A Float32, judged in binary64.
  f32: Float32(..=0.1)
  /// A Duration read in milliseconds.
  d: Duration(1s..=1h) @json(unit: ms)
  /// A string, in bytes.
  s: String(1..=4)
  /// A list and its elements.
  tags: [Int(0..=5)](..=3)
  /// A map, its keys and its values.
  m: {String(1..=3): Int(0..=9)}(..=2)
  /// A map with an integer key.
  mi: {UInt8(..=100): String}
  /// A map whose key has no refinement.
  me: {String: Int(0..=9)}
  /// A map of records.
  mr: {String: Sub}
  /// A list of optionals.
  opts: [Int(0..=5)?]
  /// An optional.
  opt: Int(0..=5)?
  /// An optional with a none marker.
  mk: Int(0..=5)? @json(none: -1)
  /// A literal union over a refined string.
  lit: String(6..=8) | "auto"
  /// A default.
  dfl: Int(1..=5) = 3
  /// A nested record.
  sub: Sub
  /// A variant.
  shape: Shape
  /// Flags.
  flags: [Flag](1..=2) @json(bits)
  /// A flag chooser.
  dsel: Flag
  /// A dependent value.
  dep: Pick(dsel)
  /// Rows.
  rows: [Row](..=2) keyed by id
  /// Slots.
  slots: [Slot](1..=2) @json(pairs: ["n{i}", "w{i}"])
  /// A Duration read in seconds.
  ds: Duration(1s..=2s) @json(unit: s)
  /// A required value down a path.
  pr: Int(0..=9) @json(path: "p.q")
  /// A defaulted value down a path.
  pd: Int(0..=9) = 4 @json(path: "pd.q")
  /// An optional value down a path.
  po: Int(0..=9)? @json(path: "po.q")
  /// A map of optional values.
  mo: {String: Int(0..=9)?} = {}
}

/// A refined list, a @text result.
@text("caps.json")
export fn caps() -> [Int(0..=5)](..=2) { return [1] }

emit ts { out: "@features/a/a.ts", mode: types }
emit text { out: "out/a" }

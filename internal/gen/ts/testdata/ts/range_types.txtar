}

function decString(raw: unknown, path: string): string {
  if (raw === null) decFail(path, "null");
  if (typeof raw !== "string") decFail(path, "expected a string");
  return raw;
}

function decDuration(raw: unknown, path: string, unit: number): number {
  if (raw === null) decFail(path, "null");
  const d = decDecimal(decText(raw) ?? "");
  if (d === undefined) return decFail(path, "expected a number");
  if (d.digits === "") return 0;
  // digits ends in no 0, and a unit holds at most 2^10 and 5^5: below 10^-64 no product is whole.
  if (d.exp < -64n) decFail(path, "not a whole number of milliseconds");
  if (d.exp > 20n) decFail(path, "duration out of range");
  const num = BigInt(d.digits) * BigInt(unit) * 10n ** (d.exp > 0n ? d.exp : 0n);
  const den = 10n ** (d.exp < 0n ? -d.exp : 0n);
  if (num % den !== 0n) decFail(path, "not a whole number of milliseconds");
  const ms = num / den;
  if (ms > 9223372036854n) decFail(path, "duration out of range");
  return Number(d.neg ? -ms : ms);
}

/** A number within its range refinement (CODEGEN.md §5.15): lo inclusive, hi inclusive when `inclusive`, an open end ±Infinity. */
function decIn(v: number, path: string, lo: number, hi: number, inclusive: boolean, range: string): number {
  if (!(v >= lo && (inclusive ? v <= hi : v < hi))) decFail(path, "expected a value in " + range);
  return v;
}

/** A String within its length refinement, in UTF-8 bytes (TYPES.md §7.4): s.length to 3 × s.length bytes, counted only between; a surrogate pair is 4 bytes, a lone surrogate 3 (as TextEncoder writes its replacement). A literal of a union passes. */
function decStrIn(s: string, path: string, lo: number, hi: number, inclusive: boolean, range: string, literals: ReadonlyArray<string> = []): string {
  let n = s.length;
  if ((n >= lo && (inclusive ? 3 * n <= hi : 3 * n < hi)) || literals.includes(s)) return s;
  for (let i = 0; i < s.length; i++) {
    const c = s.charCodeAt(i);
    if (c < 0x80) continue;
    const pair = c >= 0xd800 && c <= 0xdbff && i + 1 < s.length && s.charCodeAt(i + 1) >= 0xdc00 && s.charCodeAt(i + 1) <= 0xdfff;
    n += c < 0x800 ? 1 : 2;
    if (pair) i++;
  }
  if (!(n >= lo && (inclusive ? n <= hi : n < hi))) decFail(path, "expected a byte length in " + range);
  return s;
}

/** A list's, keyed list's or map's element count within its length refinement (CODEGEN.md §5.15). */
function decCountIn<T>(v: T, path: string, lo: number, hi: number, inclusive: boolean, range: string): T {
  const n = Array.isArray(v) ? v.length : (v as unknown as ReadonlyMap<unknown, unknown>).size;
  if (!(n >= lo && (inclusive ? n <= hi : n < hi))) decFail(path, "expected an element count in " + range);
  return v;
}

/** The rows of a keyed list or table unique by key (WIRE.md §5.7): the first row, in order, whose key repeats an earlier one fails at its key's path (`<path>[i].<keyPath>`), naming that row at the path without its leading `<name>: `; `token` writes a key as the data wire does (a String quoted, a number or bigint in decimal). */
function decUnique<R extends ReadonlyArray<unknown>, K>(rows: R, path: string, key: (row: R[number]) => K, keyPath: string, token: (k: K) => string = (k) => (typeof k === "string" ? JSON.stringify(k) : String(k))): R {
  const seen = new Map<K, number>();
  for (let i = 0; i < rows.length; i++) {
    const k = key(rows[i]);
    const first = seen.get(k);
    if (first !== undefined) decFail(path + "[" + i + "]." + keyPath, "duplicate id " + token(k) + " (first at " + path.slice(path.indexOf(": ") + 2) + "[" + first + "])");
    seen.set(k, i);
  }
  return rows;
}

/** One of members; a string no member has is refused with its value, as every target does (CODEGEN.md §5.13). */
function decEnum<T extends string>(raw: unknown, path: string, members: ReadonlyArray<T>): T {
  const s = decString(raw, path);
  const m = members.find((x) => x === s);
  if (m === undefined) decFail(path, "unknown value " + s);
  return m;
}

function decBits<T extends string>(raw: unknown, path: string, members: ReadonlyArray<T>, codes: Readonly<Record<T, number>>): T[] {
  if (raw === null) decFail(path, "null");
  if (typeof raw !== "bigint" && (typeof raw !== "number" || !Number.isSafeInteger(raw))) decFail(path, "expected a non-negative integer");
  let rest = BigInt(raw);
  if (rest < 0n) decFail(path, "expected a non-negative integer");
  if (rest > 9223372036854775807n) decFail(path, "integer out of range");
  const out: T[] = [];
  for (const m of [...members].sort((a, b) => codes[a] - codes[b])) {
    const bit = BigInt(codes[m]);
    if ((rest & bit) !== 0n) {
      out.push(m);
      rest &= ~bit;
    }
  }
  if (rest !== 0n) decFail(path, "unknown bits 0x" + rest.toString(16));
  return out;
}

function decList<T>(raw: unknown, path: string, read: (x: unknown, p: string) => T): T[] {
  return decArray(raw, path).map((x, i) => read(x, path + "[" + i + "]"));
}

/** An integer map key, exactly `0|-?[1-9][0-9]*` (WIRE.md §5.8; the message is the bytes of every target, CODEGEN.md §5.13), then a safe integer: past it is TypeScript's own limit. */
function decIntKey(k: string, path: string): number {
  if (!/^(0|-?[1-9][0-9]*)$/.test(k)) decFail(path, "expected a canonical decimal integer key");
  const n = Number(k);
  if (!Number.isSafeInteger(n)) decFail(path, "integer outside the TypeScript safe range");
  return n;
}

function decMap<K, V>(raw: unknown, path: string, key: (k: string, p: string) => K, read: (x: unknown, p: string) => V): CanonMap<K, V> {
  const o = decObject(raw, path);
  return new CanonMap(decKeys(o).map((k): readonly [K, V] => [key(k, path + "." + k), canonFreeze(read(o[k], path + "." + k))]));
}

function decPairs<T>(o: Record<string, unknown>, path: string, ka: ReadonlyArray<string>, kb: ReadonlyArray<string>, read: (a: unknown, b: unknown, pa: string, pb: string) => T): T[] {
  const out: T[] = [];
  let empty = false;
  for (let i = 0; i < ka.length; i++) {
    const a = decGet(o, ka[i]);
    const b = decGet(o, kb[i]);
    if (a === undefined && b === undefined) {
      empty = true;
      continue;
    }
    const first = path + "." + (a === undefined ? kb[i] : ka[i]);
    if (a === undefined || b === undefined) decFail(first, "incomplete pairs slot");
    if (a === null || b === null) decFail(first, "null in a pairs slot");
    if (empty) decFail(first, "pairs slot after an empty one");
    out.push(read(a, b, path + "." + ka[i], path + "." + kb[i]));
  }
  return out;
}

/** Reads JSON text the way WIRE.md §3.1 to §3.3 read a file, the first failure in document order, placed where it becomes certain. A types-mode decoder (root `$`): a syntax error is `<T>: invalid JSON at byte N`, N the 0-based UTF-8 offset of the first byte that cannot continue the document (a BOM counted) or the text's length when it ends too early; a repeated key, an unpaired surrogate, a lone surrogate code unit in a string (`not UTF-8`) and nesting past 512 are named at their `$` path (`<T>: $.a[1]: …`). A data file (root ""): a syntax error, invalid UTF-8 or an unpaired surrogate is `<file>: not a canon data file (invalid JSON)`, as the loaders print it; a repeated key and nesting past 512 are named at their path (`<file>: a[1]: …`) (DECISIONS 361). */
function decParse(text: string, label: string, root: string): unknown {
  let i = text.charCodeAt(0) === 0xfeff ? 1 : 0;
  const escapes: Record<string, string> = { '"': '"', "\\": "\\", "/": "/", b: "\b", f: "\f", n: "\n", r: "\r", t: "\t" };
  const bytes = (end: number): number => {
    let n = 0;
    for (const ch of text.slice(0, end)) {
      const cp = ch.codePointAt(0) as number;
      n += cp < 0x80 ? 1 : cp < 0x800 ? 2 : cp < 0x10000 ? 3 : 4;
    }
    return n;
  };
  const data = root === "";
  const member = (path: string, k: string): string => (path === label + ": " ? path + k : path + "." + k);
  const bad = (): never => decFail(label, data ? "not a canon data file (invalid JSON)" : "invalid JSON at byte " + bytes(i));
  const invalid = (path: string, message: string): never => (data ? bad() : decFail(path, message));
  const ws = (): void => {
    while (i < text.length && " \t\n\r".includes(text[i])) i++;
  };
  const digits = (): void => {
    if (!(text[i] >= "0" && text[i] <= "9")) bad();
    while (text[i] >= "0" && text[i] <= "9") i++;
  };
  const hex4 = (): number => {
    for (let k = 0; k < 4; k++) {
      if (!/^[0-9a-fA-F]$/.test(text[i + k] ?? "")) {
        i += k;
        bad();
      }
    }
    i += 4;
    return parseInt(text.slice(i - 4, i), 16);
  };
  const unicode = (path: string): string => {
    const u = hex4();
    if (u >= 0xdc00 && u <= 0xdfff) invalid(path, "unpaired surrogate");
    if (u < 0xd800 || u > 0xdbff) return String.fromCharCode(u);
    const next = text.slice(i, i + 2);
    if (next.length < 2 && "\\u".startsWith(next)) {
      i = text.length;
      bad();
    }
    if (next !== "\\u") invalid(path, "unpaired surrogate");
    i += 2;
    const lo = hex4();
    if (lo < 0xdc00 || lo > 0xdfff) invalid(path, "unpaired surrogate");
    return String.fromCharCode(u, lo);
  };
  const str = (path: string): string => {
    i++;
    let out = "";
    for (;;) {
      if (i >= text.length || text[i] < " ") bad();
      const c = text[i++];
      if (c === '"') return out;
      if (c >= "\ud800" && c <= "\udfff") {
        i--;
        if (c > "\udbff" || !(text[i + 1] >= "\udc00" && text[i + 1] <= "\udfff")) invalid(path, "not UTF-8");
        out += text.slice(i, i + 2);
        i += 2;
      } else if (c !== "\\") {
        out += c;
      } else if (text[i] === "u") {
        i++;
        out += unicode(path);
      } else if (Object.prototype.hasOwnProperty.call(escapes, text[i])) {
        out += escapes[text[i++]];
      } else {
        bad();
      }
    }
  };
  const num = (): unknown => {
    const start = i;
    if (text[i] === "-") i++;
    if (text[i] === "0") i++;
    else digits();
    let exact = false;
    if (text[i] === ".") {
      i++;
      digits();
      exact = true;
    }
    if (text[i] === "e" || text[i] === "E") {
      i++;
      if (text[i] === "+" || text[i] === "-") i++;
      digits();
      exact = true;
    }
    const token = text.slice(start, i);
    if (exact) return decToken(token);
    const n = Number(token);
    return Number.isSafeInteger(n) ? n : BigInt(token);
  };
  const word = (w: string, v: unknown): unknown => {
    for (let k = 0; k < w.length; k++) {
      if (text[i + k] !== w[k]) {
        i += k;
        bad();
      }
    }
    i += w.length;
    return v;
  };
  const sep = (close: string): boolean => {
    ws();
    if (text[i] === ",") {
      i++;
      return true;
    }
    if (text[i] !== close) bad();
    i++;
    return false;
  };
  const open = (depth: number, path: string): void => {
    if (depth >= 512) decFail(path, "nested deeper than 512 levels");
    i++;
    ws();
  };
  const obj = (depth: number, path: string): unknown => {
    open(depth, path);
    const o: Record<string, unknown> = {};
    const order: string[] = [];
    if (text[i] === "}") {
      i++;
    } else {
      do {
        ws();
        if (text[i] !== '"') bad();
        const k = str(path);
        if (Object.prototype.hasOwnProperty.call(o, k)) decFail(member(path, k), "duplicate key");
        ws();
        if (text[i] !== ":") bad();
        i++;
        Object.defineProperty(o, k, { value: val(depth + 1, member(path, k)), enumerable: true, writable: true, configurable: true });
        order.push(k);
      } while (sep("}"));
    }
    Object.defineProperty(o, decOrder, { value: order });
    return o;
  };
  const arr = (depth: number, path: string): unknown => {
    open(depth, path);
    const a: unknown[] = [];
    if (text[i] === "]") {
      i++;
      return a;
    }
    do {
      a.push(val(depth + 1, path + "[" + a.length + "]"));
    } while (sep("]"));
    return a;
  };
  const val = (depth: number, path: string): unknown => {
    ws();
    const c = text[i];
    if (c === "{") return obj(depth, path);
    if (c === "[") return arr(depth, path);
    if (c === '"') return str(path);
    if (c === "t") return word("true", true);
    if (c === "f") return word("false", false);
    if (c === "n") return word("null", null);
    if (c === "-" || (c >= "0" && c <= "9")) return num();
    return bad();
  };
  const v = val(0, label + ": " + root);
  ws();
  if (i < text.length) bad();
  return v;
}

function readPick($raw: unknown, $path: string, $disc: Flag): Pick {
  switch ($disc) {
    case "a":
      return { branch: "a", value: decStrIn(decString($raw, $path), $path, 2, 3, true, "2..=3") };
    case "b":
      return { branch: "b", value: decIn(decInt($raw, $path, -9223372036854776000, 9223372036854776000), $path, 0, 5, true, "0..=5") };
    default:
      return decFail($path, "no branch for this value");
  }
}

function readSub($raw: unknown, $path: string): Sub {
  const $o = decObject($raw, $path);
  const $v1: number = decIn(decInt(decGet($o, "v", $path + ".v"), $path + ".v", -9223372036854776000, 9223372036854776000), $path + ".v", 0, 3, true, "0..=3");
  return { v: $v1 };
}

/** A nested record. */
export function decodeSub(json: unknown): Sub {
  return canonFreeze(readSub(json, "Sub: $"));
}

export function parseSub(text: string): Sub {
  return decodeSub(decParse(text, "Sub", "$"));
}

function readSlot($raw: unknown, $path: string): Slot {
  const $o = decObject($raw, $path);
  const $v1: number = decIn(decInt(decGet($o, "n", $path + ".n"), $path + ".n", -9223372036854776000, 9223372036854776000), $path + ".n", 0, 3, true, "0..=3");
  const $v2: number = decIn(decInt(decGet($o, "w", $path + ".w"), $path + ".w", -9223372036854776000, 9223372036854776000), $path + ".w", 0, 3, true, "0..=3");
  return { n: $v1, w: $v2 };
}

/** A slot of the pairs list. */
export function decodeSlot(json: unknown): Slot {
  return canonFreeze(readSlot(json, "Slot: $"));
}

export function parseSlot(text: string): Slot {
  return decodeSlot(decParse(text, "Slot", "$"));
}

function readRow($raw: unknown, $path: string): Row {
  const $o = decObject($raw, $path);
  const $v1: number = decIn(decInt(decGet($o, "id", $path + ".id"), $path + ".id", -9223372036854776000, 9223372036854776000), $path + ".id", 0, 9, true, "0..=9");
  return { id: $v1 };
}

/** A keyed row. */
export function decodeRow(json: unknown): Row {
  return canonFreeze(readRow(json, "Row: $"));
}

export function parseRow(text: string): Row {
  return decodeRow(decParse(text, "Row", "$"));
}

function readShape($raw: unknown, $path: string): Shape {
  const $o = decObject($raw, $path);
  const $tag = decString(decGet($o, "kind", $path + ".kind"), $path + ".kind");
  switch ($tag) {
    case "circle":
      return readShapeCircle($o, $path);
    case "dot":
      return { kind: "dot" };
    default:
      return decFail($path + ".kind", "unknown case " + $tag);
  }
}

function readShapeCircle($o: Record<string, unknown>, $path: string): ShapeCircle {
  const $v1: number = decIn(decInt(decGet($o, "r", $path + ".r"), $path + ".r", -9223372036854776000, 9223372036854776000), $path + ".r", 0, 2, true, "0..=2");
  return { kind: "circle", r: $v1 };
}

/** A shape. */
export function decodeShape(json: unknown): Shape {
  return canonFreeze(readShape(json, "Shape: $"));
}

export function parseShape(text: string): Shape {
  return decodeShape(decParse(text, "Shape", "$"));
}

function readProbe($raw: unknown, $path: string): Probe {
  const $o = decObject($raw, $path);
  const $v1: number = decIn(decInt(decGet($o, "n", $path + ".n"), $path + ".n", -9223372036854776000, 9223372036854776000), $path + ".n", 1, 120, true, "1..=120");
  const $v2: number = decInt(decGet($o, "u8", $path + ".u8"), $path + ".u8", 0, 255);
  const $v3: number = decIn(decInt(decGet($o, "i8", $path + ".i8"), $path + ".i8", -128, 127), $path + ".i8", 0, Infinity, true, "0..=300");
  const $v4: number = decIn(decInt(decGet($o, "ex", $path + ".ex"), $path + ".ex", -9223372036854776000, 9223372036854776000), $path + ".ex", -Infinity, 5, false, "..5");
  const $v5: number = decIn(decFloat(decGet($o, "f", $path + ".f"), $path + ".f"), $path + ".f", 0, 1, false, "0..1");
  const $v6: number = decIn(decF32(decGet($o, "f32", $path + ".f32"), $path + ".f32"), $path + ".f32", -Infinity, 0.1, true, "..=0.1");
  const $v7: number = decIn(decDuration(decGet($o, "d", $path + ".d"), $path + ".d", 1), $path + ".d", 1000, 3600000, true, "1s..=1h");
  const $v8: string = decStrIn(decString(decGet($o, "s", $path + ".s"), $path + ".s"), $path + ".s", 1, 4, true, "1..=4");
  const $v9: ReadonlyArray<number> = decCountIn(decList(decGet($o, "tags", $path + ".tags"), $path + ".tags", ($x, $p) => decIn(decInt($x, $p, -9223372036854776000, 9223372036854776000), $p, 0, 5, true, "0..=5")), $path + ".tags", -Infinity, 3, true, "..=3");
  const $v10: ReadonlyMap<string, number> = decCountIn(decMap(decGet($o, "m", $path + ".m"), $path + ".m", ($k, $p) => decStrIn($k, $p, 1, 3, true, "1..=3"), ($x, $p) => decIn(decInt($x, $p, -9223372036854776000, 9223372036854776000), $p, 0, 9, true, "0..=9")), $path + ".m", -Infinity, 2, true, "..=2");
  const $v11: ReadonlyMap<number, string> = decMap(decGet($o, "mi", $path + ".mi"), $path + ".mi", ($k, $p) => decIn(decInt(decIntKey($k, $p), $p, 0, 255), $p, -Infinity, 100, true, "..=100"), ($x, $p) => decString($x, $p));
  const $v12: ReadonlyMap<string, number> = decMap(decGet($o, "me", $path + ".me"), $path + ".me", ($k, $p) => $k, ($x, $p) => decIn(decInt($x, $p, -9223372036854776000, 9223372036854776000), $p, 0, 9, true, "0..=9"));
  const $v13: ReadonlyMap<string, Sub> = decMap(decGet($o, "mr", $path + ".mr"), $path + ".mr", ($k, $p) => $k, ($x, $p) => readSub($x, $p));
  const $v14: ReadonlyArray<number | null> = decList(decGet($o, "opts", $path + ".opts"), $path + ".opts", ($x, $p) => $x === null ? null : decIn(decInt($x, $p, -9223372036854776000, 9223372036854776000), $p, 0, 5, true, "0..=5"));
  const $r15 = decGet($o, "opt");
  const $v15: number | null = $r15 === undefined || $r15 === null ? null : decIn(decInt($r15, $path + ".opt", -9223372036854776000, 9223372036854776000), $path + ".opt", 0, 5, true, "0..=5");
  const $r16 = decGet($o, "mk");
  const $v16: number | null = $r16 === undefined || $r16 === null || decSame($r16, "-1") ? null : decIn(decInt($r16, $path + ".mk", -9223372036854776000, 9223372036854776000), $path + ".mk", 0, 5, true, "0..=5");
  const $v17: string | "auto" = decStrIn(decString(decGet($o, "lit", $path + ".lit"), $path + ".lit") as string | "auto", $path + ".lit", 6, 8, true, "6..=8", ["auto"]);
  const $r18 = decGet($o, "dfl", $path + ".dfl", true);
  const $v18: number = $r18 === undefined ? 3 : decIn(decInt($r18, $path + ".dfl", -9223372036854776000, 9223372036854776000), $path + ".dfl", 1, 5, true, "1..=5");
  const $v19: Sub = readSub(decGet($o, "sub", $path + ".sub"), $path + ".sub");
  const $v20: Shape = readShape(decGet($o, "shape", $path + ".shape"), $path + ".shape");
  const $v21: ReadonlyArray<Flag> = decCountIn(decBits(decGet($o, "flags", $path + ".flags"), $path + ".flags", FlagMembers, FlagCodes), $path + ".flags", 1, 2, true, "1..=2");
  const $v22: Flag = decEnum(decGet($o, "dsel", $path + ".dsel"), $path + ".dsel", FlagMembers);

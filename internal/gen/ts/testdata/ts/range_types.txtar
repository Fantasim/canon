  const $v24: ReadonlyArray<Row> = decCountIn(decUnique(decList(decGet($o, "rows", $path + ".rows"), $path + ".rows", ($x, $p) => readRow($x, $p)), $path + ".rows", ($e) => $e.id, "id"), $path + ".rows", -Infinity, 2, true, "..=2");
  const $v25: ReadonlyArray<Slot> = decCountIn(decPairs($o, $path, ["n0", "n1"], ["w0", "w1"], ($a, $b, $pa, $pb) => ({ n: decIn(decInt($a, $pa, -9223372036854776000, 9223372036854776000), $pa, 0, 3, true, "0..=3"), w: decIn(decInt($b, $pb, -9223372036854776000, 9223372036854776000), $pb, 0, 3, true, "0..=3") })), $path + ".slots", 1, 2, true, "1..=2");
  const $v26: number = decIn(decDuration(decGet($o, "ds", $path + ".ds"), $path + ".ds", 1000), $path + ".ds", 1000, 2000, true, "1s..=2s");
  const $v27: number = decIn(decInt(decAt($o, ["p", "q"], $path, true), $path + ".p.q", -9223372036854776000, 9223372036854776000), $path + ".p.q", 0, 9, true, "0..=9");
  const $r28 = decAt($o, ["pd", "q"], $path, false);
  const $v28: number = $r28 === undefined ? 4 : decIn(decInt($r28, $path + ".pd.q", -9223372036854776000, 9223372036854776000), $path + ".pd.q", 0, 9, true, "0..=9");

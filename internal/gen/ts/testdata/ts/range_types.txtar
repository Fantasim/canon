  const c = decCompare(x, Math.abs(d));
  if (c === 0) return f;
  const pick = c > 0 ? Math.max(af, ag) : Math.min(af, ag);
  return Math.sign(d) * (pick === top ? Infinity : pick);
}

function decF32(raw: unknown, path: string, refusal = "number out of range"): number {
  const d = decFloat(raw, path, refusal);
  const f = Math.fround(d);
  const v = f === d || typeof raw === "number" ? f : decHalf(raw, d, f);
  if (!Number.isFinite(v)) decFail(path, "expected a number that fits Float32");

/// A precomputed map.
package a

/// A pair of numbers.
record Pair {
  /// Its weight.
  weight: Int
}

/// Weights by name.
export fn weights() -> {String: Pair} { return { "a": { weight: 1 }, "b": { weight: 2 } } }

/// Counts by name.
export fn counts() -> {String: Int} { return { "x": 1 } }


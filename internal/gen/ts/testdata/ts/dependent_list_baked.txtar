/// Lists of dependent values.
package a

/// Moods.
enum Mood { grim, merry }


/// A bonus, by mood.
type Bonus(m: Mood) = match m {
  grim => Int
  merry => String
}

/// A hero.
record Hero {
  /// The mood.
  aim: Mood
  /// The bonuses.
  bonuses: [Bonus(aim)]
}

/// The hero.
let hero: Hero = { aim: grim, bonuses: [1, 2] }

emit ts { out: "@features/a/a.ts" }

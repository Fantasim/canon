function canonTable<K, T, B extends Record<string, keyof T> = {}>(rows: ReadonlyArray<T>, keyOf: (row: T) => K, by?: B): CanonTable<K, T> & { readonly [P in keyof B]: (value: T[B[P]]) => T | null } {

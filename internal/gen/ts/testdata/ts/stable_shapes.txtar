/// Stable lookup shapes.
package a

/// An item.
record Item {
  /// Key.
  name: String(1..)
  /// Code.
  code: Int(1..) @stable @ts(name: "theCode")
  /// Serial.
  serial: Int(0..) @stable @ts(bigint)
}

/// Items.
let items: stable table Item = {
  a { name: "a", code: 1, serial: 9007199254740993 }
  b { name: "b", code: 2, serial: 5 }
}

/// Listed.
let listed: [Item] keyed by name = [
  { name: "x", code: 3, serial: 7 }
]


/// Rows that are also keyed-list elements.
package a

/// An item.
record Item {
  /// Its sku.
  sku: String
}

/// Extra items, a table.
let extra: table Item = { one { sku: "one" } }

/// Items, a keyed list of the same record.
let items: [Item] keyed by sku = [ { sku: "i1" } ]


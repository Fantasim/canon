/// Embedded.
package a

/// A country.
record Country {
  /// Its code.
  code: String
  /// VAT.
  vat: Float = 20.0
  /// Cards.
  cards: Bool = true
}

/// The countries.
let countries: [Country] keyed by code = [
  { code: "FR" },
  { code: "BE", vat: 21.0, cards: false },
]

/// The default.
let home: Country = { code: "FR" }

emit ts { out: "@features/a/a.ts", mode: embedded }

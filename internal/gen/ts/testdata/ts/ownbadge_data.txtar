export function decodeHolders(json: unknown): CanonTable<string, Holder> {
  const $doc = canonEnvelope(json, holdersSchema, "holders.json");
  return canonTable(canonFreeze(decList(decGet($doc, "rows"), "holders.json: rows", ($x, $p) => readHolder($x, $p))), ($e) => $e.key);
}

export function parseHolders(text: string): CanonTable<string, Holder> {
  return decodeHolders(decParse(text, "holders.json", ""));
}

export function decodeMine(json: unknown): CanonTable<BadgeId, CanonRow<Badge, BadgeId>> {
  const $doc = canonEnvelope(json, mineSchema, "mine.json");
  return canonTable(canonFreeze(decList(decGet($doc, "rows"), "mine.json: rows", ($x, $p) => readBadge($x, $p, null) as CanonRow<Badge, BadgeId>)), ($e) => $e.id);
}

export function parseMine(text: string): CanonTable<BadgeId, CanonRow<Badge, BadgeId>> {
  return decodeMine(decParse(text, "mine.json", ""));
}

export function decodeTheirs(json: unknown): CanonTable<string, base.Badge> {
  const $doc = canonEnvelope(json, theirsSchema, "theirs.json");
  return canonTable(canonFreeze(decList(decGet($doc, "rows"), "theirs.json: rows", ($x, $p) => read_base_Badge($x, $p))), ($e) => $e.label);
}

export function parseTheirs(text: string): CanonTable<string, base.Badge> {
  return decodeTheirs(decParse(text, "theirs.json", ""));
}

function readBadge($raw: unknown, $path: string, $rowId?: string | null): Badge {
  const $o = decObject($raw, $path);
  const $v1 = $rowId === undefined ? undefined : $rowId ?? decString(decGet($o, "$id"), $path + ".$id");
  const $v2 = $rowId === undefined ? undefined : decGet($o, "$retired") === undefined ? false : decBool(decGet($o, "$retired"), $path + ".$retired");
  const $v3: string = decString(decGet($o, "name"), $path + ".name");
  const $r4 = decGet($o, "rank");
  const $v4: number = $r4 === undefined ? 0 : decInt($r4, $path + ".rank", -9223372036854776000, 9223372036854776000);
  return { ...($v1 === undefined ? {} : { id: $v1, retired: $v2 }), name: $v3, rank: $v4 };
}

function readHolder($raw: unknown, $path: string): Holder {
  const $o = decObject($raw, $path);
  const $v1: string = decString(decGet($o, "key"), $path + ".key");
  const $v2: Badge = readBadge(decGet($o, "mine"), $path + ".mine");
  const $v3: base.Badge = read_base_Badge(decGet($o, "theirs"), $path + ".theirs");
  return { key: $v1, mine: $v2, theirs: $v3 };
}

function read_base_Badge($raw: unknown, $path: string): base.Badge {
  const $o = decObject($raw, $path);
  const $v1: string = decString(decGet($o, "label"), $path + ".label");
  const $r2 = decGet($o, "weight");
  const $v2: number = $r2 === undefined ? 1 : decFloat($r2, $path + ".weight");
  return { label: $v1, weight: $v2 };
}

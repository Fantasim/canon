/// Shared types.
package base

/// A badge of base.
record Badge {
  /// Its label.
  label: String
  /// Its weight.
  weight: Float = 1.0
}

emit ts { out: "@features/base/base.ts", mode: types }
-- a/a.canon --
/// Holds both badges.
package a

import base

/// A badge of a.
record Badge {
  /// Its name.
  name: String
  /// Its rank.
  rank: Int = 0
}

/// A holder of both.
record Holder {
  /// Its key.
  key: String
  /// a's badge.
  mine: Badge
  /// base's badge.
  theirs: base.Badge
}

/// The holders.
let holders: [Holder] keyed by key = [{ key: "h", mine: { name: "m", rank: 2 }, theirs: { label: "t" } }]

/// a's badges, a table.
let mine: table Badge = {
  gold { name: "Gold" }
}

/// base's badges, keyed by label.
let theirs: [base.Badge] keyed by label = [{ label: "Silver", weight: 0.5 }]

emit json { out: "@features/a/data/" }
emit ts { out: "@features/a/a.ts", mode: data }
-- ts.out --

/** Ranks, written as their code. */
export type Rank = "gold" | "silver";
export const RankMembers: ReadonlyArray<Rank> = Object.freeze(["gold", "silver"]);
export const RankLiveMembers: ReadonlyArray<Rank> = Object.freeze(["gold", "silver"]);
export const RankNames: Readonly<Record<Rank, string>> = Object.freeze({ gold: "gold", silver: "silver" });
export const RankCodes: Readonly<Record<Rank, number>> = Object.freeze({ gold: 1, silver: 2 });

/** Sides, one with a renamed wire. */
export type Side = "left" | "RIGHT";
export const SideMembers: ReadonlyArray<Side> = Object.freeze(["left", "RIGHT"]);
export const SideLiveMembers: ReadonlyArray<Side> = Object.freeze(["left", "RIGHT"]);
export const SideNames: Readonly<Record<Side, string>> = Object.freeze({ left: "left", RIGHT: "right" });


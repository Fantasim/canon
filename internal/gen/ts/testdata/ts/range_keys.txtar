  return { medals: $v1, entries: $v2, slots: $v3, picks: $v4, bigs: $v5, groups: $v6, byName: $v7 };
}

/** Every key type. */
export function decodeKeys(json: unknown): Keys {
  return canonFreeze(readKeys(json, "Keys: $"));
}

export function parseKeys(text: string): Keys {
  return decodeKeys(decParse(text, "Keys", "$"));
}

WIRE.md §5.7, §5.14, CODEGEN.md §5.15: a keyed list refuses a repeated key at every key type: an enum written by its code, a ref into such a list, an enum with a renamed wire, a ref into an Int-keyed list, a bigint, and a list nested in a record or in a map value whose key holds ": ".
-- a/a.canon --
/// Keyed lists at every key type.
package a

/// Ranks, written as their code.
enum Rank @codes(UInt8) @json(codes) { gold = 1, silver = 2 }

/// Sides, one with a renamed wire.
enum Side { left, right = "RIGHT" }

/// A medal, keyed by its rank.
record Medal {
  /// Its rank.
  r: Rank
}

/// The medals.
let medalList: [Medal] keyed by r = [{ r: gold }, { r: silver }]

/// An entry, keyed by a ref into the medals.
record Entry {
  /// The medal.
  m: ref medalList
}

/// A slot, keyed by its side.
record Slot {
  /// Its side.
  side: Side
}

/// A number.
record Num {
  /// Its value.
  n: Int
}

/// The numbers.
let numList: [Num] keyed by n = [{ n: 1 }, { n: 2 }]

/// A pick, keyed by a ref into the numbers.
record Pick {
  /// The number.
  n: ref numList
}

/// A big row.
record Big {
  /// Its key, past 2^53.
  b: Int @ts(bigint)
}

/// A row.
record Row {
  /// Its key.
  id: Int
}

/// A group of rows.
record Group {
  /// Its rows.
  rows: [Row] keyed by id
}

/// Every key type.
record Keys {
  /// Keyed by an enum's code.
  medals: [Medal] keyed by r
  /// Keyed by a ref into a list keyed by a code.
  entries: [Entry] keyed by m
  /// Keyed by an enum with a renamed wire.
  slots: [Slot] keyed by side
  /// Keyed by a ref into an Int-keyed list.
  picks: [Pick] keyed by n
  /// Keyed by a bigint.
  bigs: [Big] keyed by b
  /// Lists nested in records.
  groups: [Group]
  /// Lists nested in map values.
  byName: {String: [Row] keyed by id}
}

emit ts { out: "@features/a/a.ts", mode: types }
-- ts.out --
=== features/a/a.ts ===
// GENERATED by canon from a/. DO NOT EDIT.

// ---------------------------------------------------------------------------
// canon runtime, TypeScript v1 (CODEGEN.md §8.2). Identical in every generated file.

  const $v4: game_tone.Tone = decEnum(decGet($o, "tone"), $path + ".tone", game_tone.ToneMembers);
  const $v5: game_core.StatusId = decEntry(decGet($o, "status"), $path + ".status", game_core_StatusIdIndex);

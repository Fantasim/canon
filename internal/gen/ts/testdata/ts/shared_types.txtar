function read_game_core_Bonus($raw: unknown, $path: string, $disc: game_core.Aim): game_core.Bonus {
  switch ($disc) {
    case "gold":
      return { branch: "gold", value: decInt($raw, $path, -9223372036854776000, 9223372036854776000) };
    case "mood":
      return { branch: "mood", value: decEnum($raw, $path, game_tone.ToneMembers) };
    default:
      return decFail($path, "no branch for this value");
  }
}

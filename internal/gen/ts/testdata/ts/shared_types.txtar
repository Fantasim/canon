function read_game_core_Effect($raw: unknown, $path: string): game_core.Effect {
  const $o = decObject($raw, $path);
  const $v1: game_core.Aim = decEnum(decGet($o, "aim"), $path + ".aim", game_core.AimMembers);
  const $v2: game_core.Bonus = read_game_core_Bonus(decGet($o, "bonus"), $path + ".bonus", $v1);

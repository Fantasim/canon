DECISIONS 278, CODEGEN.md §4.1: a ref or a map key into a @ts(bigint) key field is a bigint everywhere (type, literal, decoder, find), and an @ts(bigint) map key reads with decBigKey; keys past 2^53. Mode data.
-- a/a.canon --
/// Bigint keys, refs and map keys.
package a

/// A row keyed by a bigint.
record R {
  /// Its key.
  n: Int @ts(bigint)
  /// The next row, by its bigint key.
  next: ref rs?
  /// Counts by bigint key.
  m: {Int: Int} = {} @ts(bigint)
  /// Bigints.
  l: [Int] = [] @ts(bigint)
  /// A bigint none marker.
  mx: Int? @ts(bigint) @json(none: -1)
  /// Weights by row.
  w: {ref rs: Int} = {}
}

/// The rows.
let rs: [R] keyed by n = [
  { n: 9_007_199_254_740_993, next: 9_007_199_254_740_993, m: { 9_007_199_254_740_995: 1 }, l: [9_007_199_254_740_997], mx: 9_007_199_254_740_999, w: { 1: 2 } },
  { n: 1, next: 9_007_199_254_740_993 },
]

emit ts { out: "@features/a/a.ts", mode: data }
emit json { out: "@features/a/data/" }
-- ts.out --

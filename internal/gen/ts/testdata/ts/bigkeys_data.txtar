export function decodeRs(json: unknown): CanonTable<bigint, R> {
  const $doc = canonEnvelope(json, rsSchema, "rs.json");
  return canonTable(canonFreeze(decList(decGet($doc, "rows"), "rs.json: rows", ($x, $p) => readR($x, $p))), ($e) => $e.n);
}

export function parseRs(text: string): CanonTable<bigint, R> {

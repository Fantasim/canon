  /** A dot. */
  | "dot";

/** A point. */
export interface P {
  /** Across. */
  readonly x: number;
  /** Twice x. */
  readonly double: number;
}

/** A circle. */
export interface ShapeCircle {
  readonly kind: "circle";
  /** Radius. */

/// Rows that are also plain values.
package a

/// A point.
record P {
  /// Across.
  x: Int
}

/// A holder of a point and of a table of them.
record Q {
  /// Its key.
  k: String
  /// A plain point.
  inner: P
  /// Points by name.
  slots: table P = {}
}

/// The points, a table.
let ps: table P = {
  p1 { x: 1 }
  retired p2 { x: 2 }
}

/// A single point.
let single: P = { x: 5 }

/// The holders.
let qs: [Q] keyed by k = [{ k: "a", inner: { x: 3 }, slots: { s1 { x: 4 } } }]

emit ts { out: "@features/a/a.ts", mode: embedded }

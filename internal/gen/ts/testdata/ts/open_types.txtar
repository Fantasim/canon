CODEGEN.md §5.2, §5.13, §8.1, DECISIONS 362, 363: an enum the ts types emit opens is `<E>Known` plus `E = <E>Known | (string & {})`, its tables keyed by Known, with `is<E>Known` and `<e>Name`; a decoder reads any string for it, and a numeric wire, a literal union and a dependent discriminant stay closed; a decoded @text result gets decode<Fn>File and parse<Fn>File.
-- a/a.canon --
/// Opened and closed enums, and decoded @text results.
package a

/// Destinations.
enum Dst @codes(UInt16) { DST_HP = 1, DST_MP = 2, retired DST_OLD = 3 }

/// Tones.
enum Tone { calm, loud = "LOUD" }

/// Grades, numbers on the wire.
enum Grade @codes(UInt8) @json(codes) { low = 1, high = 2 }

/// What a rule aims at.
enum Goal { kill, visit }

/// What a goal needs.
type Target(g: Goal) = match g {
  kill => String(1..)
  visit => Never
}

/// A rule.
record Rule {
  /// Where it applies.
  dst: Dst
  /// Its tone.
  tone: Tone
  /// Its grade.
  grade: Grade
  /// A tone or "any".
  mood: Tone | "any" = "any"
  /// Counts by tone.
  byTone: {Tone: Int} = {}
  /// Tones.
  tones: [Tone] = []
  /// The goal.
  goal: Goal
  /// The target.
  target: Target(goal)?
  /// A decimal.
  f: Float = 0.0
}

/// A named destination.
record Named {
  /// Name.
  name: String
  /// Destination.
  dst: Dst
}

/// The rules.
@text("rules.json")
export fn rules() -> [Rule] { return [] }

/// Counts by tone.
@text("tones.json")
export fn tones() -> {Tone: Int} { return { calm: 1 } }

/// Named destinations.
@text("named.json")
export fn named() -> [Named] keyed by name { return [] }

/// A maybe-file.
@text("maybe.json")
export fn maybe() -> [Rule]? { return none }

emit ts { out: "@features/a/a.ts", mode: types, open: [Dst, Tone, Grade, Goal] }
emit text { out: "out/a" }
-- ts.out --
=== features/a/a.ts ===
// GENERATED by canon from a/. DO NOT EDIT.

// ---------------------------------------------------------------------------
// canon runtime, TypeScript v1 (CODEGEN.md §8.2). Identical in every generated file.
// ---------------------------------------------------------------------------

/** An error the Canon evaluator would also report, with its code ("E4101"). */
export class CanonEvalError extends Error {
  readonly code: string;
  constructor(code: string, message: string) {
    super(code + ": " + message);
    this.name = "CanonEvalError";
    this.code = code;
  }
}

/** A read-only Map: set, delete and clear throw. */
class CanonMap<K, V> extends Map<K, V> {
  constructor(entries: ReadonlyArray<readonly [K, V]>) {
    super();
    for (const [k, v] of entries) super.set(k, v);
    Object.freeze(this);
  }
  override set(_k: K, _v: V): this { throw new TypeError("canon: read-only map"); }
  override delete(_k: K): boolean { throw new TypeError("canon: read-only map"); }
  override clear(): void { throw new TypeError("canon: read-only map"); }
}

/** A table or keyed list: entries in source order, lookup by key. */
export interface CanonTable<K, T> {
  readonly length: number;
  readonly all: ReadonlyArray<T>;
  at(i: number): T;
  find(key: K): T | null;
}

/** Deep-freezes plain objects and arrays (CanonMaps are already read-only). */
function canonFreeze<T>(x: T): T {
  if (typeof x === "object" && x !== null && !Object.isFrozen(x)) {
    Object.freeze(x);
    for (const v of Object.values(x)) canonFreeze(v);
  }
  return x;
}
// ---------------------------------------------------------------------------

export type DstKnown =
  | "DST_HP"
  | "DST_MP"
  /** Retired. */
  | "DST_OLD";
/** Destinations. */
export type Dst = DstKnown | (string & {});
export const DstMembers: ReadonlyArray<DstKnown> = Object.freeze(["DST_HP", "DST_MP", "DST_OLD"]);
export const DstNames: Readonly<Record<DstKnown, string>> = Object.freeze({ DST_HP: "DST_HP", DST_MP: "DST_MP", DST_OLD: "DST_OLD" });
export const DstIndex: Readonly<Record<DstKnown, number>> = Object.freeze({ DST_HP: 0, DST_MP: 1, DST_OLD: 2 });
export const DstCodes: Readonly<Record<DstKnown, number>> = Object.freeze({ DST_HP: 1, DST_MP: 2, DST_OLD: 3 });

export function isDstKnown(v: Dst): v is DstKnown {
  return Object.prototype.hasOwnProperty.call(DstNames, v);
}

export function dstName(v: Dst): string {
  return isDstKnown(v) ? DstNames[v] : v;
}

export type ToneKnown = "calm" | "LOUD";
/** Tones. */
export type Tone = ToneKnown | (string & {});
export const ToneMembers: ReadonlyArray<ToneKnown> = Object.freeze(["calm", "LOUD"]);
export const ToneNames: Readonly<Record<ToneKnown, string>> = Object.freeze({ calm: "calm", LOUD: "loud" });
export const ToneIndex: Readonly<Record<ToneKnown, number>> = Object.freeze({ calm: 0, LOUD: 1 });

export function isToneKnown(v: Tone): v is ToneKnown {
  return Object.prototype.hasOwnProperty.call(ToneNames, v);
}

export function toneName(v: Tone): string {
  return isToneKnown(v) ? ToneNames[v] : v;
}

export type GradeKnown = "low" | "high";
/** Grades, numbers on the wire. */
export type Grade = GradeKnown | (string & {});
export const GradeMembers: ReadonlyArray<GradeKnown> = Object.freeze(["low", "high"]);
export const GradeNames: Readonly<Record<GradeKnown, string>> = Object.freeze({ low: "low", high: "high" });
export const GradeIndex: Readonly<Record<GradeKnown, number>> = Object.freeze({ low: 0, high: 1 });
export const GradeCodes: Readonly<Record<GradeKnown, number>> = Object.freeze({ low: 1, high: 2 });

export function isGradeKnown(v: Grade): v is GradeKnown {
  return Object.prototype.hasOwnProperty.call(GradeNames, v);
}

export function gradeName(v: Grade): string {
  return isGradeKnown(v) ? GradeNames[v] : v;
}

export type GoalKnown = "kill" | "visit";
/** What a rule aims at. */
export type Goal = GoalKnown | (string & {});
export const GoalMembers: ReadonlyArray<GoalKnown> = Object.freeze(["kill", "visit"]);
export const GoalNames: Readonly<Record<GoalKnown, string>> = Object.freeze({ kill: "kill", visit: "visit" });
export const GoalIndex: Readonly<Record<GoalKnown, number>> = Object.freeze({ kill: 0, visit: 1 });

export function isGoalKnown(v: Goal): v is GoalKnown {
  return Object.prototype.hasOwnProperty.call(GoalNames, v);
}

export function goalName(v: Goal): string {
  return isGoalKnown(v) ? GoalNames[v] : v;
}

export type TargetBranch = "kill";

/** What a goal needs. */
export type Target =
  | { readonly branch: "kill"; readonly value: string };

/** A rule. */
export interface Rule {
  /** Where it applies. */
  readonly dst: Dst;
  /** Its tone. */
  readonly tone: Tone;
  /** Its grade. */
  readonly grade: Grade;
  /** A tone or "any". */
  readonly mood: ToneKnown | "any";
  /** Counts by tone. */
  readonly byTone: ReadonlyMap<Tone, number>;
  /** Tones. */
  readonly tones: ReadonlyArray<Tone>;
  /** The goal. */
  readonly goal: Goal;
  /** The target. */
  readonly target: Target | null;
  /** A decimal. */
  readonly f: number;
}

/** A named destination. */
export interface Named {
  /** Name. */
  readonly name: string;
  /** Destination. */
  readonly dst: Dst;
}

const decOrder = Symbol.for("canon.order");

const decTokenKey = Symbol.for("canon.token");

/** A number token with a fraction or an exponent, as parse reads it: its exact text, under a key every generated file shares. */
function decToken(text: string): unknown {
  return Object.freeze(Object.defineProperty({}, decTokenKey, { value: text }));
}

/** The exact decimal text of a number: a token parse kept, or a number or bigint. */
function decText(raw: unknown): string | undefined {
  if (typeof raw === "number" || typeof raw === "bigint") return String(raw);
  const t = typeof raw === "object" && raw !== null ? Reflect.get(raw, decTokenKey) : undefined;
  return typeof t === "string" ? t : undefined;
}

function decKeys(o: Record<string, unknown>): string[] {
  const order = Reflect.get(o, decOrder) as string[] | undefined;
  return order === undefined ? Object.keys(o) : order;
}

/** Throws the failure at path, behind the name of what is read: `$`-rooted for a types-mode decoder (`Skill: $.events[1].level`), from the file's top for a data file (`skills.json: rows[1].level`) (CODEGEN.md §5.13, DECISIONS 361). */
function decFail(path: string, message: string): never {
  throw new Error(path + ": " + message);
}

function decGet(o: Record<string, unknown>, key: string): unknown {
  return Object.prototype.hasOwnProperty.call(o, key) ? o[key] : undefined;
}

function decIsObject(raw: unknown): raw is Record<string, unknown> {
  return typeof raw === "object" && raw !== null && !Array.isArray(raw) && !Reflect.has(raw, decTokenKey);
}

function decObject(raw: unknown, path: string): Record<string, unknown> {
  if (!decIsObject(raw)) decFail(path, "expected an object");
  return raw;
}

function decArray(raw: unknown, path: string): ReadonlyArray<unknown> {
  if (!Array.isArray(raw)) decFail(path, "expected an array");
  return raw;
}

function decInt(raw: unknown, path: string, lo: number, hi: number): number {
  if (typeof raw === "bigint") decFail(path, "integer outside the TypeScript safe range");
  if (typeof raw !== "number" || !Number.isInteger(raw)) decFail(path, "expected an integer");
  if (!Number.isSafeInteger(raw)) decFail(path, "integer outside the TypeScript safe range");
  if (raw < lo || raw > hi) decFail(path, "integer out of range");
  return raw === 0 ? 0 : raw;
}

/** A Float64; a number past its range is refused with `refusal`: "number out of range" in a types-mode decoder, the data loaders' "expected a number" in a data file. */
function decFloat(raw: unknown, path: string, refusal = "number out of range"): number {
  const text = decText(raw);
  if (text === undefined) decFail(path, "expected a number");
  const v = typeof raw === "number" ? raw : Number(text);
  if (!Number.isFinite(v)) decFail(path, refusal);
  return v === 0 ? 0 : v;
}

function decString(raw: unknown, path: string): string {
  if (typeof raw !== "string") decFail(path, "expected a string");
  return raw;
}

/** One of members; a literal union's arm refuses with the value, as the Go decoder does. */
function decEnum<T extends string>(raw: unknown, path: string, members: ReadonlyArray<T>, union = false): T {
  const m = members.find((x) => x === raw);
  if (m === undefined) decFail(path, union ? "unknown value " + String(raw) : "unknown member");
  return m;
}

function decCode<T extends string>(raw: unknown, path: string, members: ReadonlyArray<T>, codes: Readonly<Record<T, number>>): T {
  const m = members.find((x) => codes[x] === raw);
  if (m === undefined) decFail(path, "unknown code");
  return m;
}

function decList<T>(raw: unknown, path: string, read: (x: unknown, p: string) => T): T[] {
  return decArray(raw, path).map((x, i) => read(x, path + "[" + i + "]"));
}

function decMap<K, V>(raw: unknown, path: string, key: (k: string, p: string) => K, read: (x: unknown, p: string) => V): CanonMap<K, V> {
  const o = decObject(raw, path);
  return new CanonMap(decKeys(o).map((k): readonly [K, V] => [key(k, path + "." + k), canonFreeze(read(o[k], path + "." + k))]));
}

/** Reads JSON text the way WIRE.md §3.1 to §3.3 read a file, the first failure in document order, placed where it becomes certain. A types-mode decoder (root `$`): a syntax error is `<T>: invalid JSON at byte N`, N the 0-based UTF-8 offset of the first byte that cannot continue the document (a BOM counted) or the text's length when it ends too early; a repeated key, an unpaired surrogate, a lone surrogate code unit in a string (`not UTF-8`) and nesting past 512 are named at their `$` path (`<T>: $.a[1]: …`). A data file (root ""): a syntax error, invalid UTF-8 or an unpaired surrogate is `<file>: not a canon data file (invalid JSON)`, as the loaders print it; a repeated key and nesting past 512 are named at their path (`<file>: a[1]: …`) (DECISIONS 361). */
function decParse(text: string, label: string, root: string): unknown {
  let i = text.charCodeAt(0) === 0xfeff ? 1 : 0;
  const escapes: Record<string, string> = { '"': '"', "\\": "\\", "/": "/", b: "\b", f: "\f", n: "\n", r: "\r", t: "\t" };
  const bytes = (end: number): number => {
    let n = 0;
    for (const ch of text.slice(0, end)) {
      const cp = ch.codePointAt(0) as number;
      n += cp < 0x80 ? 1 : cp < 0x800 ? 2 : cp < 0x10000 ? 3 : 4;
    }
    return n;
  };
  const data = root === "";
  const member = (path: string, k: string): string => (path === label + ": " ? path + k : path + "." + k);
  const bad = (): never => decFail(label, data ? "not a canon data file (invalid JSON)" : "invalid JSON at byte " + bytes(i));
  const invalid = (path: string, message: string): never => (data ? bad() : decFail(path, message));
  const ws = (): void => {
    while (i < text.length && " \t\n\r".includes(text[i])) i++;
  };
  const digits = (): void => {
    if (!(text[i] >= "0" && text[i] <= "9")) bad();
    while (text[i] >= "0" && text[i] <= "9") i++;
  };
  const hex4 = (): number => {
    for (let k = 0; k < 4; k++) {
      if (!/^[0-9a-fA-F]$/.test(text[i + k] ?? "")) {
        i += k;
        bad();
      }
    }
    i += 4;
    return parseInt(text.slice(i - 4, i), 16);
  };
  const unicode = (path: string): string => {
    const u = hex4();
    if (u >= 0xdc00 && u <= 0xdfff) invalid(path, "unpaired surrogate");
    if (u < 0xd800 || u > 0xdbff) return String.fromCharCode(u);
    const next = text.slice(i, i + 2);
    if (next.length < 2 && "\\u".startsWith(next)) {
      i = text.length;
      bad();
    }
    if (next !== "\\u") invalid(path, "unpaired surrogate");
    i += 2;
    const lo = hex4();
    if (lo < 0xdc00 || lo > 0xdfff) invalid(path, "unpaired surrogate");
    return String.fromCharCode(u, lo);
  };
  const str = (path: string): string => {
    i++;
    let out = "";
    for (;;) {
      if (i >= text.length || text[i] < " ") bad();
      const c = text[i++];
      if (c === '"') return out;
      if (c >= "\ud800" && c <= "\udfff") {
        i--;
        if (c > "\udbff" || !(text[i + 1] >= "\udc00" && text[i + 1] <= "\udfff")) invalid(path, "not UTF-8");
        out += text.slice(i, i + 2);
        i += 2;
      } else if (c !== "\\") {
        out += c;
      } else if (text[i] === "u") {
        i++;
        out += unicode(path);
      } else if (Object.prototype.hasOwnProperty.call(escapes, text[i])) {
        out += escapes[text[i++]];
      } else {
        bad();
      }
    }
  };
  const num = (): unknown => {
    const start = i;
    if (text[i] === "-") i++;
    if (text[i] === "0") i++;
    else digits();
    let exact = false;
    if (text[i] === ".") {
      i++;
      digits();
      exact = true;
    }
    if (text[i] === "e" || text[i] === "E") {
      i++;
      if (text[i] === "+" || text[i] === "-") i++;
      digits();
      exact = true;
    }
    const token = text.slice(start, i);
    if (exact) return decToken(token);
    const n = Number(token);
    return Number.isSafeInteger(n) ? n : BigInt(token);
  };
  const word = (w: string, v: unknown): unknown => {
    for (let k = 0; k < w.length; k++) {
      if (text[i + k] !== w[k]) {
        i += k;
        bad();
      }
    }
    i += w.length;
    return v;
  };
  const sep = (close: string): boolean => {
    ws();
    if (text[i] === ",") {
      i++;
      return true;
    }
    if (text[i] !== close) bad();
    i++;
    return false;
  };
  const open = (depth: number, path: string): void => {
    if (depth >= 512) decFail(path, "nested deeper than 512 levels");
    i++;
    ws();
  };
  const obj = (depth: number, path: string): unknown => {
    open(depth, path);
    const o: Record<string, unknown> = {};
    const order: string[] = [];
    if (text[i] === "}") {
      i++;
    } else {
      do {
        ws();
        if (text[i] !== '"') bad();
        const k = str(path);
        if (Object.prototype.hasOwnProperty.call(o, k)) decFail(member(path, k), "duplicate key");
        ws();
        if (text[i] !== ":") bad();
        i++;
        Object.defineProperty(o, k, { value: val(depth + 1, member(path, k)), enumerable: true, writable: true, configurable: true });
        order.push(k);
      } while (sep("}"));
    }
    Object.defineProperty(o, decOrder, { value: order });
    return o;
  };
  const arr = (depth: number, path: string): unknown => {
    open(depth, path);
    const a: unknown[] = [];
    if (text[i] === "]") {
      i++;
      return a;
    }
    do {
      a.push(val(depth + 1, path + "[" + a.length + "]"));
    } while (sep("]"));
    return a;
  };
  const val = (depth: number, path: string): unknown => {
    ws();
    const c = text[i];
    if (c === "{") return obj(depth, path);
    if (c === "[") return arr(depth, path);
    if (c === '"') return str(path);
    if (c === "t") return word("true", true);
    if (c === "f") return word("false", false);
    if (c === "n") return word("null", null);
    if (c === "-" || (c >= "0" && c <= "9")) return num();
    return bad();
  };
  const v = val(0, label + ": " + root);
  ws();
  if (i < text.length) bad();
  return v;
}

function readTarget($raw: unknown, $path: string, $disc: Goal): Target {
  switch ($disc) {
    case "kill":
      return { branch: "kill", value: decString($raw, $path) };
    default:
      return decFail($path, "no branch for this value");
  }
}

function readRule($raw: unknown, $path: string): Rule {
  const $o = decObject($raw, $path);
  const $v1: Dst = decString(decGet($o, "dst"), $path + ".dst") as Dst;
  const $v2: Tone = decString(decGet($o, "tone"), $path + ".tone") as Tone;
  const $v3: Grade = decCode(decGet($o, "grade"), $path + ".grade", GradeMembers, GradeCodes);
  const $r4 = decGet($o, "mood");
  const $v4: ToneKnown | "any" = $r4 === undefined ? "any" : decEnum(decString($r4, $path + ".mood"), $path + ".mood", $union1, true);
  const $r5 = decGet($o, "byTone");
  const $v5: ReadonlyMap<Tone, number> = $r5 === undefined ? new CanonMap<Tone, number>([]) : decMap($r5, $path + ".byTone", ($k, $p) => decString($k, $p) as Tone, ($x, $p) => decInt($x, $p, -9223372036854776000, 9223372036854776000));
  const $r6 = decGet($o, "tones");
  const $v6: ReadonlyArray<Tone> = $r6 === undefined ? [] : decList($r6, $path + ".tones", ($x, $p) => decString($x, $p) as Tone);
  const $v7: Goal = decString(decGet($o, "goal"), $path + ".goal") as Goal;
  const $r8 = decGet($o, "target");
  const $v8: Target | null = $r8 === undefined || $r8 === null ? null : readTarget($r8, $path + ".target", $v7);
  const $r9 = decGet($o, "f");
  const $v9: number = $r9 === undefined ? 0 : decFloat($r9, $path + ".f");
  return { dst: $v1, tone: $v2, grade: $v3, mood: $v4, byTone: $v5, tones: $v6, goal: $v7, target: $v8, f: $v9 };
}

/** A rule. */
export function decodeRule(json: unknown): Rule {
  return canonFreeze(readRule(json, "Rule: $"));
}

export function parseRule(text: string): Rule {
  return decodeRule(decParse(text, "Rule", "$"));
}

function readNamed($raw: unknown, $path: string): Named {
  const $o = decObject($raw, $path);
  const $v1: string = decString(decGet($o, "name"), $path + ".name");
  const $v2: Dst = decString(decGet($o, "dst"), $path + ".dst") as Dst;
  return { name: $v1, dst: $v2 };
}

/** A named destination. */
export function decodeNamed(json: unknown): Named {
  return canonFreeze(readNamed(json, "Named: $"));
}

export function parseNamed(text: string): Named {
  return decodeNamed(decParse(text, "Named", "$"));
}

/** The rules. */
export function decodeRulesFile(json: unknown): ReadonlyArray<Rule> {
  return canonFreeze(decList(json, "RulesFile: $", ($x, $p) => readRule($x, $p)));
}

export function parseRulesFile(text: string): ReadonlyArray<Rule> {
  return decodeRulesFile(decParse(text, "RulesFile", "$"));
}

/** Counts by tone. */
export function decodeTonesFile(json: unknown): ReadonlyMap<Tone, number> {
  return canonFreeze(decMap(json, "TonesFile: $", ($k, $p) => decString($k, $p) as Tone, ($x, $p) => decInt($x, $p, -9223372036854776000, 9223372036854776000)));
}

export function parseTonesFile(text: string): ReadonlyMap<Tone, number> {
  return decodeTonesFile(decParse(text, "TonesFile", "$"));
}

/** Named destinations. */
export function decodeNamedFile(json: unknown): ReadonlyArray<Named> {
  return canonFreeze(decList(json, "NamedFile: $", ($x, $p) => readNamed($x, $p)));
}

export function parseNamedFile(text: string): ReadonlyArray<Named> {
  return decodeNamedFile(decParse(text, "NamedFile", "$"));
}

/** A maybe-file. */
export function decodeMaybeFile(json: unknown): ReadonlyArray<Rule> {
  return canonFreeze(decList(json, "MaybeFile: $", ($x, $p) => readRule($x, $p)));
}

export function parseMaybeFile(text: string): ReadonlyArray<Rule> {
  return decodeMaybeFile(decParse(text, "MaybeFile", "$"));
}

const $union1: ReadonlyArray<ToneKnown | "any"> = [...ToneMembers, "any"];

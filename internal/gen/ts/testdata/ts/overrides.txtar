  for (const [kind, void_, want, code] of vectors) {
    const [got, gotCode] = canonCatch(() => $thingWithin(kind, void_));
    assert.equal(gotCode, code, `Thing.within(kind=${kind}, void=${void_})`);
    if (code === "") assert.ok(Object.is(got, want), `Thing.within(kind=${kind}, void=${void_}) = ${got}, canon says ${want}`);
  }
});

test("choose conformance", () => {
  const vectors: ReadonlyArray<readonly [number, number, string]> = [
    [1, 1, ""],
    [-9223372036854776000, 0, "E8303"],
    [-1, -1, ""],
    [0, 0, ""],
    [9223372036854776000, 0, "E8303"],
  ];
  for (const [n, want, code] of vectors) {

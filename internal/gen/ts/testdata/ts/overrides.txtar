/// Names.
package a

/// A thing. A comment closer */ in a doc is escaped.
///
/// A second paragraph.
record Thing @ts(name: "Item") {
  /// Its kind.
  kind: Int = 0 @ts(name: "type")
  /// Reserved as a property: left alone.
  class: String = "c"
  /// Reserved word as a precomputed fn.
  export fn delete(self) -> Bool { return kind > 0 }
  /// Takes a reserved parameter name.
  export fn with(self, new: Int) -> Int { return kind + new }
  /// Escapes a local.
  export fn within(self, void: Int) -> Int {
    let this = void * 2
    return this + kind
  }
}

/// The things.
@ts(name: "allItems")
let things: [Thing] keyed by class = [{ class: "a" }]

/// A reserved value name.
let default: Thing = { class: "d" }

/// Text with escapes and non-ASCII.
const GREETING = "caf\u{e9} \"quoted\" \\ tab\t </script>"

/// A constant renamed.
@ts(name: "LIMIT_2")
const LIMIT = 3

/// A fn renamed.
@ts(name: "pickOne")
export fn choose(n: Int) -> Int { return n }

/// A reserved fn name.
export fn function(n: Int) -> Int { return n }

test "t" {
  let t: Thing = { class: "t", kind: 1 }
  expect t.with(2) == 3
  expect t.within(2) == 5
  expect choose(1) == 1
  expect function(1) == 1
}


import { test } from "node:test";
import * as assert from "node:assert/strict";
import { $thingWith, $thingWithin, CanonEvalError, function_, pickOne } from "./a.js";

function canonCatch<T>(f: () => T): [T | undefined, string] {
  try {
    return [f(), ""];
  } catch (e) {
    if (e instanceof CanonEvalError) return [undefined, e.code];
    throw e;
  }
}

test("Thing.with conformance", () => {
  const vectors: ReadonlyArray<readonly [number, number, number, string]> = [
    [1, 2, 3, ""],
    [1, -9223372036854776000, 0, "E8303"],
    [1, -1, 0, ""],
    [1, 0, 1, ""],
    [1, 1, 2, ""],
    [1, 9223372036854776000, 0, "E8303"],
  ];
  for (const [kind, new_, want, code] of vectors) {
    const [got, gotCode] = canonCatch(() => $thingWith(kind, new_));
    assert.equal(gotCode, code, `Thing.with(kind=${kind}, new=${new_})`);
    if (code === "") assert.ok(Object.is(got, want), `Thing.with(kind=${kind}, new=${new_}) = ${got}, canon says ${want}`);
  }
});

test("Thing.within conformance", () => {
  const vectors: ReadonlyArray<readonly [number, number, number, string]> = [
    [1, 2, 5, ""],
    [1, -9223372036854776000, 0, "E8303"],
    [1, -1, -1, ""],
    [1, 0, 1, ""],
    [1, 1, 3, ""],
    [1, 9223372036854776000, 0, "E8303"],

/** Text with escapes and non-ASCII. */
export const GREETING = "café \"quoted\" \\ tab\t </script>";

/** A constant renamed. */
export const LIMIT_2 = 3;

/**
 * A thing. A comment closer *\/ in a doc is escaped.
 *
 * A second paragraph.
 */
export interface Item {
  /** Its kind. */
  readonly type: number;
  /** Reserved as a property: left alone. */
  readonly class: string;
  /** Reserved word as a precomputed fn. */
  readonly delete: boolean;
}

/** The things. */
export const allItems: CanonTable<string, Item> = canonTable(canonFreeze<ReadonlyArray<Item>>([
  { type: 0, class: "a", delete: false },
]), (e) => e.class);

/** A reserved value name. */
export const default_: Item = canonFreeze<Item>({ type: 0, class: "d", delete: false });

/** Takes a reserved parameter name. */
export function thingWith(self: Item, new_: number): number {
  return $thingWith(self.type, new_);
}

export function $thingWith(kind: number, new_: number): number {
  kind = canonInt(kind);
  new_ = canonInt(new_);
  return canonAdd(kind, new_);
}

/** Escapes a local. */
export function thingWithin(self: Item, void_: number): number {
  return $thingWithin(self.type, void_);
}

export function $thingWithin(kind: number, void_: number): number {
  kind = canonInt(kind);
  void_ = canonInt(void_);
  const this_ = canonMul(void_, 2);
  return canonAdd(this_, kind);
}

/** A fn renamed. */
export function pickOne(n: number): number {
  n = canonInt(n);
  return n;
}

/** A reserved fn name. */
export function function_(n: number): number {
  n = canonInt(n);
  return n;
}

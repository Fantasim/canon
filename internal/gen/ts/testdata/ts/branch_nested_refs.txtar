  };
  const arr = (depth: number, path: string): unknown => {
    open(depth, path);
    const a: unknown[] = [];
    if (text[i] === "]") {
      i++;
      return a;
    }
    do {
      a.push(val(depth + 1, path + "[" + a.length + "]"));
    } while (sep("]"));
    return a;
  };
  const val = (depth: number, path: string): unknown => {
    ws();
    const c = text[i];
    if (c === "{") return obj(depth, path);
    if (c === "[") return arr(depth, path);
    if (c === '"') return str(path);
    if (c === "t") return word("true", true);
    if (c === "f") return word("false", false);
    if (c === "n") return word("null", null);
    if (c === "-" || (c >= "0" && c <= "9")) return num();
    return bad();
  };
  const v = val(0, label + ": " + root);
  ws();
  if (i < text.length) bad();
  return v;
}

export function decodeEe(json: unknown): CanonTable<Elem, ER> {
  const $doc = canonEnvelope(json, eeSchema, "ee.json");
  return canonTable(canonFreeze(decUnique(decList(decGet($doc, "rows", "ee.json: rows"), "ee.json: rows", ($x, $p) => readER($x, $p)), "ee.json: rows", ($e) => $e.e, "e")), ($e) => $e.e);
}

export function parseEe(text: string): CanonTable<Elem, ER> {
  return decodeEe(decParse(text, "ee.json", ""));
}

export function decodeEe2(json: unknown): CanonTable<Elem, E2> {
  const $doc = canonEnvelope(json, ee2Schema, "ee2.json");
  return canonTable(canonFreeze(decUnique(decList(decGet($doc, "rows", "ee2.json: rows"), "ee2.json: rows", ($x, $p) => readE2($x, $p)), "ee2.json: rows", ($e) => $e.r, "r")), ($e) => $e.r);
}

export function parseEe2(text: string): CanonTable<Elem, E2> {
  return decodeEe2(decParse(text, "ee2.json", ""));
}

export function decodeNb(json: unknown): CanonTable<number, NB> {
  const $doc = canonEnvelope(json, nbSchema, "nb.json");
  return canonTable(canonFreeze(decUnique(decList(decGet($doc, "rows", "nb.json: rows"), "nb.json: rows", ($x, $p) => readNB($x, $p)), "nb.json: rows", ($e) => $e.n, "n")), ($e) => $e.n);
}

export function parseNb(text: string): CanonTable<number, NB> {
  return decodeNb(decParse(text, "nb.json", ""));
}

export function decodeNb2(json: unknown): CanonTable<number, N2> {
  const $doc = canonEnvelope(json, nb2Schema, "nb2.json");
  return canonTable(canonFreeze(decUnique(decList(decGet($doc, "rows", "nb2.json: rows"), "nb2.json: rows", ($x, $p) => readN2($x, $p)), "nb2.json: rows", ($e) => $e.r, "r")), ($e) => $e.r);
}

export function parseNb2(text: string): CanonTable<number, N2> {
  return decodeNb2(decParse(text, "nb2.json", ""));

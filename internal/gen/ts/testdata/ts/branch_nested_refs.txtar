CODEGEN.md §5.6, §5.9, DECISIONS 350, 456: a dependent type decided through a ref whose list is keyed by a ref into a list keyed by an enum (Elem, its second member written "w" on the wire) has a branch table keyed by that enum's wire, as the decoder reads it ("w", not "water"), in data (bd) and types (bt) modes.
-- bd/bd.canon --
/// Package.
package bd

/// Code enum.
enum Elem { fire, water = "w", earth }

/// Shape.
enum Shape { count, place, none_ }

/// E row.
record ER {
  /// Key.
  e: Elem
}

/// Enums.
let ee: [ER] keyed by e = [ { e: earth }, { e: fire }, { e: water } ]

/// E2.
record E2 {
  /// Key: a ref into a list keyed by an enum.
  r: ref ee
  /// Shape.
  shape: Shape
}

/// E2s: keyed by a ref, so a ref into it is a chain.
let ee2: [E2] keyed by r = [ { r: fire, shape: count }, { r: water, shape: place }, { r: earth, shape: none_ } ]

/// A number row.
record NB {
  /// Key.
  n: Int
}

/// Numbers.
let nb: [NB] keyed by n = [ { n: 20 }, { n: 5 } ]

/// N2.
record N2 {
  /// Key: a ref into a list keyed by an Int.
  r: ref nb
  /// Shape.
  shape: Shape
}

/// N2s: keyed by a ref, so a ref into it is a chain whose key is an Int.
let nb2: [N2] keyed by r = [ { r: 5, shape: count }, { r: 20, shape: place } ]

/// A parameter, by shape.
type Param(s: Shape) = match s {
  count => Int(0..)
  place => String
  none_ => Never
}

/// Reward.
record Reward {
  /// Event: a ref whose list is keyed by a ref.
  ev: ref ee2
  /// Param, decided through the chain.
  param: Param(ev.shape)? @json(none: 0)
  /// Number: a ref whose list is keyed by a ref to an Int key.
  num: ref nb2
  /// Param, decided through the number's chain.
  byNum: Param(num.shape)? @json(none: 0)
}

/// File.
record RF {
  /// Rewards.
  rewards: [Reward]
}

/// Rewards: an Int key is no Canon literal, the cases bring their own.
let rewards: RF = { rewards: [] }

emit ts { out: "@features/bd/bd.ts", mode: data }
emit json { out: "out/" }

-- p/p.canon --
/// Tones, in a package named p.
package p

/// A tone, written as its code.
enum Tone @codes(UInt8) @json(codes) { soft = 1, loud = 2 }

emit ts { out: "@features/p/p.ts" }
-- raw/raw.canon --
/// Notes, in a package named raw.
package raw

import p { Tone }

/// A kind.
enum Kind { small, big }

/// A note.
record Note {
  /// Its kind.
  kind: Kind
  /// Its tones.
  tones: [Tone] = []
}

emit ts { out: "@features/raw/raw.ts", mode: types }
-- a/a.canon --
/// Reads both.
package a

import p { Tone }
import raw { Note }

/// A holder.
record Holder {
  /// Its key.
  key: String
  /// Tones.
  tones: [Tone] = []
  /// Weights by tone.
  weights: {Tone: Int} = {}
  /// A note of raw.
  note: Note
  /// Notes of raw.
  notes: [Note] = []

  /// A weight per tone, stored by code.
  export fn weight(self, t: Tone) -> Int { return match t { soft => 1, loud => 2 } }
}

/// The holders.
let holders: [Holder] keyed by key = [
  { key: "h", tones: [loud, soft], weights: { soft: 3 }, note: { kind: big, tones: [soft] }, notes: [{ kind: small }] },
]

emit json { out: "@features/a/data/" }
emit ts { out: "@features/a/a.ts", mode: data }

/** Row keyed by a ref. */
export function decodeB2R(json: unknown): B2R {
  return canonFreeze(readB2R(json, "B2R: $"));
}

export function parseB2R(text: string): B2R {
  return decodeB2R(decParse(text, "B2R", "$"));
}

function readB3R($raw: unknown, $path: string): B3R {
  const $o = decObject($raw, $path);
  const $v1: bigint = decBig(decGet($o, "k", $path + ".k"), $path + ".k", -9223372036854775808n, 9223372036854775807n);
  return { k: $v1 };
}

/** Row keyed by a ref to a ref. */
export function decodeB3R(json: unknown): B3R {
  return canonFreeze(readB3R(json, "B3R: $"));
}

export function parseB3R(text: string): B3R {
  return decodeB3R(decParse(text, "B3R", "$"));
}

function readH($raw: unknown, $path: string): H {
  const $o = decObject($raw, $path);
  const $v1: bigint = decBig(decGet($o, "two", $path + ".two"), $path + ".two", -9223372036854775808n, 9223372036854775807n);
  const $v2: bigint = decBig(decGet($o, "three", $path + ".three"), $path + ".three", -9223372036854775808n, 9223372036854775807n);
  const $v3: ReadonlyArray<bigint> = decList(decGet($o, "l", $path + ".l"), $path + ".l", ($x, $p) => decBig($x, $p, -9223372036854775808n, 9223372036854775807n));
  const $v4: ReadonlyMap<bigint, number> = decMap(decGet($o, "m", $path + ".m"), $path + ".m", ($k, $p) => decBigKey($k, $p, -9223372036854775808n, 9223372036854775807n), ($x, $p) => decInt($x, $p, -9223372036854776000, 9223372036854776000));
  const $v5: number = decInt(decGet($o, "plain", $path + ".plain"), $path + ".plain", -9223372036854776000, 9223372036854776000);
  return { two: $v1, three: $v2, l: $v3, m: $v4, plain: $v5 };
}

/** Holder. */
export function decodeH(json: unknown): H {
  return canonFreeze(readH(json, "H: $"));
}

export function parseH(text: string): H {
  return decodeH(decParse(text, "H", "$"));
}

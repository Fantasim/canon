/// Package.
package bgd

/// Leaf row.
record B1R {
/// Key, a bigint.
  n: Int @ts(bigint)
}

/// Leaves.
let b1: [B1R] keyed by n = [ { n: 9_007_199_254_740_993 }, { n: 5 } ]

/// Shape.
enum Shape { count, place, none_ }

/// A parameter, by shape.
type Param(s: Shape) = match s {
  count => Int(0..)
  place => String
  none_ => Never
}

/// Row keyed by a ref.
record B2R {
/// Key.
  k: ref b1
/// Shape.
  shape: Shape
}

/// Rows.
let b2: [B2R] keyed by k = [ { k: 9_007_199_254_740_993, shape: count }, { k: 5, shape: place } ]

/// Row keyed by a ref to a ref.
record B3R {
/// Key.
  k: ref b2
}

/// Rows.
let b3: [B3R] keyed by k = [ { k: 9_007_199_254_740_993 }, { k: 5 } ]

/// Holder.
record H {
/// Two deep.
  two: ref b2
/// Three deep.
  three: ref b3
/// A list.
  l: [ref b3]
/// A map.
  m: {ref b3: Int}
/// A plain integer.
  plain: Int
/// Event, 2 deep.
  ev: ref b2
/// Parameter, decided through the chain.
  param: Param(ev.shape)? @json(none: 0)
}

/// The holder.
let h: H = { two: 9_007_199_254_740_993, three: 9_007_199_254_740_993, l: [5, 9_007_199_254_740_993], m: { 9_007_199_254_740_993: 1 }, plain: 7, ev: 9_007_199_254_740_993, param: 3 }

emit json { out: "@features/bgd/json/" }

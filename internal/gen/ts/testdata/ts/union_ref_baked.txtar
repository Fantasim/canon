/// A literal union over refs.
package a

import b { rs }

/// The keys of the rows.
enum Kind {
  /// The first.
  Alpha = "alpha"
  /// The second.
  Beta = "beta"
}

/// A row keyed by a plain string.
record A {
  /// Its key.
  id: String
}

/// The plain-keyed rows.
let aa: [A] keyed by id = [ { id: "first" } ]

/// A row keyed by an enum.
record B {
  /// Its key.
  k: Kind
}

/// The enum-keyed rows.
let bs: [B] keyed by k = [ { k: Alpha }, { k: Beta } ]

/// A table row.
record Item {
  /// Its weight.
  w: Int
}

/// The table.
let items: table Item = {
  sword { w: 3 }
  shield { w: 4 }
}

/// A plain ref or a literal.
type PickA = ref aa | "none"

/// An enum-keyed ref or a literal.
type PickB = ref bs | "none"

/// A table ref or a literal.
type PickT = ref items | "none"

/// A foreign enum-keyed ref or a literal.
type PickF = ref rs | "none"

/// A nested record.
record In {
  /// A table pick.
  t: PickT
}

/// The holder.
record Holder {
  /// A plain-keyed pick.
  p: PickA
  /// An enum-keyed pick.
  q: PickB
  /// A literal in the enum-keyed union.
  r: PickB
  /// A table pick.
  t: PickT
  /// A foreign enum-keyed pick.
  f: PickF
  /// An optional pick.
  o: PickB?
  /// An absent optional pick.
  on: PickB?
  /// A list of picks.
  l: [PickB] = []
  /// A list of optional picks.
  lo: [PickT?] = []
  /// Picks as map values.
  mv: {String: PickB} = {}
  /// Picks as map keys.
  mk: {PickB: Int} = {}
  /// A nested pick.
  n: In
}

/// The holder.
let h: Holder = { p: "first", q: Beta, r: "none", t: shield, f: High, o: Alpha, on: none, l: [Beta, "none", Alpha], lo: [sword, none], mv: { "x": Beta, "y": "none" }, mk: { Alpha: 1, "none": 2 }, n: { t: sword } }

/// A direct let of the union type.
let one: PickB = Beta

/// A direct let of the table union.
let tone: PickT = shield

/// A direct let of the foreign union.
let far: PickF = Low

emit ts { out: "@features/a/a.ts", mode: baked }

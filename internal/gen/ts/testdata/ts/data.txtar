/** Flags, written as one bitmask. */
export type Flag = "tradable" | "droppable" | "soulbound";
export const FlagMembers: ReadonlyArray<Flag> = Object.freeze(["tradable", "droppable", "soulbound"]);
export const FlagNames: Readonly<Record<Flag, string>> = Object.freeze({ tradable: "tradable", droppable: "droppable", soulbound: "soulbound" });
export const FlagIndex: Readonly<Record<Flag, number>> = Object.freeze({ tradable: 0, droppable: 1, soulbound: 2 });
export const FlagCodes: Readonly<Record<Flag, number>> = Object.freeze({ tradable: 1, droppable: 2, soulbound: 4 });

/** Elements, written as their code. */
export type Element =
  | "FIRE"
  | "WATER"
  /** Retired. */
  | "WIND";
export const ElementMembers: ReadonlyArray<Element> = Object.freeze(["FIRE", "WATER", "WIND"]);
export const ElementNames: Readonly<Record<Element, string>> = Object.freeze({ FIRE: "FIRE", WATER: "WATER", WIND: "WIND" });
export const ElementIndex: Readonly<Record<Element, number>> = Object.freeze({ FIRE: 0, WATER: 1, WIND: 2 });
export const ElementCodes: Readonly<Record<Element, number>> = Object.freeze({ FIRE: 1, WATER: 2, WIND: 3 });

/** Sides. */
export type Side = "left" | "RIGHT";
export const SideMembers: ReadonlyArray<Side> = Object.freeze(["left", "RIGHT"]);
export const SideNames: Readonly<Record<Side, string>> = Object.freeze({ left: "left", RIGHT: "right" });
export const SideIndex: Readonly<Record<Side, number>> = Object.freeze({ left: 0, RIGHT: 1 });

/** What an objective counts. */
export type Goal = "kill" | "collect" | "visit";
export const GoalMembers: ReadonlyArray<Goal> = Object.freeze(["kill", "collect", "visit"]);
export const GoalNames: Readonly<Record<Goal, string>> = Object.freeze({ kill: "kill", collect: "collect", visit: "visit" });
export const GoalIndex: Readonly<Record<Goal, number>> = Object.freeze({ kill: 0, collect: 1, visit: 2 });

export type KindKind =
  | "weapon"
  | "armor"
  /**
   * A retired kind.
   * Retired.
   */
  | "junk"
  /** No kind. */
  | "plain";

export type TargetBranch = "kill" | "collect";

export type StatusId = string;

/** What an objective aims at. */
export type Target =
  | { readonly branch: "kill"; readonly value: string }
  | { readonly branch: "collect"; readonly value: number };

/** A stat bonus. */
export interface StatBonus {
  /** The stat. */
  readonly attribute: string;
  /** By how much. */
  readonly value: number;
}

/** A weapon skill. */
export interface KindWeapon {
  readonly kind: "weapon";
  /** Damage. */
  readonly attack: number;
  /** Element. */
  readonly affinity: Element | null;
}

/** An armor skill. */
export interface KindArmor {
  readonly kind: "armor";
  /** Defense. */
  readonly defense: number;
}

/** The kinds of a skill. */
export type Kind = KindWeapon | KindArmor | { readonly kind: "junk" } | { readonly kind: "plain" };

/** An objective. */
export interface Objective {
  /** The goal. */
  readonly goal: Goal;
  /** The target, none when the goal has none. */
  readonly target: Target | null;
}

/** A skill. */
export interface Skill {
  /** Its id. */

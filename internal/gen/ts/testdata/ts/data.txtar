CODEGEN.md §5.13, §8.1, WIRE.md §5: a data-mode emit decodes every wire form: paths, pairs, inline variants, units, Bool as 0/1, bits, codes, none markers, maps, dependent types and tables.
-- a/a.canon --
/// Every decode rule of the TypeScript data mode.
package a

/// Flags, written as one bitmask.
enum Flag @codes(UInt8) { tradable = 1, droppable = 2, soulbound = 4 }

/// Elements, written as their code.
enum Element @codes(UInt8) @json(codes) { FIRE = 1, WATER = 2, retired WIND = 3 }

/// Sides.
enum Side { left, right = "RIGHT" }

/// What an objective counts.
enum Goal { kill, collect, visit }

/// What an objective aims at.
type Target(g: Goal) = match g {
  kill => String(1..)
  collect => Int(1..)
  visit => Never
}

/// A stat bonus.
record StatBonus {
  /// The stat.
  attribute: String
  /// By how much.
  value: Int
}

/// The kinds of a skill.
variant Kind @json(tag: "type") {
  /// A weapon skill.
  weapon {
    /// Damage.
    attack: Int
    /// Element.
    affinity: Element? = none
  }
  /// An armor skill.
  armor {
    /// Defense.
    defense: Int
  }
  /// A retired kind.
  retired junk
  /// No kind.
  plain
}

/// An objective.
record Objective {
  /// The goal.
  goal: Goal
  /// The target, none when the goal has none.
  target: Target(goal)?
}

/// A skill.
record Skill @json(case: snake) {
  /// Its id.
  id: String @json("dwID")
  /// Mana.
  reqMp: Int = 0 @json(path: "legacy.reqMp")
  /// Focus.
  reqFp: Int = 0 @json(path: "legacy.reqFp")
  /// Element, 0 when none.
  element: Element? = none @json(none: 0)
  /// Flags.
  flags: [Flag] = [] @json(bits)
  /// Two handed, 0 or 1.
  twoHanded: Bool = false @json("bTwoHanded", int)
  /// Side or "both".
  side: Side | "both" = "both"
  /// Cast time in seconds.
  castTime: Duration? = none @json(unit: s)
  /// Weights by element.
  weights: {Element: Float} = {}
  /// Counts by level.
  counts: {Int: Int} = {}
  /// Bonuses, in numbered slots.
  stats: [StatBonus](..=3) = [] @json(pairs: ["dwDestParam{i}", "nAdjParamVal{i}"])
  /// The kind, written in this object.
  kind: Kind @json(inline)
  /// Objectives.
  goals: [Objective] = []
  /// Cheap.
  export fn isFree(self) -> Bool { return reqMp == 0 and reqFp == 0 }
  /// By element.
  export fn resist(self, e: Element) -> Int { return match e { FIRE => 1, WATER => 2, WIND => 3 } }
}

/// The skills.
let skills: [Skill] keyed by id = [
  { id: "fireball", reqMp: 12, element: FIRE, flags: [tradable, soulbound], castTime: 2s, counts: { 3: 4, 1: 2, 2: 7 }, kind: weapon { attack: 5 } },
  { id: "aegis", side: right, kind: armor { defense: 3 }, goals: [{ goal: kill, target: "wolf" }, { goal: visit }] },
]

/// Statuses.
record Status {
  /// Label.
  label: String
  /// Next.
  next: [ref Status] = []
}

/// The statuses, a table.
let statuses: stable table Status = {
  open { label: "Open", next: [closed] }
  closed { label: "Closed" }
  retired stale { label: "Stale" }
}

/// A single record.
let objective: Objective = { goal: collect, target: 3 }

/// None markers, equal by exact value whatever the token (WIRE.md §5.4), and a Float32.
record Mark {
  /// Its key.
  key: String
  /// A fraction marker.
  half: Float? = none @json(none: 0.5)
  /// A negative marker written with a fraction.
  minus: Float? = none @json(none: -1.0)
  /// An integer marker past 2^53.
  big: Int? = none @json(none: 9223372036854775807) @ts(bigint)
  /// Rounded once from the exact decimal.
  narrow: Float32 = 0.0
}

/// The marks: one with every marker, one with values.
let marks: [Mark] keyed by key = [
  { key: "none" },
  { key: "set", half: 1.5, minus: 2.0, big: 9007199254740993, narrow: 0.1 },
]

emit ts { out: "@features/a/a.ts", mode: data }
emit json { out: "@features/a/data/" }
-- ts.out --

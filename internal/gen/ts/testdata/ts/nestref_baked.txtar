/// Package.
package nrb

/// Shape.
enum Shape { count, place, none_ }

/// A parameter, by shape.
type Param(s: Shape) = match s {
  count => Int(0..)
  place => String
  none_ => Never
}

/// T.
record T {
/// Shape.
  shape: Shape
}

/// The table.
let tbl: table T = {
  sword { shape: count }
  shield { shape: place }
}

/// Leaf ew.
enum Tone { first, second = "z2", third }

/// Row.
record EwR1 {
/// Key.
  k: Tone
/// Shape.
  shape: Shape
}

/// List.
let ew1: [EwR1] keyed by k = [ { k: second, shape: count }, { k: third, shape: place } ]

/// Row.
record EwR2 {
/// Key.
  k: ref ew1
/// Shape.
  shape: Shape
}

/// List.
let ew2: [EwR2] keyed by k = [ { k: second, shape: count }, { k: third, shape: place } ]

/// Row.
record EwR3 {
/// Key.
  k: ref ew2
/// Shape.
  shape: Shape
}

/// List.
let ew3: [EwR3] keyed by k = [ { k: second, shape: count }, { k: third, shape: place } ]

/// Holder.
record HEw {
/// A field.
  f2: ref ew2
/// A field.
  f3: ref ew3
/// A field.
  fl: [ref ew3]
/// A field.
  fm: {ref ew3: Int}
/// A field.
  fu: ref ew2 | "none"
/// A field.
  fus: [ref ew3 | "none"]
/// A field.
  ev: ref ew3
/// A field.
  param: Param(ev.shape)? @json(none: 0)
/// A field.
  ev2: ref ew2
/// A field.
  param2: Param(ev2.shape)? @json(none: 0)
}

/// The holder.
let hew: HEw = { f2: second, f3: second, fl: [third], fm: { second: 1 }, fu: second, fus: ["none", third], ev: second, param: 3, ev2: third, param2: "x" }

/// Leaf ec.
enum Rank @codes(UInt8) @json(codes) { zulu = 4, alpha = 9, mid = 1 }

/// Row.
record EcR1 {
/// Key.
  k: Rank
/// Shape.
  shape: Shape
}

/// List.
let ec1: [EcR1] keyed by k = [ { k: alpha, shape: count }, { k: zulu, shape: place } ]

/// Row.
record EcR2 {
/// Key.
  k: ref ec1
/// Shape.
  shape: Shape
}

/// List.
let ec2: [EcR2] keyed by k = [ { k: alpha, shape: count }, { k: zulu, shape: place } ]

/// Row.
record EcR3 {
/// Key.
  k: ref ec2
/// Shape.
  shape: Shape
}

/// List.
let ec3: [EcR3] keyed by k = [ { k: alpha, shape: count }, { k: zulu, shape: place } ]

/// Holder.
record HEc {
/// A field.
  f2: ref ec2
/// A field.
  f3: ref ec3
/// A field.
  fl: [ref ec3]
/// A field.
  fm: {ref ec3: Int}
/// A field.
  ev: ref ec3
/// A field.
  param: Param(ev.shape)? @json(none: 0)
/// A field.
  ev2: ref ec2
/// A field.
  param2: Param(ev2.shape)? @json(none: 0)
}

/// The holder.
let hec: HEc = { f2: alpha, f3: alpha, fl: [zulu], fm: { alpha: 1 }, ev: alpha, param: 3, ev2: zulu, param2: "x" }

/// Row.
record StR1 {
/// Key.
  k: String
/// Shape.
  shape: Shape
}

/// List.
let st1: [StR1] keyed by k = [ { k: "q", shape: count }, { k: "p", shape: place } ]

/// Row.

export type TierId = "low" | "high";
export const TierIdMembers: ReadonlyArray<TierId> = Object.freeze(["low", "high"]);
export const TierIdLiveMembers: ReadonlyArray<TierId> = Object.freeze(["low", "high"]);

/** A tier. */
export interface Tier {
  readonly id?: TierId;
  readonly retired?: boolean;
  /** Its rank. */
  readonly rank: number;
}

/** A band. */
export interface Band {
  /** Its base. */
  readonly base: number;
  /** Its bonus for a tier. */
  readonly bonus: Readonly<Record<TierId, number>>;
  /** The tier after a tier. */
  readonly next: Readonly<Record<TierId, TierId>>;
}

/** The tiers. */
export const tiers: CanonTable<TierId, CanonRow<Tier, TierId>> = canonTable(canonFreeze(canonList<CanonRow<Tier, TierId>>(($r) => [
  $r({ id: "low", retired: false, rank: 1 }),
  $r({ id: "high", retired: false, rank: 2 }),
])), ($e) => $e.id);

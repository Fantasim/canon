-- a/a.canon --
/// Baked mode: every value as a literal.
package a

/// Flags, written as one bitmask.
enum Flag @codes(UInt8) { tradable = 1, droppable = 2, soulbound = 4 }

/// Elements, written as their code.
enum Element @codes(UInt8) @json(codes) { FIRE = 1, WATER = 2, retired WIND = 3 }

/// Sides.
enum Side { left, right = "RIGHT" }

/// What an objective counts.
enum Goal { kill, collect, visit }

/// What an objective aims at.
type Target(g: Goal) = match g {
  kill => String(1..)
  collect => Int(1..)
  visit => Never
}

/// A stat bonus.
record StatBonus {
  /// The stat.
  attribute: String
  /// By how much.
  value: Int
}

/// The kinds of a skill.
variant Kind @json(tag: "type") {
  /// A weapon skill.
  weapon {
    /// Damage.
    attack: Int
    /// Element.
    affinity: Element? = none
  }
  /// An armor skill.
  armor {
    /// Defense.
    defense: Int
  }
  /// A retired kind.
  retired junk
  /// No kind.
  plain
}

/// An objective.
record Objective {
  /// The goal.
  goal: Goal
  /// The target, none when the goal has none.
  target: Target(goal)?
}

/// A skill.
record Skill @json(case: snake) {
  /// Its id.
  id: String @json("dwID")
  /// Mana.
  reqMp: Int = 0 @json(path: "legacy.reqMp")
  /// Focus.
  reqFp: Int = 0 @json(path: "legacy.reqFp")
  /// Element, 0 when none.
  element: Element? = none @json(none: 0)
  /// Flags.
  flags: [Flag] = [] @json(bits)
  /// Two handed, 0 or 1.
  twoHanded: Bool = false @json("bTwoHanded", int)
  /// Side or "both".
  side: Side | "both" = "both"
  /// Cast time in seconds.
  castTime: Duration? = none @json(unit: s)
  /// Weights by element.
  weights: {Element: Float} = {}
  /// Counts by level.
  counts: {Int: Int} = {}
  /// Objectives by name, a map of records.
  named: {String: Objective} = {}
  /// Bonuses, in numbered slots.
  stats: [StatBonus](..=3) = [] @json(pairs: ["dwDestParam{i}", "nAdjParamVal{i}"])
  /// The kind, written in this object.
  kind: Kind @json(inline)
  /// Objectives.
  goals: [Objective] = []
  /// A Float32, stored as the double it rounds to.
  rate: Float32 = 0.1
  /// Negative zero.
  zero: Float = -0.0
  /// A duration.
  wait: Duration = 1m30s
  /// Past 2^53.
  serial: Int = 9_007_199_254_740_993 @ts(bigint)
  /// Serials.
  serials: [Int] = [1, 9_007_199_254_740_993] @ts(bigint)
  /// A sized integer.
  level: UInt8 = 200
  /// Cheap.
  export fn isFree(self) -> Bool { return reqMp == 0 and reqFp == 0 }
  /// By element.
  export fn resist(self, e: Element) -> Int { return match e { FIRE => 1, WATER => 2, WIND => 3 } }
}

/// The skills.
let skills: [Skill] keyed by id = [
  { id: "fireball", reqMp: 12, element: FIRE, named: { "x": { goal: collect, target: 2 } }, flags: [tradable, soulbound], castTime: 2s, kind: weapon { attack: 5 } },
  { id: "aegis", side: right, kind: armor { defense: 3 }, goals: [{ goal: kill, target: "wolf" }, { goal: visit }] },
]

/// Statuses.
record Status {
  /// Label.
  label: String
  /// Next.
  next: [ref Status] = []
}

/// The statuses, a table.
let statuses: stable table Status = {
  open { label: "Open", next: [closed] }
  closed { label: "Closed" }
  retired stale { label: "Stale" }
}

/// A rate whose type depends on its key.
record Rate(s: Status) {
  /// The rate.
  value: Int
}

/// Rates.
record Rates {
  /// A rate for each status, keyed by a ref.
  byStatus: {s in statuses: Rate(s)}
  /// Counts per status.
  counts: {ref statuses: Int}
}

/// The rates.
let rates: Rates = { byStatus: { open: { value: 1 }, closed: { value: 2 }, stale: { value: 3 } }, counts: { open: 4 } }

/// A single record.
let objective: Objective = { goal: collect, target: 3 }

/// Constants of every kind.
const LIMIT = 50
const RATE = 0.25
const NAME = "canon"
const TICK = 90s
const SIDE = Side.right
const LEVELS = [1, 2, 3]
const SCALES = { "a": 1.5, "b": 2.5 }

/// A package-level value without a parameter.
export fn defaultFlags() -> [Flag] { return [tradable, droppable] }

/// Whether a flag is storable.
export fn storable(flag: Flag) -> Bool { return flag != soulbound }

/// A status chosen by two Bool and a ref.
export fn nextOf(s: ref statuses, forward: Bool) -> ref statuses? {
  return if forward { statuses.open.next.first() } else { none }
}

emit ts { out: "@features/a/a.ts" }

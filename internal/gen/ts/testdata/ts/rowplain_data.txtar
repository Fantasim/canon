export function decodePs(json: unknown): CanonTable<PId, P> {
  const doc = canonEnvelope(json, psSchema, "ps.json");
  return canonTable(canonFreeze(decList(decGet(doc, "rows"), "/rows", (x, p) => readP(x, p, null))), (e) => e.id);
}

export function parsePs(text: string): CanonTable<PId, P> {
  return decodePs(decParse(text));
}

export function decodeSingle(json: unknown): P {
  const doc = canonEnvelope(json, singleSchema, "single.json");
  return canonFreeze(readP(decGet(doc, "value"), "/value"));
}

export function parseSingle(text: string): P {
  return decodeSingle(decParse(text));
}

export function decodeQs(json: unknown): CanonTable<string, Q> {
  const doc = canonEnvelope(json, qsSchema, "qs.json");
  return canonTable(canonFreeze(decList(decGet(doc, "rows"), "/rows", (x, p) => readQ(x, p))), (e) => e.k);
}

export function parseQs(text: string): CanonTable<string, Q> {
  return decodeQs(decParse(text));
}

function readP(raw: unknown, path: string, id?: string | null): P {
  const o = decObject(raw, path);
  const v1 = id === undefined ? undefined : id ?? decString(decGet(o, "$id"), path + "/$id");
  const v2 = id === undefined ? undefined : decGet(o, "$retired") === undefined ? false : decBool(decGet(o, "$retired"), path + "/$retired");

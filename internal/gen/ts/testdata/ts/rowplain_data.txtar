  return { ...(v1 === undefined ? {} : { id: v1, retired: v2 }), x: v3 };
}

function readQ(raw: unknown, path: string): Q {
  const o = decObject(raw, path);
  const v1: string = decString(decGet(o, "k"), path + "/k");
  const v2: P = readP(decGet(o, "inner"), path + "/inner");
  const r3 = decGet(o, "slots");
  const v3: ReadonlyArray<P> = r3 === undefined ? [] : decTable(r3, path + "/slots", (x, p, id) => readP(x, p, id));
  return { k: v1, inner: v2, slots: v3 };
}

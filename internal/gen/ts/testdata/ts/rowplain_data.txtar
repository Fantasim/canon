export type PId = string;

/** A point. */
export interface P {
  readonly id?: string;
  readonly retired?: boolean;
  /** Across. */
  readonly x: number;
}

/** A holder of a point and of a table of them. */
export interface Q {
  /** Its key. */
  readonly k: string;
  /** A plain point. */
  readonly inner: P;
  /** Points by name. */
  readonly slots: ReadonlyArray<P>;
}

export const psSchema = "a.P@b5a47a2e";

export const singleSchema = "a.P@275fcd97";

export const qsSchema = "a.Q@6173575e";

const decOrder = Symbol.for("canon.order");

const decTokenKey = Symbol.for("canon.token");

/** A number token with a fraction or an exponent, as parse reads it: its exact text, under a key every generated file shares. */

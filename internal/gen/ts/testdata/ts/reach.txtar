export function decodeStatuses(json: unknown): CanonTable<SId, S> {
  const doc = canonEnvelope(json, statusesSchema, "statuses.json");
  return canonTable(canonFreeze(decList(decGet(doc, "rows"), "/rows", (x, p) => readS(x, p))), (e) => e.id);
}

export function parseStatuses(text: string): CanonTable<SId, S> {
  return decodeStatuses(decParse(text));
}

function readS(raw: unknown, path: string, id?: string): S {
  const o = decObject(raw, path);
  const v1 = id ?? decString(decGet(o, "$id"), path + "/$id");
  const v2 = decGet(o, "$retired") === undefined ? false : decBool(decGet(o, "$retired"), path + "/$retired");
  const v3: string = decString(decGet(o, "label"), path + "/label");
  return { id: v1, retired: v2, label: v3 };
}

CODEGEN.md §5.6, §5.13, DECISIONS 278: a data emit decodes only the classes its selected values reach, so a dependent map in a record no selected value holds is no E8019 and the module builds.
-- a/a.canon --
/// Only statuses are emitted.
package a

/// A status.
record S {
  /// Label.
  label: String
}

/// The statuses.
let statuses: table S = {
  open { label: "Open" }
}

/// A rate.
record Rate(s: S) {
  /// Value.
  value: Int
}

/// Rates, held by no emitted value.
record Rates {
  /// By status.
  byStatus: {s in statuses: Rate(s)}
}

/// The rates, not emitted.
let rates: Rates = { byStatus: { open: { value: 1 } } }

emit ts { out: "@features/a/a.ts", mode: data, values: [statuses] }
emit json { out: "@features/a/data/", values: [statuses] }
-- ts.out --

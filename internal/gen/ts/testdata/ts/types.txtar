  const r7 = decGet(o, "side");
  const v7: Side | "both" = r7 === undefined ? "both" : decString(r7, path + "/side") as Side | "both";
  const r8 = decGet(o, "cast_time");
  const v8: number | null = r8 === undefined || r8 === null ? null : decDuration(r8, path + "/cast_time", 1000);
  const r9 = decGet(o, "weights");
  const v9: ReadonlyMap<Element, number> = r9 === undefined ? new CanonMap<Element, number>([]) : decMap(r9, path + "/weights", (k, p) => decCode(Number(k), p, ElementMembers, ElementCodes), (x, p) => decFloat(x, p));
  const r10 = decGet(o, "counts");
  const v10: ReadonlyMap<number, number> = r10 === undefined ? new CanonMap<number, number>([]) : decMap(r10, path + "/counts", (k, p) => decIntKey(k, p), (x, p) => decInt(x, p, -9223372036854776000, 9223372036854776000));
  const v11: ReadonlyArray<StatBonus> = decPairs(o, path, ["dwDestParam0", "dwDestParam1", "dwDestParam2"], ["nAdjParamVal0", "nAdjParamVal1", "nAdjParamVal2"], (a, b, pa, pb) => ({ attribute: decString(a, pa), value: decInt(b, pb, -9223372036854776000, 9223372036854776000) }));
  const v12: Kind = readKind(o, path);
  const r13 = decGet(o, "goals");
  const v13: ReadonlyArray<Objective> = r13 === undefined ? [] : decList(r13, path + "/goals", (x, p) => readObjective(x, p));
  return { id: v1, reqMp: v2, reqFp: v3, element: v4, flags: v5, twoHanded: v6, side: v7, castTime: v8, weights: v9, counts: v10, stats: v11, kind: v12, goals: v13 };
}

/** A skill. */
export function decodeSkill(json: unknown): Skill {
  return canonFreeze(readSkill(json, ""));
}

export function parseSkill(text: string): Skill {
  return decodeSkill(decParse(text));
}

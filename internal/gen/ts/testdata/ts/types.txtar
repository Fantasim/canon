function readKindArmor(o: Record<string, unknown>, path: string): KindArmor {
  const v1: number = decInt(decGet(o, "defense"), path + "/defense", -9223372036854776000, 9223372036854776000);
  return { kind: "armor", defense: v1 };
}

/** The kinds of a skill. */
export function decodeKind(json: unknown): Kind {
  return canonFreeze(readKind(json, ""));
}

export function parseKind(text: string): Kind {
  return decodeKind(decParse(text));
}

function readObjective(raw: unknown, path: string): Objective {
  const o = decObject(raw, path);
  const v1: Goal = decEnum(decGet(o, "goal"), path + "/goal", GoalMembers);

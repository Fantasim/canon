  const tag = decString(decGet(o, "type"), path + "/type");
  switch (tag) {
    case "weapon":
      return readKindWeapon(o, path);
    case "armor":
      return readKindArmor(o, path);
    case "junk":
      return { kind: "junk" };
    case "plain":
      return { kind: "plain" };
    default:
      return decFail(path + "/type", "unknown case");
  }
}

function readKindWeapon(o: Record<string, unknown>, path: string): KindWeapon {

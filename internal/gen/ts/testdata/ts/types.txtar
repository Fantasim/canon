  return { goal: v1, target: v2 };
}

/** An objective. */
export function decodeObjective(json: unknown): Objective {
  return canonFreeze(readObjective(json, ""));
}

export function parseObjective(text: string): Objective {
  return decodeObjective(decParse(text));
}


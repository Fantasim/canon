function readEventShape($raw: unknown, $path: string): EventShape {
  const $o = decObject($raw, $path);
  const $v1: Event = decEnum(decGet($o, "event"), $path + ".event", EventMembers);
  const $v2: Shape = decEnum(decGet($o, "shape"), $path + ".shape", ShapeMembers);
  return { event: $v1, shape: $v2 };
}

/** An event and the shape of its parameter. */
export function decodeEventShape(json: unknown): EventShape {
  return canonFreeze(readEventShape(json, "EventShape: $"));
}

export function parseEventShape(text: string): EventShape {
  return decodeEventShape(decParse(text, "EventShape", "$"));
}

function readParam($raw: unknown, $path: string, $disc: Shape): Param {
  switch ($disc) {
    case "count":
      return { branch: "count", value: decInt($raw, $path, -9223372036854776000, 9223372036854776000) };
    case "place":
      return { branch: "place", value: decString($raw, $path) };
    default:
      return decFail($path, "no branch for this value");
  }
}

function readReward($raw: unknown, $path: string): Reward {
  const $o = decObject($raw, $path);
  const $v1: Event = decEnum(decGet($o, "event"), $path + ".event", EventMembers);
  const $r2 = decGet($o, "param");
  const $v2: Param | null = $r2 === undefined || $r2 === null || decSame($r2, "0") ? null : readParam($r2, $path + ".param", branchesRewardParam.get($v1)!);
  const $v3: number = decInt(decGet($o, "points"), $path + ".points", -9223372036854776000, 9223372036854776000);
  return { event: $v1, param: $v2, points: $v3 };
}

/** One reward. */
export function decodeReward(json: unknown): Reward {
  return canonFreeze(readReward(json, "Reward: $"));
}

export function parseReward(text: string): Reward {
  return decodeReward(decParse(text, "Reward", "$"));
}

function readRewardFile($raw: unknown, $path: string): RewardFile {
  const $o = decObject($raw, $path);
  const $v1: ReadonlyArray<Reward> = decList(decGet($o, "rewards"), $path + ".rewards", ($x, $p) => readReward($x, $p));
  return { rewards: $v1 };
}

/** A reward file. */
export function decodeRewardFile(json: unknown): RewardFile {
  return canonFreeze(readRewardFile(json, "RewardFile: $"));
}

export function parseRewardFile(text: string): RewardFile {
  return decodeRewardFile(decParse(text, "RewardFile", "$"));
}

const branchesRewardParam: ReadonlyMap<Event, Shape> = new Map<Event, Shape>(canonList<readonly [Event, Shape]>(($r) => [
  $r(["beat_monster", "count"]),
  $r(["reach_place", "place"]),
]));

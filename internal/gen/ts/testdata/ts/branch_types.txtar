CODEGEN.md §5.6, §8.1, DECISIONS 350, 370: a dependent value decided through a ref is read through a build-time branch table, whose entries are checked one by one (canonList of tuples). Mode types.
-- a/a.canon --
/// A ref-decided dependent value.
package a

/// The shape of an event's parameter.
enum Shape { count, place, none_ }

/// What happened.
enum Event { beat_monster, reach_place, new_day }

/// An event and the shape of its parameter.
record EventShape {
  /// The event.
  event: Event
  /// What its parameter holds.
  shape: Shape
}

/// Every event, keyed by event.
let eventShapes: [EventShape] keyed by event = [
  { event: beat_monster, shape: count },
  { event: reach_place, shape: place },
  { event: new_day, shape: none_ },
]

/// A parameter, by shape.
type Param(s: Shape) = match s {
  count => Int(0..)
  place => String
  none_ => Never
}

/// One reward.
record Reward {
  /// The event.
  event: ref eventShapes
  /// The event's filter.
  param: Param(event.shape)? @json(none: 0)
  /// Points granted.
  points: Int(1..)
}

/// A reward file.
record RewardFile {
  /// The rewards.
  rewards: [Reward]
}

emit ts { out: "@features/a/a.ts", mode: types }
-- ts.out --
=== features/a/a.ts ===

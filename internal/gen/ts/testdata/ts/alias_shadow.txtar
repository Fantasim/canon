// Conformance vectors of package a, computed by the Canon evaluator.
import { test } from "node:test";
import * as assert from "node:assert/strict";
import { $gateBonus, $gatePoints, $gateTag, CanonEvalError } from "./a.js";

function canonCatch<T>(f: () => T): [T | undefined, string] {
  try {
    return [f(), ""];
  } catch (e) {
    if (e instanceof CanonEvalError) return [undefined, e.code];
    throw e;
  }
}

test("Gate.points conformance", () => {
  const vectors: ReadonlyArray<readonly [Parameters<typeof $gatePoints>[0], number, number, number, string]> = [
    ["admin", 3, 2, 10, ""],
    ["member", 1, 2, 3, ""],
    ["admin", 3, -9223372036854776000, 0, "E8303"],
    ["admin", 3, -1, 4, ""],
    ["admin", 3, 0, 6, ""],
    ["admin", 3, 1, 8, ""],
    ["admin", 3, 3, 12, ""],
    ["admin", 3, 4, 14, ""],
    ["admin", 3, 9223372036854776000, 0, "E8303"],
    ["member", 1, -9223372036854776000, 0, "E8303"],
    ["member", 1, -1, 0, ""],
    ["member", 1, 0, 1, ""],
    ["member", 1, 1, 2, ""],
    ["member", 1, 9223372036854776000, 0, "E8303"],
  ];
  for (const [min, level, roles$, want, code] of vectors) {
    const [got, gotCode] = canonCatch(() => $gatePoints(min, level, roles$));
    assert.equal(gotCode, code, `Gate.points(min=${min}, level=${level}, roles=${roles$})`);
    if (code === "") assert.ok(Object.is(got, want), `Gate.points(min=${min}, level=${level}, roles=${roles$}) = ${got}, canon says ${want}`);
  }
});

test("Gate.tag conformance", () => {
  const vectors: ReadonlyArray<readonly [Parameters<typeof $gateTag>[0], number, string, string]> = [
    ["admin", 4, "admin:4", ""],
    ["admin", -9223372036854776000, "", "E8303"],
    ["admin", -1, "admin:-1", ""],
    ["admin", 0, "admin:0", ""],
    ["admin", 1, "admin:1", ""],
    ["admin", 9223372036854776000, "", "E8303"],
  ];
  for (const [min, roles$, want, code] of vectors) {
    const [got, gotCode] = canonCatch(() => $gateTag(min, roles$));

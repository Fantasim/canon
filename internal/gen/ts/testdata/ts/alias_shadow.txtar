/// Roles.
package roles

/// A role, lowest first.
enum Role ordered { guest, member, admin }

emit ts { out: "@features/roles/roles.ts" }
-- a/a.canon --
/// Gates on roles.
package a

import roles { Role }

/// A gate.
record Gate {
  /// The least role.
  min: Role
  /// Its level.
  level: Int

  /// Points for `roles` more levels, doubled when the gate is above member.
  export fn points(self, roles: Int) -> Int { return if min > Role.member { (level + roles) * 2 } else { level + roles } }

  /// Its role's name and a count.
  export fn tag(self, roles: Int) -> String { return "{min}:{roles}" }

  /// A local named roles, beside an ordered comparison.
  export fn bonus(self, n: Int) -> Int {
    let roles = n + level
    return if min >= Role.admin { roles } else { 0 }
  }
}

/// Whether a role is above member.
export fn above(roles: Role) -> Bool { return roles > Role.member }

/// The admin gate.
let gate: Gate = { min: admin, level: 3 }

test "gates" {
  let g: Gate = { min: admin, level: 3 }
  let m: Gate = { min: member, level: 1 }
  expect g.points(2) == 10
  expect m.points(2) == 3
  expect g.tag(4) == "admin:4"
  expect g.bonus(1) == 4
  expect m.bonus(1) == 0
}

emit ts { out: "@features/a/a.ts" }
-- ts.out --

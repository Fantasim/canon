// GENERATED by canon from a/. DO NOT EDIT.
import * as roles from "../roles/roles.js";

// ---------------------------------------------------------------------------
// canon runtime, TypeScript v1 (CODEGEN.md §8.2). Identical in every generated file.
// ---------------------------------------------------------------------------

/** An error the Canon evaluator would also report, with its code ("E4101"). */
export class CanonEvalError extends Error {
  readonly code: string;
  constructor(code: string, message: string) {
    super(code + ": " + message);
    this.name = "CanonEvalError";
    this.code = code;
  }
}

function canonFail(code: string, message: string): never {
  throw new CanonEvalError(code, message);
}

/** Every Int crossing a translated function is a safe integer; -0 becomes 0. */
function canonInt(x: number): number {
  if (!Number.isSafeInteger(x)) canonFail("E8303", "integer outside the TypeScript safe range");
  return x === 0 ? 0 : x;
}

function canonAdd(a: number, b: number): number { return canonInt(a + b); }
function canonMul(a: number, b: number): number { return canonInt(a * b); }

/** A table or keyed list: entries in source order, lookup by key. */
export interface CanonTable<K, T> {
  readonly length: number;
  readonly all: ReadonlyArray<T>;
  at(i: number): T;
  find(key: K): T | null;
}

/** Deep-freezes plain objects and arrays (CanonMaps are already read-only). */
function canonFreeze<T>(x: T): T {
  if (typeof x === "object" && x !== null && !Object.isFrozen(x)) {
    Object.freeze(x);
    for (const v of Object.values(x)) canonFreeze(v);
  }
  return x;
}
// ---------------------------------------------------------------------------

/** A gate. */
export interface Gate {
  /** The least role. */
  readonly min: roles.Role;
  /** Its level. */
  readonly level: number;
}

/** The admin gate. */
export const gate: Gate = canonFreeze<Gate>({ min: "admin", level: 3 });

/** Points for `roles` more levels, doubled when the gate is above member. */
export function gatePoints(self: Gate, roles$: number): number {
  return $gatePoints(self.min, self.level, roles$);
}

export function $gatePoints(min: roles.Role, level: number, roles$: number): number {
  level = canonInt(level);
  roles$ = canonInt(roles$);
  if (roles.RoleIndex[min] > roles.RoleIndex["member"]) {
    return canonMul(canonAdd(level, roles$), 2);
  }
  return canonAdd(level, roles$);
}

/** Its role's name and a count. */
export function gateTag(self: Gate, roles$: number): string {
  return $gateTag(self.min, roles$);
}

export function $gateTag(min: roles.Role, roles$: number): string {
  roles$ = canonInt(roles$);
  return roles.RoleNames[min] + ":" + String(roles$);
}

/** A local named roles, beside an ordered comparison. */
export function gateBonus(self: Gate, n: number): number {
  return $gateBonus(self.min, self.level, n);
}

export function $gateBonus(min: roles.Role, level: number, n: number): number {
  level = canonInt(level);
  n = canonInt(n);
  const roles$ = canonAdd(n, level);
  if (roles.RoleIndex[min] >= roles.RoleIndex["admin"]) {
    return roles$;
  }
  return 0;
}

const ABOVE: ReadonlyArray<boolean> = canonFreeze<ReadonlyArray<boolean>>([
  false, false, true,
]);

/** Whether a role is above member. */
export function above(roles$: roles.Role): boolean {
  return ABOVE[roles.RoleIndex[roles$]];
}

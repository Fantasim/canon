/// A package.
package a

/// A shape.
variant Shape {
  /// A circle.
  circle {
    /// Its radius.
    r: Int
  }
  /// A point.
  point {
    /// Whether it is at the origin.
    export fn atOrigin(self) -> Bool { return true }
  }
}

/// A holder.
record H {
  /// Its key.
  k: String
  /// Its shape.
  s: Shape
}

/// The holders.
let hs: [H] keyed by k = [{ k: "a", s: point }, { k: "b", s: circle { r: 1 } }]

emit ts { out: "@features/a/a.ts", mode: data }
emit json { out: "@features/a/data/" }

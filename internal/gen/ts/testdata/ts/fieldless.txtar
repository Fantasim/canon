export type ShapeKind =
  | "circle"
  /** A point. */
  | "point";

/** A circle. */
export interface ShapeCircle {
  readonly kind: "circle";
  /** Its radius. */
  readonly r: number;
}

/** A point. */
export interface ShapePoint {
  readonly kind: "point";
  /** Whether it is at the origin. */
  readonly atOrigin: boolean;
}

/** A shape. */
export type Shape = ShapeCircle | ShapePoint;

/** A holder. */
export interface H {
  /** Its key. */
  readonly k: string;
  /** Its shape. */
  readonly s: Shape;
}

export const hsSchema = "a.H@6d3b2141";

const decOrder = Symbol.for("canon.order");

const decTokenKey = Symbol.for("canon.token");

/** A number token with a fraction or an exponent, as parse reads it: its exact text, under a key every generated file shares. */

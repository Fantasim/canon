  const got = doc !== null && typeof doc === "object" && typeof doc["$schema"] === "string" ? doc["$schema"] : "<none>";
  if (got !== schema) {
    throw new Error(name + ": built from schema " + got + ", this binary expects " + schema + ". Rebuild the data or deploy the matching binary");

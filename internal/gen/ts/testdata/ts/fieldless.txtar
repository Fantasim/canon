export type ShapeKind =
  | "circle"
  /** A point. */
  | "point";

/** A circle. */
export interface ShapeCircle {
  readonly kind: "circle";
  /** Its radius. */
  readonly r: number;
}

/** A point. */
export interface ShapePoint {
  readonly kind: "point";
  /** Whether it is at the origin. */
  readonly atOrigin: boolean;
}

/** A shape. */
export type Shape = ShapeCircle | ShapePoint;

/** A holder. */
export interface H {
  /** Its key. */
  readonly k: string;
  /** Its shape. */
  readonly s: Shape;
}


CODEGEN.md §5.10, log-2026-10-06 "U5 re-verify": a data reader of another package's record whose lookup takes a ref into that package's EMPTY baked table writes the cell domain as a literal array of the ids, from ir.ExportFn.Domains: `[]`, which decKeyed's type argument types as the owner's id union (`never`), so tsc --strict accepts it.
-- b/b.canon --
/// Items and bands, baked.
package b

/// An item.
record Item {
  /// Its rank.
  rank: Int
}

/// The items: none yet.
let items: table Item = {}

/// A band.
record Band {
  /// Its base.
  base: Int
  /// Its bonus for an item.
  export fn bonus(self, t: ref items) -> Int { return self.base + t.rank }
}

emit ts { out: "@features/b/b.ts" }
-- a/a.canon --
/// A zone, in data mode.
package a

import b { Band }

/// A zone.
record Zone {
  /// Its band.
  band: Band
}

/// The zone.
let zone: Zone = { band: { base: 3 } }

emit json { out: "@features/a/data/" }
emit ts { out: "@features/a/a.ts", mode: data }

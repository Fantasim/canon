-- game/core/core.canon --
/// The core vocabulary.
package game.core

import game.tone { Tone }

/// A status.
record Status {
  /// Its label.
  label: String
}

/// The statuses.
let statuses: table Status = {
  open { label: "Open" }
  retired shut { label: "Shut" }
}

/// A level band.
record LevelRange {
  /// Lowest.
  min: Int
  /// Highest.
  max: Int
  /// Labels.
  labels: [String] = []
  /// Its tone.
  tone: Tone
  /// Its status.
  status: ref statuses
  /// Its width.
  export fn width(self) -> Int { return self.max - self.min }
}

/// A reward.
variant Reward {
  /// Coins.
  coins {
    /// How many.
    amount: Int
  }
  /// Nothing.
  nothing
}

/// A badge.
record Badge {
  /// Its label.
  label: String
}

/// The badges: a table of game.core, so Badge is a row record here too.
let badges: table Badge = {
  gold { label: "Gold" }
}

/// A marker.
record Marker {
  /// Its code.
  code: String
}

/// What a bonus aims at.
enum Aim { gold, mood }

/// A bonus, by its aim.
type Bonus(a: Aim) = match a {
  gold => Int
  mood => Tone
}

/// An effect.
record Effect {
  /// Its aim.
  aim: Aim
  /// Its bonus.
  bonus: Bonus(aim)
}

/// A shelf, holding a table of game.core's own.
record Shelf {
  /// Its slots.
  slots: table Marker
}

emit ts { out: "@features/core/core.ts" }
-- game/world/world.canon --
/// The world.
package game.world

import game.core { LevelRange, Reward, Marker, Status, Badge, Effect, Aim, Bonus, Shelf }

/// A zone.
record Zone {
  /// Its levels.
  levels: LevelRange
  /// Its reward.
  reward: Reward
  /// Its markers.
  markers: table Marker
  /// Its effect.
  effect: Effect
}

/// A perk.
record Perk {
  /// Its aim.
  aim: Aim
  /// Its bonus.
  bonus: Bonus(aim)
}

/// The zones.
let zones: table Zone = {
  forest {
    levels: { min: 1, max: 5, tone: soft, status: open }
    reward: coins { amount: 3 }
    markers: { gate { code: "g" }, retired well { code: "w" } }
    effect: { aim: gold, bonus: 2 }
  }
}

/// Level bands.
let bands: table LevelRange = {
  low { min: 1, max: 5, tone: soft, status: open }
  retired old { min: 0, max: 1, tone: loud, status: shut }
}

/// Moods: game.core's Status, keyed by game.world's own StatusId beside game.core's, which LevelRange.status names.
let moods: table Status = {
  calm { label: "Calm" }
  retired grim { label: "Grim" }
}

/// Medals: game.core's badges, keyed by game.world's own ids.
let medals: table Badge = {
  bronze { label: "Bronze" }
  retired tin { label: "Tin" }
}

/// The start band.
let start: LevelRange = { min: 1, max: 2, tone: loud, status: open }

/// A shelf: its table of game.core's Marker sits inside game.core's record.
let shelf: Shelf = { slots: { top { code: "t" }, retired low { code: "l" } } }

/// The perks.
let perks: table Perk = {
  rich { aim: gold, bonus: 7 }
}

emit ts { out: "@features/world/world.ts", mode: embedded }
-- ts.out --

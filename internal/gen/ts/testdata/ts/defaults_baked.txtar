DECISIONS 278: a field default holding a record or case with precomputed export fns carries their results, precomputed at stage E as baked does, so a data reader fills an absent key with them. Mode baked.
-- a/a.canon --
/// Defaults holding stored results.
package a

/// A point.
record P {
  /// Across.
  x: Int
  /// Twice x.
  export fn double(self) -> Int { return x * 2 }
}

/// A shape.
variant Shape {
  /// A circle.
  circle {
    /// Radius.
    r: Int
  }
  /// A dot.
  dot {
    /// Its area.
    export fn area(self) -> Int { return 0 }
  }
}

/// A holder whose defaults hold stored results.
record O {
  /// Its key.
  id: String
  /// A point.
  p: P = { x: 1 }
  /// A shape.
  sh: Shape = dot
}

/// The holders: one with every default, one without.
let os: [O] keyed by id = [{ id: "a" }, { id: "b", p: { x: 4 }, sh: circle { r: 2 } }]

emit ts { out: "@features/a/a.ts", mode: baked }
-- ts.out --
=== features/a/a.ts ===

/// Roles, in a package named p.
package p

/// A role, lowest first.
enum Role ordered { guest, member, admin }

emit ts { out: "@features/p/p.ts" }
-- a/a.canon --
/// Duplicate-looking parameters.
package a

import p { Role }

/// A record whose fields are named like escaped parameters.
record Pair {
  /// A field named default: a property, never escaped.
  default: Int
  /// Its neighbour.
  default_: Int
}

/// Whether a role passes, given a flag.
export fn visible(p: Role, p_: Bool) -> Bool { return p_ and p > Role.guest }

/// A sum of two parameters, one named with a reserved word.
export fn total(default: Int, default_: Int) -> Int {
  let p = default + default_
  let p_ = p * 2
  return p_
}

/// One pair.
let pair: Pair = { default: 1, default_: 2 }

test "totals" {
  expect total(1, 2) == 6
}

emit ts { out: "@features/a/a.ts" }

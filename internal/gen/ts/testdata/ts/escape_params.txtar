// GENERATED by canon from a/. DO NOT EDIT.
// Conformance vectors of package a, computed by the Canon evaluator.
import { test } from "node:test";
import * as assert from "node:assert/strict";
import { CanonEvalError, total } from "./a.js";

function canonCatch<T>(f: () => T): [T | undefined, string] {
  try {
    return [f(), ""];
  } catch (e) {
    if (e instanceof CanonEvalError) return [undefined, e.code];
    throw e;
  }
}

test("total conformance", () => {
  const vectors: ReadonlyArray<readonly [number, number, number, string]> = [
    [1, 2, 6, ""],
    [-9223372036854776000, -9223372036854776000, 0, "E8303"],
    [-9223372036854776000, -1, 0, "E8303"],
    [-9223372036854776000, 0, 0, "E8303"],
    [-9223372036854776000, 1, 0, "E8303"],
    [-9223372036854776000, 2, 0, "E8303"],
    [-9223372036854776000, 9223372036854776000, 0, "E8303"],
    [-1, -9223372036854776000, 0, "E8303"],
    [-1, -1, -4, ""],
    [-1, 0, -2, ""],
    [-1, 1, 0, ""],
    [-1, 2, 2, ""],
    [-1, 9223372036854776000, 0, "E8303"],
    [0, -9223372036854776000, 0, "E8303"],
    [0, -1, -2, ""],
    [0, 0, 0, ""],
    [0, 1, 2, ""],
    [0, 2, 4, ""],
    [0, 9223372036854776000, 0, "E8303"],
    [1, -9223372036854776000, 0, "E8303"],
    [1, -1, 0, ""],
    [1, 0, 2, ""],
    [1, 1, 4, ""],
    [1, 9223372036854776000, 0, "E8303"],
    [9223372036854776000, -9223372036854776000, 0, "E8303"],
    [9223372036854776000, -1, 0, "E8303"],
    [9223372036854776000, 0, 0, "E8303"],
    [9223372036854776000, 1, 0, "E8303"],
    [9223372036854776000, 2, 0, "E8303"],
    [9223372036854776000, 9223372036854776000, 0, "E8303"],
  ];
  for (const [default$, default_, want, code] of vectors) {
    const [got, gotCode] = canonCatch(() => total(default$, default_));
    assert.equal(gotCode, code, `total(default=${default$}, default_=${default_})`);
    if (code === "") assert.ok(Object.is(got, want), `total(default=${default$}, default_=${default_}) = ${got}, canon says ${want}`);
  }
});

/// Uses badges.
package a

import base { Badge }

/// A holder.
record Holder {
  /// Its key.
  id: String
  /// A badge.
  b: Badge
}

/// The holders.
let hs: [Holder] keyed by id = [{ id: "h", b: { label: "x" } }]

/// Badges, keyed by label.
let badges: [Badge] keyed by label = [{ label: "gold", weight: 2.5 }]

/// One badge.
let best: Badge = { label: "best" }

emit json { out: "@features/a/data/" }
emit ts { out: "@features/a/a.ts", mode: data }

/// Bigint positions beside refs.
package a

/// A row keyed by a plain integer.
record K {
  /// Its key.
  n: Int
}

/// The plain-keyed rows.
let ks: [K] keyed by n = [ { n: 1 }, { n: 2 } ]

/// A row keyed by a bigint.
record B {
  /// Its key.
  n: Int @ts(bigint)
}

/// The bigint-keyed rows.
let bs: [B] keyed by n = [ { n: 9_007_199_254_740_993 } ]

/// Fields whose @ts(bigint) leaves their refs in their targets' key form.
record H {
  /// Bigint weights by plain-keyed row: the key a number, the weight a bigint.
  m: {ref ks: Int} = {} @ts(bigint)
  /// Plain-keyed rows by bigint: the key a bigint, the row's key a number.
  byBig: {Int: ref ks} = {} @ts(bigint)
  /// A bigint-keyed row in a field without the flag: a bigint.
  b: ref bs?
  /// Plain-keyed rows by bigint-keyed row, in a field without the flag.
  bk: {ref bs: ref ks} = {}
}

/// The holder.
let h: H = { m: { 1: 9_007_199_254_740_995 }, byBig: { 9_007_199_254_740_997: 2 }, b: 9_007_199_254_740_993, bk: { 9_007_199_254_740_993: 1 } }

emit json { out: "@features/a/json/" }
emit ts { out: "@features/a/a.ts", mode: types }

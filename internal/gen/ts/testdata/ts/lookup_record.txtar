CODEGEN.md §5.10, §8.1, DECISIONS 370: a lookup fn whose result is a record holds its cells one by one (canonList of records); a list-of-lists result is typed the same way.
-- a/a.canon --
/// A lookup whose answers are records.
package a

/// Sides.
enum Side { left, right }

/// A pair of numbers.
record Pair {
  /// Its side.
  side: Side
  /// Its weight.
  weight: Int
}

/// The pair of a side.
export fn pairOf(s: Side) -> Pair { return match s { left => { side: left, weight: 1 }, right => { side: right, weight: 2 } } }

/// The sides of a side.
export fn sidesOf(s: Side) -> [[Side]] { return match s { left => [[left], [right]], right => [[right]] } }

emit ts { out: "@features/a/a.ts" }

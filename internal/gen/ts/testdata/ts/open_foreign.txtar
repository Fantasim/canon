/// A.
package a

import b { Dst, Item }

/// A use.
record Use {
  /// Where.
  dst: Dst
  /// Where, or all.
  place: Dst | "all" = "all"
  /// Destinations by count.
  counts: {Dst: Int} = {}
}

/// The items.
@text("items.json")
export fn items() -> [Item] { return [] }

emit ts { out: "@features/a/a.ts", mode: types }

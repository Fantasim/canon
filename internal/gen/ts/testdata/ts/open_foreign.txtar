function readItem($raw: unknown, $path: string): Item {
  const $o = decObject($raw, $path);
  const $v1: Dst = decString(decGet($o, "dst"), $path + ".dst") as Dst;
  return { dst: $v1 };
}

/** An item. */
export function decodeItem(json: unknown): Item {
  return canonFreeze(readItem(json, "Item: $"));
}

export function parseItem(text: string): Item {
  return decodeItem(decParse(text, "Item", "$"));
}

      return true;
    }
    if (text[i] !== close) fail("expected , or " + close);
    i++;
    return false;
  };
  const obj = (depth: number): unknown => {
    i++;
    const o: Record<string, unknown> = {};
    const order: string[] = [];
    ws();
    if (text[i] === "}") {
      i++;
    } else {
      do {
        ws();
        if (text[i] !== '"') fail("expected a string key");
        const k = str();
        if (Object.prototype.hasOwnProperty.call(o, k)) fail("duplicate key " + k);
        ws();
        if (text[i++] !== ":") fail("expected :");
        Object.defineProperty(o, k, { value: val(depth + 1), enumerable: true, writable: true, configurable: true });
        order.push(k);
      } while (sep("}"));
    }
    Object.defineProperty(o, decOrder, { value: order });
    return o;
  };
  const arr = (depth: number): unknown => {
    i++;
    const a: unknown[] = [];
    ws();
    if (text[i] === "]") {
      i++;
      return a;
    }
    do {
      a.push(val(depth + 1));
    } while (sep("]"));
    return a;
  };
  const val = (depth: number): unknown => {
    if (depth > 512) fail("nesting deeper than 512");
    ws();
    const c = text[i];
    if (c === "{") return obj(depth);
    if (c === "[") return arr(depth);
    if (c === '"') return str();
    if (c === "t") return word("true", true);
    if (c === "f") return word("false", false);
    if (c === "n") return word("null", null);
    return num();
  };
  const v = val(0);
  ws();
  if (i < text.length) fail("trailing content");
  return v;
}

export function decodeAwards(json: unknown): CanonTable<string, Award> {
  const doc = canonEnvelope(json, awardsSchema, "awards.json");
  return canonTable(canonFreeze(decList(decGet(doc, "rows"), "/rows", (x, p) => readAward(x, p))), (e) => e.code);
}

export function parseAwards(text: string): CanonTable<string, Award> {
  return decodeAwards(decParse(text));
}

function readAward(raw: unknown, path: string): Award {
  const o = decObject(raw, path);
  const v1: string = decString(decGet(o, "code"), path + "/code");
  const v2: BadgeId = decString(decGet(o, "badge"), path + "/badge") as BadgeId;
  const v3: Tone = decEnum(decGet(o, "tone"), path + "/tone", ToneMembers);
  const r4 = decGet(o, "weights");
  const v4: ReadonlyMap<Tone, number> = r4 === undefined ? new CanonMap<Tone, number>([]) : decMap(r4, path + "/weights", (k, p) => decEnum(k, p, ToneMembers), (x, p) => decInt(x, p, -9223372036854776000, 9223372036854776000));
  const v5: Pin = decForeign(decGet(o, "pin"), path + "/pin", decodePin);
  const r6 = decGet(o, "tones");
  const v6: ReadonlyArray<Tone> = r6 === undefined ? [] : decList(r6, path + "/tones", (x, p) => decEnum(x, p, ToneMembers));
  return { code: v1, badge: v2, tone: v3, weights: v4, pin: v5, tones: v6 };
}

CODEGEN.md §2.8, §5.3, §5.8: a package imports the types and the values of another package's ts emit by relative `.js` paths: a ref into an imported table, an imported enum in a map, a union and a lookup over an imported enum (its Index is imported as a value); a types-mode package's record read by this file's own reader, also from parse's tokens (DECISIONS 278, 323).
-- base/base.canon --
/// The vocabulary.
package base

/// A colour.
enum Tone { red, blue }

/// Roles, lowest first.
enum Role ordered { member, admin }

/// A badge.
record Badge {
  /// Its colour.
  tone: Tone
  /// Its label.
  label: String
}

/// The badges.
let badges: table Badge = {
  gold { tone: red, label: "Gold" }
  iron { tone: blue, label: "Iron" }
}

emit ts { out: "@features/shared/base.ts" }
-- types/types.canon --
/// Types read through public decoders.
package types

/// A pin.
record Pin {
  /// Where.
  place: String
  /// How many.
  count: Int = 1
  /// How heavy.
  weight: Float = 1.0
}

emit ts { out: "@features/shared/types.ts", mode: types }
-- user/user.canon --
/// Uses the vocabulary.
package user

import base { Tone, Role, Badge, badges }
import types { Pin }

/// An award.
record Award {
  /// Its code.
  code: String
  /// The badge, a ref into an imported table.
  badge: ref badges
  /// A tone.
  tone: Tone
  /// Weights by tone.
  weights: {Tone: Int} = {}
  /// A pin.
  pin: Pin
  /// The tones it may take.
  tones: [Tone] = []
}

/// The awards.
let awards: [Award] keyed by code = [
  { code: "a", badge: gold, tone: red, weights: { red: 1 }, pin: { place: "here", weight: 2.5 } },
]

emit ts { out: "@features/user/user.ts", mode: data }
emit json { out: "@features/user/data/" }
-- lookups/lookups.canon --
/// Lookups over imported vocabulary.
package lookups

import base { Role, badges }

/// What a role may see, a lookup over an imported enum.
export fn visible(r: Role) -> Bool { return r >= admin }

/// A badge for a role, a ref into an imported table.
export fn badgeFor(r: Role) -> ref badges { return if r >= admin { badges.gold } else { badges.iron } }

emit ts { out: "@features/lookups/lookups.ts" }

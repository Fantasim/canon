  return Object.freeze(Object.defineProperty({}, decTokenKey, { value: text }));
}

/** The exact decimal text of a number: a token parse kept, or a number or bigint. */
function decText(raw: unknown): string | undefined {
  if (typeof raw === "number" || typeof raw === "bigint") return String(raw);
  const t = typeof raw === "object" && raw !== null ? Reflect.get(raw, decTokenKey) : undefined;
  return typeof t === "string" ? t : undefined;
}

function decKeys(o: Record<string, unknown>): string[] {
  const order = Reflect.get(o, decOrder) as string[] | undefined;
  return order === undefined ? Object.keys(o) : order;
}

/** Throws the failure at path, behind the name of what is read: `$`-rooted for a types-mode decoder (`Skill: $.events[1].level`), from the file's top for a data file (`skills.json: rows[1].level`) (CODEGEN.md §5.13, DECISIONS 361). */
function decFail(path: string, message: string): never {
  throw new Error(path + ": " + message);
}

function decGet(o: Record<string, unknown>, key: string): unknown {
  return Object.prototype.hasOwnProperty.call(o, key) ? o[key] : undefined;
}

function decIsObject(raw: unknown): raw is Record<string, unknown> {
  return typeof raw === "object" && raw !== null && !Array.isArray(raw) && !Reflect.has(raw, decTokenKey);
}

function decObject(raw: unknown, path: string): Record<string, unknown> {
  if (!decIsObject(raw)) decFail(path, "expected an object");
  return raw;
}

function decArray(raw: unknown, path: string): ReadonlyArray<unknown> {
  if (!Array.isArray(raw)) decFail(path, "expected an array");
  return raw;
}

function decInt(raw: unknown, path: string, lo: number, hi: number): number {
  if (typeof raw === "bigint") decFail(path, "integer outside the TypeScript safe range");
  if (typeof raw !== "number" || !Number.isInteger(raw)) decFail(path, "expected an integer");
  if (!Number.isSafeInteger(raw)) decFail(path, "integer outside the TypeScript safe range");
  if (raw < lo || raw > hi) decFail(path, "integer out of range");
  return raw === 0 ? 0 : raw;
}

/** A Float64; a number past its range is refused with `refusal`: "number out of range" in a types-mode decoder, the data loaders' "expected a number" in a data file. */
function decFloat(raw: unknown, path: string, refusal = "number out of range"): number {
  const text = decText(raw);
  if (text === undefined) decFail(path, "expected a number");
  const v = typeof raw === "number" ? raw : Number(text);
  if (!Number.isFinite(v)) decFail(path, refusal);
  return v === 0 ? 0 : v;
}

function decString(raw: unknown, path: string): string {
  if (typeof raw !== "string") decFail(path, "expected a string");
  return raw;
}

/** One of members; a literal union's arm refuses with the value, as the Go decoder does. */
function decEnum<T extends string>(raw: unknown, path: string, members: ReadonlyArray<T>, union = false): T {
  const m = members.find((x) => x === raw);
  if (m === undefined) decFail(path, union ? "unknown value " + String(raw) : "unknown member");
  return m;
}

/** A ref's key into a table whose ids the file knows through its Index: a key it does not hold names no entry. */
function decEntry<K extends string>(raw: unknown, path: string, index: Readonly<Record<K, number>>): K {
  const k = decString(raw, path);
  if (!Object.prototype.hasOwnProperty.call(index, k)) decFail(path, "no entry " + k);
  return k as K;
}

function decList<T>(raw: unknown, path: string, read: (x: unknown, p: string) => T): T[] {
  return decArray(raw, path).map((x, i) => read(x, path + "[" + i + "]"));
}

function decMap<K, V>(raw: unknown, path: string, key: (k: string, p: string) => K, read: (x: unknown, p: string) => V): CanonMap<K, V> {
  const o = decObject(raw, path);
  return new CanonMap(decKeys(o).map((k): readonly [K, V] => [key(k, path + "." + k), canonFreeze(read(o[k], path + "." + k))]));
}

/** Reads JSON text the way WIRE.md §3.1 to §3.3 read a file, the first failure in document order, placed where it becomes certain. A types-mode decoder (root `$`): a syntax error is `<T>: invalid JSON at byte N`, N the 0-based UTF-8 offset of the first byte that cannot continue the document (a BOM counted) or the text's length when it ends too early; a repeated key, an unpaired surrogate, a lone surrogate code unit in a string (`not UTF-8`) and nesting past 512 are named at their `$` path (`<T>: $.a[1]: …`). A data file (root ""): a syntax error, invalid UTF-8 or an unpaired surrogate is `<file>: not a canon data file (invalid JSON)`, as the loaders print it; a repeated key and nesting past 512 are named at their path (`<file>: a[1]: …`) (DECISIONS 361). */
function decParse(text: string, label: string, root: string): unknown {
  let i = text.charCodeAt(0) === 0xfeff ? 1 : 0;
  const escapes: Record<string, string> = { '"': '"', "\\": "\\", "/": "/", b: "\b", f: "\f", n: "\n", r: "\r", t: "\t" };
  const bytes = (end: number): number => {
    let n = 0;
    for (const ch of text.slice(0, end)) {
      const cp = ch.codePointAt(0) as number;
      n += cp < 0x80 ? 1 : cp < 0x800 ? 2 : cp < 0x10000 ? 3 : 4;
    }
    return n;
  };
  const data = root === "";
  const member = (path: string, k: string): string => (path === label + ": " ? path + k : path + "." + k);
  const bad = (): never => decFail(label, data ? "not a canon data file (invalid JSON)" : "invalid JSON at byte " + bytes(i));
  const invalid = (path: string, message: string): never => (data ? bad() : decFail(path, message));
  const ws = (): void => {
    while (i < text.length && " \t\n\r".includes(text[i])) i++;
  };
  const digits = (): void => {
    if (!(text[i] >= "0" && text[i] <= "9")) bad();
    while (text[i] >= "0" && text[i] <= "9") i++;
  };
  const hex4 = (): number => {
    for (let k = 0; k < 4; k++) {
      if (!/^[0-9a-fA-F]$/.test(text[i + k] ?? "")) {
        i += k;
        bad();
      }
    }
    i += 4;
    return parseInt(text.slice(i - 4, i), 16);
  };
  const unicode = (path: string): string => {
    const u = hex4();
    if (u >= 0xdc00 && u <= 0xdfff) invalid(path, "unpaired surrogate");
    if (u < 0xd800 || u > 0xdbff) return String.fromCharCode(u);
    const next = text.slice(i, i + 2);
    if (next.length < 2 && "\\u".startsWith(next)) {
      i = text.length;
      bad();
    }
    if (next !== "\\u") invalid(path, "unpaired surrogate");
    i += 2;
    const lo = hex4();
    if (lo < 0xdc00 || lo > 0xdfff) invalid(path, "unpaired surrogate");
    return String.fromCharCode(u, lo);
  };
  const str = (path: string): string => {
    i++;
    let out = "";
    for (;;) {
      if (i >= text.length || text[i] < " ") bad();
      const c = text[i++];
      if (c === '"') return out;
      if (c >= "\ud800" && c <= "\udfff") {
        i--;
        if (c > "\udbff" || !(text[i + 1] >= "\udc00" && text[i + 1] <= "\udfff")) invalid(path, "not UTF-8");
        out += text.slice(i, i + 2);
        i += 2;
      } else if (c !== "\\") {
        out += c;
      } else if (text[i] === "u") {
        i++;
        out += unicode(path);
      } else if (Object.prototype.hasOwnProperty.call(escapes, text[i])) {
        out += escapes[text[i++]];
      } else {
        bad();
      }
    }
  };
  const num = (): unknown => {
    const start = i;
    if (text[i] === "-") i++;
    if (text[i] === "0") i++;
    else digits();
    let exact = false;
    if (text[i] === ".") {
      i++;
      digits();
      exact = true;
    }
    if (text[i] === "e" || text[i] === "E") {
      i++;
      if (text[i] === "+" || text[i] === "-") i++;
      digits();
      exact = true;
    }
    const token = text.slice(start, i);
    if (exact) return decToken(token);
    const n = Number(token);
    return Number.isSafeInteger(n) ? n : BigInt(token);
  };
  const word = (w: string, v: unknown): unknown => {
    for (let k = 0; k < w.length; k++) {
      if (text[i + k] !== w[k]) {
        i += k;
        bad();
      }
    }
    i += w.length;
    return v;
  };
  const sep = (close: string): boolean => {
    ws();
    if (text[i] === ",") {
      i++;
      return true;
    }
    if (text[i] !== close) bad();
    i++;
    return false;
  };
  const open = (depth: number, path: string): void => {
    if (depth >= 512) decFail(path, "nested deeper than 512 levels");
    i++;
    ws();
  };
  const obj = (depth: number, path: string): unknown => {
    open(depth, path);
    const o: Record<string, unknown> = {};
    const order: string[] = [];
    if (text[i] === "}") {
      i++;
    } else {
      do {
        ws();
        if (text[i] !== '"') bad();
        const k = str(path);
        if (Object.prototype.hasOwnProperty.call(o, k)) decFail(member(path, k), "duplicate key");
        ws();
        if (text[i] !== ":") bad();
        i++;
        Object.defineProperty(o, k, { value: val(depth + 1, member(path, k)), enumerable: true, writable: true, configurable: true });
        order.push(k);
      } while (sep("}"));
    }
    Object.defineProperty(o, decOrder, { value: order });
    return o;
  };
  const arr = (depth: number, path: string): unknown => {
    open(depth, path);
    const a: unknown[] = [];
    if (text[i] === "]") {
      i++;
      return a;
    }
    do {
      a.push(val(depth + 1, path + "[" + a.length + "]"));
    } while (sep("]"));
    return a;
  };
  const val = (depth: number, path: string): unknown => {
    ws();
    const c = text[i];
    if (c === "{") return obj(depth, path);
    if (c === "[") return arr(depth, path);
    if (c === '"') return str(path);
    if (c === "t") return word("true", true);
    if (c === "f") return word("false", false);
    if (c === "n") return word("null", null);
    if (c === "-" || (c >= "0" && c <= "9")) return num();
    return bad();
  };
  const v = val(0, label + ": " + root);
  ws();
  if (i < text.length) bad();
  return v;
}

export function decodeAwards(json: unknown): CanonTable<string, Award> {
  const $doc = canonEnvelope(json, awardsSchema, "awards.json");
  return canonTable(canonFreeze(decList(decGet($doc, "rows"), "awards.json: rows", ($x, $p) => readAward($x, $p))), ($e) => $e.code);
}

export function parseAwards(text: string): CanonTable<string, Award> {
  return decodeAwards(decParse(text, "awards.json", ""));
}

function readAward($raw: unknown, $path: string): Award {
  const $o = decObject($raw, $path);
  const $v1: string = decString(decGet($o, "code"), $path + ".code");
  const $v2: base.BadgeId = decEntry(decGet($o, "badge"), $path + ".badge", base_BadgeIdIndex);
  const $v3: base.Tone = decEnum(decGet($o, "tone"), $path + ".tone", base.ToneMembers);
  const $r4 = decGet($o, "weights");
  const $v4: ReadonlyMap<base.Tone, number> = $r4 === undefined ? new CanonMap<base.Tone, number>([]) : decMap($r4, $path + ".weights", ($k, $p) => decEnum($k, $p, base.ToneMembers), ($x, $p) => decInt($x, $p, -9223372036854776000, 9223372036854776000));
  const $v5: types.Pin = read_types_Pin(decGet($o, "pin"), $path + ".pin");
  const $r6 = decGet($o, "tones");
  const $v6: ReadonlyArray<base.Tone> = $r6 === undefined ? [] : decList($r6, $path + ".tones", ($x, $p) => decEnum($x, $p, base.ToneMembers));
  return { code: $v1, badge: $v2, tone: $v3, weights: $v4, pin: $v5, tones: $v6 };
}

function read_types_Pin($raw: unknown, $path: string): types.Pin {
  const $o = decObject($raw, $path);
  const $v1: string = decString(decGet($o, "place"), $path + ".place");
  const $r2 = decGet($o, "count");
  const $v2: number = $r2 === undefined ? 1 : decInt($r2, $path + ".count", -9223372036854776000, 9223372036854776000);
  const $r3 = decGet($o, "weight");
  const $v3: number = $r3 === undefined ? 1 : decFloat($r3, $path + ".weight", "expected a number");
  return { place: $v1, count: $v2, weight: $v3 };
}

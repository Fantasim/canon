/** A holder of a point and of a table of them. */
export interface Q {
  /** Its key. */
  readonly k: string;
  /** A plain point. */
  readonly inner: P;
  /** Points by name. */
  readonly slots: ReadonlyArray<CanonRow<P, string>>;
}


CONFORMANCE.md §2–§4, CODEGEN.md §5.10: translated fns of every operation: one checked helper each, entry and exit checks, reads of self through optional records, enums, variant kinds, templates, floats and durations; methods of records and cases.
-- a/a.canon --
/// Translated functions in a baked emit.
package a

/// Grades, lowest first.
enum Grade ordered { low, mid, high }

/// A bonus.
record Bonus {
  /// Its value.
  value: Int
}

/// A shape.
variant Shape {
  /// A circle.
  circle {
    /// Its radius.
    r: Int(1..=100)

    /// Its scaled radius.
    export fn scaled(self, k: Int) -> Int { return r * k }
  }
  /// A square.
  square {
    /// Its side.
    side: Int
  }
}

/// A unit.
record Unit {
  /// Hit points.
  hp: Int
  /// Speed.
  speed: Float
  /// Cooldown.
  cooldown: Duration
  /// Grade.
  grade: Grade
  /// Name.
  name: String
  /// An optional bonus.
  bonus: Bonus? = none
  /// Its shape.
  shape: Shape = circle { r: 2 }
  /// A flag.
  fast: Bool = false

  /// Precomputed, read like a field.
  export fn strong(self) -> Bool { return hp > 100 }

  /// Integer arithmetic.
  export fn arith(self, k: Int) -> Int {
    let base = hp * k + (hp - k) / 2
    return if strong() { base % 7 } else { -base }
  }

  /// A bonus, or zero.
  export fn extra(self) -> Int { return bonus?.value ?? 0 }

  /// A label.
  export fn label(self, n: Int) -> String { return "{name}#{n} {grade}" }

  /// Compares grades.
  export fn atLeast(self, g: Grade) -> Bool { return grade >= g }

  /// Float math.
  export fn dist(self, t: Float) -> Float { return speed * t + 1.5 }

  /// Duration math.
  export fn wait(self, n: Int) -> Duration { return cooldown * n + 2s }

  /// Ratio of durations.
  export fn ratio(self, d: Duration) -> Float { return cooldown / d }

  /// Whether it is round.
  export fn round(self, n: Int) -> Bool { return shape is circle and n > 0 }
}

/// A refined result.
export fn clamped(x: Int, lo: Int, hi: Int) -> Int(0..=1000) { return clamp(x, lo, hi) }

/// Sized types.
export fn small(n: Int8, m: UInt8) -> Int16 { return n * m }

/// Conversions.
export fn conv(f: Float, i: Int) -> Int { return floor(f) + ceil(f) + round(f) + Int(f) + abs(i) + max(i, 2, 3) + min(i, 5) }

/// Float32.
export fn narrow(f: Float32) -> Float32 { return f + f }

/// A refined float.
export fn unit(x: Float(0.0..1.0)) -> Float { return x }

/// Logic.
export fn logic(a: Bool, b: Bool, n: Int) -> Bool { return (a or b) and not (n == 3) }

/// Calls another translated fn.
export fn twice(n: Int) -> Int { return clamped(n, 0, 10) * 2 }

test "units" {
  let u: Unit = { hp: 150, speed: 1.5, cooldown: 3s, grade: mid, name: "ann", bonus: { value: 4 } }
  expect u.arith(3) == 3
  expect u.extra() == 4
  expect u.label(1) == "ann#1 mid"
  expect u.atLeast(high) == false
  expect u.dist(2.0) == 4.5
  expect u.wait(2) == 8s
  expect u.ratio(1s) == 3.0
  expect u.round(1)
  expect clamped(500, 0, 9) == 9
  expect small(2, 3) == 6
  expect conv(1.5, -4) == 1 + 2 + 2 + 1 + 4 + 3 + -4
  expect narrow(1.5) == 3.0
  expect unit(0.5) == 0.5
  expect logic(true, false, 1)
  expect twice(4) == 8
}

test "shapes" {
  let c: Shape.circle = circle { r: 3 }
  expect c.scaled(2) == 6
}

emit ts { out: "@features/a/a.ts" }
-- ts.out --

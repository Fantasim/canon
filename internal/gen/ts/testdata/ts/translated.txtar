import { test } from "node:test";
import * as assert from "node:assert/strict";
import { $shapeCircleScaled, $unitArith, $unitDist, $unitLabel, $unitRatio, $unitRound, $unitWait, CanonEvalError, clamped, conv, logic, narrow, small, twice, unit } from "./a.js";

function canonCatch<T>(f: () => T): [T | undefined, string] {
  try {
    return [f(), ""];
  } catch (e) {
    if (e instanceof CanonEvalError) return [undefined, e.code];
    throw e;
  }
}

test("Shape.circle.scaled conformance", () => {
  const vectors: ReadonlyArray<readonly [number, number, number, string]> = [
    [3, 2, 6, ""],
    [3, -9223372036854776000, 0, "E8303"],
    [3, -1, -3, ""],
    [3, 0, 0, ""],
    [3, 1, 3, ""],
    [3, 3, 9, ""],
    [3, 4, 12, ""],
    [3, 9223372036854776000, 0, "E8303"],
  ];
  for (const [r, k, want, code] of vectors) {
    const [got, gotCode] = canonCatch(() => $shapeCircleScaled(r, k));
    assert.equal(gotCode, code, `Shape.circle.scaled(r=${r}, k=${k})`);
    if (code === "") assert.ok(Object.is(got, want), `Shape.circle.scaled(r=${r}, k=${k}) = ${got}, canon says ${want}`);
  }
});


    if (code === "") assert.ok(Object.is(got, want), `unit(x=${x}) = ${got}, canon says ${want}`);
  }
});

test("logic conformance", () => {
  const vectors: ReadonlyArray<readonly [boolean, boolean, number, boolean, string]> = [
    [true, false, 1, true, ""],
    [false, false, -9223372036854776000, false, "E8303"],
    [false, false, -1, false, ""],
    [false, false, 0, false, ""],
    [false, false, 1, false, ""],
    [false, false, 9223372036854776000, false, "E8303"],
    [false, true, -9223372036854776000, false, "E8303"],
    [false, true, -1, true, ""],
    [false, true, 0, true, ""],
    [false, true, 1, true, ""],
    [false, true, 9223372036854776000, false, "E8303"],
    [true, false, -9223372036854776000, false, "E8303"],
    [true, false, -1, true, ""],
    [true, false, 0, true, ""],
    [true, false, 9223372036854776000, false, "E8303"],
    [true, true, -9223372036854776000, false, "E8303"],
    [true, true, -1, true, ""],
    [true, true, 0, true, ""],
    [true, true, 1, true, ""],
    [true, true, 9223372036854776000, false, "E8303"],
  ];
  for (const [a, b, n, want, code] of vectors) {
    const [got, gotCode] = canonCatch(() => logic(a, b, n));
    assert.equal(gotCode, code, `logic(a=${a}, b=${b}, n=${n})`);
    if (code === "") assert.ok(Object.is(got, want), `logic(a=${a}, b=${b}, n=${n}) = ${got}, canon says ${want}`);
  }
});


/** Grades, lowest first. */
export type Grade = "low" | "mid" | "high";
export const GradeMembers: ReadonlyArray<Grade> = Object.freeze(["low", "mid", "high"]);
export const GradeNames: Readonly<Record<Grade, string>> = Object.freeze({ low: "low", mid: "mid", high: "high" });

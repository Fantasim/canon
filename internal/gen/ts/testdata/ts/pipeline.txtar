CONFORMANCE.md §6.6, §7.2: the potion example with `damageAt` added: its TypeScript conformance file is the template of CONFORMANCE.md §7.2, vectors and all.
-- pipeline/pipeline.canon --
/// A deliberately small object.
package pipeline

/// A healing potion.
record Potion {
  /// The item define.
  id: String
  /// Hit points restored.
  heal: Int

  /// Needs a runtime input.
  export fn healFor(self, missingHp: Int) -> Int { return min(heal, max(missingHp, 0)) }

  /// A refined parameter.
  export fn damageAt(self, level: Int(1..=150)) -> Int { return heal * level / 100 }
}

test "healFor never overheals and never goes negative" {
  let p: Potion = { id: "II_POT_T", heal: 500 }
  expect p.healFor(200) == 200
  expect p.healFor(9000) == 500
  expect p.healFor(-5) == 0
}

test "damageAt scales with the level" {
  let p: Potion = { id: "II_POT_T", heal: 500 }
  expect p.damageAt(10) == 50
}

emit ts { out: "@features/pipeline/generated.ts" }

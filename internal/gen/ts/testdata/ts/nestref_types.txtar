/// Package.
package nrt

import nrlib { items, Shape }

/// A parameter, by shape.
type Param(s: Shape) = match s {
  count => Int(0..)
  place => String
  none_ => Never
}

/// Leaf ew.
enum Tone { first, second = "z2", third }

/// Row.
record EwR1 {
/// Key.
  k: Tone
/// Shape.
  shape: Shape
}

/// List.
let ew1: [EwR1] keyed by k = [ { k: second, shape: count }, { k: third, shape: place } ]

/// Row.
record EwR2 {
/// Key.
  k: ref ew1
/// Shape.
  shape: Shape
}

/// List.
let ew2: [EwR2] keyed by k = [ { k: second, shape: count }, { k: third, shape: place } ]

/// Row.
record EwR3 {
/// Key.
  k: ref ew2
/// Shape.
  shape: Shape
}

/// List.
let ew3: [EwR3] keyed by k = [ { k: second, shape: count }, { k: third, shape: place } ]

/// Holder.
record HEw {
/// A field.
  f2: ref ew2
/// A field.
  f3: ref ew3
/// A field.
  fl: [ref ew3]
/// A field.
  fm: {ref ew3: Int}
/// A field.
  fu: ref ew2 | "none"
/// A field.
  fus: [ref ew3 | "none"]
/// A field.
  ev: ref ew3
/// A field.
  param: Param(ev.shape)? @json(none: 0)
/// A field.
  ev2: ref ew2
/// A field.
  param2: Param(ev2.shape)? @json(none: 0)
}

/// The holder.
let hew: HEw = { f2: second, f3: second, fl: [third], fm: { second: 1 }, fu: second, fus: ["none", third], ev: second, param: 3, ev2: third, param2: "x" }

/// Leaf ec.
enum Rank @codes(UInt8) @json(codes) { zulu = 4, alpha = 9, mid = 1 }

/// Row.
record EcR1 {
/// Key.
  k: Rank
/// Shape.
  shape: Shape
}

/// List.
let ec1: [EcR1] keyed by k = [ { k: alpha, shape: count }, { k: zulu, shape: place } ]

/// Row.
record EcR2 {
/// Key.
  k: ref ec1
/// Shape.
  shape: Shape
}

/// List.
let ec2: [EcR2] keyed by k = [ { k: alpha, shape: count }, { k: zulu, shape: place } ]

/// Row.
record EcR3 {
/// Key.
  k: ref ec2
/// Shape.
  shape: Shape
}

/// List.
let ec3: [EcR3] keyed by k = [ { k: alpha, shape: count }, { k: zulu, shape: place } ]

/// Holder.
record HEc {
/// A field.
  f2: ref ec2
/// A field.
  f3: ref ec3
/// A field.
  fl: [ref ec3]
/// A field.
  fm: {ref ec3: Int}
/// A field.
  ev: ref ec3
/// A field.
  param: Param(ev.shape)? @json(none: 0)
/// A field.
  ev2: ref ec2
/// A field.
  param2: Param(ev2.shape)? @json(none: 0)
}

/// The holder.
let hec: HEc = { f2: alpha, f3: alpha, fl: [zulu], fm: { alpha: 1 }, ev: alpha, param: 3, ev2: zulu, param2: "x" }

/// Row.
record StR1 {
/// Key.
  k: String
/// Shape.
  shape: Shape
}

/// List.
let st1: [StR1] keyed by k = [ { k: "q", shape: count }, { k: "p", shape: place } ]

/// Row.
record StR2 {
/// Key.
  k: ref st1
/// Shape.
  shape: Shape
}

/// List.
let st2: [StR2] keyed by k = [ { k: "q", shape: count }, { k: "p", shape: place } ]

/// Row.
record StR3 {
/// Key.
  k: ref st2
/// Shape.
  shape: Shape
}

/// List.
let st3: [StR3] keyed by k = [ { k: "q", shape: count }, { k: "p", shape: place } ]

/// Holder.
record HSt {
/// A field.
  f2: ref st2
/// A field.
  f3: ref st3
/// A field.
  fl: [ref st3]
/// A field.
  fm: {ref st3: Int}
/// A field.
  fu: ref st2 | "none"
/// A field.
  fus: [ref st3 | "none"]
/// A field.
  ev: ref st3
/// A field.
  param: Param(ev.shape)? @json(none: 0)
/// A field.
  ev2: ref st2
/// A field.
  param2: Param(ev2.shape)? @json(none: 0)
}

/// The holder.
let hst: HSt = { f2: "q", f3: "q", fl: ["p"], fm: { "q": 1 }, fu: "q", fus: ["none", "p"], ev: "q", param: 3, ev2: "p", param2: "x" }

/// Row.
record InR1 {
/// Key.
  k: Int
/// Shape.
  shape: Shape
}

/// List.
let in1: [InR1] keyed by k = [ { k: 20, shape: count }, { k: 5, shape: place } ]

/// Row.
record InR2 {
/// Key.
  k: ref in1
/// Shape.
  shape: Shape
}

/// List.
let in2: [InR2] keyed by k = [ { k: 20, shape: count }, { k: 5, shape: place } ]

/// Row.
record InR3 {
/// Key.
  k: ref in2
/// Shape.
  shape: Shape
}

/// List.
let in3: [InR3] keyed by k = [ { k: 20, shape: count }, { k: 5, shape: place } ]

/// Holder.
record HIn {
/// A field.
  f2: ref in2
/// A field.
  f3: ref in3
/// A field.
  fl: [ref in3]
/// A field.
  fm: {ref in3: Int}
/// A field.
  ev: ref in3
/// A field.
  param: Param(ev.shape)? @json(none: 0)
/// A field.
  ev2: ref in2
/// A field.
  param2: Param(ev2.shape)? @json(none: 0)
}

/// The holder.
let hin: HIn = { f2: 20, f3: 20, fl: [5], fm: { 20: 1 }, ev: 20, param: 3, ev2: 5, param2: "x" }

/// Row.
record TbR1 {
/// Key.
  k: ref items
/// Shape.
  shape: Shape
}

/// List.
let tb1: [TbR1] keyed by k = [ { k: sword, shape: count }, { k: shield, shape: place } ]

/// Row.
record TbR2 {
/// Key.
  k: ref tb1
/// Shape.
  shape: Shape
}

/// List.
let tb2: [TbR2] keyed by k = [ { k: sword, shape: count }, { k: shield, shape: place } ]

/// Row.
record TbR3 {
/// Key.
  k: ref tb2
/// Shape.
  shape: Shape
}

/// List.
let tb3: [TbR3] keyed by k = [ { k: sword, shape: count }, { k: shield, shape: place } ]

/// Holder.
record HTb {
/// A field.
  f2: ref tb2
/// A field.
  f3: ref tb3
/// A field.
  fl: [ref tb3]
/// A field.
  fm: {ref tb3: Int}
/// A field.
  fu: ref tb2 | "none"
/// A field.
  fus: [ref tb3 | "none"]
/// A field.
  ev: ref tb3
/// A field.
  param: Param(ev.shape)? @json(none: 0)
/// A field.
  ev2: ref tb2
/// A field.
  param2: Param(ev2.shape)? @json(none: 0)
}

/// The holder.
let htb: HTb = { f2: sword, f3: sword, fl: [shield], fm: { sword: 1 }, fu: sword, fus: ["none", shield], ev: sword, param: 3, ev2: shield, param2: "x" }


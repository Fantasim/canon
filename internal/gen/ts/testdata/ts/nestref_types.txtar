function readHEc($raw: unknown, $path: string): HEc {
  const $o = decObject($raw, $path);
  const $v1: Rank = decCode(decInt(decGet($o, "f2", $path + ".f2"), $path + ".f2", 0, 255), $path + ".f2", RankMembers, RankCodes);
  const $v2: Rank = decCode(decInt(decGet($o, "f3", $path + ".f3"), $path + ".f3", 0, 255), $path + ".f3", RankMembers, RankCodes);
  const $v3: ReadonlyArray<Rank> = decList(decGet($o, "fl", $path + ".fl"), $path + ".fl", ($x, $p) => decCode(decInt($x, $p, 0, 255), $p, RankMembers, RankCodes));
  const $v4: ReadonlyMap<Rank, number> = decMap(decGet($o, "fm", $path + ".fm"), $path + ".fm", ($k, $p) => decCode(decInt(decIntKey($k, $p), $p, 0, 255), $p, RankMembers, RankCodes), ($x, $p) => decInt($x, $p, -9223372036854776000, 9223372036854776000));
  const $v5: Rank = decCode(decInt(decGet($o, "ev", $path + ".ev"), $path + ".ev", 0, 255), $path + ".ev", RankMembers, RankCodes);
  const $r6 = decGet($o, "param");
  const $v6: Param | null = $r6 === undefined || $r6 === null || decSame($r6, "0") ? null : readParam($r6, $path + ".param", branchesHEcParam.get($v5)!);
  const $v7: Rank = decCode(decInt(decGet($o, "ev2", $path + ".ev2"), $path + ".ev2", 0, 255), $path + ".ev2", RankMembers, RankCodes);
  const $r8 = decGet($o, "param2");
  const $v8: Param | null = $r8 === undefined || $r8 === null || decSame($r8, "0") ? null : readParam($r8, $path + ".param2", branchesHEcParam2.get($v7)!);
  return { f2: $v1, f3: $v2, fl: $v3, fm: $v4, ev: $v5, param: $v6, ev2: $v7, param2: $v8 };
}


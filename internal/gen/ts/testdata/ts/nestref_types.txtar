/// Foreign tables.
package nrlib

/// Shape.
enum Shape { count, place, none_ }

/// T.
record T {
/// Shape.
  shape: Shape
}

/// The items.
let items: table T = {
  sword { shape: count }
  shield { shape: place }
}


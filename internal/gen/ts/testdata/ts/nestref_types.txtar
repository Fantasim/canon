function readHEw($raw: unknown, $path: string): HEw {
  const $o = decObject($raw, $path);
  const $v1: Tone = decEnum(decGet($o, "f2", $path + ".f2"), $path + ".f2", ToneMembers);
  const $v2: Tone = decEnum(decGet($o, "f3", $path + ".f3"), $path + ".f3", ToneMembers);
  const $v3: ReadonlyArray<Tone> = decList(decGet($o, "fl", $path + ".fl"), $path + ".fl", ($x, $p) => decEnum($x, $p, ToneMembers));
  const $v4: ReadonlyMap<Tone, number> = decMap(decGet($o, "fm", $path + ".fm"), $path + ".fm", ($k, $p) => decEnum($k, $p, ToneMembers), ($x, $p) => decInt($x, $p, -9223372036854776000, 9223372036854776000));
  const $v5: string = decString(decGet($o, "fu", $path + ".fu"), $path + ".fu") as string;
  const $v6: ReadonlyArray<string> = decList(decGet($o, "fus", $path + ".fus"), $path + ".fus", ($x, $p) => decString($x, $p) as string);
  const $v7: Tone = decEnum(decGet($o, "ev", $path + ".ev"), $path + ".ev", ToneMembers);
  const $r8 = decGet($o, "param");
  const $v8: Param | null = $r8 === undefined || $r8 === null || decSame($r8, "0") ? null : readParam($r8, $path + ".param", branchesHEwParam.get($v7)!);
  const $v9: Tone = decEnum(decGet($o, "ev2", $path + ".ev2"), $path + ".ev2", ToneMembers);
  const $r10 = decGet($o, "param2");
  const $v10: Param | null = $r10 === undefined || $r10 === null || decSame($r10, "0") ? null : readParam($r10, $path + ".param2", branchesHEwParam2.get($v9)!);
  return { f2: $v1, f3: $v2, fl: $v3, fm: $v4, fu: $v5, fus: $v6, ev: $v7, param: $v8, ev2: $v9, param2: $v10 };
}


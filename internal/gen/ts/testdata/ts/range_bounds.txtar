  };
  const num = (): unknown => {
    const start = i;
    if (text[i] === "-") i++;
    if (text[i] === "0") i++;
    else digits();
    let exact = false;
    if (text[i] === ".") {
      i++;
      digits();
      exact = true;
    }
    if (text[i] === "e" || text[i] === "E") {

-- a/a.canon --
/// Bound constants and the keys of integer maps.
package a

/// Bounds at every level.
record Bounds {
  /// A bigint with a bound past 2^53.
  big: Int(1..=10_000_000_000_000_000) @ts(bigint)
  /// A number with a bound past 2^53.
  huge: Int(0..=10_000_000_000_000_000)
  /// Bigints below five.
  bigs: [Int(..5)] = [] @ts(bigint)
  /// Bigint keys.
  bigk: {Int(0..=5): Int} = {} @ts(bigint)
  /// Counts by byte.
  bytes: {UInt8: Int} = {}
  /// A float.
  f: Float(-1.5..=1.5)
  /// A Float32.
  f32: Float32(..=0.1)
  /// A Duration.
  d: Duration(1s..=1h) @json(unit: ms)
  /// A string.
  s: String(1..=4)
  /// A list and its elements.
  tags: [Int(0..=5)](..=3)
  /// A map, its keys and its values.
  m: {String(1..=3): Int(0..=9)}
  /// A list of optionals.
  opts: [Int(0..=5)?]
  /// An exclusive bound.
  ex: Int(..5)
}

/// A variant whose case holds a bound.
variant Shape @json(tag: "kind") {
  /// A circle.
  circle {
    /// Its radius.
    r: Int(0..=2)
  }
  /// A dot.
  dot
}

emit ts { out: "@features/a/a.ts", mode: types }

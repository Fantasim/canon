        if (text[i] !== ":") bad();
        i++;
        Object.defineProperty(o, k, { value: val(depth + 1, member(path, k)), enumerable: true, writable: true, configurable: true });
        order.push(k);
      } while (sep("}"));
    }
    Object.defineProperty(o, decOrder, { value: order });
    return o;
  };
  const arr = (depth: number, path: string): unknown => {
    open(depth, path);
    const a: unknown[] = [];
    if (text[i] === "]") {
      i++;
      return a;
    }
    do {
      a.push(val(depth + 1, path + "[" + a.length + "]"));
    } while (sep("]"));
    return a;
  };
  const val = (depth: number, path: string): unknown => {
    ws();
    const c = text[i];
    if (c === "{") return obj(depth, path);
    if (c === "[") return arr(depth, path);
    if (c === '"') return str(path);
    if (c === "t") return word("true", true);
    if (c === "f") return word("false", false);
    if (c === "n") return word("null", null);
    if (c === "-" || (c >= "0" && c <= "9")) return num();
    return bad();
  };
  const v = val(0, label + ": " + root);
  ws();
  if (i < text.length) bad();
  return v;
}

function readBounds($raw: unknown, $path: string): Bounds {
  const $o = decObject($raw, $path);
  const $v1: bigint = decInBig(decBig(decGet($o, "big", $path + ".big"), $path + ".big", -9223372036854775808n, 9223372036854775807n), $path + ".big", 1n, 10000000000000000n, true, "1..=10000000000000000");
  const $v2: number = decIn(decInt(decGet($o, "huge", $path + ".huge"), $path + ".huge", -9223372036854776000, 9223372036854776000), $path + ".huge", 0, 10000000000000000, true, "0..=10000000000000000");
  const $r3 = decGet($o, "bigs", $path + ".bigs", true);
  const $v3: ReadonlyArray<bigint> = $r3 === undefined ? [] : decList($r3, $path + ".bigs", ($x, $p) => decInBig(decBig($x, $p, -9223372036854775808n, 9223372036854775807n), $p, null, 5n, false, "..5"));
  const $r4 = decGet($o, "bigk", $path + ".bigk", true);
  const $v4: ReadonlyMap<bigint, bigint> = $r4 === undefined ? /*#__PURE__*/ new CanonMap<bigint, bigint>([]) : decMap($r4, $path + ".bigk", ($k, $p) => decInBig(decBigKey($k, $p, -9223372036854775808n, 9223372036854775807n), $p, 0n, 5n, true, "0..=5"), ($x, $p) => decBig($x, $p, -9223372036854775808n, 9223372036854775807n));
  const $r5 = decGet($o, "bytes", $path + ".bytes", true);
  const $v5: ReadonlyMap<number, number> = $r5 === undefined ? /*#__PURE__*/ new CanonMap<number, number>([]) : decMap($r5, $path + ".bytes", ($k, $p) => decInt(decIntKey($k, $p), $p, 0, 255), ($x, $p) => decInt($x, $p, -9223372036854776000, 9223372036854776000));
  const $v6: number = decIn(decFloat(decGet($o, "f", $path + ".f"), $path + ".f"), $path + ".f", -1.5, 1.5, true, "-1.5..=1.5");
  const $v7: number = decIn(decF32(decGet($o, "f32", $path + ".f32"), $path + ".f32"), $path + ".f32", -Infinity, 0.1, true, "..=0.1");
  const $v8: number = decIn(decDuration(decGet($o, "d", $path + ".d"), $path + ".d", 1), $path + ".d", 1000, 3600000, true, "1s..=1h");
  const $v9: string = decStrIn(decString(decGet($o, "s", $path + ".s"), $path + ".s"), $path + ".s", 1, 4, true, "1..=4");
  const $v10: ReadonlyArray<number> = decCountIn(decList(decGet($o, "tags", $path + ".tags"), $path + ".tags", ($x, $p) => decIn(decInt($x, $p, -9223372036854776000, 9223372036854776000), $p, 0, 5, true, "0..=5")), $path + ".tags", -Infinity, 3, true, "..=3");
  const $v11: ReadonlyMap<string, number> = decMap(decGet($o, "m", $path + ".m"), $path + ".m", ($k, $p) => decStrIn($k, $p, 1, 3, true, "1..=3"), ($x, $p) => decIn(decInt($x, $p, -9223372036854776000, 9223372036854776000), $p, 0, 9, true, "0..=9"));
  const $v12: ReadonlyArray<number | null> = decList(decGet($o, "opts", $path + ".opts"), $path + ".opts", ($x, $p) => $x === null ? null : decIn(decInt($x, $p, -9223372036854776000, 9223372036854776000), $p, 0, 5, true, "0..=5"));
  const $v13: number = decIn(decInt(decGet($o, "ex", $path + ".ex"), $path + ".ex", -9223372036854776000, 9223372036854776000), $path + ".ex", -Infinity, 5, false, "..5");
  return { big: $v1, huge: $v2, bigs: $v3, bigk: $v4, bytes: $v5, f: $v6, f32: $v7, d: $v8, s: $v9, tags: $v10, m: $v11, opts: $v12, ex: $v13 };
}

/** Bounds at every level. */
export function decodeBounds(json: unknown): Bounds {
  return canonFreeze(readBounds(json, "Bounds: $"));
}

export function parseBounds(text: string): Bounds {
  return decodeBounds(decParse(text, "Bounds", "$"));
}

function readShape($raw: unknown, $path: string): Shape {
  const $o = decObject($raw, $path);
  const $tag = decString(decGet($o, "kind", $path + ".kind"), $path + ".kind");
  switch ($tag) {
    case "circle":
      return readShapeCircle($o, $path);
    case "dot":
      return { kind: "dot" };
    default:
      return decFail($path + ".kind", "unknown case " + $tag);
  }
}

function readShapeCircle($o: Record<string, unknown>, $path: string): ShapeCircle {
  const $v1: number = decIn(decInt(decGet($o, "r", $path + ".r"), $path + ".r", -9223372036854776000, 9223372036854776000), $path + ".r", 0, 2, true, "0..=2");
  return { kind: "circle", r: $v1 };
}

/** A variant whose case holds a bound. */
export function decodeShape(json: unknown): Shape {
  return canonFreeze(readShape(json, "Shape: $"));
}

export function parseShape(text: string): Shape {
  return decodeShape(decParse(text, "Shape", "$"));
}

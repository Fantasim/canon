/** A circle. */
export interface ShapeCircle {
  readonly kind: "circle";
  /** Its radius. */
  readonly r: number;
}

/** The lower bound of r, from its refinement 0..=2. */
export const ShapeCircle_RMin: number = 0;
/** The upper bound of r, from its refinement 0..=2. */

export type ShapeKind =
  | "circle"
  /** A dot. */
  | "dot";

/** Bounds at every level. */
export interface Bounds {
  /** A bigint with a bound past 2^53. */
  readonly big: bigint;
  /** A number with a bound past 2^53. */

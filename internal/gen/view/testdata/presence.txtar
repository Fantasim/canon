    "pkg.F": {"kind": "typeFunction", "name": "F", "params": [], "select": "", "branches": [], "drivers": {}}
  },
  "i18n": {"source": "en", "languages": {"fr": {"files": [], "missing": 0, "texts": {}}}}
}

API.md L2: a field name that keeps a legacy type prefix is a warning with the name it should
have, for every prefix and type the lint reads, in a record and in a case of a variant; a field
named without a prefix is not reported.
-- project.canon --
project acme {
  canon: "0.1"
}
-- m/m.canon --
package m

enum Kind { sword, bow }

/// Rows of a table, so that a ref has a target.
record Row { label: String }

let rows: table Row = {}

record Legacy {
  dwItemCount: Int
  szName: String
  lpPoint: String
  strLabel: String
  nLog: Int
  wKind: Kind
  iRow: ref rows
  uMask: Int?
  fScale: Float
  bOn: Bool
  bFlags: Int
  m_value: Int
  dwID: Int
  szURLPath: String
  clean: Int
}

variant Shape {
  circle {
    dwRadius: Int
  }
  square {
    dwSide: Int
  }
}
-- findings.txt --
warning[W0001]  m/m.canon:11:3
  field dwItemCount keeps the legacy prefix dw in its Canon name: rename it itemCount (canon rename keeps the old wire name with @json where a load or a data emit reads the field)


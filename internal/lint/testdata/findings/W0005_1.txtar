API.md §5.7: a string literal holding the words of canon's generated marker is reported, in a
value, a constant, a raw string and a function; the same words in a test declaration, and words
that only look like them, are not.
-- project.canon --
project acme {
  canon: "0.1"
}
-- m/m.canon --
package m

let header: String = "// GENERATED by canon from game/"

const OTHER = "// Code generated by canon: mine"

let raw: String = r"GENERATED by canon"

let near: String = "Generated by canon, generated BY canon"

fn banner() -> String { return "x GENERATED by canon x" }

test "the banner" {
  expect banner() == "// GENERATED by canon"
}
-- findings.txt --
warning[W0005]  m/m.canon:3:22
  this string holds the words of canon's generated marker: an output built from it claims to come from canon's generators; give it a marker of its own


API.md L7: the entries of a let with @files that sit in files off the path its template gives are
reported once, at the annotation, with their number and the first such file in path order with the
path the template gives its entry. Entries at their path, and one in the let's own file, are not off.
-- project.canon --
project acme {
  canon: "0.1"
}
-- m/m.canon --
package m

enum Kind { sword, bow }

record Item {
  kind: Kind
  power: Int = 1
}

@files("items/{kind}/{id}.canon")
let items: table Item = {}

entry items.inside { kind: bow }
-- m/items/sword/ok.canon --
package m

entry items.ok { kind: sword }
-- m/items/bow/fine.canon --
package m

entry items.fine { kind: bow }
-- m/zeta/z.canon --
package m

entry items.z { kind: bow, power: 2 }
-- m/loose/a.canon --
package m

entry items.a { kind: sword }
-- findings.txt --
warning[W0006]  m/m.canon:10:1
  2 entry files of items are off the path its @files template gives; first: m/loose/a.canon, which belongs at m/items/sword/a.canon

0 errors, 1 warning in 1 package (…)

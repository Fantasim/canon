API.md L4: a String type limited to the names of several enums, joined with + or read through a
{k: true for k in …} map, is reported with all its enums in first-use order, once each, and the
softer text that names a dependent type.
-- project.canon --
project acme {
  canon: "0.1"
}
-- m/m.canon --
package m

enum A { x, y }
enum B { z }

let names: [String] = [a.name for a in A.members] + [b.name for b in B.members]

let nameSet: {String: Bool} = {n: true for n in names}

type AnyName = String where names.contains(it)

type SetName = String where it in nameSet

type Twice = String where it in ([a.name for a in A.members] + [a.name for a in A.members]).unique()
-- findings.txt --
warning[W0003]  m/m.canon:10:6
  AnyName is a String limited to the member names of A, B: type it with the enum, or with a dependent type on the field that decides which enum

warning[W0003]  m/m.canon:12:6
  SetName is a String limited to the member names of A, B: type it with the enum, or with a dependent type on the field that decides which enum

warning[W0003]  m/m.canon:14:6
  Twice is a String limited to the member names of A: type it A


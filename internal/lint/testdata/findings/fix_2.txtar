API.md §5.7: a record that only a load reaches through a dependent field is on the wire, so the
rename request of its legacy-prefix finding keeps the old wire name (canon edit adds @json) and
linting again after the request applies reports nothing.
-- project.canon --
project acme {
  canon: "0.1"
}
-- apply --
-- m/m.canon --
package m

enum Kind { a, b }

record Inner {
  dwCount: Int
}

type Body(k: Kind) = match k {
  a => Inner
  b => Int
}

record Item {
  kind: Kind
  body: Body(kind)
}

let items: table Item = load("items.json")
-- m/items.json --
{
  "x": { "kind": "a", "body": { "dwCount": 1 } }
}
-- findings.txt --
warning[W0001]  m/m.canon:6:3
  field dwCount keeps the legacy prefix dw in its Canon name: rename it count (canon rename keeps the old wire name with @json where a load or a data emit reads the field)

0 errors, 1 warning in 1 package (…)
fix W0001 m/m.canon:6:3 {"ops":[{"op":"renameName","path":"m:Inner.dwCount","name":"count"}]}
after the first fix:
0 errors, 0 warnings in 1 package (…)

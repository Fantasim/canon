{
  "permissions": {
    "allow": [
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(awk *)",
      "Bash(sed -n *)",
      "Bash(sort *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git worktree list*)",
      "Bash(git rev-parse *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(go run *)",
      "Bash(go list *)",
      "Bash(go mod tidy)",
      "Bash(go mod why *)",
      "Bash(gofmt *)",
      "Bash(make check*)",
      "Bash(make audit*)",
      "Bash(make test*)",
      "Bash(make vet*)",
      "Bash(GOTOOLCHAIN=local make *)",
      "Bash(GOTOOLCHAIN=local go *)"
    ],
    "deny": [
      "Edit(/../../Resource/**)",
      "Write(/../../Resource/**)",
      "Edit(/../../Source/**)",
      "Write(/../../Source/**)",
      "Edit(/../../Client/**)",
      "Write(/../../Client/**)",
      "Edit(/../../Scripts/**)",
      "Write(/../../Scripts/**)",
      "Edit(/../../Program/**)",
      "Write(/../../Program/**)",
      "Edit(/../../Telemetry/**)",
      "Write(/../../Telemetry/**)",
      "Edit(/../../Dumps/**)",
      "Write(/../../Dumps/**)",
      "Edit(/../../Logs/**)",
      "Write(/../../Logs/**)",
      "Edit(/../../Reports/**)",
      "Write(/../../Reports/**)",
      "Edit(/../admin/**)",
      "Write(/../admin/**)",
      "Edit(/../balance/**)",
      "Write(/../balance/**)",
      "Edit(/../hdpay/**)",
      "Write(/../hdpay/**)",
      "Edit(/../monitoring/**)",
      "Write(/../monitoring/**)",
      "Edit(/../resourcestudio/**)",
      "Write(/../resourcestudio/**)",
      "Edit(/../sovcommon/**)",
      "Write(/../sovcommon/**)",
      "Edit(/../trello/**)",
      "Write(/../trello/**)",
      "Edit(/../website/**)",
      "Write(/../website/**)",
      "Edit(/.sovaudit/baseline.tsv)",
      "Write(/.sovaudit/baseline.tsv)",
      "Edit(/.sovaudit/state.tsv)",
      "Write(/.sovaudit/state.tsv)",
      "Edit(/tools/audit/.sovaudit/baseline.tsv)",
      "Write(/tools/audit/.sovaudit/baseline.tsv)",
      "Edit(/tools/audit/.sovaudit/state.tsv)",
      "Write(/tools/audit/.sovaudit/state.tsv)",
      "Bash(git push*)",
      "Bash(git remote add*)",
      "Bash(git remote set-url*)"
    ]
  },

  "hooks": {
  "PreToolUse": [
    { "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [
      { "type": "command", "shell": "bash", "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-outside.py\"" },
      { "type": "command", "shell": "bash", "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-scratch.py\"" } ] }
  ],
  "SessionStart": [ { "hooks": [
    { "type": "command", "shell": "bash", "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.py\"" } ] } ],
  "Stop": [ { "hooks": [
    { "type": "command", "shell": "bash", "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-uncommitted.py\"" } ] } ]
  }
}
